---
import '../styles/global.css';
import { SITE } from '../lib/constants';
import { OG_IMAGES } from '../lib/og';
import { webSiteSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = OG_IMAGES.default,
  noindex = false,
  schema,
} = Astro.props;

const ymCounterId = import.meta.env.PUBLIC_YM_COUNTER_ID || '110176980';
---
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {ymCounterId && <meta name="ym-counter-id" content={ymCounterId} />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={SITE.name} />
  {ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={title} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImage} />
    </>
  )}

  <!-- JSON-LD структурированные данные -->
  <script is:inline type="application/ld+json" set:html={
    JSON.stringify(
      schema
        ? (Array.isArray(schema) ? [webSiteSchema(), ...schema] : [webSiteSchema(), schema])
        : [webSiteSchema()]
    )
  } />
  <!-- Дополнительные JSON-LD из страниц -->
  <slot name="head" />

  <!-- llms.txt для AI-crawler'ов (GEO) -->
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Яндекс Метрика — подключается через CookieBanner после Accept, Partytown исполняет script в worker -->
</head>
<body>
  <slot />
  {ymCounterId && (
    <noscript>
      <div>
        <img src={`https://mc.yandex.ru/watch/${ymCounterId}`} style="position:absolute; left:-9999px;" alt="" />
      </div>
    </noscript>
  )}

  <!-- Global click tracking for data-track attributes -->
  <script is:inline>
    (function () {
      function hasAnalyticsConsent() {
        try {
          return window.localStorage.getItem('vn_cookie_consent') === 'accepted';
        } catch (_) {
          return false;
        }
      }

      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-track]');
        if (!el) return;
        var event = el.getAttribute('data-track');
        var params = {};
        try {
          var raw = el.getAttribute('data-track-params');
          if (raw) params = JSON.parse(raw);
        } catch (_) {}
        if (hasAnalyticsConsent() && window.ym) {
          var cid = parseInt(document.querySelector('meta[name="ym-counter-id"]')?.getAttribute('content') || '0', 10);
          if (cid) window.ym(cid, 'reachGoal', event, params);
        }
      });
    })();
  </script>

  <!-- Scroll depth tracking -->
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function hasAnalyticsConsent() {
        try {
          return window.localStorage.getItem('vn_cookie_consent') === 'accepted';
        } catch (_) {
          return false;
        }
      }
      var depths = {};
      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight > 0) {
            var depth = Math.round((scrollTop / docHeight) * 100);
            if (depth >= 50 && !depths[50]) {
              depths[50] = true;
              if (hasAnalyticsConsent() && window.ym) {
                var cid = parseInt(document.querySelector('meta[name="ym-counter-id"]')?.getAttribute('content') || '0', 10);
                if (cid) window.ym(cid, 'reachGoal', 'page_scroll_50');
              }
            }
            if (depth >= 90 && !depths[90]) {
              depths[90] = true;
              if (hasAnalyticsConsent() && window.ym) {
                var cid = parseInt(document.querySelector('meta[name="ym-counter-id"]')?.getAttribute('content') || '0', 10);
                if (cid) window.ym(cid, 'reachGoal', 'page_scroll_90');
              }
            }
          }
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>

  <!-- Reveal on scroll — IntersectionObserver для data-reveal элементов -->
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const mode = el.dataset.reveal;
            const delay = parseInt(el.dataset.revealDelay || '0', 10);
            const stagger = parseInt(el.dataset.revealStagger || '80', 10);

            if (mode === 'stagger') {
              el.querySelectorAll('[data-reveal-child]').forEach((child, i) => {
                child.style.transitionDelay = (delay + i * stagger) + 'ms';
              });
            } else {
              el.style.transitionDelay = delay + 'ms';
            }

            el.classList.add('is-revealed');

            if (el.dataset.revealOnce === 'true') {
              observer.unobserve(el);
            }
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px',
      });

      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    })();
  </script>
</body>
</html>
