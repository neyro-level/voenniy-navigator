---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import RouteMapOverlay from '../components/layout/RouteMapOverlay.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBottomCTA from '../components/layout/MobileBottomCTA.astro';
import RequestModal from '../components/ui/RequestModal';
import CookieBanner from '../components/ui/CookieBanner';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const props = Astro.props;
---
<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <Header />
  <RouteMapOverlay />
  <main>
    <slot />
  </main>
  <Footer />
  <MobileBottomCTA />
  <RequestModal client:load />
  <CookieBanner client:load />
</BaseLayout>

<script>
  import '../lib/navigation/navigationState';

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const trigger = target.closest('[data-modal-open]');
    if (!(trigger instanceof HTMLElement)) return;

    event.preventDefault();

    window.dispatchEvent(
      new CustomEvent('open-modal', {
        detail: {
          title: trigger.dataset.modalTitle,
          subtitle: trigger.dataset.modalSubtitle,
          source: trigger.dataset.modalSource || window.location.pathname,
        },
      }),
    );
  });
</script>
