---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="vn-journal-breadcrumbs" aria-label="Хлебные крошки">
  <ol class="vn-journal-breadcrumbs__list">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="vn-journal-breadcrumbs__item">
          {item.href && !isLast ? (
            <a href={item.href} class="vn-journal-breadcrumbs__link">{item.label}</a>
          ) : (
            <span class="vn-journal-breadcrumbs__current" aria-current={isLast ? 'page' : undefined}>
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .vn-journal-breadcrumbs {
    color: var(--color-text-tertiary);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-ui);
  }

  .vn-journal-breadcrumbs__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vn-journal-breadcrumbs__item {
    display: inline;
  }

  .vn-journal-breadcrumbs__item:not(:last-child)::after {
    content: " / ";
    color: color-mix(in srgb, var(--color-text-tertiary) 58%, transparent);
  }

  .vn-journal-breadcrumbs__link {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .vn-journal-breadcrumbs__link:hover {
    color: var(--color-accent-cta);
  }

  .vn-journal-breadcrumbs__current {
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }
</style>
