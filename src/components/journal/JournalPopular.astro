---
import type { JournalPostEntry } from '../../lib/journal';
import type { CommercialPageDescriptor } from '../../lib/journal';
import { formatJournalDate, getJournalCategory, getJournalPostUrl } from '../../lib/journal';
import CommercialRouteCard from './CommercialRouteCard.astro';

interface Props {
  posts: JournalPostEntry[];
  nextStep?: CommercialPageDescriptor;
}

const { posts, nextStep } = Astro.props;
---

<aside class="vn-journal-popular" aria-labelledby="vn-journal-popular-title">
  <p class="vn-journal-popular__eyebrow">Популярное</p>
  <h2 class="vn-journal-popular__title" id="vn-journal-popular-title">Материалы, с которых удобно начать</h2>
  <div class="vn-journal-popular__list">
    {posts.map((post, index) => {
      const category = getJournalCategory(post.data.categorySlug);
      return (
        <a href={getJournalPostUrl(post)} class="vn-journal-popular__item">
          <span class="vn-journal-popular__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="vn-journal-popular__copy">
            <span class="vn-journal-popular__meta">{formatJournalDate(post.data.publishDate)} · {category.label}</span>
            <span class="vn-journal-popular__name">{post.data.title}</span>
          </span>
        </a>
      );
    })}
  </div>
  {nextStep && <CommercialRouteCard page={nextStep} compact eyebrow="Главный следующий шаг" />}
</aside>

<style>
  .vn-journal-popular {
    display: grid;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-card);
  }

  .vn-journal-popular__eyebrow {
    margin: 0;
    color: var(--color-accent-cta);
    font-size: var(--fs-body-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: var(--lh-ui);
    text-transform: uppercase;
  }

  .vn-journal-popular__title {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 18px;
    font-weight: 700;
    line-height: var(--lh-title);
  }

  .vn-journal-popular__list {
    display: grid;
  }

  .vn-journal-popular__item {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    padding-block: 12px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .vn-journal-popular__number {
    color: color-mix(in srgb, var(--color-accent-cta) 74%, var(--color-text-secondary));
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .vn-journal-popular__copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .vn-journal-popular__meta {
    color: var(--color-text-tertiary);
    font-size: 13px;
    line-height: var(--lh-ui);
  }

  .vn-journal-popular__name {
    color: var(--color-text-primary);
    font-size: var(--fs-body-sm);
    font-weight: 700;
    line-height: var(--lh-title);
    transition: color 0.2s ease;
  }

  .vn-journal-popular__item:hover .vn-journal-popular__name {
    color: var(--color-accent-cta);
  }
</style>
