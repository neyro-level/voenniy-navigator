---
import { CONTACTS } from '../../lib/constants';

const phoneHref = `tel:${CONTACTS.phone.replace(/[^\d+]/g, '')}`;
---

<div id="landing-bottom-cta" class="vn-landing-bottom-cta" role="complementary" aria-label="Быстрые действия" data-visible="false">
  <nav class="vn-landing-bottom-cta__dock" aria-label="Быстрые действия">
    <a
      href="/contacts/#request"
      data-modal-open
      data-modal-title="Консультация по военной ипотеке"
      data-modal-source="landing-bottom-ipoteka"
      class="vn-landing-bottom-cta__item"
    >
      <span class="vn-landing-bottom-cta__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 3h6l4 4v14H7z"/>
          <path d="M13 3v5h5"/>
          <path d="M9.5 12h5"/>
          <path d="M9.5 15.5h3.5"/>
        </svg>
      </span>
      <span class="vn-landing-bottom-cta__label">Ипотека</span>
    </a>

    <a
      href={phoneHref}
      class="vn-landing-bottom-cta__item vn-landing-bottom-cta__item--phone"
      aria-label={`Позвонить ${CONTACTS.phone}`}
    >
      <span class="vn-landing-bottom-cta__phone-orb" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v2.1a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 3.3 2 2 0 0 1 4.11 1.1h2.11a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.62a2 2 0 0 1-.45 2.11L7.5 8.44a16 16 0 0 0 6 6l.89-.89a2 2 0 0 1 2.11-.45c.84.29 1.72.5 2.62.62A2 2 0 0 1 22 16.92z"/>
        </svg>
      </span>
      <span class="vn-landing-bottom-cta__label vn-landing-bottom-cta__label--phone">Позвонить</span>
    </a>

    <a
      href="/contacts/#request"
      data-modal-open
      data-modal-title="Подобрать новостройку"
      data-modal-source="landing-bottom-podbor"
      class="vn-landing-bottom-cta__item"
    >
      <span class="vn-landing-bottom-cta__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10.5 12 3l9 7.5"/>
          <path d="M5.5 9.5V21h13V9.5"/>
          <path d="M9.5 21v-6h5v6"/>
          <circle cx="17.5" cy="7.5" r="3.25"/>
          <path d="m20 10 2 2"/>
        </svg>
      </span>
      <span class="vn-landing-bottom-cta__label">Подбор</span>
    </a>
  </nav>
</div>

<style>
  .vn-landing-bottom-cta {
    display: none;
    position: fixed;
    bottom: max(16px, calc(env(safe-area-inset-bottom) + 8px));
    left: 16px;
    right: 16px;
    z-index: 50;
    padding: 5px;
    background: color-mix(in srgb, var(--color-bg-surface) 80%, transparent);
    backdrop-filter: blur(28px) saturate(1.7);
    -webkit-backdrop-filter: blur(28px) saturate(1.7);
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 9%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-bg-surface) 55%, transparent),
      0 8px 32px color-mix(in srgb, var(--color-bg-dark) 13%, transparent),
      0 2px 6px color-mix(in srgb, var(--color-accent-primary) 5%, transparent);
    opacity: 0;
    transform: translateY(calc(100% + 32px));
    pointer-events: none;
    transition:
      opacity 240ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .vn-landing-bottom-cta[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .vn-landing-bottom-cta__dock {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 4px;
  }

  .vn-landing-bottom-cta__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 52px;
    padding: 9px 6px 7px;
    border-radius: 12px;
    color: var(--color-text-secondary);
    font-family: var(--font-family-base);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-primary) 7%, transparent);
    transition:
      color 150ms ease,
      background 150ms ease,
      box-shadow 150ms ease;
  }

  .vn-landing-bottom-cta__item:active {
    background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-primary) 18%, transparent);
    color: var(--color-accent-primary);
  }

  @media (hover: hover) {
    .vn-landing-bottom-cta__item:hover {
      background: color-mix(in srgb, var(--color-accent-primary) 5%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-primary) 12%, transparent);
      color: var(--color-text-primary);
    }
  }

  .vn-landing-bottom-cta__item--phone .vn-landing-bottom-cta__phone-orb {
    color: var(--color-accent-cta);
  }

  .vn-landing-bottom-cta__item--phone .vn-landing-bottom-cta__label--phone {
    color: var(--color-accent-cta);
    opacity: 0.7;
  }

  .vn-landing-bottom-cta__icon,
  .vn-landing-bottom-cta__phone-orb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: currentColor;
    flex-shrink: 0;
  }

  .vn-landing-bottom-cta__label {
    display: block;
    max-width: 100%;
    margin-top: 4px;
    overflow: hidden;
    color: currentColor;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .vn-landing-bottom-cta {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-landing-bottom-cta,
    .vn-landing-bottom-cta__item {
      transition: none;
    }
  }
</style>

<script>
  const landingBottomCta = document.getElementById('landing-bottom-cta');

  if (landingBottomCta) {
    const mobileQuery = window.matchMedia('(max-width: 1023px)');
    const threshold = 500;

    const updateLandingBottomCta = () => {
      const shouldShow = mobileQuery.matches && window.scrollY >= threshold;
      landingBottomCta.dataset.visible = shouldShow ? 'true' : 'false';
    };

    updateLandingBottomCta();
    window.addEventListener('scroll', updateLandingBottomCta, { passive: true });
    window.addEventListener('resize', updateLandingBottomCta);
  }
</script>
