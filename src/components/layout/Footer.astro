---
import { NAV_ITEMS } from '../../lib/navigation/navData';
import { CONTACTS, LEGAL } from '../../lib/constants';
import { FOOTER_LEGAL_LINKS } from '../technical/technicalManifest';

const currentPath = Astro.url.pathname;
const hasMobileDock = !currentPath.includes('/contacts/');
---

<footer class={`vn-footer${hasMobileDock ? ' vn-footer--with-mobile-dock' : ''}`} role="contentinfo">

  <!-- ── Logo Bar ── -->
  <div class="vn-footer__bar">
    <a href="/" class="vn-footer__logo-link" aria-label="Военный навигатор — на главную">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="9"
          class="vn-footer__logo-ring"
          stroke-width="0.7"
          stroke-dasharray="2.2 2.2"/>
        <path d="M7 13 L7 7 L13 7" class="vn-footer__logo-mark" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M27 7 L33 7 L33 13" class="vn-footer__logo-mark" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7 27 L7 33 L13 33" class="vn-footer__logo-mark" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M27 33 L33 33 L33 27" class="vn-footer__logo-mark" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="20" cy="20" r="2.8" class="vn-footer__logo-dot"/>
      </svg>
      <div class="vn-footer__brand-text">
        <span class="vn-footer__brand-name">Военный навигатор</span>
        <span class="vn-footer__brand-owner">Михаил Хряпин</span>
      </div>
    </a>

    <div class="vn-footer__bar-contacts">
      <a href={`tel:${CONTACTS.phone}`} class="vn-footer__bar-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 9.82 19.79 19.79 0 0 1 1.61 1.24 2 2 0 0 1 3.6 0h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 7.91a16 16 0 0 0 6.1 6.1l.88-.88a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.72 15.3"/>
        </svg>
        {CONTACTS.phone}
      </a>
      <span class="vn-footer__bar-sep" aria-hidden="true"></span>
      <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="vn-footer__bar-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4 20-7z"/><path d="M22 2 11 13"/>
        </svg>
        Telegram
      </a>
      <span class="vn-footer__bar-sep" aria-hidden="true"></span>
      <a href={CONTACTS.vk} target="_blank" rel="noopener noreferrer" class="vn-footer__bar-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
          <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
        </svg>
        ВКонтакте
      </a>
    </div>
  </div>

  <!-- ── Nav + Docs Links (desktop only) ── -->
  <div class="vn-footer__links-block">
    <nav class="vn-footer__links-row" aria-label="Разделы сайта">
      <a href="/" class="vn-footer__link"
         aria-current={currentPath === '/' ? 'page' : undefined}>Главная</a>
      {NAV_ITEMS.map((item) => (
        <>
          <span class="vn-footer__link-dot" aria-hidden="true">·</span>
          <a
            href={item.href}
            class="vn-footer__link"
            aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          >{item.label}</a>
        </>
      ))}
    </nav>

    <div class="vn-footer__links-row vn-footer__links-row--docs" aria-label="Правовой раздел">
      <span class="vn-footer__docs-title">Правовой раздел</span>
      {FOOTER_LEGAL_LINKS.map((link) => (
        <>
          <span class="vn-footer__link-dot" aria-hidden="true">·</span>
          <a href={link.href} class="vn-footer__link vn-footer__link--muted">{link.label}</a>
        </>
      ))}
    </div>
  </div>

  <!-- ── Docs (mobile only) ── -->
  <div class="vn-footer__docs-mobile" aria-label="Правовой раздел">
    <span class="vn-footer__docs-mobile-title">Правовой раздел</span>
    {FOOTER_LEGAL_LINKS.map((link) => (
      <a href={link.href} class="vn-footer__doc-link">{link.label}</a>
    ))}
  </div>

  <!-- ── Legal Strip ── -->
  <div class="vn-footer__legal">
    <p class="vn-footer__legal-copy">
      © {LEGAL.year} {LEGAL.name} · ИНН&nbsp;{LEGAL.inn}
    </p>
    <a
      href="https://ams24.ru"
      target="_blank"
      rel="noopener noreferrer"
      class="vn-footer__dev-link"
      aria-label="Сайт разработан в АМС-Маркетинг"
    >
      <span class="vn-footer__dev-accent" aria-hidden="true"></span>
      <span class="vn-footer__dev-text">Сайт разработан в АМС-Маркетинг</span>
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
      </svg>
    </a>
  </div>

</footer>

<style>
  .vn-footer {
    background: var(--color-bg-dark);
    color: var(--color-text-ondark);
    font-family: var(--font-family-base);
  }

  /* ── Logo Bar ── */
  .vn-footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 24px;
    padding-inline: max(48px, calc((100% - 1280px) / 2 + 48px));
    border-bottom: 1px solid var(--color-border-ondark);
  }
  .vn-footer__logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
  }
  .vn-footer__logo-ring {
    stroke: var(--color-text-ondark);
    opacity: 0.22;
  }
  .vn-footer__logo-mark {
    stroke: var(--color-text-ondark);
    opacity: 0.75;
  }
  .vn-footer__logo-dot {
    fill: var(--color-accent-cta);
  }
  .vn-footer__brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .vn-footer__brand-name {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-ondark);
  }
  .vn-footer__brand-owner {
    font-size: var(--fs-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-ondark);
    opacity: 0.4;
  }
  .vn-footer__bar-contacts {
    display: flex;
    align-items: center;
  }
  .vn-footer__bar-link {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fs-body-sm);
    color: var(--color-text-ondark);
    opacity: 0.5;
    text-decoration: none;
    padding: 6px 16px;
    transition: opacity 150ms ease;
    white-space: nowrap;
  }
  .vn-footer__bar-link svg {
    color: var(--color-text-ondark);
    opacity: 0.5;
    flex-shrink: 0;
  }
  .vn-footer__bar-link:hover {
    opacity: 0.9;
  }
  .vn-footer__bar-sep {
    display: block;
    width: 1px;
    height: 16px;
    background: var(--color-border-ondark);
    flex-shrink: 0;
  }

  /* ── Nav + Docs Links block ── */
  .vn-footer__links-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 28px;
    padding-inline: max(48px, calc((100% - 1280px) / 2 + 48px));
    border-bottom: 1px solid var(--color-border-ondark);
  }
  .vn-footer__links-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .vn-footer__link {
    font-size: var(--fs-body-sm);
    color: var(--color-text-ondark);
    opacity: 0.55;
    text-decoration: none;
    transition: opacity 150ms ease;
    white-space: nowrap;
  }
  .vn-footer__link:hover {
    opacity: 0.9;
  }
  .vn-footer__link[aria-current="page"] {
    opacity: 0.85;
  }
  .vn-footer__link--muted {
    font-size: var(--fs-label);
    opacity: 0.3;
  }
  .vn-footer__link--muted:hover {
    opacity: 0.65;
  }
  .vn-footer__link-dot {
    font-size: var(--fs-body-sm);
    color: var(--color-text-ondark);
    opacity: 0.18;
    padding: 0 10px;
    flex-shrink: 0;
  }
  .vn-footer__links-row--docs {
    margin-top: 0;
  }
  .vn-footer__docs-title {
    color: var(--color-text-ondark);
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.2;
    opacity: 0.42;
    text-transform: uppercase;
  }

  /* ── Docs mobile (hidden on desktop) ── */
  .vn-footer__docs-mobile {
    display: none;
  }
  .vn-footer__docs-mobile-title {
    display: none;
  }

  /* ── Legal Strip ── */
  .vn-footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 48px;
    padding-inline: max(48px, calc((100% - 1280px) / 2 + 48px));
  }
  .vn-footer__legal-copy {
    font-size: var(--fs-caption);
    color: var(--color-text-ondark);
    opacity: 0.28;
    margin: 0;
  }
  .vn-footer__dev-link {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    padding: 5px 10px 5px 9px;
    border: 1px solid color-mix(in srgb, var(--color-text-ondark) 12%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-text-ondark) 3%, transparent);
    font-size: var(--fs-caption);
    color: var(--color-text-ondark);
    opacity: 0.46;
    text-decoration: none;
    transition:
      opacity 200ms ease,
      border-color 200ms ease,
      background 200ms ease;
  }
  .vn-footer__dev-link:hover {
    opacity: 0.9;
    border-color: color-mix(in srgb, rgb(158 7 7) 42%, transparent);
    background: color-mix(in srgb, rgb(158 7 7) 7%, transparent);
  }
  .vn-footer__dev-accent {
    width: 3px;
    height: 16px;
    border-radius: 2px;
    background: rgb(158 7 7);
    flex-shrink: 0;
  }
  .vn-footer__dev-text {
    white-space: nowrap;
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .vn-footer__bar         { padding-inline: 32px; }
    .vn-footer__links-block { padding-inline: 32px; }
    .vn-footer__legal       { padding-inline: 32px; padding-bottom: 24px; height: auto; padding-top: 14px; }
    .vn-footer--with-mobile-dock .vn-footer__legal { padding-bottom: 84px; }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .vn-footer__bar          { padding: 20px 24px; }
    .vn-footer__bar-contacts { display: none; }
    .vn-footer__links-block  { display: none; }

    .vn-footer__docs-mobile {
      display: flex;
      flex-direction: column;
      gap: 0;
      border-bottom: 1px solid var(--color-border-ondark);
    }
    .vn-footer__docs-mobile-title {
      display: block;
      padding: 18px 24px 6px;
      color: var(--color-text-ondark);
      font-size: var(--fs-caption);
      font-weight: 650;
      letter-spacing: 0.08em;
      opacity: 0.42;
      text-transform: uppercase;
    }
    .vn-footer__doc-link {
      display: flex;
      align-items: center;
      min-height: 48px;
      font-size: var(--fs-body-sm);
      color: var(--color-text-ondark);
      opacity: 0.4;
      text-decoration: none;
      padding: 12px 24px;
      border-bottom: 1px solid var(--color-border-ondark);
      transition: opacity 150ms ease;
    }
    .vn-footer__doc-link:last-child {
      border-bottom: none;
    }
    .vn-footer__doc-link:hover {
      opacity: 0.75;
    }

    .vn-footer__legal {
      flex-direction: column;
      height: auto;
      padding: 18px 24px 28px;
      gap: 12px;
      align-items: center;
      text-align: center;
    }
    .vn-footer--with-mobile-dock .vn-footer__legal {
      padding-bottom: 96px;
    }
    .vn-footer__legal-copy {
      max-width: 28ch;
      line-height: 1.45;
    }
    .vn-footer__dev-link {
      min-height: 40px;
      max-width: 100%;
    }
    .vn-footer__dev-text {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
