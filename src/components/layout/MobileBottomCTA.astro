---
import { CONTACTS } from '../../lib/constants';
import { Icon } from 'astro-icon/components';

// Скрывается на /contacts/ — там уже много CTA
const currentPath = Astro.url.pathname;
const isContactsPage = currentPath.includes('/contacts/');
const phoneHref = `tel:${CONTACTS.phone.replace(/[^\d+]/g, '')}`;
---

{!isContactsPage && (
  <div id="mobile-bottom-cta" class="vn-bottom-cta" role="complementary" aria-label="Быстрые действия" data-visible="true">
    <nav class="vn-bottom-cta__dock" aria-label="Быстрые действия">
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Консультация по военной ипотеке"
        data-modal-source="mobile-bottom-ipoteka"
        class="vn-bottom-cta__item"
      >
        <span class="vn-bottom-cta__icon" aria-hidden="true">
          <Icon name="file-sheet" width="22" height="22" />
        </span>
        <span class="vn-bottom-cta__label">Ипотека</span>
      </a>

      <a
        href={phoneHref}
        class="vn-bottom-cta__item vn-bottom-cta__item--phone"
        aria-label={`Позвонить ${CONTACTS.phone}`}
      >
        <span class="vn-bottom-cta__phone-orb" aria-hidden="true">
          <Icon name="phone" width="22" height="22" />
        </span>
        <span class="vn-bottom-cta__label vn-bottom-cta__label--phone">Позвонить</span>
      </a>

      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Подобрать новостройку"
        data-modal-source="mobile-bottom-podbor"
        class="vn-bottom-cta__item"
      >
        <span class="vn-bottom-cta__icon" aria-hidden="true">
          <Icon name="house-search" width="22" height="22" />
        </span>
        <span class="vn-bottom-cta__label">Подбор</span>
      </a>
    </nav>
  </div>
)}

<style>
  /* ── Outer glass pill ── */
  .vn-bottom-cta {
    display:          none;
    position:         fixed;
    bottom:           max(16px, calc(env(safe-area-inset-bottom) + 8px));
    left:             16px;
    right:            16px;
    z-index:          50;
    padding:          5px;

    background:       color-mix(in srgb, var(--color-bg-surface) 80%, transparent);
    backdrop-filter:  blur(28px) saturate(1.7);
    -webkit-backdrop-filter: blur(28px) saturate(1.7);

    border-radius:    20px;
    border:           1px solid color-mix(in srgb, var(--color-accent-primary) 9%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-bg-surface) 55%, transparent),
      0 8px 32px color-mix(in srgb, var(--color-bg-dark) 13%, transparent),
      0 2px 6px  color-mix(in srgb, var(--color-accent-primary) 5%, transparent);

    opacity:          0;
    transform:        translateY(calc(100% + 32px));
    pointer-events:   none;
    transition:
      opacity   240ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .vn-bottom-cta[data-visible="true"] {
    opacity:        1;
    transform:      translateY(0);
    pointer-events: auto;
  }

  /* ── Item grid — без подложки ── */
  .vn-bottom-cta__dock {
    display:               grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items:           center;
    gap:                   4px;
  }

  /* ── Items — ghost capsule + press fill ── */
  .vn-bottom-cta__item {
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    min-width:       0;
    min-height:      52px;
    padding:         9px 6px 7px;
    border-radius:   12px;
    color:           var(--color-text-secondary);
    font-family:     var(--font-family-base);
    text-decoration: none;
    /* ghost outline */
    box-shadow:      inset 0 0 0 1px color-mix(in srgb, var(--color-accent-primary) 7%, transparent);
    transition:
      color      150ms ease,
      background 150ms ease,
      box-shadow 150ms ease;
  }

  /* press: stronger outline + fill */
  .vn-bottom-cta__item:active {
    background: color-mix(in srgb, var(--color-accent-primary) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-primary) 18%, transparent);
    color:      var(--color-accent-primary);
  }

  @media (hover: hover) {
    .vn-bottom-cta__item:hover {
      background: color-mix(in srgb, var(--color-accent-primary) 5%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-primary) 12%, transparent);
      color:      var(--color-text-primary);
    }
  }

  /* ── Center phone — только синяя иконка ── */
  .vn-bottom-cta__item--phone .vn-bottom-cta__phone-orb {
    color: var(--color-accent-cta);
  }

  .vn-bottom-cta__item--phone .vn-bottom-cta__label--phone {
    color:   var(--color-accent-cta);
    opacity: 0.7;
  }

  /* ── Icons ── */
  .vn-bottom-cta__icon,
  .vn-bottom-cta__phone-orb {
    display:         inline-flex;
    align-items:     center;
    justify-content: center;
    width:           20px;
    height:          20px;
    color:           currentColor;
    flex-shrink:     0;
  }

  /* ── Labels ── */
  .vn-bottom-cta__label {
    display:        block;
    max-width:      100%;
    margin-top:     4px;
    overflow:       hidden;
    color:          currentColor;
    font-size:      var(--fs-caption);
    font-weight:    400;
    letter-spacing: 0.01em;
    line-height:    1;
    text-align:     center;
    text-overflow:  ellipsis;
    white-space:    nowrap;
  }

  @media (max-width: 1023px) {
    .vn-bottom-cta { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-bottom-cta,
    .vn-bottom-cta__item { transition: none; }
  }
</style>

<script>
  const mobileDock = document.getElementById('mobile-bottom-cta');

  if (mobileDock) {
    let lastScrollY = window.scrollY;
    let idleTimer = 0;
    const minDelta = 6;
    const idleDelay = 520;
    const threshold = 1000;
    const mobileQuery = window.matchMedia('(max-width: 1023px)');

    const showDock = () => {
      mobileDock.dataset.visible = window.scrollY >= threshold ? 'true' : 'false';
    };

    const hideDock = () => {
      mobileDock.dataset.visible = 'false';
    };

    const handleScroll = () => {
      if (!mobileQuery.matches) {
        showDock();
        return;
      }

      const currentScrollY = Math.max(window.scrollY, 0);
      const delta = currentScrollY - lastScrollY;

      window.clearTimeout(idleTimer);

      if (currentScrollY < threshold) {
        hideDock();
        lastScrollY = currentScrollY;
        return;
      }

      if (Math.abs(delta) > minDelta) {
        if (delta > 0) {
          hideDock();
        } else {
          showDock();
        }
        lastScrollY = currentScrollY;
      }

      idleTimer = window.setTimeout(showDock, idleDelay);
    };

    showDock();
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll);
  }
</script>
