---
/**
 * OptimizedImage — unified image wrapper.
 * Uses Astro <Image> for imported assets, fallback <img> for external URLs
 * and public/ paths. Supports LQIP (Low Quality Image Placeholder) blur
 * background, responsive srcset widths, and automatic WebP conversion.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  placeholder?: string; // base64 blur or tiny image URL
  widths?: number[];
  sizes?: string;
  style?: string;
}

const {
  src,
  alt,
  width = 800,
  height = 600,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  placeholder,
  widths = [640, 750, 828, 1080, 1200, 1920],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 800px',
  style: extraStyle = '',
} = Astro.props;

const isExternal = typeof src === 'string' && (src.startsWith('http://') || src.startsWith('https://'));
// const isPublicPath = typeof src === 'string' && src.startsWith('/');

// LQIP style: if placeholder provided, set as background-image with blur
const lqipStyle = placeholder
  ? `background-image:url(${placeholder});background-size:cover;background-position:center;filter:blur(12px);transition:filter 0.3s ease;${extraStyle}`
  : extraStyle;

const onloadHandler = placeholder
  ? `this.style.removeProperty('background-image');this.style.removeProperty('background-size');this.style.removeProperty('background-position');this.style.removeProperty('filter');this.style.removeProperty('transition');`
  : undefined;
---

{typeof src !== 'string' ? (
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    widths={widths}
    sizes={sizes}
    style={lqipStyle || undefined}
    onload={onloadHandler}
  />
) : isExternal ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    style={lqipStyle || undefined}
    onload={onloadHandler}
    onerror="this.style.display='none'"
  />
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    style={lqipStyle || undefined}
    onload={onloadHandler}
    onerror="this.style.display='none'"
  />
)}
