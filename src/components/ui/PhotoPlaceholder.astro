---
interface Props {
  type?: 'building' | 'office' | 'portrait' | 'generic';
  height?: string;
  width?: string;
  filename?: string;
  alt?: string;
}

const {
  type = 'generic',
  height = '280px',
  width = '100%',
  filename = 'photo.jpg',
  alt = 'Фото будет добавлено позже',
} = Astro.props;

const icons = {
  building: `<path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4M9 9h1M9 13h1M9 17h1M13 13h1M13 17h1"/>`,
  office:   `<path d="M4 21V3h16v18M8 21V13h8v8M9 7h1M14 7h1M9 11h1M14 11h1"/>`,
  portrait: `<circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 10-16 0"/>`,
  generic:  `<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>`,
};
---
<div
  class="vn-photo-placeholder"
  style={`height: ${height}; width: ${width};`}
  aria-label={alt}
  role="img"
  data-placeholder-filename={filename}
>
  <svg
    width="48"
    height="48"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <Fragment set:html={icons[type]} />
  </svg>
  <span class="vn-photo-placeholder__label">{filename}</span>
</div>

<style>
  .vn-photo-placeholder {
    background-color: var(--color-bg-secondary);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--color-text-tertiary);
    overflow: hidden;
  }

  .vn-photo-placeholder__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.03em;
    opacity: 0.7;
  }
</style>
