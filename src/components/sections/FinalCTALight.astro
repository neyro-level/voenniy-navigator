---
import { CONTACTS } from "../../lib/constants";
import { getConfiguredValue } from "../../lib/utils";
import { Icon } from 'astro-icon/components';

interface Guarantee {
  icon: string;
  text: string;
}

interface Props {
  sectionId?: string;
  eyebrow?: string;
  title?: string;
  accentText?: string;
  subtitle?: string;
  ctaText?: string;
  ctaModalTitle?: string;
  guarantees?: Guarantee[];
}

const {
  sectionId = "section-cta-final",
  eyebrow = "ПЕРСОНАЛЬНЫЙ РАЗБОР",
  title = "Получите разбор вашей ситуации",
  accentText = "и реальный план покупки",
  subtitle = "За 20 минут выясним вашу задачу, проверим лимиты банка и подберём объекты, которые реально одобрят. Без обязательств и скрытых платежей.",
  ctaText = "Получить подборку",
  ctaModalTitle = ctaText,
  guarantees = [
    { icon: 'shield-check', text: 'Без комиссий для покупателя' },
    { icon: 'globe', text: 'Можно полностью дистанционно' },
    { icon: 'clock', text: 'Занимает всего 20 минут' }
  ]
} = Astro.props;

const telegramHref = getConfiguredValue(CONTACTS.telegram);
const maxHref = getConfiguredValue(CONTACTS.max);
const maxIsPhone = maxHref?.startsWith('tel:');
const titleId = `${sectionId}-title`;
---

<section id={sectionId} class="vn-final-cta-light" aria-labelledby={titleId}>
  <div class="vn-container">
    <div class="vn-final-cta-light__layout">
      
      <!-- Левая часть: Оффер и действие -->
      <div class="vn-final-cta-light__content">
        <span class="vn-label-mono vn-final-cta-light__eyebrow">{eyebrow}</span>
        <h2 class="vn-final-cta-light__title" id={titleId}>
          {title}
          {accentText && <><br><span class="vn-final-cta-light__accent">{accentText}</span></>}
        </h2>
        <p class="vn-final-cta-light__subtitle">{subtitle}</p>
        
        <div class="vn-final-cta-light__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title={ctaModalTitle}
            class="vn-btn-primary vn-final-cta-light__cta"
          >
            {ctaText}
          </a>
          
          {(telegramHref || maxHref) && (
            <p class="vn-final-cta-light__alt">
              <span>Или напишите напрямую:</span>
              <span class="vn-final-cta-light__alt-links">
                {telegramHref && (
                  <a href={telegramHref} target="_blank" rel="noopener noreferrer" class="vn-final-cta-light__alt-link">Telegram</a>
                )}
                {telegramHref && maxHref && <span class="vn-final-cta-light__alt-sep">/</span>}
                {maxHref && (
                  <a
                    href={maxHref}
                    target={maxIsPhone ? undefined : '_blank'}
                    rel={maxIsPhone ? undefined : 'noopener noreferrer'}
                    class="vn-final-cta-light__alt-link"
                  >
                    Max
                  </a>
                )}
              </span>
            </p>
          )}
        </div>
      </div>

      <!-- Правая часть: Гарантии -->
      <div class="vn-final-cta-light__guarantees-wrap">
        <div class="vn-final-cta-light__guarantees">
        {guarantees.map((item, index) => (
          <div class="vn-final-cta-light__guarantee-item">
            <span class="vn-final-cta-light__guarantee-index">{String(index + 1).padStart(2, '0')}</span>
            <div class="vn-final-cta-light__guarantee-icon">
              <Icon name={item.icon} width="20" height="20" aria-hidden="true" />
            </div>
            <span class="vn-final-cta-light__guarantee-text">{item.text}</span>
          </div>
        ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .vn-final-cta-light {
    position: relative;
    padding-block: 96px;
    background: var(--color-bg-surface);
    overflow: hidden;
  }

  .vn-final-cta-light::after {
    content: '';
    position: absolute;
    right: -220px;
    bottom: -260px;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 8%, transparent) 0%,
      transparent 72%
    );
    pointer-events: none;
  }

  .vn-final-cta-light__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 64px;
    align-items: center;
  }

  .vn-final-cta-light__eyebrow {
    color: var(--color-accent-cta);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .vn-final-cta-light__title {
    margin: 16px 0 20px;
    max-width: 720px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-final-cta-light__accent {
    color: var(--color-accent-cta);
  }

  .vn-final-cta-light__subtitle {
    margin: 0 0 36px;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 520px;
    text-wrap: pretty;
  }

  .vn-final-cta-light__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .vn-final-cta-light__cta {
    font-size: var(--fs-body);
    padding: 18px 36px;
    min-width: 280px;
    text-align: center;
  }

  .vn-final-cta-light__alt {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.4;
    color: var(--color-text-tertiary);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .vn-final-cta-light__alt-links {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .vn-final-cta-light__alt-sep {
    color: var(--color-text-tertiary);
    opacity: 0.5;
  }

  .vn-final-cta-light__alt-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .vn-final-cta-light__alt-link:hover {
    color: var(--color-accent-cta);
  }

  /* Гарантии */
  .vn-final-cta-light__guarantees-wrap {
    position: relative;
    isolation: isolate;
  }

  .vn-final-cta-light__guarantees-wrap::before {
    content: '';
    position: absolute;
    inset: 26px -18px -26px 18px;
    border-radius: calc(var(--radius-xl) + 8px);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-surface)) 0%,
      color-mix(in srgb, var(--color-bg-primary) 94%, white) 62%,
      color-mix(in srgb, var(--color-accent-primary) 6%, var(--color-bg-surface)) 100%
    );
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, var(--color-border));
    z-index: 0;
  }

  .vn-final-cta-light__guarantees-wrap::after {
    content: '';
    position: absolute;
    top: -18px;
    right: -14px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 14%, transparent) 0%,
      transparent 70%
    );
    z-index: 0;
    pointer-events: none;
  }

  .vn-final-cta-light__guarantees {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 14px;
    padding: 18px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-primary) 94%, white) 0%,
      color-mix(in srgb, var(--color-bg-surface) 96%, white) 100%
    );
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, var(--color-border));
    border-radius: calc(var(--radius-xl) + 4px);
    box-shadow:
      0 26px 60px color-mix(in srgb, var(--color-bg-dark) 8%, transparent),
      0 10px 24px color-mix(in srgb, var(--color-bg-dark) 5%, transparent);
  }

  .vn-final-cta-light__guarantee-item {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 18px 18px;
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 10%, var(--color-border));
    border-radius: var(--radius-lg);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-primary) 92%, white) 0%,
      color-mix(in srgb, var(--color-bg-surface) 88%, white) 100%
    );
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 48%, transparent);
  }

  .vn-final-cta-light__guarantee-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 46px;
    height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 14%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-cta) 7%, var(--color-bg-primary));
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent-cta);
    font-variant-numeric: tabular-nums;
  }

  .vn-final-cta-light__guarantee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, white 56%, transparent), transparent 45%),
      color-mix(in srgb, var(--color-accent-cta) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, transparent);
    color: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-final-cta-light__guarantee-text {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  /* Мобильная адаптация */
  @media (max-width: 1023px) {
    .vn-final-cta-light {
      padding-block: 72px;
    }

    .vn-final-cta-light__layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .vn-final-cta-light__guarantees-wrap {
      max-width: 760px;
    }

    .vn-final-cta-light__guarantees-wrap::before {
      inset: 18px -10px -18px 12px;
    }

    .vn-final-cta-light__guarantees-wrap::after {
      width: 140px;
      height: 140px;
      right: -6px;
      top: -12px;
    }

    .vn-final-cta-light__guarantees {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      padding: 24px;
    }

    .vn-final-cta-light__guarantee-item {
      min-height: 100%;
      padding: 16px;
    }

    .vn-final-cta-light__guarantee-item:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .vn-final-cta-light {
      padding-block: 56px;
    }

    .vn-final-cta-light__title {
      line-height: 1.18;
    }

    .vn-final-cta-light__subtitle {
      font-size: var(--fs-body);
      margin-bottom: 28px;
      line-height: 1.55;
    }

    .vn-final-cta-light__cta {
      width: 100%;
      min-width: auto;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vn-final-cta-light__guarantees {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 14px;
    }

    .vn-final-cta-light__guarantee-item {
      padding: 16px;
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: 12px;
    }

    .vn-final-cta-light__guarantees-wrap::before {
      inset: 14px -6px -10px 10px;
      border-radius: calc(var(--radius-lg) + 8px);
    }

    .vn-final-cta-light__guarantees-wrap::after {
      width: 100px;
      height: 100px;
      right: -2px;
      top: -8px;
    }

    .vn-final-cta-light__guarantee-index {
      min-width: 40px;
      height: 30px;
      padding: 0 10px;
      font-size: 0.75rem;
    }

    .vn-final-cta-light__guarantee-icon {
      width: 42px;
      height: 42px;
    }

    .vn-final-cta-light__guarantee-text {
      font-size: var(--fs-body-sm);
      line-height: 1.45;
    }
  }
</style>
