---
import type { CommercialPageKey, JournalPostEntry } from '../../lib/journal';
import {
  getCommercialPage,
  getJournalCategory,
  getJournalPostUrl,
  getRelatedCommercialPages,
  getSupportingPostsForCommercialPage,
} from '../../lib/journal';

interface Props {
  pageKey: CommercialPageKey;
  posts: JournalPostEntry[];
}

const { pageKey, posts } = Astro.props;
const page = getCommercialPage(pageKey);
const supportingPosts = getSupportingPostsForCommercialPage(pageKey, posts, 4);
const relatedPages = getRelatedCommercialPages(pageKey);
---

{supportingPosts.length > 0 && (
  <section class="vn-supporting-materials" aria-labelledby={`vn-supporting-materials-${page.key}`}>
    <div class="vn-container vn-supporting-materials__inner">
      <div class="vn-supporting-materials__head">
        <p class="vn-supporting-materials__eyebrow">Полезные материалы</p>
        <h2 class="vn-supporting-materials__title" id={`vn-supporting-materials-${page.key}`}>
          Разборы, которые усиливают страницу «{page.title}»
        </h2>
        <p class="vn-supporting-materials__lead">
          Эти материалы закрывают вопросы вокруг основной страницы: расчёт, выбор направления,
          локальные нюансы и частые возражения до заявки.
        </p>
      </div>

      <div class="vn-supporting-materials__grid">
        {supportingPosts.map((post) => {
          const category = getJournalCategory(post.data.categorySlug);
          return (
            <article class="vn-supporting-materials__card">
              <p class="vn-supporting-materials__meta">{category.label}</p>
              <h3 class="vn-supporting-materials__card-title">
                <a href={getJournalPostUrl(post)}>{post.data.title}</a>
              </h3>
              <p class="vn-supporting-materials__excerpt">{post.data.excerpt}</p>
              <a class="vn-supporting-materials__link" href={getJournalPostUrl(post)}>
                Читать разбор <span aria-hidden="true">→</span>
              </a>
            </article>
          );
        })}
      </div>

      {relatedPages.length > 0 && (
        <div class="vn-supporting-materials__routes">
          <p class="vn-supporting-materials__routes-title">Соседние направления по теме</p>
          <div class="vn-supporting-materials__routes-list">
            {relatedPages.map((relatedPage) => (
              <a class="vn-supporting-materials__route" href={relatedPage.url}>
                <span>{relatedPage.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .vn-supporting-materials {
    padding: 96px 0 72px;
    background: var(--color-bg-secondary);
  }

  .vn-supporting-materials__inner {
    display: grid;
    gap: 24px;
  }

  .vn-supporting-materials__head {
    max-width: 760px;
  }

  .vn-supporting-materials__eyebrow {
    margin: 0 0 10px;
    color: var(--color-accent-cta);
    font-size: var(--fs-body-sm);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: var(--lh-ui);
    text-transform: uppercase;
  }

  .vn-supporting-materials__title {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--fs-h2);
    line-height: var(--lh-title);
    text-wrap: balance;
  }

  .vn-supporting-materials__lead {
    max-width: 680px;
    margin: 12px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .vn-supporting-materials__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .vn-supporting-materials__card {
    display: grid;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-card);
  }

  .vn-supporting-materials__meta {
    margin: 0;
    color: var(--color-accent-cta);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: var(--lh-ui);
    text-transform: uppercase;
  }

  .vn-supporting-materials__card-title {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--fs-h3);
    line-height: var(--lh-title);
  }

  .vn-supporting-materials__card-title a {
    color: inherit;
    text-decoration: none;
  }

  .vn-supporting-materials__card-title a:hover,
  .vn-supporting-materials__link:hover {
    color: var(--color-accent-cta);
  }

  .vn-supporting-materials__excerpt {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
  }

  .vn-supporting-materials__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    color: var(--color-text-primary);
    font-size: var(--fs-body-sm);
    font-weight: 800;
    line-height: var(--lh-ui);
    text-decoration: none;
  }

  .vn-supporting-materials__routes {
    display: grid;
    gap: 12px;
  }

  .vn-supporting-materials__routes-title {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--fs-body-sm);
    font-weight: 800;
    line-height: var(--lh-ui);
  }

  .vn-supporting-materials__routes-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .vn-supporting-materials__route {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    font-size: var(--fs-body-sm);
    font-weight: 700;
    line-height: var(--lh-ui);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .vn-supporting-materials__route:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 34%, var(--color-border));
    color: var(--color-accent-cta);
  }

  @media (max-width: 760px) {
    .vn-supporting-materials {
      padding-bottom: 56px;
    }

    .vn-supporting-materials__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
