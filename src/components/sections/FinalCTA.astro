---
import { CONTACTS } from "../../lib/constants";
import { getConfiguredValue } from "../../lib/utils";
import { Icon } from 'astro-icon/components';

interface UsefulLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  accentText?: string;
  subtitle: string;
  ctaText: string;
  ctaModalTitle?: string;
  showStats?: boolean;
  showUsefulLinks?: boolean;
  usefulLinks?: UsefulLink[];
}

const {
  eyebrow = "ГОТОВЫ К ПЕРВОМУ ШАГУ?",
  title,
  accentText,
  subtitle,
  ctaText,
  ctaModalTitle = ctaText,
  showStats = true,
  showUsefulLinks = false,
  usefulLinks = [],
} = Astro.props;
const telegramHref = getConfiguredValue(CONTACTS.telegram);
const maxHref = getConfiguredValue(CONTACTS.max);
---

<section
  id="section-cta-final"
  class="vn-section vn-section--dark vn-final-cta"
  aria-labelledby="vn-final-cta-title"
>
  <div class="vn-deco-grid vn-deco-grid--dark" aria-hidden="true"></div>
  <div class="vn-final-cta__radial" aria-hidden="true"></div>

  <div class="vn-container vn-rel">
    <div class="vn-grid-12">
      <!-- ── Left: headline + CTA ── -->
      <div class="vn-final-cta__left" style="grid-column: 1 / 8">
        <span class="vn-label-mono vn-final-cta__eyebrow">{eyebrow}</span>
        <h2 class="vn-final-cta__title" id="vn-final-cta-title">
          {title}
          {accentText && <span class="vn-final-cta__accent">{accentText}</span>}
        </h2>
        <p class="vn-final-cta__subtitle">{subtitle}</p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title={ctaModalTitle}
          class="vn-btn-primary vn-final-cta__cta"
        >
          {ctaText}
        </a>
        <p class="vn-final-cta__alt">
          <span>Или напишите напрямую:</span>
          <span class="vn-final-cta__alt-links">
            {telegramHref && (
              <a
                href={telegramHref}
                target="_blank"
                rel="noopener noreferrer"
                class="vn-final-cta__alt-link">Telegram</a
              >
            )}
            {telegramHref && maxHref && <span class="vn-final-cta__alt-sep">/</span>}
            {maxHref && (
              <a
                href={maxHref}
                target="_blank"
                rel="noopener noreferrer"
                class="vn-final-cta__alt-link">Max</a
              >
            )}
          </span>
        </p>
      </div>

      <!-- ── Right: stats + useful pages ── -->
      <div class="vn-final-cta__right" style="grid-column: 8 / 13">
        {
          showStats && (
            <div class="vn-final-cta__stats" role="list">
              <div class="vn-final-cta__stat" role="listitem">
                <Icon name="clock-3" width="18" height="18" aria-hidden="true" />
                <span>Без обязательств</span>
              </div>
              <div class="vn-final-cta__stat" role="listitem">
                <Icon name="calendar-days" width="18" height="18" aria-hidden="true" />
                <span>Можно дистанционно</span>
              </div>
              <div class="vn-final-cta__stat" role="listitem">
                <Icon name="check" width="18" height="18" aria-hidden="true" />
                <span>Первый шаг</span>
              </div>
            </div>
          )
        }

        {
          showUsefulLinks && usefulLinks.length > 0 && (
            <div class="vn-final-cta__pages">
              <span class="vn-label-mono vn-final-cta__pages-label">
                ПОЛЕЗНЫЕ СТРАНИЦЫ
              </span>
              <div class="vn-final-cta__pages-list">
                {usefulLinks.map((link) => (
                  <a href={link.href} class="vn-final-cta__page-link">
                    <span>{link.label}</span>
                    <Icon name="chevron-right" width="14" height="14" aria-hidden="true" />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── FinalCTA — универсальный финальный блок ─── */
  .vn-final-cta {
    position: relative;
    overflow: hidden;
    padding-top: 120px;
    padding-bottom: 96px;
  }

  .vn-final-cta__radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 900px 400px at 30% 0%,
      color-mix(in srgb, var(--color-accent-cta) 8%, transparent),
      transparent
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ── Left column ── */
  .vn-final-cta__left {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vn-final-cta__eyebrow {
    color: var(--color-accent-cta);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .vn-final-cta__title {
    margin: 16px 0 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-ondark);
    text-wrap: balance;
  }

  .vn-final-cta__accent {
    color: var(--color-accent-cta);
  }

  .vn-final-cta__subtitle {
    margin: 20px 0 36px;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-ondark-secondary);
    max-width: 480px;
    text-wrap: pretty;
  }

  .vn-final-cta__cta {
    font-size: var(--fs-body);
    padding: 16px 32px;
  }

  .vn-final-cta__alt {
    margin: 20px 0 0;
    font-size: var(--fs-body-sm);
    color: var(--color-text-ondark-secondary);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .vn-final-cta__alt-links {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap; /* Гарантирует, что ссылки всегда остаются в одну строку */
  }

  .vn-final-cta__alt-sep {
    color: var(--color-text-ondark-secondary);
    opacity: 0.5;
  }

  .vn-final-cta__alt-link {
    color: var(--color-text-ondark);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    white-space: nowrap; /* Запрещает разрыв слова внутри ссылки */
    transition: color 150ms ease;
  }
  .vn-final-cta__alt-link:hover {
    color: var(--color-accent-cta);
  }

  /* ── Right column ── */
  .vn-final-cta__right {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 48px;
    border-left: 1px solid var(--color-border-ondark);
  }

  /* Stats */
  .vn-final-cta__stats {
    display: flex;
    flex-direction: column;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border-ondark);
    margin-bottom: 32px;
  }

  .vn-final-cta__stat {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-ondark);
    border-bottom: 1px solid var(--color-border-ondark);
  }
  .vn-final-cta__stat:last-child {
    border-bottom: none;
  }
  .vn-final-cta__stat svg {
    color: var(--color-accent-cta);
    flex-shrink: 0;
  }

  /* Useful pages */
  .vn-final-cta__pages-label {
    color: var(--color-text-ondark-secondary);
    font-weight: 600;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 16px;
  }

  .vn-final-cta__pages-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vn-final-cta__page-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    background: var(--color-bg-dark-elev);
    border: 1px solid var(--color-border-ondark);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-ondark);
    transition:
      border-color 150ms ease,
      background 150ms ease,
      transform 150ms ease;
  }
  .vn-final-cta__page-link svg {
    color: var(--color-text-ondark);
    opacity: 0.4;
    flex-shrink: 0;
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }
  .vn-final-cta__page-link:hover {
    border-color: var(--color-accent-cta);
    background: color-mix(
      in srgb,
      var(--color-accent-cta) 5%,
      var(--color-bg-dark-elev)
    );
    transform: translateX(4px);
  }
  .vn-final-cta__page-link:hover svg {
    opacity: 1;
    transform: translateX(4px);
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .vn-final-cta__left {
      grid-column: 1 / -1 !important;
    }
    .vn-final-cta__right {
      grid-column: 1 / -1 !important;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--color-border-ondark);
      padding-top: 40px;
      margin-top: 8px;
    }
    .vn-final-cta__stats {
      flex-direction: row;
      gap: 24px;
      flex-wrap: wrap;
    }
    .vn-final-cta__stat {
      border-bottom: none;
      padding: 0;
    }
  }

  /* ── Mobile Compact ── */
  @media (max-width: 640px) {
    .vn-final-cta {
      padding-top: 72px;
      padding-bottom: 64px;
    }

    .vn-final-cta__title {
      font-size: 28px;
    }

    .vn-final-cta__subtitle {
      font-size: var(--fs-body);
      margin-bottom: 28px;
    }

    .vn-final-cta__cta {
      width: 100%;
      text-align: center;
      padding: 16px 24px;
    }

    .vn-final-cta__stats {
      flex-direction: column;
      gap: 0;
      padding-bottom: 24px;
      margin-bottom: 24px;
    }
    .vn-final-cta__stat {
      padding: 10px 0;
      border-bottom: 1px solid var(--color-border-ondark);
      font-size: 13px;
    }
    .vn-final-cta__stat:last-child {
      border-bottom: none;
    }

    .vn-final-cta__pages-label {
      margin-bottom: 12px;
      font-size: 12px;
    }

    .vn-final-cta__page-link {
      padding: 12px 14px;
      font-size: 13px;
    }
  }
</style>
