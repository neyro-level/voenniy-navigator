---
import CookieBanner from '../ui/CookieBanner';
import LeadGenFooter from './LeadGenFooter.astro';
import LeadGenBottomCTA from './LeadGenBottomCTA.astro';
import LeadGenRequestModal from './LeadGenRequestModal';

interface Props {
  requestTitle?: string;
  requestSubtitle?: string;
  requestSource?: string;
  thankYouUrl?: string;
}

const {
  requestTitle = 'Напишите ваше имя и телефон',
  requestSubtitle = 'Уточню ваш запрос и задачу, а затем подготовлю подборку квартир.',
  requestSource = Astro.url.pathname,
  thankYouUrl = '/podbor/thanks/',
} = Astro.props;
---

<LeadGenFooter />
<LeadGenBottomCTA />
<LeadGenRequestModal
  client:load
  title={requestTitle}
  subtitle={requestSubtitle}
  source={requestSource}
  thankYouUrl={thankYouUrl}
/>
<CookieBanner client:load />

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const trigger = target.closest('[data-modal-open]');
    if (!(trigger instanceof HTMLElement)) return;

    event.preventDefault();

    window.dispatchEvent(
      new CustomEvent('open-leadgen-modal', {
        detail: {
          title: trigger.dataset.modalTitle,
          subtitle: trigger.dataset.modalSubtitle,
          source: trigger.dataset.modalSource || window.location.pathname,
          thankYouUrl: trigger.dataset.modalThankYouUrl,
        },
      }),
    );
  });
</script>
