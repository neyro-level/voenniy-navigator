---
import { CONTACTS } from '../../../lib/constants';

const phoneHref = `tel:${CONTACTS.phone.replace(/\D/g, '')}`;
---

<header class="vn-podbor-header">
  <div class="vn-container">
    <div class="vn-podbor-header__inner">
      <a href="/" class="vn-podbor-header__logo" aria-label="Военный навигатор — на главную">
        <svg width="36" height="36" viewBox="0 0 40 40" fill="none" class="vn-podbor-header__mark" aria-hidden="true">
          <circle
            cx="20"
            cy="20"
            r="9"
            stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))"
            stroke-width="0.7"
            stroke-dasharray="2.2 2.2"
          />
          <path d="M7 13 L7 7 L13 7" stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M27 7 L33 7 L33 13" stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M7 27 L7 33 L13 33" stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M27 33 L33 33 L33 27" stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="20" cy="20" r="2.8" fill="var(--color-accent-cta)" />
        </svg>

        <span class="vn-podbor-header__logo-text">
          <span class="vn-podbor-header__brand">Военный навигатор</span>
          <span class="vn-podbor-header__descriptor">Подбор квартир по военной ипотеке</span>
        </span>
      </a>

      <div class="vn-podbor-header__actions">
        {false && (
        <a class="vn-podbor-header__phone" href={phoneHref}>
          <span class="vn-podbor-header__phone-number">{CONTACTS.phone}</span>
          <span class="vn-podbor-header__phone-note">Краснодар · офис по записи</span>
        </a>

        )}

        <a
          href="/contacts/#request"
          class="vn-podbor-header__cta"
          data-modal-open
          data-modal-title="Напишите ваше имя и телефон"
          data-modal-subtitle="Уточню ваш запрос и задачу, а затем подготовлю подборку квартир."
          data-modal-source="/podbor/header"
        >
          Заказать звонок
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .vn-podbor-header {
    background: color-mix(in srgb, var(--color-bg-dark) 94%, transparent);
    border-bottom: 1px solid var(--color-border-ondark);
    padding: 0;
  }

  .vn-podbor-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }

  .vn-podbor-header__logo {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 12px;
    color: var(--color-text-ondark);
    text-decoration: none;
  }

  .vn-podbor-header__mark {
    flex: 0 0 36px;
  }

  .vn-podbor-header__logo-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 3px;
  }

  .vn-podbor-header__brand {
    color: var(--color-text-ondark);
    font-size: var(--fs-body-sm);
    font-weight: 650;
    line-height: 1.05;
    white-space: nowrap;
  }

  .vn-podbor-header__descriptor {
    color: var(--color-text-ondark-mute);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
  }

  .vn-podbor-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }

  .vn-podbor-header__phone {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    color: var(--color-text-ondark);
    text-decoration: none;
  }

  .vn-podbor-header__phone-number {
    font-size: var(--fs-body-sm);
    font-weight: 650;
    line-height: 1.1;
    white-space: nowrap;
  }

  .vn-podbor-header__phone-note {
    color: var(--color-text-ondark-mute);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
  }

  .vn-podbor-header__cta {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid color-mix(in srgb, var(--color-text-ondark) 18%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-text-ondark) 6%, transparent);
    color: var(--color-text-ondark);
    font-size: var(--fs-body-sm);
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
  }

  .vn-podbor-header__cta:hover {
    border-color: var(--color-accent-cta);
    background: color-mix(in srgb, var(--color-accent-cta) 18%, transparent);
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    .vn-podbor-header__inner {
      min-height: 64px;
      gap: 16px;
    }

    .vn-podbor-header__descriptor,
    .vn-podbor-header__phone {
      display: none;
    }

    .vn-podbor-header__cta {
      min-height: 38px;
      padding-inline: 14px;
      font-size: var(--fs-label);
    }
  }

  @media (max-width: 420px) {
    .vn-podbor-header__brand {
      font-size: var(--fs-body-sm);
    }

    .vn-podbor-header__mark {
      width: 32px;
      height: 32px;
      flex-basis: 32px;
    }

    .vn-podbor-header__cta {
      padding-inline: 12px;
    }
  }
</style>
