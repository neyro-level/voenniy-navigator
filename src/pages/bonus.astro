---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAGNETS } from '../lib/bonus-content';
import { CONTACTS } from '../lib/constants';

const url = Astro.url;
const v = url.searchParams.get('v') ?? 'both';
const primaryKey = v === 'novostroyki' ? 'novostroyki' : 'ipoteka';
const magnet = MAGNETS[primaryKey];

const secondaryKey = primaryKey === 'ipoteka' ? 'novostroyki' : 'ipoteka';
const secondMagnet = MAGNETS[secondaryKey];

const videoReady = magnet.vk_embed_url !== '[VK_VIDEO_IPOTEKA_URL]'
  && magnet.vk_embed_url !== '[VK_VIDEO_NOVOSTROYKI_URL]'
  && magnet.vk_embed_url.length > 10;

const TELEGRAM_CHANNEL: string = '[TELEGRAM_CHANNEL]';
const showTelegram = TELEGRAM_CHANNEL !== '[TELEGRAM_CHANNEL]' && TELEGRAM_CHANNEL.length > 10;
---

<BaseLayout
  title="Ваш материал готов — Военный навигатор"
  description="Закрытый материал по военной ипотеке от Михаила Хряпина."
  noindex={true}
>
  <div class="vn-bonus-page">
    <!-- Mini Header -->
    <header class="vn-bonus-header">
      <div class="vn-container">
        <div class="vn-bonus-header__inner">
          <a href="/" class="vn-bonus-header__logo" aria-label="Военный навигатор — на главную">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
            <span>ВОЕННЫЙ НАВИГАТОР</span>
          </a>
          <a href="/podbor/" class="vn-bonus-header__back">← Вернуться к подбору</a>
        </div>
      </div>
    </header>

    <!-- Зона 1: Подтверждение -->
    <section class="vn-bonus-confirm">
      <div class="vn-bonus-confirm__inner">
        <div class="vn-bonus-check" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
            <path
              d="M6 17 L13 24 L26 9"
              stroke="#2563EB"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="vn-bonus-check__path"
            />
          </svg>
        </div>

        <span class="vn-label-mono" style="color: var(--color-accent-cta)">ВАШ МАТЕРИАЛ ГОТОВ</span>

        <h1 class="vn-bonus-confirm__title">{magnet.title}</h1>
        <p class="vn-bonus-confirm__sub">{magnet.subtitle}</p>

        <ul class="vn-bonus-checklist">
          {magnet.what_inside.map((item) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Зона 2: Видео -->
    <section class="vn-bonus-video">
      <div class="vn-container">
        <p class="vn-bonus-video__label">СМОТРЕТЬ ПРЯМО СЕЙЧАС</p>
        <div class="vn-bonus-video__inner">
          {videoReady ? (
            <div class="vn-bonus-video__wrap">
              <iframe
                src={magnet.vk_embed_url}
                allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
                style="border:0"
                allowfullscreen
                loading="lazy"
                title={magnet.vk_title}
              />
            </div>
          ) : (
            <div class="vn-bonus-video__placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                <line x1="7" y1="2" x2="7" y2="22"/>
                <line x1="17" y1="2" x2="17" y2="22"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <line x1="2" y1="7" x2="7" y2="7"/>
                <line x1="2" y1="17" x2="7" y2="17"/>
                <line x1="17" y1="17" x2="22" y2="17"/>
                <line x1="17" y1="7" x2="22" y2="7"/>
              </svg>
              <p>Видео появится здесь</p>
              <code>Плейсхолдер: {primaryKey}</code>
            </div>
          )}
          {magnet.duration && magnet.duration !== '[VK_VIDEO_IPOTEKA_DURATION]' && (
            <p class="vn-bonus-video__duration">⏱ Длительность: {magnet.duration}</p>
          )}
        </div>
      </div>
    </section>

    <!-- Зона 3: Тизер второго материала -->
    <section class="vn-bonus-teaser">
      <div class="vn-container">
        <div class="vn-grid-12">
          <div style="grid-column: 1 / 6">
            <div class="vn-bonus-teaser__lock">
              <div class="vn-bonus-teaser__lock-blur" aria-hidden="true"></div>
              <div class="vn-bonus-teaser__lock-badge">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                ЗАКРЫТЫЙ МАТЕРИАЛ
              </div>
            </div>
          </div>
          <div style="grid-column: 6 / 13">
            <span class="vn-label-mono" style="color: var(--color-accent-cta)">ЕЩЁ ОДИН МАТЕРИАЛ</span>
            <h2 class="vn-bonus-teaser__title">{secondMagnet.teaser_title}</h2>
            <p class="vn-bonus-teaser__sub">{secondMagnet.teaser_sub}</p>
            {showTelegram ? (
              <a
                href={TELEGRAM_CHANNEL}
                target="_blank"
                rel="noopener noreferrer"
                class="vn-btn-primary vn-bonus-teaser__cta"
              >
                Получить второй материал в Telegram →
              </a>
            ) : (
              <a href={`tel:${CONTACTS.phone}`} class="vn-btn-primary vn-bonus-teaser__cta">
                Позвонить за вторым материалом
              </a>
            )}
            <p class="vn-bonus-teaser__micro">
              Напишите в канал — Михаил пришлёт материал&nbsp;лично
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Зона 4: Следующий шаг -->
    <section class="vn-bonus-next">
      <div class="vn-container">
        <div class="vn-bonus-next__inner">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="vn-bonus-next__icon">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
          </svg>
          <h2 class="vn-bonus-next__title">
            Готовы рассчитать варианты<br />под вашу ситуацию?
          </h2>
          <p class="vn-bonus-next__body">
            Посмотрели материал — и видите, что ситуация
            сложнее или есть вопросы? Михаил разбирает
            каждую задачу лично. Бесплатно.
          </p>
          <p class="vn-bonus-next__body">
            30 минут. Сначала цель, потом объект.
          </p>
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Разобрать мою ситуацию"
            data-modal-source="/bonus/"
            class="vn-btn-primary vn-bonus-next__cta"
          >
            Рассчитать варианты бесплатно
          </a>
          <div class="vn-bonus-next__trust">
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Бесплатно
            </span>
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              30 минут
            </span>
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Без обязательств
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Зона 5: Mini Footer -->
    <footer class="vn-bonus-footer">
      <div class="vn-container">
        <div class="vn-bonus-footer__inner">
          <span>© 2026 Военный навигатор · Михаил Хряпин</span>
          <nav class="vn-bonus-footer__legal" aria-label="Правовой раздел">
            <a href="/soglasie/">Согласие на обработку</a>
            <a href="/politika/">Политика обработки данных</a>
            <a href="/cookies/">Использование Cookie</a>
          </nav>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
/* ─── Bonus page ─── */
.vn-bonus-page {
  min-height: 100vh;
  background: var(--color-bg-dark);
}

/* Mini Header */
.vn-bonus-header {
  background: var(--color-bg-dark);
  border-bottom: 1px solid var(--color-border-ondark);
}

.vn-bonus-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
}

.vn-bonus-header__logo {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text-ondark);
  font-size: var(--fs-label);
  font-weight: 600;
  letter-spacing: 0.04em;
  text-decoration: none;
}

.vn-bonus-header__logo svg {
  color: var(--color-accent-cta);
}

.vn-bonus-header__back {
  font-size: var(--fs-body-sm);
  color: rgba(241, 243, 245, 0.45);
  text-decoration: none;
  transition: color 150ms ease;
}

.vn-bonus-header__back:hover {
  color: var(--color-text-ondark);
}

/* Confirm */
.vn-bonus-confirm {
  padding: 64px 40px 48px;
  background: var(--color-bg-dark);
}

.vn-bonus-confirm__inner {
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
}

.vn-bonus-check {
  width: 48px;
  height: 48px;
  background: var(--color-accent-cta-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
}

.vn-bonus-check__path {
  stroke-dasharray: 40;
  stroke-dashoffset: 40;
  animation: vn-bonus-draw 600ms ease forwards 300ms;
}

@keyframes vn-bonus-draw {
  to { stroke-dashoffset: 0; }
}

.vn-bonus-confirm__title {
  margin: 12px 0 0;
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--color-text-ondark);
  line-height: 1.15;
  text-wrap: balance;
}

.vn-bonus-confirm__sub {
  margin: 12px 0 0;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-ondark-mute);
  opacity: 0.7;
  text-wrap: pretty;
}

.vn-bonus-checklist {
  list-style: none;
  margin: 20px auto 0;
  padding: 0;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  text-align: left;
}

.vn-bonus-checklist li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: var(--fs-body-sm);
  color: var(--color-text-ondark-mute);
  line-height: 1.45;
}

.vn-bonus-checklist li svg {
  color: var(--color-accent-cta);
  flex-shrink: 0;
  margin-top: 2px;
}

/* Video */
.vn-bonus-video {
  padding: 0 40px 72px;
  background: var(--color-bg-dark);
}

.vn-bonus-video__label {
  text-align: center;
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-accent-cta);
  margin-bottom: 16px;
}

.vn-bonus-video__inner {
  max-width: 760px;
  margin: 0 auto;
}

.vn-bonus-video__wrap {
  position: relative;
  padding-top: 56.25%;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(241, 243, 245, 0.08);
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
}

.vn-bonus-video__wrap iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.vn-bonus-video__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 80px 20px;
  background: var(--color-bg-dark-elev);
  border: 1px solid var(--color-border-ondark);
  border-radius: 14px;
  color: var(--color-text-ondark-mute);
  text-align: center;
}

.vn-bonus-video__placeholder p {
  margin: 0;
  font-size: var(--fs-body);
}

.vn-bonus-video__placeholder code {
  font-size: var(--fs-label);
  color: var(--color-text-tertiary);
  background: rgba(241, 243, 245, 0.05);
  padding: 4px 8px;
  border-radius: 4px;
}

.vn-bonus-video__duration {
  text-align: center;
  font-size: var(--fs-label);
  color: rgba(241, 243, 245, 0.35);
  margin-top: 12px;
}

/* Teaser */
.vn-bonus-teaser {
  padding: 64px 40px;
  background: var(--color-bg-surface);
}

.vn-bonus-teaser__lock {
  position: relative;
  aspect-ratio: 16 / 10;
  background: linear-gradient(135deg, #1a2332 0%, #0f1419 100%);
  border-radius: 12px;
  overflow: hidden;
}

.vn-bonus-teaser__lock-blur {
  position: absolute;
  inset: 0;
  background: rgba(15, 20, 25, 0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.vn-bonus-teaser__lock-badge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: rgba(15, 20, 25, 0.85);
  border-radius: var(--radius-md);
  color: var(--color-text-ondark);
  font-size: var(--fs-body-sm);
  font-weight: 500;
  white-space: nowrap;
}

.vn-bonus-teaser__title {
  margin: 16px 0 0;
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
  text-wrap: balance;
}

.vn-bonus-teaser__sub {
  margin: 12px 0 0;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  text-wrap: pretty;
}

.vn-bonus-teaser__cta {
  margin-top: 24px;
}

.vn-bonus-teaser__micro {
  margin: 8px 0 0;
  font-size: var(--fs-label);
  color: var(--color-text-tertiary);
}

/* Next step */
.vn-bonus-next {
  padding: 64px 40px;
  background: var(--color-bg-primary);
}

.vn-bonus-next__inner {
  max-width: 560px;
  margin: 0 auto;
  text-align: center;
}

.vn-bonus-next__icon {
  color: var(--color-accent-cta);
  margin-bottom: 16px;
}

.vn-bonus-next__title {
  margin: 0;
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-bonus-next__body {
  margin: 16px 0 0;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  text-wrap: pretty;
}

.vn-bonus-next__cta {
  margin-top: 28px;
}

.vn-bonus-next__trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 12px;
  flex-wrap: wrap;
}

.vn-bonus-next__trust span {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-label);
  color: var(--color-text-tertiary);
}

.vn-bonus-next__trust svg {
  color: var(--color-text-tertiary);
}

/* Footer */
.vn-bonus-footer {
  background: var(--color-bg-dark);
  border-top: 1px solid var(--color-border-ondark);
}

.vn-bonus-footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  font-size: var(--fs-label);
  color: rgba(241, 243, 245, 0.35);
}

.vn-bonus-footer__inner a {
  color: inherit;
  text-decoration: none;
  transition: color 150ms ease;
}

.vn-bonus-footer__inner a:hover {
  color: var(--color-text-ondark);
}

.vn-bonus-footer__legal {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12px;
}

/* Mobile */
@media (max-width: 1023px) {
  .vn-bonus-teaser .vn-grid-12 > * {
    grid-column: 1 / -1 !important;
  }
  .vn-bonus-teaser__lock {
    max-width: 480px;
    margin: 0 auto 32px;
  }
}

@media (max-width: 640px) {
  .vn-bonus-confirm {
    padding: 48px 24px 32px;
  }
  .vn-bonus-video {
    padding: 0 24px 48px;
  }
  .vn-bonus-teaser {
    padding: 48px 24px;
  }
  .vn-bonus-next {
    padding: 48px 24px;
  }
  .vn-bonus-footer__inner {
    flex-direction: column;
    height: auto;
    padding: 16px 0;
    gap: 6px;
    text-align: center;
  }
  .vn-bonus-footer__legal {
    justify-content: center;
    gap: 8px 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .vn-bonus-check__path {
    animation: none;
    stroke-dashoffset: 0;
  }
}
</style>
