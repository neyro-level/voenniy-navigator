---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "./_usloviya-voennoy-ipoteki/01-Hero.astro";
import Conditions from "./_usloviya-voennoy-ipoteki/02-Conditions.astro";
import Eligibility from "./_usloviya-voennoy-ipoteki/03-Eligibility.astro";
import Amount from "./_usloviya-voennoy-ipoteki/04-Amount.astro";
import Scenarios from "./_usloviya-voennoy-ipoteki/05-Scenarios.astro";
import Banks from "./_usloviya-voennoy-ipoteki/06-Banks.astro";
import Process from "./_usloviya-voennoy-ipoteki/07-Process.astro";
import Geo from "./_usloviya-voennoy-ipoteki/08-Geo.astro";
import FAQ from "../components/sections/FAQ.astro";
import FinalCTALight from "../components/sections/FinalCTALight.astro";
import { pageMeta, schemas, faqItems } from "./_usloviya-voennoy-ipoteki/pageData";
---

<PageLayout {...pageMeta} schema={schemas}>
  <Hero />
  <Conditions />
  <Eligibility />
  <Amount />
  <Scenarios />
  <Banks />
  <Process />
  <Geo />
  <FAQ
    items={faqItems}
    eyebrow="FAQ"
    title="Частые вопросы об условиях военной ипотеки"
    lead="Короткие ответы на ключевые вопросы, которые обычно возникают до выбора банка, объекта и формата сделки. Если вашей ситуации здесь нет, лучше разобрать её отдельно."
    linkText="Не нашли свой вопрос? Разберите ситуацию на первом шаге →"
    linkHref="/contacts/#request"
    linkModalTitle="Получить расчёт ситуации"
  />
  <FinalCTALight />
</PageLayout>
