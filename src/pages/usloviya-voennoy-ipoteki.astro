---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "./_usloviya-voennoy-ipoteki/01-Hero.astro";
import Conditions from "./_usloviya-voennoy-ipoteki/02-Conditions.astro";
import Amount from "./_usloviya-voennoy-ipoteki/03-Amount.astro";
import Banks from "./_usloviya-voennoy-ipoteki/04-Banks.astro";
import Geo from "./_usloviya-voennoy-ipoteki/05-Geo.astro";
import FAQ from "../components/sections/FAQ.astro";
import FinalCTALight from "../components/sections/FinalCTALight.astro";
import { pageMeta, schemas, faqItems } from "./_usloviya-voennoy-ipoteki/pageData";
---

<PageLayout {...pageMeta} schema={schemas}>
  <Hero />
  <Conditions />
  <Amount />
  <Banks />
  <Geo />
  <FAQ
    items={faqItems}
    eyebrow="FAQ"
    title="Частые вопросы об условиях военной ипотеки"
    lead="Короткие ответы на ключевые вопросы до выбора банка и объекта."
    linkText="Не нашли свой вопрос? Разберите ситуацию на первом шаге →"
    linkHref="/contacts/#request"
    linkModalTitle="Получить расчёт ситуации"
  />
  <FinalCTALight />
</PageLayout>
