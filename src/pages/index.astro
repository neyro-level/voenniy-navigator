---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, CONTACTS } from '../lib/constants';
import {
  organizationSchema,
  personSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../lib/seo';

const faqItems = [
  {
    q: 'Как начинается работа?',
    a: 'Работа начинается с бесплатного разбора цели покупки — 30-минутной видеовстречи в Яндекс Телемост. На разборе определяем задачу, сценарий и критерии выбора. Никаких обязательств продолжать — только понимание ситуации.',
  },
  {
    q: 'Сколько стоит сопровождение?',
    // TODO: уточнить у Михаила — модель оплаты (комиссия от застройщика или фиксированная плата)
    a: 'Уточняется на первом разборе — после понимания задачи и сценария.',
  },
  {
    q: 'Можно ли работать полностью удалённо?',
    a: 'Да. Разбор цели — онлайн. Подбор и анализ — онлайн. Показы — по видео. Часть документов — через доверенность. Михаил находится в Краснодаре и смотрит объекты лично. Подробнее — на странице про дистанционную покупку.',
  },
  {
    q: 'Что конкретно входит в сопровождение?',
    a: 'Разбор задачи, отбор объектов, локальная проверка района и ЖК, организация показов, банк и документы военной ипотеки, координация застройщика и банка, сопровождение до регистрации права собственности.',
  },
  {
    q: 'Чем это отличается от работы с агентством?',
    a: 'Агентство работает с любой недвижимостью в любом городе. Михаил — только новостройки в Краснодаре, только военная ипотека. Не «подберём что-нибудь», а отбор под конкретную задачу клиента.',
  },
  {
    q: 'Что происходит после регистрации сделки?',
    // TODO: уточнить у Михаила — приёмка квартиры, ремонт, контроль сроков, постсделочное сопровождение
    a: 'Уточняется индивидуально — в зависимости от ситуации.',
  },
];

const schemas = [
  organizationSchema,
  personSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
  },
  serviceSchema({
    name: 'Сопровождение покупки новостройки по военной ипотеке в Краснодаре',
    description:
      'Помощь военнослужащим с выбором новостройки и прохождением военной ипотеки в Краснодаре: разбор цели, отбор объектов, сопровождение сделки до регистрации права собственности.',
    url: `${SITE.url}/`,
    areaServed: 'Краснодар',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Главная', url: `${SITE.url}/` }]),
];
---

<PageLayout
  title="Навигатор по новостройкам Краснодара для военнослужащих"
  description="Помогаю военнослужащим и семьям выбрать новостройку в Краснодаре под реальную цель покупки и пройти военную ипотеку до результата. Первый шаг — разбор цели."
  canonical={`${SITE.url}/`}
  ogImage={`${SITE.url}/og/home.jpg`}
  schema={schemas}
>

<!-- ══════════════════════════════════════════════
     БЛОК 01 — HERO
════════════════════════════════════════════════ -->
<section id="section-hero" class="vn-home-hero">
  <div class="vn-home-hero__grid-bg" aria-hidden="true"></div>
  <div class="vn-home-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-home-hero__inner">

      <!-- Left: 6 колонок -->
      <div class="vn-home-hero__left vn-col-6">
        <div class="vn-home-hero__eyebrow">Военный навигатор</div>

        <h1 class="vn-home-hero__h1">
          Навигатор по новостройкам Краснодара
          <span class="vn-home-hero__h1-accent"> для военнослужащих</span>
        </h1>

        <p class="vn-home-hero__sub">
          Помогаю понять, что вам действительно стоит купить
          и провожу путь по военной ипотеке от первого разбора до результата.
        </p>

        <div class="vn-home-hero__cta-row">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Записаться на разбор"
            class="vn-btn-primary vn-home-hero__btn-primary"
          >
            Записаться на разбор
          </a>
        </div>

        <!-- Stats 2×2 -->
        <div class="vn-home-hero__stats" role="list">
          <div class="vn-home-hero__stat" role="listitem">
            <span class="vn-home-hero__stat-label">Опыт</span>
            <span class="vn-home-hero__stat-value">С 2016 года в профессии эксперта по недвижимости</span>
          </div>
          <div class="vn-home-hero__stat" role="listitem">
            <span class="vn-home-hero__stat-label">Маршрут</span>
            <span class="vn-home-hero__stat-value">65 сделок по военной ипотеке</span>
          </div>
          <div class="vn-home-hero__stat" role="listitem">
            <span class="vn-home-hero__stat-label">Практика</span>
            <span class="vn-home-hero__stat-value">180+ сделок в недвижимости</span>
          </div>
          <div class="vn-home-hero__stat" role="listitem">
            <span class="vn-home-hero__stat-label">Формат</span>
            <span class="vn-home-hero__stat-value">Дистанционное сопровождение</span>
          </div>
        </div>
      </div>

      <!-- Right: 6 колонок -->
      <div class="vn-home-hero__right vn-col-6">
        <div class="vn-home-hero__photo-outer">
          <div class="vn-home-hero__portrait-frame">
            <img
              src="/images/mikhail-hero.png"
              alt="Михаил Хряпин — навигатор по новостройкам Краснодара"
              loading="eager"
              decoding="async"
              class="vn-home-hero__portrait"
            />
            <div class="vn-home-hero__name-card">
              <p class="vn-home-hero__name-card-title">Михаил Хряпин</p>
              <p class="vn-home-hero__name-card-sub">Навигатор по новостройкам Краснодара для&nbsp;военнослужащих</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 02 — КОРОТКИЙ ОТВЕТ (AI-ready)
════════════════════════════════════════════════ -->
<section id="section-short-answer" class="vn-home-answer">
  <div class="vn-container">
    <div class="vn-home-answer__inner">
      <blockquote class="vn-home-answer__quote">
        Военный навигатор Михаила Хряпина помогает военнослужащим и их семьям
        выбрать новостройку в Краснодарском крае или в Крыму
        под реальную цель покупки для жизни или инвестиции.
      </blockquote>
      <p class="vn-home-answer__detail">
        Работа начинается с разбора задачи, а не подборки&nbsp;вариантов.
        Дальше&nbsp;– сопровождение по всему маршруту до регистрации права&nbsp;собственности.
      </p>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 03 — ГЛАВНАЯ ОШИБКА ВЫБОРА
════════════════════════════════════════════════ -->
<section id="section-problem" class="vn-section vn-section--secondary">
  <span class="vn-section-marker vn-pos-tr" aria-hidden="true">03</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ОШИБКА ВЫБОРА / 03</span>
    <h2 class="vn-home-h2" style="max-width:680px; margin-top:16px;">
      Главная ошибка — начать с объекта, а не с цели
    </h2>
    <div class="vn-home-prob__theses">
      <p class="vn-home-prob__thesis">
        Один и тот же ЖК может быть хорошим для сдачи и слабым для жизни
        семьи. Критерии выбора зависят от цели — и она должна быть определена первой.
      </p>
      <p class="vn-home-prob__thesis">
        Реклама застройщика продаёт объект, а не вашу задачу. Рендеры и акции
        не отвечают на вопрос: подходит ли этот вариант именно вам.
      </p>
      <p class="vn-home-prob__thesis vn-home-prob__thesis--key">
        Поэтому работа начинается не с просмотра ЖК, а с разбора цели покупки.
      </p>
    </div>
    <a
      href="/contacts/#request"
      data-modal-open
      data-modal-title="Разобрать мою задачу"
      class="vn-home-textlink"
    >
      Разобрать мою задачу сначала →
    </a>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 04 — СЦЕНАРИИ
════════════════════════════════════════════════ -->
<section id="section-scenarios" class="vn-section">
  <span class="vn-section-marker vn-pos-bl" aria-hidden="true">04</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ВАШ СЦЕНАРИЙ / 04</span>
    <h2 class="vn-home-h2" style="max-width:680px; margin-top:16px;">
      С какой задачей обычно приходят
    </h2>
    <p class="vn-home-sub" style="max-width:520px; margin-top:12px; margin-bottom:48px;">
      Узнайте свою ситуацию. Разные сценарии требуют разных решений —
      но первый шаг для каждого одинаковый.
    </p>

    <div class="vn-home-sc__grid">

      <article class="vn-home-sc__card">
        <span class="vn-tag">01</span>
        <div class="vn-accent-line" aria-hidden="true"></div>
        <h3 class="vn-home-sc__title">Для жизни</h3>
        <p class="vn-home-sc__body">Нужна новостройка, в которой реально удобно жить семье с детьми.</p>
      </article>

      <article class="vn-home-sc__card vn-home-sc__card--low">
        <span class="vn-tag">02</span>
        <div class="vn-accent-line" aria-hidden="true"></div>
        <h3 class="vn-home-sc__title">Переезд позже</h3>
        <p class="vn-home-sc__body">Квартиру покупают сейчас, а переезжать будут через 2–3 года.</p>
      </article>

      <article class="vn-home-sc__card">
        <span class="vn-tag">03</span>
        <div class="vn-accent-line" aria-hidden="true"></div>
        <h3 class="vn-home-sc__title">Под сдачу до переезда</h3>
        <p class="vn-home-sc__body">Важно, чтобы квартира работала и приносила доход до момента переезда.</p>
      </article>

      <article class="vn-home-sc__card vn-home-sc__card--low">
        <span class="vn-tag">04</span>
        <div class="vn-accent-line" aria-hidden="true"></div>
        <h3 class="vn-home-sc__title">Дистанционная покупка</h3>
        <p class="vn-home-sc__body">Нет возможности постоянно приезжать в Краснодар и контролировать всё лично.</p>
      </article>

      <article class="vn-home-sc__card">
        <span class="vn-tag">05</span>
        <div class="vn-accent-line" aria-hidden="true"></div>
        <h3 class="vn-home-sc__title">Сложный маршрут</h3>
        <p class="vn-home-sc__body">Сжатые сроки НИС, нестандартная ситуация, документы, координация сторон.</p>
      </article>

    </div>

    <p class="vn-home-sc__note">
      Какой бы ни был ваш сценарий — работа начинается одинаково: с разбора цели покупки.
    </p>
    <div class="vn-home-sc__cta-row">
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Разобрать мою ситуацию"
        class="vn-btn-primary"
      >
        Разобрать мою ситуацию
      </a>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 05 — МЕТОД
════════════════════════════════════════════════ -->
<section id="section-method" class="vn-section vn-section--secondary">
  <span class="vn-section-marker vn-pos-tr" aria-hidden="true">05</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">МЕТОД / 05</span>
    <h2 class="vn-home-h2" style="margin-top:16px;">
      Метод навигации:
      <span style="color:var(--color-accent-primary);">цель → сценарий → объект → сделка</span>
    </h2>
    <p class="vn-home-sub" style="max-width:560px; margin-top:12px; margin-bottom:48px;">
      Последовательность, которая объясняет роль навигатора — не просто
      «подобрать квартиру», а провести весь путь логично и без хаоса.
    </p>

    <!-- 4 шага -->
    <div class="vn-home-method__steps">

      <div class="vn-card vn-home-method__step">
        <div class="vn-home-method__badge">01</div>
        <div class="vn-accent-line" style="margin:8px 0;" aria-hidden="true"></div>
        <h3 class="vn-home-method__step-title">Разбираем цель покупки</h3>
        <p class="vn-home-method__step-body">
          Жить, переехать позже, сдавать или зафиксировать актив. От ответа на этот вопрос
          зависят все следующие решения. Без него подбор превращается в случайную выборку.
        </p>
      </div>

      <div class="vn-card vn-home-method__step">
        <div class="vn-home-method__badge">02</div>
        <div class="vn-accent-line" style="margin:8px 0;" aria-hidden="true"></div>
        <h3 class="vn-home-method__step-title">Определяем сценарий и ограничения</h3>
        <p class="vn-home-method__step-body">
          Бюджет, банк, документы, регион проживания, сроки. Какие риски нужно учесть.
          Особенности именно вашей ситуации.
        </p>
      </div>

      <div class="vn-card vn-home-method__step">
        <div class="vn-home-method__badge">03</div>
        <div class="vn-accent-line" style="margin:8px 0;" aria-hidden="true"></div>
        <h3 class="vn-home-method__step-title">Отсекаем неподходящие варианты</h3>
        <p class="vn-home-method__step-body">
          Это главная экономия времени: районы, форматы и ЖК, которые не подходят под задачу,
          исключаются до просмотра.
        </p>
      </div>

      <div class="vn-card vn-home-method__step">
        <div class="vn-home-method__badge">04</div>
        <div class="vn-accent-line" style="margin:8px 0;" aria-hidden="true"></div>
        <h3 class="vn-home-method__step-title">Сопровождаем до результата</h3>
        <p class="vn-home-method__step-body">
          Подбор объекта, банк, документы, координация сторон, регистрация.
          Не «подобрали и ушли» — весь путь до конца.
        </p>
      </div>

    </div>

    <!-- Сравнение с рынком -->
    <div style="margin-top:64px;">
      <span class="vn-label-mono" style="margin-bottom:24px; display:inline-flex;">
        ЧЕМ ОТЛИЧАЕТСЯ ОТ ТИПОВОГО ПОДБОРА
      </span>
      <div class="vn-home-method__compare">
        <div class="vn-home-method__compare-col vn-home-method__compare-col--left">
          <div class="vn-home-method__compare-head">Типовой подбор на рынке</div>
          <div class="vn-home-method__compare-row">Подборка из витрины по цене</div>
          <div class="vn-home-method__compare-row">«Посмотрите все варианты»</div>
          <div class="vn-home-method__compare-row">Фокус на оформлении ипотеки</div>
          <div class="vn-home-method__compare-row">«Подобрали — занимайтесь дальше»</div>
        </div>
        <div class="vn-home-method__compare-col vn-home-method__compare-col--right">
          <div class="vn-home-method__compare-head">Навигатор</div>
          <div class="vn-home-method__compare-row vn-home-method__compare-row--accent">Отбор под задачу клиента</div>
          <div class="vn-home-method__compare-row vn-home-method__compare-row--accent">Отсечение неподходящих до просмотра</div>
          <div class="vn-home-method__compare-row vn-home-method__compare-row--accent">Сначала выбор правильного объекта</div>
          <div class="vn-home-method__compare-row vn-home-method__compare-row--accent">Сопровождение до регистрации права</div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 06 — ПЕРВЫЙ ШАГ
════════════════════════════════════════════════ -->
<section id="section-first-step" class="vn-section">
  <span class="vn-section-marker vn-pos-bl" aria-hidden="true">06</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ПЕРВЫЙ ШАГ / 06</span>
    <h2 class="vn-home-h2" style="margin-top:16px; margin-bottom:40px;">
      Разбор цели покупки — как это устроено
    </h2>

    <div class="vn-home-fs__cols">

      <!-- Левая: как проходит -->
      <div>
        <h3 class="vn-home-fs__col-title">Как проходит</h3>
        <ul class="vn-home-fs__list">
          <li class="vn-home-fs__item">
            <span class="vn-home-fs__check" aria-hidden="true">✓</span>
            Бесплатная видеовстреча, 30 минут
          </li>
          <li class="vn-home-fs__item">
            <span class="vn-home-fs__check" aria-hidden="true">✓</span>
            Яндекс Телемост — никуда не нужно ехать
          </li>
          <li class="vn-home-fs__item">
            <span class="vn-home-fs__check" aria-hidden="true">✓</span>
            Разбираем вашу ситуацию, сценарий и задачу
          </li>
        </ul>

        <blockquote class="vn-home-fs__quote">
          Первый разбор — это не обязательство продолжать.
          Это понимание, стоит ли идти дальше.
        </blockquote>

        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Записаться на разбор"
          class="vn-btn-primary"
          style="margin-top:32px;"
        >
          Записаться на разбор
        </a>
      </div>

      <!-- Правая: что получите -->
      <div class="vn-card vn-home-fs__results">
        <h3 class="vn-home-fs__col-title" style="margin-bottom:20px;">После разбора вы получите</h3>
        <ol class="vn-home-fs__results-list">
          <li class="vn-home-fs__result-item">
            <span class="vn-home-fs__num">01</span>
            <span>Понимание своей реальной цели покупки</span>
          </li>
          <li class="vn-home-fs__result-item">
            <span class="vn-home-fs__num">02</span>
            <span>Понимание подходящего сценария</span>
          </li>
          <li class="vn-home-fs__result-item">
            <span class="vn-home-fs__num">03</span>
            <span>Понимание, что смотреть при выборе ЖК в Краснодаре</span>
          </li>
          <li class="vn-home-fs__result-item">
            <span class="vn-home-fs__num">04</span>
            <span>Понимание, как строится маршрут сделки</span>
          </li>
          <li class="vn-home-fs__result-item">
            <span class="vn-home-fs__num">05</span>
            <span>Честный ответ — стоит ли идти дальше в сопровождение</span>
          </li>
        </ol>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 07 — СОПРОВОЖДЕНИЕ
════════════════════════════════════════════════ -->
<section id="section-service" class="vn-section vn-section--secondary">
  <span class="vn-section-marker vn-pos-tr" aria-hidden="true">07</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">СОПРОВОЖДЕНИЕ / 07</span>
    <h2 class="vn-home-h2" style="margin-top:16px;">
      Что входит в основное сопровождение
    </h2>
    <p class="vn-home-sub" style="max-width:560px; margin-top:12px; margin-bottom:48px;">
      От разбора задачи до регистрации права собственности.
    </p>

    <div class="vn-home-svc__grid">

      <div class="vn-card vn-home-svc__item">
        <svg class="vn-home-svc__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        <div class="vn-accent-line vn-home-svc__line" aria-hidden="true"></div>
        <h3 class="vn-home-svc__title">Разбор цели и сценария</h3>
