---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './_home/01-Hero.astro';
import EntryPoints from './_home/02-EntryPoints.astro';

import WhyFree from './_home/03-WhyFree.astro';
import Mortgage from './_home/04-Mortgage.astro';
import SelectionLogic from './_home/05-SelectionLogic.astro';
import Scenarios from './_home/06-Scenarios.astro';
import MikhailTrust from './_home/07-MikhailTrust.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTALight from '../components/sections/FinalCTALight.astro';
import { SITE } from '../lib/constants';
import { OG_IMAGES } from '../lib/og';
import {
  organizationSchema,
  personSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../lib/seo';

const faqItems = [
  {
    q: 'Чем вы отличаетесь от обычного агентства или самостоятельного поиска на агрегаторах?',
    a: 'Агрегаторы показывают всё подряд, чтобы получить клик. Мы работаем наоборот: сначала анализируем ваши лимиты и задачу, отсеиваем 90% неподходящих вариантов на бумаге, и только потом показываем 3–5 реальных объектов, которые одобрит банк.'
  },
  {
    q: 'Сколько стоят ваши услуги? Есть ли скрытые комиссии для покупателя?',
    a: 'Первичный расчёт вариантов и подбор новостройки — без комиссий для вас. Наши услуги оплачивает застройщик. Вы не переплачиваете сверх стоимости объекта.'
  },
  {
    q: 'Что именно происходит на первичном расчёте и сколько он занимает?',
    a: 'Это 20-минутная консультация с Михаилом. Мы выясняем вашу цель, бюджет и ограничения программы. На выходе вы получаете не абстрактные советы, а чёткое понимание: какие объекты вам подходят, а какие лучше сразу отсеять.'
  },
  {
    q: 'Можно ли провести всю сделку дистанционно, если я в другом городе?',
    a: 'Да, мы регулярно проводим сделки удалённо. Мы определяем, какие этапы можно пройти онлайн, организуем показ доверенным лицом и готовим документы, чтобы вам не пришлось летать на встречи.'
  },
  {
    q: 'С какими регионами вы работаете?',
    a: 'Наша базовая экспертиза — новостройки Краснодара и Крыма. Также мы сопровождаем дистанционные покупки в других регионах, если там есть проверенные партнёры и подходящие под вашу программу объекты.'
  },
  {
    q: 'Что если банк откажет в ипотеке после подбора объекта?',
    a: 'Именно чтобы этого избежать, мы проверяем ваши лимиты и требования банка *до* начала подбора. Мы показываем только те новостройки и застройщиков, которые уже прошли проверку на соответствие вашей военной ипотеке.'
  }
];

const schemas = [
  organizationSchema(),
  personSchema(),
  serviceSchema({
    name: 'Военный навигатор — сервис по военной ипотеке и новостройкам',
    description:
      'Военный навигатор помогает рассчитать варианты покупки, определить ограничения и отобрать квартиры и новостройки по военной ипотеке в Краснодаре, Крыму и дистанционном формате.',
    url: `${SITE.url}/`,
    areaServed: 'Россия',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Главная', url: `${SITE.url}/` }]),
];
---

<PageLayout
  title="Военный навигатор — сервис по военной ипотеке и новостройкам"
  description="Военный навигатор помогает выбрать новостройку по военной ипотеке в Краснодаре и Крыму: сначала расчёт вариантов, потом подбор и следующий шаг по сделке."
  canonical={`${SITE.url}/`}
  ogImage={OG_IMAGES.home}
  schema={schemas}
>
  <Hero />
  <EntryPoints />
  <WhyFree />
  <Mortgage />
  <SelectionLogic />
  <Scenarios />
  <MikhailTrust />
  <FAQ
    items={faqItems}
    eyebrow="FAQ"
    title="Вопросы о сервисе и первом расчёте"
    lead="Здесь собраны ответы о сервисе, расчёте вариантов, регионах работы и моменте перехода к подбору объекта."
    linkText="Не нашли свой вопрос? Получите подборку на первом шаге →"
    linkHref="/contacts/#request"
    linkModalTitle="Получить подборку"
  />
  <FinalCTALight />
</PageLayout>
