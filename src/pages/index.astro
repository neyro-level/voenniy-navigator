---
import PageLayout from '../layouts/PageLayout.astro';
import HomeSharedStyles from './_home/00-HomeSharedStyles.astro';
import Hero from './_home/01-Hero.astro';
import ShortAnswer from './_home/02-ShortAnswer.astro';
import Problem from './_home/03-Problem.astro';
import Scenarios from './_home/04-Scenarios.astro';
import Method from './_home/05-Method.astro';
import FirstStep from './_home/06-FirstStep.astro';
import Service from './_home/07-Service.astro';
import Trust from './_home/08-Trust.astro';
import Reviews from './_home/09-Reviews.astro';
import Limits from './_home/10-Limits.astro';
import FAQ from './_home/11-FAQ.astro';
import FinalCTA from './_home/12-FinalCTA.astro';
import { SITE } from '../lib/constants';
import {
  organizationSchema,
  personSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../lib/seo';

const faqItems = [
  {
    q: 'Как начинается работа?',
    a: 'Работа начинается с бесплатного разбора цели покупки — 30-минутной видеовстречи в Яндекс Телемост. На разборе определяем задачу, сценарий и критерии выбора. Никаких обязательств продолжать — только понимание ситуации.',
  },
  {
    q: 'Сколько стоит сопровождение?',
    // TODO: уточнить у Михаила — модель оплаты (комиссия от застройщика или фиксированная плата)
    a: 'Уточняется на первом разборе — после понимания задачи и сценария.',
  },
  {
    q: 'Можно ли работать полностью удалённо?',
    a: 'Да. Разбор цели — онлайн. Подбор и анализ — онлайн. Показы — по видео. Часть документов — через доверенность. Михаил находится в Краснодаре и смотрит объекты лично. Подробнее — на странице про дистанционную покупку.',
  },
  {
    q: 'Что конкретно входит в сопровождение?',
    a: 'Разбор задачи, отбор объектов, локальная проверка района и ЖК, организация показов, банк и документы военной ипотеки, координация застройщика и банка, сопровождение до регистрации права собственности.',
  },
  {
    q: 'Чем это отличается от работы с агентством?',
    a: 'Агентство работает с любой недвижимостью в любом городе. Михаил — только новостройки в Краснодаре, только военная ипотека. Не «подберём что-нибудь», а отбор под конкретную задачу клиента.',
  },
  {
    q: 'Что происходит после регистрации сделки?',
    // TODO: уточнить у Михаила — приёмка квартиры, ремонт, контроль сроков, постсделочное сопровождение
    a: 'Уточняется индивидуально — в зависимости от ситуации.',
  },
];

const schemas = [
  organizationSchema,
  personSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
  },
  serviceSchema({
    name: 'Сопровождение покупки новостройки по военной ипотеке в Краснодаре',
    description:
      'Помощь военнослужащим с выбором новостройки и прохождением военной ипотеки в Краснодаре: разбор цели, отбор объектов, сопровождение сделки до регистрации права собственности.',
    url: `${SITE.url}/`,
    areaServed: 'Краснодар',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Главная', url: `${SITE.url}/` }]),
];
---

<PageLayout
  title="Навигатор по новостройкам Краснодара для военнослужащих"
  description="Помогаю военнослужащим и семьям выбрать новостройку в Краснодаре под реальную цель покупки и пройти военную ипотеку до результата. Первый шаг — разбор цели."
  canonical={`${SITE.url}/`}
  ogImage={`${SITE.url}/og/home.jpg`}
  schema={schemas}
>
  <HomeSharedStyles />
  <Hero />
  <ShortAnswer />
  <Problem />
  <Scenarios />
  <Method />
  <FirstStep />
  <Service />
  <Trust />
  <Reviews />
  <Limits />
  <FAQ items={faqItems} />
  <FinalCTA />
</PageLayout>
