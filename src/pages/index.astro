---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './_home/01-Hero.astro';
import ShortAnswer from './_home/02-ShortAnswer.astro';
import Routes from './_home/03-Routes.astro';
import FirstReview from './_home/04-FirstReview.astro';
import SelectionLogic from './_home/05-SelectionLogic.astro';
import Scenarios from './_home/06-Scenarios.astro';
import MikhailTrust from './_home/07-MikhailTrust.astro';
import Proof from './_home/08-Proof.astro';
import FAQ from './_home/09-FAQ.astro';
import FinalCTA from './_home/10-FinalCTA.astro';
import { SITE } from '../lib/constants';
import { OG_IMAGES } from '../lib/og';
import {
  organizationSchema,
  personSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../lib/seo';

const faqItems = [
  {
    q: 'Что такое Военный навигатор?',
    a: 'Это сервис выбора новостройки и сопровождения покупки по военной ипотеке. Первый шаг — разбор ситуации: цель покупки, ограничения, бюджет, сроки и логика дальнейшего маршрута.',
  },
  {
    q: 'Что происходит на первом разборе?',
    a: 'Михаил уточняет задачу покупки, ограничения по программе, банк, бюджет, сроки и критерии выбора. После этого становится понятнее, какой маршрут покупки логичен именно в вашей ситуации.',
  },
  {
    q: 'Сколько стоит первый шаг?',
    a: 'Первый шаг — это разбор ситуации. Детали лучше уточнять при обращении, потому что маршрут дальше зависит от задачи покупки, региона и сценария сделки.',
  },
  {
    q: 'Можно ли пройти разбор дистанционно?',
    a: 'Да. Сервис работает с дистанционным форматом: на первом разборе определяется, какие этапы можно пройти удалённо и где потребуется личное участие.',
  },
  {
    q: 'С какими регионами работает сервис?',
    a: 'Базовая география — Краснодар, Крым и дистанционный формат. Если задача связана с этими маршрутами, сервис помогает пройти путь от разбора ситуации до следующего шага по сделке.',
  },
  {
    q: 'Когда вы переходите к подбору объекта?',
    a: 'Не сразу после обращения, а после того как понятны задача, ограничения и критерии выбора. Подбор начинается тогда, когда уже ясно, что именно стоит искать и что нужно отсечь.',
  },
];

const schemas = [
  organizationSchema(),
  personSchema(),
  serviceSchema({
    name: 'Сервис выбора новостройки по военной ипотеке',
    description:
      'Военный навигатор помогает разобраться в задаче покупки, определить ограничения и отобрать подходящие новостройки по военной ипотеке.',
    url: `${SITE.url}/`,
    areaServed: 'Россия',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Главная', url: `${SITE.url}/` }]),
];
---

<PageLayout
  title="Сервис выбора новостройки по военной ипотеке"
  description="Военный навигатор помогает разобраться в ситуации, отобрать подходящие новостройки и начать покупку по военной ипотеке с первого разбора."
  canonical={`${SITE.url}/`}
  ogImage={OG_IMAGES.home}
  schema={schemas}
>
  <Hero />
  <ShortAnswer />
  <Routes />
  <FirstReview />
  <SelectionLogic />
  <Scenarios />
  <MikhailTrust />
  <Proof />
  <FAQ items={faqItems} />
  <FinalCTA />
</PageLayout>
