---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './_home/01-Hero.astro';
import ShortAnswer from './_home/02-ShortAnswer.astro';
import Problem from './_home/03-Problem.astro';
import Scenarios from './_home/04-Scenarios.astro';
import Review from './_home/05-Review.astro';
import Limits from './_home/06-Limits.astro';
import Service from './_home/07-Service.astro';
import Trust from './_home/08-Trust.astro';
import Reviews from './_home/09-Reviews.astro';
import FAQ from './_home/10-FAQ.astro';
import FinalCTA from './_home/11-FinalCTA.astro';
import { SITE } from '../lib/constants';
import { OG_IMAGES } from '../lib/og';
import {
  organizationSchema,
  personSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../lib/seo';

const faqItems = [
  {
    q: 'Сколько времени занимает покупка от разбора до сделки?',
    a: 'Зависит от задачи и готовности объекта. В среднем от 2 до 6 недель: разбор, отбор, банк, документы, регистрация. Точные сроки обсуждаем на первичном разборе.',
  },
  {
    q: 'Можно ли купить квартиру по военной ипотеке, находясь в другом городе?',
    a: 'Да, начать можно дистанционно. На разборе уточняем задачу и формат сделки, дальше определяем, какие этапы проходят удалённо и где нужно личное участие.',
  },
  {
    q: 'Что делать, если банк отказал в одобрении?',
    a: 'Отказ банка — не конец маршрута. Разбираем причину, смотрим другие банки или программы, корректируем документы. Решение за банком, но подготовка в наших руках.',
  },
  {
    q: 'Можно ли совместить военную ипотеку с маткапиталом или семейной?',
    a: 'Да, если банк и программа позволяют. На разборе считаем, как увеличивается бюджет и какие документы нужны для совмещения.',
  },
  {
    q: 'Чем это отличается от работы с агентством?',
    a: 'Работа начинается не с просмотра случайных вариантов, а с задачи покупки. Сначала цель, условия и ограничения, потом — отбор новостроек, которые действительно стоит рассматривать.',
  },
  {
    q: 'Сколько стоит сопровождение?',
    a: 'В новостройках сопровождение обычно оплачивает застройщик. На первичном разборе мы объясним, как устроена оплата в вашем случае и какие расходы могут быть отдельно.',
  },
];

const schemas = [
  organizationSchema(),
  personSchema(),
  serviceSchema({
    name: 'Помощь с выбором новостройки по военной ипотеке',
    description:
      'Помощь военнослужащим с выбором новостройки под задачу, первичным разбором, банком, документами и сопровождением сделки до регистрации.',
    url: `${SITE.url}/`,
    areaServed: 'Россия',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Главная', url: `${SITE.url}/` }]),
];
---

<PageLayout
  title="Военная ипотека: выбор новостройки под вашу задачу"
  description="Помогаем военнослужащим выбрать новостройку по военной ипотеке под задачу: для жизни или вложения. Первый шаг — первичный разбор без обязательств."
  canonical={`${SITE.url}/`}
  ogImage={OG_IMAGES.home}
  schema={schemas}
>
  <Hero />
  <ShortAnswer />
  <Problem />
  <Scenarios />
  <Review />
  <Limits />
  <Service />
  <Trust />
  <Reviews />
  <FAQ items={faqItems} />
  <FinalCTA />
</PageLayout>
