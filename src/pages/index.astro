---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './_home/01-Hero.astro';
import ShortAnswer from './_home/02-ShortAnswer.astro';
import Problem from './_home/03-Problem.astro';
import Scenarios from './_home/04-Scenarios.astro';
import Method from './_home/05-Method.astro';
import FirstStep from './_home/06-FirstStep.astro';
import Service from './_home/07-Service.astro';
import Trust from './_home/08-Trust.astro';
import Reviews from './_home/09-Reviews.astro';
import Limits from './_home/10-Limits.astro';
import FAQ from './_home/11-FAQ.astro';
import FinalCTA from './_home/12-FinalCTA.astro';
import { SITE } from '../lib/constants';
import {
  organizationSchema,
  personSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../lib/seo';

const faqItems = [
  {
    q: 'Как начинается работа?',
    a: 'Работа начинается с первичного разбора без обязательств. Можно начать с сообщения или короткого звонка: я уточню задачу, бюджет, сроки и ограничения по военной ипотеке, а затем подскажу понятный следующий шаг.',
  },
  {
    q: 'Сколько стоит сопровождение?',
    a: 'В новостройках сопровождение обычно оплачивает застройщик. На первичном разборе я объясню, как устроена оплата в вашем случае и какие расходы могут быть отдельно.',
  },
  {
    q: 'Можно ли работать полностью удалённо?',
    a: 'Да, начать можно дистанционно. На первичном разборе мы уточним задачу, ограничения и формат сделки, а дальше станет понятно, какие этапы можно пройти удалённо и где нужно личное участие.',
  },
  {
    q: 'Что конкретно входит в сопровождение?',
    a: 'Сопровождение включает разбор задачи, формирование критериев, отбор подходящих новостроек, проверку вариантов, согласование банка и документов, координацию участников сделки и доведение до регистрации.',
  },
  {
    q: 'Чем это отличается от работы с агентством?',
    a: 'Работа строится не с просмотра случайных вариантов, а с задачи покупки. Сначала фиксируем цель, условия и ограничения, затем отбираем новостройки, которые действительно стоит рассматривать.',
  },
  {
    q: 'Что происходит после регистрации сделки?',
    a: 'После регистрации при необходимости можно обсудить приёмку, ремонт, комплектацию или сдачу квартиры через проверенных подрядчиков. Это зависит от вашей задачи и формата покупки.',
  },
];

const schemas = [
  organizationSchema,
  personSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
  },
  serviceSchema({
    name: 'Помощь с выбором новостройки по военной ипотеке',
    description:
      'Помощь военнослужащим с выбором новостройки под задачу, первичным разбором, банком, документами и сопровождением сделки до регистрации.',
    url: `${SITE.url}/`,
    areaServed: 'Россия',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Главная', url: `${SITE.url}/` }]),
];
---

<PageLayout
  title="Военная ипотека: выбор новостройки под вашу задачу"
  description="Помогаю военнослужащим выбрать новостройку по военной ипотеке под задачу: для жизни или вложения. Первый шаг — первичный разбор без обязательств."
  canonical={`${SITE.url}/`}
  ogImage={`${SITE.url}/og/home.jpg`}
  schema={schemas}
>
  <Hero />
  <ShortAnswer />
  <Problem />
  <Scenarios />
  <Method />
  <FirstStep />
  <Service />
  <Trust />
  <Reviews />
  <Limits />
  <FAQ items={faqItems} />
  <FinalCTA />
</PageLayout>
