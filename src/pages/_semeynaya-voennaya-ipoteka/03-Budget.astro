      grid-column: 1 / -1 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-sem-budget { padding: 72px 0; }
    .vn-sem-budget__card { padding: 24px; }
    .vn-sem-budget__cta { width: 100%; justify-content: center; }
  }
