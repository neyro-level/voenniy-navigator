    gap: 12px;
  }

  .vn-sem-budget__card li {
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .vn-sem-budget__card li strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    .vn-sem-budget__content {
      grid-column: 1 / -1 !important;
      position: static;
      margin-bottom: 40px;
    }
