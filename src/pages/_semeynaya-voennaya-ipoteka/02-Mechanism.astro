<!-- ══════════════════════════════════════════════
     БЛОК 02 — МЕХАНИЗМ СОВМЕЩЕНИЯ
════════════════════════════════════════════════ -->
<section id="section-sem-mechanism" class="vn-sem-mechanism">
  <div class="vn-container">
    <div class="vn-grid-12 vn-sem-mechanism__grid">
      
      <div class="vn-sem-mechanism__content" style="grid-column: 1 / 7">
        <span class="vn-label-mono">КАК ЭТО РАБОТАЕТ</span>
        <h2 class="vn-sem-mechanism__title">
          Механизм совмещения двух программ
        </h2>
        <p class="vn-sem-mechanism__lead">
          Военная ипотека покрывает базовый платеж за счет государства. 
          Семейная ипотека позволяет расширить бюджет покупки и зафиксировать 
          низкую ставку на всю сумму кредита или его часть.
        </p>
      </div>

      <div class="vn-sem-mechanism__steps" style="grid-column: 7 / 13">
        <div class="vn-sem-mechanism__step">
          <span class="vn-sem-mechanism__num">01</span>
          <div>
            <h3>Базовое одобрение</h3>
            <p>Банк одобряет кредит с учетом права на семейную ипотеку (до 6 млн ₽ под 6%).</p>
          </div>
        </div>
        <div class="vn-sem-mechanism__step">
          <span class="vn-sem-mechanism__num">02</span>
          <div>
            <h3>Погашение от государства</h3>
            <p>Ежемесячные платежи по кредиту покрываются за счет средств НИС (около 34 265 ₽/мес в 2026 г.).</p>
          </div>
        </div>
        <div class="vn-sem-mechanism__step">
          <span class="vn-sem-mechanism__num">03</span>
          <div>
            <h3>Увеличение бюджета</h3>
            <p>Если стоимости жилья не хватает, разницу можно покрыть собственными средствами или маткапиталом.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .vn-sem-mechanism {
    padding: 96px 0;
    background: var(--color-bg-surface);
  }

  .vn-sem-mechanism__grid {
    align-items: start;
  }

  .vn-sem-mechanism__content {
    position: sticky;
    top: 104px;
  }

  .vn-sem-mechanism__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 650;
    line-height: 1.18;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-sem-mechanism__lead {
    margin: 16px 0 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 480px;
  }

  .vn-sem-mechanism__steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .vn-sem-mechanism__step {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .vn-sem-mechanism__num {
    color: var(--color-accent-cta);
    font-size: var(--fs-caption);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }

  .vn-sem-mechanism__step h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
  }

  .vn-sem-mechanism__step p {
    margin: 8px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    line-height: 1.55;
  }

  @media (max-width: 1023px) {
    .vn-sem-mechanism__content {
      grid-column: 1 / -1 !important;
      position: static;
      margin-bottom: 40px;
    }
    .vn-sem-mechanism__steps {
      grid-column: 1 / -1 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-sem-mechanism { padding: 72px 0; }
    .vn-sem-mechanism__step {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 16px;
      padding: 20px 0;
    }
    .vn-sem-mechanism__step h3 { font-size: var(--fs-body); }
  }
</style>
