---
---

<section id="section-sem-hero" class="vn-sem-hero">
  <div class="vn-sem-hero__grid-bg" aria-hidden="true"></div>
  <div class="vn-sem-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12 vn-sem-hero__inner">
      <div class="vn-sem-hero__content">
        <p class="vn-label-mono">Военная ипотека / семейная / совмещение</p>

        <h1 class="vn-sem-hero__title">
          Семейная
          <span class="vn-sem-hero__title-accent">военная ипотека</span>
        </h1>

        <p class="vn-sem-hero__lead">
          Как совместить военную и семейную ипотеку: условия, сумма, документы и ограничения.
          Для военнослужащих с детьми — увеличение лимита и снижение ставки до 6%.
        </p>

        <div class="vn-sem-hero__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Узнать, подхожу ли я для совмещения"
            class="vn-btn-primary vn-sem-hero__primary"
          >
            Узнать, подхожу ли я
          </a>
          <a href="/kalkulyator-voennoy-ipoteki/" class="vn-btn-ghost vn-sem-hero__secondary">
            Калькулятор совмещения →
          </a>
        </div>

        <dl class="vn-sem-hero__proof" aria-label="Ориентировочные условия совмещения">
          <div class="vn-sem-hero__proof-item">
            <dt>Ставка</dt>
            <dd>от 6% (ориентир)</dd>
          </div>
          <div class="vn-sem-hero__proof-item">
            <dt>Лимит</dt>
            <dd>до 6 млн ₽</dd>
          </div>
          <div class="vn-sem-hero__proof-item">
            <dt>Кому</dt>
            <dd>Военнослужащим с детьми</dd>
          </div>
          <div class="vn-sem-hero__proof-item">
            <dt>Срок</dt>
            <dd>до 30 лет</dd>
          </div>
        </dl>
        <p class="vn-sem-hero__disclaimer">
          Ориентир. Точные условия зависят от выбранного банка и вашей ситуации. 
          <a href="/kalkulyator-voennoy-ipoteki/" class="vn-sem-hero__disclaimer-link">Рассчитать в калькуляторе →</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-sem-hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    padding-top: 160px;
    padding-bottom: 96px;
    background: var(--color-bg-primary);
  }

  .vn-sem-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid-light) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid-light) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }

  .vn-sem-hero__radial {
    position: absolute;
    top: -200px;
    right: -200px;
    width: 800px;
    height: 800px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-bg-surface) 60%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .vn-sem-hero__inner {
    position: relative;
    z-index: 1;
    align-items: start;
  }

  .vn-sem-hero__content {
    grid-column: 1 / 8;
    padding-top: 24px;
  }

  .vn-sem-hero__title {
    margin: 16px 0 24px;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-sem-hero__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-sem-hero__lead {
    margin: 0 0 36px;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    max-width: 640px;
  }

  .vn-sem-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 48px;
  }

  .vn-sem-hero__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .vn-sem-hero__primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .vn-sem-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: var(--fs-body);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    background: transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .vn-sem-hero__secondary:hover {
    border-color: var(--color-accent-cta);
    color: var(--color-accent-cta);
  }

  .vn-sem-hero__proof {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 520px;
  }

  .vn-sem-hero__proof-item {
    padding: 16px;
    border-left: 2px solid var(--color-accent-cta);
    background: color-mix(in srgb, var(--color-bg-surface) 50%, transparent);
  }

  .vn-sem-hero__proof-item dt {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: 4px;
  }

  .vn-sem-hero__proof-item dd {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-sem-hero__disclaimer {
    margin: 16px 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-tertiary);
    max-width: 520px;
  }

  .vn-sem-hero__disclaimer-link {
    color: var(--color-accent-cta);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .vn-sem-hero__disclaimer-link:hover {
    border-bottom-color: var(--color-accent-cta);
  }

  @media (max-width: 1023px) {
    .vn-sem-hero__content {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .vn-sem-hero {
      padding-top: 120px;
      padding-bottom: 64px;
    }

    .vn-sem-hero__title {
      font-size: 32px;
      line-height: 1.1;
    }

    .vn-sem-hero__lead {
      font-size: var(--fs-body);
    }

    .vn-sem-hero__actions {
      flex-direction: column;
    }

    .vn-sem-hero__primary,
    .vn-sem-hero__secondary {
      width: 100%;
    }

    .vn-sem-hero__proof {
      grid-template-columns: 1fr;
    }
  }
</style>
