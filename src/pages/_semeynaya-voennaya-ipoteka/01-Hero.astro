---
---

<section id="section-sem-hero" class="vn-sem-hero">
  <div class="vn-sem-hero__grid-bg" aria-hidden="true"></div>
  <div class="vn-sem-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12 vn-sem-hero__inner">
      <div class="vn-col-7 vn-sem-hero__content" data-reveal="fade-up">
        <p class="vn-label-mono">Семейная + военная ипотека / совмещение программ</p>

        <h1 class="vn-sem-hero__title">Семейная военная ипотека</h1>

        <p class="vn-sem-hero__lead">
          Для военнослужащих с детьми. Банк одобряет больший лимит, а государство продолжает покрывать базовый платёж по НИС.
        </p>

        <div class="vn-sem-hero__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Получить разбор ситуации"
            class="vn-btn-primary"
          >
            Получить разбор ситуации
          </a>
          <a href="/kalkulyator-voennoy-ipoteki/" class="vn-sem-hero__ghost-link">
            Или сначала рассчитать в калькуляторе →
          </a>
        </div>
      </div>

      <aside class="vn-col-5 vn-sem-hero__visual" data-reveal="fade-in">
        <div class="vn-sem-potential-card">
          <div class="vn-sem-potential-card__row">
            <span class="vn-sem-potential-card__label">Базовый лимит по НИС</span>
            <span class="vn-sem-potential-card__value">~2,1–2,3 млн ₽</span>
          </div>

          <div class="vn-sem-potential-card__divider"></div>

          <div class="vn-sem-potential-card__row">
            <span class="vn-sem-potential-card__label">Семейная программа</span>
            <span class="vn-sem-potential-card__value">до 6 млн ₽</span>
          </div>

          <div class="vn-sem-potential-card__row">
            <span class="vn-sem-potential-card__label">Ставка</span>
            <span class="vn-sem-potential-card__value vn-sem-potential-card__value--accent">от 6%</span>
            <span class="vn-sem-potential-card__sublabel">ориентир, зависит от банка</span>
          </div>

          <div class="vn-sem-potential-card__divider"></div>

          <div class="vn-sem-potential-card__row vn-sem-potential-card__row--accent">
            <span class="vn-sem-potential-card__label">Итоговый бюджет</span>
            <span class="vn-sem-potential-card__value">до 5–6 млн ₽</span>
            <span class="vn-sem-potential-card__sublabel">в сценариях с доплатой</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .vn-sem-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-primary);
    padding-top: 132px;
    padding-bottom: 96px;
  }

  .vn-sem-hero__grid-bg,
  .vn-sem-hero__radial {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vn-sem-hero__grid-bg {
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.6;
  }

  .vn-sem-hero__radial {
    inset: auto auto -200px 60%;
    width: 800px;
    height: 500px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-primary) 6%, transparent) 0%,
      transparent 70%
    );
    transform: translateX(-50%);
  }

  .vn-sem-hero__inner {
    align-items: center;
  }

  .vn-sem-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vn-sem-hero__title {
    margin: 16px 0 20px;
    max-width: 780px;
    font-size: var(--fs-display);
    line-height: 1.07;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-sem-hero__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-sem-hero__lead {
    max-width: 640px;
    margin: 0 0 32px;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-sem-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .vn-sem-hero__ghost-link {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text-tertiary) 40%, transparent);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .vn-sem-hero__ghost-link:hover {
    color: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
  }

  .vn-sem-hero__visual {
    align-self: stretch;
    justify-self: stretch;
    display: flex;
    align-items: center;
  }

  .vn-sem-potential-card {
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    padding: 14px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card-hover);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .vn-sem-potential-card__row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 20px;
    border: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface-lowest);
  }

  .vn-sem-potential-card__row:first-child,
  .vn-sem-potential-card__row--accent {
    grid-column: 1 / -1;
  }

  .vn-sem-potential-card__row--accent {
    background: color-mix(in srgb, var(--color-accent-cta) 7%, var(--color-bg-surface));
    border-color: color-mix(in srgb, var(--color-accent-cta) 20%, transparent);
  }

  .vn-sem-potential-card__row--accent .vn-sem-potential-card__value {
    color: var(--color-accent-cta);
  }

  .vn-sem-potential-card__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .vn-sem-potential-card__value {
    font-size: var(--fs-stat);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .vn-sem-potential-card__row:not(:first-child):not(.vn-sem-potential-card__row--accent) .vn-sem-potential-card__value {
    font-size: clamp(28px, 2.5vw, 38px);
    white-space: nowrap;
  }

  .vn-sem-potential-card__value--accent {
    color: var(--color-accent-cta);
  }

  .vn-sem-potential-card__sublabel {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    margin-top: 2px;
    line-height: 1.55;
  }

  .vn-sem-potential-card__divider {
    display: none;
  }

  @media (max-width: 1023px) {
    .vn-sem-hero {
      padding-top: 100px;
      padding-bottom: 64px;
    }

    .vn-sem-hero__visual {
      justify-self: stretch;
      width: 100%;
    }

    .vn-sem-potential-card {
      max-width: none;
      width: 100%;
      margin-left: 0;
      margin-top: 8px;
      padding: 12px;
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .vn-sem-hero {
      padding-top: 88px;
      padding-bottom: 48px;
    }

    .vn-sem-hero__grid-bg {
      background-size: 48px 48px;
    }

    .vn-sem-hero__radial {
      left: 50%;
      bottom: -240px;
      width: 600px;
      height: 400px;
    }

    .vn-sem-hero__title {
      margin: 12px 0 16px;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .vn-sem-hero__lead {
      margin-bottom: 24px;
      line-height: 1.55;
    }

    .vn-sem-hero__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .vn-sem-hero__actions .vn-btn-primary {
      width: 100%;
      justify-content: center;
    }

    .vn-sem-hero__ghost-link {
      text-align: center;
      align-self: center;
    }

    .vn-sem-potential-card {
      width: calc(100vw - 32px);
      max-width: none;
      margin-left: calc(50% - 50vw + 16px);
      padding: 12px;
      gap: 12px;
      border-radius: var(--radius-lg);
    }

    .vn-sem-potential-card__row {
      padding: 14px;
      gap: 5px;
    }

    .vn-sem-potential-card__value {
      font-size: clamp(24px, 7.4vw, 32px);
      line-height: 1.05;
    }

    .vn-sem-potential-card__row:not(:first-child):not(.vn-sem-potential-card__row--accent) .vn-sem-potential-card__value {
      font-size: clamp(22px, 6vw, 25px);
    }

    .vn-sem-potential-card__label {
      font-size: 10px;
      line-height: 1.35;
    }

    .vn-sem-potential-card__sublabel {
      font-size: 12px;
      line-height: 1.4;
    }
  }
</style>
