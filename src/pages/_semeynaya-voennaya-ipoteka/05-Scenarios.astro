---
import { Icon } from 'astro-icon/components';
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const scenarios = [
  {
    marker: '01',
    icon: 'users',
    title: 'Семья с ребёнком',
    text: 'Право на семейную ипотеку с рождения первого ребёнка. Увеличиваем бюджет на покупку без рыночной ставки.',
  },
  {
    marker: '02',
    icon: 'shield-check',
    title: 'Двое супругов-военных',
    text: 'Оба участника НИС могут совместить права и собрать больший бюджет на одну квартиру.',
  },
  {
    marker: '03',
    icon: 'file-text',
    title: 'Покупка с маткапиталом',
    text: 'Маткапитал идёт как доплата, а семейная программа фиксирует низкую ставку на всю сумму.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section
    id="section-sem-scenarios"
    class="vn-sem-scenarios"
    aria-labelledby="vn-sem-scenarios-title"
  >
    <div class="vn-container">
      <div class="vn-sem-scenarios__layout">
        <div class="vn-sem-scenarios__header">
          <span class="vn-label-mono">Живые сценарии</span>
          <h2 class="vn-sem-scenarios__title" id="vn-sem-scenarios-title">
            Три случая, когда совмещение решает задачу
          </h2>
        </div>

        <div class="vn-sem-scenarios__grid">
          {
            scenarios.map((scenario) => (
              <article class="vn-sem-scenarios__card">
                <div class="vn-sem-scenarios__card-top">
                  <span class="vn-sem-scenarios__card-icon" aria-hidden="true">
                    <Icon name={scenario.icon} size={24} />
                  </span>
                  <span class="vn-sem-scenarios__card-marker" aria-hidden="true">
                    {scenario.marker}
                  </span>
                </div>

                <div class="vn-sem-scenarios__card-accent" aria-hidden="true"></div>

                <h3 class="vn-sem-scenarios__card-title">{scenario.title}</h3>
                <p class="vn-sem-scenarios__text">{scenario.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-sem-scenarios {
    padding-block: var(--spacing-section);
    background: var(--color-bg-primary);
  }

  .vn-sem-scenarios__layout {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .vn-sem-scenarios__header {
    max-width: 720px;
  }

  .vn-sem-scenarios__header > .vn-label-mono {
    color: var(--color-text-tertiary);
  }

  .vn-sem-scenarios__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-title);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-sem-scenarios__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .vn-sem-scenarios__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .vn-sem-scenarios__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    box-shadow: 0 16px 40px color-mix(in srgb, var(--color-accent-primary) 6%, transparent);
  }

  .vn-sem-scenarios__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .vn-sem-scenarios__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--color-accent-cta);
    background: color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-primary));
  }

  .vn-sem-scenarios__card-marker {
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
    color: var(--color-text-primary);
    opacity: 0.05;
    font-variant-numeric: tabular-nums;
  }

  .vn-sem-scenarios__card-accent {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent-cta);
  }

  .vn-sem-scenarios__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-sem-scenarios__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .vn-sem-scenarios__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .vn-sem-scenarios__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-sem-scenarios__card {
      padding: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-sem-scenarios__card {
      transition: none;
    }

    .vn-sem-scenarios__card:hover {
      transform: none;
    }
  }
</style>
