---
import PageLayout from '../layouts/PageLayout.astro';
import FinalCTALight from '../components/sections/FinalCTALight.astro';
import Hero from './_semeynaya-voennaya-ipoteka/01-Hero.astro';
import Mechanism from './_semeynaya-voennaya-ipoteka/02-Mechanism.astro';
import Budget from './_semeynaya-voennaya-ipoteka/03-Budget.astro';
import Banks from './_semeynaya-voennaya-ipoteka/04-Banks.astro';
import FAQ from '../components/sections/FAQ.astro';
import { faqItems, pageMeta, schemas } from './_semeynaya-voennaya-ipoteka/pageData';
---

<PageLayout {...pageMeta} schema={schemas}>
  <Hero />
  <Mechanism />
  <Budget />
  <Banks />
  <FAQ
    items={faqItems}
    eyebrow="ЧАСТЫЕ ВОПРОСЫ"
    title="Ответы о совмещении программ"
    lead="Ключевые моменты, которые важно понять перед подачей заявки в банк."
    linkText="Не нашли ответ? Задайте вопрос при расчёте →"
    linkHref="/contacts/#request"
    linkModalTitle="Задать вопрос о семейной ипотеке"
  />
  <FinalCTALight />
</PageLayout>
