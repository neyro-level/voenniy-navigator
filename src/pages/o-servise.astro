---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './_o-servise/01-Hero.astro';
import ProofLayer from './_o-servise/02-ProofLayer.astro';
import Process from './_o-servise/03-Process.astro';
import RoleOfMikhail from './_o-servise/04-RoleOfMikhail.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTALight from '../components/sections/FinalCTALight.astro';
import { faqItems, pageMeta, schemas } from './_o-servise/pageData';
---

<PageLayout {...pageMeta} schema={schemas}>
  <Hero />
  <ProofLayer />
  <Process />
  <RoleOfMikhail />
  <FAQ
    items={faqItems}
    eyebrow="FAQ"
    title="Вопросы о сервисе и первом расчёте"
    lead="Здесь собраны ответы о сервисе, расчёте вариантов, регионах работы и моменте перехода к подбору объекта."
    linkText="Не нашли свой вопрос? Рассчитайте варианты на первом шаге →"
    linkHref="/contacts/#request"
    linkModalTitle="Рассчитать варианты"
  />
  <FinalCTALight />
</PageLayout>
