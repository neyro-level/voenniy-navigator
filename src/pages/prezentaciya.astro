  .vn-prez-section--gray {
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
  }

  .vn-prez-section--full {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .vn-prez-marker {
    position: absolute;
    top: 40px;
    left: 48px;
    font-size: 280px;
    font-weight: 700;
    color: var(--color-text-ondark);
    opacity: 0.03;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* Typography helpers */
  .vn-prez-h2 {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.15;
    text-wrap: balance;
  }

  .vn-prez-h2--ondark {
    color: var(--color-text-ondark);
  }

  .vn-prez-lead {
    margin: 20px 0 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-prez-body {
    margin: 16px 0 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-prez-body--ondark {
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-accent {
    margin: 24px 0 0;
    padding: 16px 20px;
    border-left: 3px solid var(--color-accent-cta);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.5;
    background: rgba(37, 99, 235, 0.05);
    border-radius: 0 8px 8px 0;
  }

  .vn-prez-section--dark .vn-prez-accent {
    color: var(--color-text-ondark);
    background: rgba(37, 99, 235, 0.1);
  }

  /* Cover */
  .vn-prez-cover__inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .vn-prez-cover__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--color-text-ondark);
    font-size: var(--fs-body-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  .vn-prez-cover__logo svg {
    color: var(--color-accent-cta);
  }

  .vn-prez-cover__route {
    margin-bottom: 32px;
  }

  .vn-prez-route__line {
    height: 1px;
    background: rgba(37, 99, 235, 0.3);
    max-width: 480px;
    margin: 0 auto;
  }

  .vn-prez-route__dots {
    display: flex;
    justify-content: space-between;
    max-width: 480px;
    margin: -4px auto 0;
  }

  .vn-prez-route__dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .vn-prez-route__dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid rgba(37, 99, 235, 0.4);
  }

  .vn-prez-route__dot--filled::before {
    background: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
  }

  .vn-prez-route__dot span {
    font-size: var(--fs-label);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-cover__title {
    margin: 16px 0 0;
    font-size: var(--fs-h1);
    font-weight: 600;
    color: var(--color-text-ondark);
    line-height: 1.1;
    text-wrap: balance;
  }

  .vn-prez-cover__sub {
    margin: 16px 0 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-ondark-mute);
    text-wrap: pretty;
  }

  /* Author badge */
  .ams-cover-author {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 36px auto 0;
    padding: 16px 20px;
    background: rgba(158, 7, 7, 0.06);
    border: 1px solid rgba(158, 7, 7, 0.2);
    border-radius: 12px;
    max-width: 380px;
    text-align: left;
  }

  .ams-cover-author__avatar {
    display: grid;
    flex: 0 0 56px;
    width: 56px;
    height: 56px;
    place-items: center;
    border-radius: 50%;
    border: 2px solid rgba(158, 7, 7, 0.4);
    background: linear-gradient(135deg, rgba(158, 7, 7, 0.18), rgba(158, 7, 7, 0.05));
    color: var(--color-text-ondark);
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
  }

  .ams-cover-name {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-text-ondark);
    margin: 0;
  }

  .ams-cover-role {
    font-size: var(--fs-label);
    color: var(--color-text-ondark-secondary);
    margin: 2px 0 0;
  }

  .ams-cover-link {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: var(--fs-label);
    color: var(--color-accent-cta);
    text-decoration: none;
  }

  .ams-badge-mini {
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    font-size: var(--fs-caption);
    font-weight: 600;
    padding: 3px 7px;
    border-radius: 5px;
  }

  /* Cards */
  .vn-prez-cards--3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .vn-prez-cards--2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .vn-prez-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--color-bg-surface);
    border-radius: 12px;
    padding: 20px 24px;
    border-left: 3px solid var(--color-accent-cta);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 200ms ease,
      transform 150ms ease;
  }

  .vn-prez-card:hover {
    box-shadow: 0 4px 16px rgba(15, 20, 25, 0.08);
    transform: translateY(-1px);
  }

  .vn-prez-card--dark {
    background: var(--color-bg-dark-elev);
    border-left-color: var(--color-accent-cta);
  }

  .vn-prez-card__num {
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-accent-cta);
  }

  .vn-prez-card__title {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .vn-prez-card__body {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .vn-prez-card__link {
    font-size: var(--fs-label);
    color: var(--color-accent-cta);
    margin-top: 4px;
  }

  .vn-prez-also {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .vn-prez-also li {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
  }

  /* Flow diagram */
  .vn-prez-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto;
    gap: 12px;
    align-items: center;
    margin-top: 32px;
    max-width: 800px;
  }

  .vn-prez-flow__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vn-prez-flow__item {
    padding: 10px 14px;
    background: rgba(241, 243, 245, 0.05);
    border: 1px solid rgba(241, 243, 245, 0.1);
    border-radius: 8px;
    font-size: var(--fs-body-sm);
    color: var(--color-text-ondark);
  }

  .vn-prez-flow__arrows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vn-prez-flow__arrow {
    padding: 10px 0;
    text-align: center;
    color: var(--color-accent-cta);
    font-size: var(--fs-body-sm);
    opacity: 0.6;
  }

  .vn-prez-flow__targets {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vn-prez-flow__target {
    padding: 10px 14px;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: 8px;
    font-size: var(--fs-label);
    color: var(--color-text-ondark-mute);
    font-family: monospace;
  }

  .vn-prez-flow__final {
    padding: 12px 16px;
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    border-radius: 8px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-align: center;
    white-space: nowrap;
  }

  /* SEO grid */
  .vn-prez-seo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .vn-prez-seo-item {
    background: var(--color-bg-surface);
    padding: 20px;
    border-radius: 10px;
  }

  .vn-prez-seo-item strong {
    display: block;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 6px;
  }

  .vn-prez-seo-item span {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .vn-prez-note {
    margin-top: 24px;
    padding: 16px 20px;
    background: var(--color-bg-surface);
    border-left: 3px solid var(--color-accent-cta);
    border-radius: 0 8px 8px 0;
    font-size: var(--fs-body-sm);
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Table */
  .vn-prez-table {
    margin-top: 24px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }

  .vn-prez-table__row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
  }

  .vn-prez-table__row:last-child {
    border-bottom: none;
  }

  .vn-prez-table__row--head {
    background: var(--color-bg-surface);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-prez-table__row span:first-child {
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .vn-prez-table__row span:last-child {
    color: var(--color-text-secondary);
  }

  .vn-prez-section--dark .vn-prez-table {
    border-color: var(--color-border-ondark);
  }

  .vn-prez-section--dark .vn-prez-table__row {
    border-color: var(--color-border-ondark);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-section--dark .vn-prez-table__row--head {
    background: var(--color-bg-dark-elev);
  }

  .vn-prez-section--dark .vn-prez-table__row span:first-child {
    color: var(--color-text-ondark);
  }

  .vn-prez-section--dark .vn-prez-table__row span:last-child {
    color: var(--color-text-ondark-mute);
  }

  /* Compare */
  .vn-prez-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 32px;
  }

  .vn-prez-compare__col {
    padding: 24px;
    border-radius: 12px;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
  }

  .vn-prez-compare__col h4 {
    margin: 0 0 4px;
    font-size: var(--fs-body-sm);
    font-weight: 600;
  }

  .vn-prez-compare__col p {
    margin: 0 0 4px;
  }

  .vn-prez-compare__col--red {
    background: rgba(226, 75, 74, 0.04);
    border: 1px solid rgba(226, 75, 74, 0.3);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-compare__col--red h4 {
    color: var(--color-accent-cta);
  }

  .vn-prez-compare__col--blue {
    background: color-mix(in srgb, var(--color-accent-cta) 6%, transparent);
    border: 1px solid
      color-mix(in srgb, var(--color-accent-cta) 30%, transparent);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-compare__col--blue h4 {
    color: var(--color-accent-cta);
  }

  .vn-prez-compare__label {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    margin-bottom: 12px !important;
    opacity: 0.8;
  }

  /* Checklist */
  .vn-prez-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vn-prez-checklist li {
    position: relative;
    padding-left: 22px;
    font-size: var(--fs-body-sm);
    line-height: 1.45;
  }

  .vn-prez-checklist li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-accent-cta);
    font-weight: 600;
  }

  .vn-prez-section--light .vn-prez-checklist li,
  .vn-prez-section--gray .vn-prez-checklist li {
    color: var(--color-text-secondary);
  }

  .vn-prez-section--dark .vn-prez-checklist li {
    color: var(--color-text-ondark-mute);
  }

  /* Price cards */
  .vn-prez-price-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .vn-prez-price-card {
    background: var(--color-bg-surface);
    padding: 20px;
    border-radius: 12px;
  }

  /* Warn */
  .vn-prez-warn {
    padding: 16px 20px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 10px;
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Package */
  .vn-prez-package {
    background: var(--color-bg-surface);
    border: 1.5px solid var(--color-border);
    border-radius: 14px;
    padding: 28px 32px;
  }

  .vn-prez-package__row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
  }

  .vn-prez-package__row--total {
    border-top: 1px solid var(--color-border);
    margin-top: 8px;
    padding-top: 12px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-prez-package__row span:last-child {
    font-weight: 600;
    color: var(--color-accent-cta);
  }

  /* Honest block */
  .vn-prez-honest {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .vn-prez-honest__col {
    padding: 20px;
    border-radius: 10px;
  }

  .vn-prez-honest__col p {
    margin: 0 0 4px;
    font-size: var(--fs-body-sm);
  }

  .vn-prez-honest__col--red {
    background: rgba(226, 75, 74, 0.04);
  }

  .vn-prez-honest__col--blue {
    background: rgba(37, 99, 235, 0.04);
  }

  /* Wireframe */
  .vn-prez-wireframe {
    margin-top: 24px;
    background: var(--color-bg-dark-elev);
    border: 1px solid var(--color-border-ondark);
    border-radius: 14px;
    padding: 24px;
  }

  .vn-prez-wireframe__header {
    text-align: center;
    margin-bottom: 16px;
  }

  .vn-prez-wireframe__header span {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-text-ondark);
  }

  .vn-prez-wireframe__filters {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 8px;
  }

  .vn-prez-wireframe__filters span {
    padding: 4px 10px;
    background: rgba(241, 243, 245, 0.08);
    border-radius: 6px;
    font-size: var(--fs-caption);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-wireframe__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .vn-prez-wireframe__card {
    background: rgba(241, 243, 245, 0.04);
    border-radius: 8px;
    padding: 12px;
    text-align: center;
  }

  .vn-prez-wireframe__img {
    aspect-ratio: 16 / 10;
    background: rgba(241, 243, 245, 0.06);
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .vn-prez-wireframe__card p {
    margin: 0 0 2px;
    font-size: var(--fs-label);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-wireframe__card span {
    font-size: var(--fs-caption);
    color: var(--color-accent-cta);
  }

  .vn-prez-wireframe__detail {
    background: rgba(241, 243, 245, 0.04);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vn-prez-wireframe__detail p {
    margin: 0;
    font-size: var(--fs-label);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-wireframe__checks {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vn-prez-wireframe__checks span {
    font-size: var(--fs-caption);
    color: var(--color-text-ondark-mute);
  }

  .vn-prez-wireframe__btn {
    margin-top: 8px;
    padding: 6px 12px;
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    border-radius: 6px;
    font-size: var(--fs-caption);
    font-weight: 500;
    text-align: center;
  }

  /* Features grid */
  .vn-prez-features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 24px;
  }

  .vn-prez-feature {
    background: var(--color-bg-surface);
    padding: 16px;
    border-radius: 10px;
  }

  .vn-prez-feature h4 {
    margin: 0 0 4px;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-prez-feature span {
    font-size: var(--fs-label);
    color: var(--color-text-secondary);
  }

  /* Guarantees */
  .vn-prez-guarantees {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .vn-prez-guarantee {
    background: rgba(241, 243, 245, 0.04);
    border: 1px solid rgba(241, 243, 245, 0.08);
    border-top: 3px solid rgba(241, 243, 245, 0.2);
    border-radius: 14px;
    padding: 24px;
  }

  /* Options */
  .vn-prez-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .vn-prez-option {
    background: rgba(241, 243, 245, 0.04);
    border: 1px solid rgba(241, 243, 245, 0.08);
    border-radius: 14px;
    padding: 28px;
  }

  .vn-prez-option--rec {
    background: rgba(37, 99, 235, 0.06);
    border: 1.5px solid rgba(37, 99, 235, 0.25);
    border-top: 3px solid var(--color-accent-cta);
  }

  /* Timeline */
  .vn-prez-timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 32px;
    position: relative;
  }

  .vn-prez-timeline::before {
    content: "";
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border-ondark);
  }

  .vn-prez-timeline__item {
    position: relative;
    padding-top: 32px;
  }

  .vn-prez-timeline__num {
    position: absolute;
    top: 0;
    left: 0;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-accent-cta);
    opacity: 0.5;
  }

  .vn-prez-timeline__status {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--color-accent-cta);
    margin-bottom: 8px;
    display: block;
  }

  .vn-prez-timeline__title {
    margin: 0 0 8px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-ondark);
  }

  .vn-prez-timeline__item ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vn-prez-timeline__item li {
    font-size: var(--fs-label);
    color: var(--color-text-ondark-mute);
    margin-bottom: 2px;
  }

  /* Rec card */
  .vn-prez-rec-card {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-accent-cta);
    border-radius: 16px;
    padding: 36px;
  }

  .vn-prez-rec-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .vn-prez-rec-row--total {
    background: rgba(37, 99, 235, 0.05);
    padding: 12px 16px;
    border-radius: 8px;
    border-bottom: none;
    margin-top: 8px;
  }

  /* Products table */
  .vn-prez-products-table {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }

