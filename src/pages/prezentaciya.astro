---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Военный навигатор — архитектура и стратегия роста"
  description="Презентация сайта для Михаила Хряпина."
  noindex={true}
>
  <script is:inline>
    (function () {
      var k = "vn_prez_auth",
        p = "2026";
      if (localStorage.getItem(k) !== p) {
        var i = window.prompt("Введите пароль:");
        if (i !== p) {
          window.location.href = "/";
        } else {
          localStorage.setItem(k, p);
        }
      }
    })();
  </script>

  <nav class="vn-prez-dots" aria-label="Навигация по разделам">
    <a
      href="#cover"
      class="vn-dot active"
      data-label="Обложка"
      aria-label="Обложка"></a>
    <a
      href="#built"
      class="vn-dot"
      data-label="Что построено"
      aria-label="Что построено"></a>
    <a
      href="#arch"
      class="vn-dot"
      data-label="Архитектура"
      aria-label="Архитектура"></a>
    <a
      href="#seo"
      class="vn-dot"
      data-label="SEO-система"
      aria-label="SEO-система"></a>
    <a
      href="#stack"
      class="vn-dot"
      data-label="Технология"
      aria-label="Технология"></a>
    <a
      href="#next"
      class="vn-dot"
      data-label="После запуска"
      aria-label="После запуска"></a>
    <a
      href="#robot"
      class="vn-dot"
      data-label="SEO-робот"
      aria-label="SEO-робот"></a>
    <a
      href="#pages"
      class="vn-dot"
      data-label="SEO-страницы"
      aria-label="SEO-страницы"></a>
    <a
      href="#direct"
      class="vn-dot"
      data-label="Яндекс Директ"
      aria-label="Яндекс Директ"></a>
    <a
      href="#catalog"
      class="vn-dot"
      data-label="Каталог ЖК"
      aria-label="Каталог ЖК"></a>
    <a
      href="#support"
      class="vn-dot"
      data-label="Поддержка"
      aria-label="Поддержка"></a>
    <a
      href="#transfer"
      class="vn-dot"
      data-label="Размещение"
      aria-label="Размещение"></a>
    <a
      href="#choice"
      class="vn-dot"
      data-label="Первый шаг"
      aria-label="Первый шаг"></a>
  </nav>

  <main class="vn-prez">
    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 01 — Обложка
    ═══════════════════════════════════════════════ -->
    <section
      id="cover"
      class="vn-prez-section vn-prez-section--dark vn-prez-section--full"
    >
      <div class="vn-prez-marker" aria-hidden="true">01</div>
      <div class="vn-container vn-prez-cover__inner">
        <div class="vn-prez-cover__logo">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          <span>ВОЕННЫЙ НАВИГАТОР</span>
        </div>

        <div class="vn-prez-cover__route" aria-hidden="true">
          <div class="vn-prez-route__line"></div>
          <div class="vn-prez-route__dots">
            <div class="vn-prez-route__dot vn-prez-route__dot--filled">
              <span>Стратегия</span>
            </div>
            <div class="vn-prez-route__dot vn-prez-route__dot--filled">
              <span>Архитектура</span>
            </div>
            <div class="vn-prez-route__dot vn-prez-route__dot--filled">
              <span>Сайт</span>
            </div>
            <div class="vn-prez-route__dot"><span>SEO</span></div>
            <div class="vn-prez-route__dot"><span>Рост</span></div>
          </div>
        </div>

        <span class="vn-label-mono" style="color: var(--color-accent-cta)"
          >ПРЕЗЕНТАЦИЯ ПРОЕКТА</span
        >
        <h1 class="vn-prez-cover__title">
          Военный навигатор:<br />
          архитектура сайта<br />
          и стратегия роста
        </h1>
        <p class="vn-prez-cover__sub">
          Сайт собран как коммерческая система:<br />
          страницы, SEO, доверие, задачи клиента<br />
          и точки роста после запуска.
        </p>

        <div class="ams-cover-author">
          <div class="ams-cover-author__avatar" aria-hidden="true">АЧ</div>
          <div>
            <p class="ams-cover-name">Андрей Чирков</p>
            <p class="ams-cover-role">Архитектор маркетинговых систем</p>
            <a
              href="https://chirkovandrey.ru"
              target="_blank"
              rel="noopener noreferrer"
              class="ams-cover-link"
            >
              <span class="ams-badge-mini">АМС</span>
              chirkovandrey.ru ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 02 — Что построено
    ═══════════════════════════════════════════════ -->
    <section id="built" class="vn-prez-section vn-prez-section--light">
      <div class="vn-container">
        <span class="vn-label-mono">РЕЗУЛЬТАТ ПРОЕКТА</span>
        <h2 class="vn-prez-h2">Что уже собрано</h2>
        <p class="vn-prez-lead">
          Это не набор страниц. Это сайт с понятной архитектурой:<br />
          каждая страница отвечает за отдельный вариант клиента<br />
          и ведёт к расчёту покупки.
        </p>

        <div class="vn-prez-cards--3">
          <a href="/" target="_blank" class="vn-prez-card">
            <span class="vn-prez-card__num">01</span>
            <span class="vn-prez-card__title">Главная</span>
            <span class="vn-prez-card__body"
              >Объясняет позицию Михаила и первый шаг</span
            >
            <span class="vn-prez-card__link">Открыть ↗</span>
          </a>
          <a
            href="/voennaya-ipoteka-krasnodar/"
            target="_blank"
            class="vn-prez-card"
          >
            <span class="vn-prez-card__num">02</span>
            <span class="vn-prez-card__title">Краснодар</span>
            <span class="vn-prez-card__body"
              >Закрывает объектный спрос по ЖК и военной ипотеке</span
            >
            <span class="vn-prez-card__link">Открыть ↗</span>
          </a>
          <a
            href="/voennaya-ipoteka-krym/"
            target="_blank"
            class="vn-prez-card"
          >
            <span class="vn-prez-card__num">03</span>
            <span class="vn-prez-card__title">Крым</span>
            <span class="vn-prez-card__body"
              >Открывает новый региональный SEO-кластер</span
            >
            <span class="vn-prez-card__link">Открыть ↗</span>
          </a>
          <a
            href="/usloviya-voennoy-ipoteki/"
            target="_blank"
            class="vn-prez-card"
          >
            <span class="vn-prez-card__num">04</span>
            <span class="vn-prez-card__title">Условия военной ипотеки</span>
            <span class="vn-prez-card__body"
              >Информационная страница — объясняет условия, ставки, банки</span
            >
            <span class="vn-prez-card__link">Открыть ↗</span>
          </a>
          <a href="/contacts/" target="_blank" class="vn-prez-card">
            <span class="vn-prez-card__num">05</span>
            <span class="vn-prez-card__title">Контакты</span>
            <span class="vn-prez-card__body"
              >Подтверждает реальность офисов, способы связи</span
            >
            <span class="vn-prez-card__link">Открыть ↗</span>
          </a>
        </div>

        <ul class="vn-prez-also">
          <li>Воронка подбора (/podbor/ → заявка → /bonus/)</li>
          <li>Попап-форма с интеграцией Telegram</li>
          <li>Страница 404 с анимацией</li>
          <li>Страница «Спасибо» с лид-магнитом</li>
          <li>Юридические страницы (Политика, Cookie) по 152-ФЗ</li>
        </ul>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 03 — Архитектура
    ═══════════════════════════════════════════════ -->
    <section id="arch" class="vn-prez-section vn-prez-section--dark">
      <div class="vn-container">
        <span class="vn-label-mono" style="color: var(--color-accent-cta)"
          >СТРАТЕГИЧЕСКАЯ ЛОГИКА</span
        >
        <h2 class="vn-prez-h2 vn-prez-h2--ondark">
          Почему у сайта<br />именно такая архитектура
        </h2>
        <p class="vn-prez-body vn-prez-body--ondark">
          Клиент по военной ипотеке приходит не одним путём.<br />
          Кто-то ищет новостройку в Краснодаре.<br />
          Кто-то боится покупать дистанционно.<br />
          Кто-то хочет понять этапы сделки.<br />
          Кто-то интересуется Крымом.
        </p>
        <p class="vn-prez-body vn-prez-body--ondark" style="margin-top: 12px">
          Сайт собран как несколько входов в одну систему.
        </p>

        <div class="vn-prez-flow" aria-hidden="true">
          <div class="vn-prez-flow__col">
            <div class="vn-prez-flow__item">Ищет новостройку</div>
            <div class="vn-prez-flow__item">Боится купить удалённо</div>
            <div class="vn-prez-flow__item">Не понимает порядок</div>
            <div class="vn-prez-flow__item">Интересует Крым</div>
          </div>
          <div class="vn-prez-flow__arrows">
            <div class="vn-prez-flow__arrow">→</div>
            <div class="vn-prez-flow__arrow">→</div>
            <div class="vn-prez-flow__arrow">→</div>
          </div>
          <div class="vn-prez-flow__targets">
            <div class="vn-prez-flow__target">/voennaya-ipoteka-krasnodar/</div>
            <div class="vn-prez-flow__target">/usloviya-voennoy-ipoteki/</div>
            <div class="vn-prez-flow__target">/voennaya-ipoteka-krym/</div>
          </div>
          <div class="vn-prez-flow__final">→ Рассчитать варианты</div>
        </div>

        <blockquote class="vn-prez-accent">
          Все страницы ведут к одному действию:<br />
          расчёт цели покупки с Михаилом.
        </blockquote>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 04 — SEO-система
    ═══════════════════════════════════════════════ -->
    <section id="seo" class="vn-prez-section vn-prez-section--gray">
      <div class="vn-container">
        <span class="vn-label-mono">SEO-СТРУКТУРА</span>
        <h2 class="vn-prez-h2">
          Сайт подготовлен<br />
          не только для людей,<br />
          но и для Яндекса
        </h2>
        <p class="vn-prez-lead">
          На каждой ключевой странице заложены элементы,<br />
          которые помогают поисковикам понять тему.<br />
          Это не надстройка над сайтом — это основа,<br />
          с которой он построен.
        </p>

        <div class="vn-prez-seo-grid">
          <div class="vn-prez-seo-item">
            <strong>Короткий ответ</strong>
            <span
              >Помогает Яндексу и Алисе быстро понять суть страницы и
              процитировать её в ответах</span
            >
          </div>
          <div class="vn-prez-seo-item">
            <strong>FAQ на каждой странице</strong>
            <span>Закрывает вопросные запросы — люди приходят за ответами</span>
          </div>
          <div class="vn-prez-seo-item">
            <strong>JSON-LD схемы</strong>
            <span
              >Дают поисковикам структурированное «описание» страницы в
              машиночитаемом формате</span
            >
          </div>
          <div class="vn-prez-seo-item">
            <strong>Внутренняя перелинковка</strong>
            <span
              >Связывает страницы в единую систему — роботы понимают что важно</span
            >
          </div>
          <div class="vn-prez-seo-item">
            <strong>Офисы и NAP-данные</strong>
            <span
              >Подтверждают реальность бизнеса — усиливают локальное доверие
              Яндекса</span
            >
          </div>
          <div class="vn-prez-seo-item">
            <strong>Блок «кому не подходит»</strong>
            <span>Честность = доверие AI-ассистентов и Алисы</span>
          </div>
        </div>

        <div class="vn-prez-note">
          SEO-структура не гарантирует быстрый топ.<br />
          Она создаёт правильную основу для роста в поиске —<br />
          и это именно то, с чего начинается долгосрочный результат.
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 05 — Технология
    ═══════════════════════════════════════════════ -->
    <section id="stack" class="vn-prez-section vn-prez-section--dark">
      <div class="vn-container">
        <span class="vn-label-mono" style="color: var(--color-accent-cta)"
          >ТЕХНОЛОГИЧЕСКИЙ ФУНДАМЕНТ</span
        >
        <h2 class="vn-prez-h2 vn-prez-h2--ondark">
          Платформа без ограничений.<br />Не на годы — навсегда.
        </h2>
        <p
          class="vn-prez-body vn-prez-body--ondark"
          style="font-size: var(--fs-h3); font-weight: 600; max-width: 600px;"
        >
          Когда на сайте будет 30–50 SEO-страниц, охватывающих все запросы по
          военной ипотеке в Краснодаре и Крыму — зачем куда-то переходить? Это и
          есть актив. Он только растёт.
        </p>

        <div class="vn-prez-table">
          <div class="vn-prez-table__row vn-prez-table__row--head">
            <span>Преимущество</span>
            <span>Что это значит для Михаила</span>
          </div>
          <div class="vn-prez-table__row">
            <span>Быстрая загрузка</span>
            <span>Сайт удобно открывать с телефона и легче продвигать</span>
          </div>
          <div class="vn-prez-table__row">
            <span>Поисковики видят текст</span>
            <span
              >Страницы сразу попадают в индекс — не нужно ждать пока JS
              отработает</span
            >
          </div>
          <div class="vn-prez-table__row">
            <span>Масштабирование без предела</span>
            <span
              >Добавить 15 новых SEO-страниц = добавить 15 файлов. Без смены
              платформы</span
            >
          </div>
          <div class="vn-prez-table__row">
            <span>Гибкость дизайна</span>
            <span>Сайт не ограничен шаблонами — можно сделать что угодно</span>
          </div>
          <div class="vn-prez-table__row">
            <span>Надёжный деплой</span>
            <span
              >Сайт на Vercel — быстрый CDN, автоматический SSL, 99.9%
              доступность</span
            >
          </div>
        </div>

        <div class="vn-prez-compare">
          <div class="vn-prez-compare__col vn-prez-compare__col--red">
            <h4>ЯНДЕКС.ДИРЕКТ</h4>
            <p class="vn-prez-compare__label">= Аренда</p>
            <p>Вложил 100 000 ₽</p>
            <p>Месяц прошёл →</p>
            <p>Деньги потрачены.</p>
            <p>Трафик остановился.</p>
            <p>Ничего не осталось.</p>
            <p style="margin-top: 12px">
              Пополнишь бюджет — снова получишь заявки. Не пополнишь — ничего
              нет.
            </p>
          </div>
          <div class="vn-prez-compare__col vn-prez-compare__col--blue">
            <h4>SEO-САЙТ</h4>
            <p class="vn-prez-compare__label">= Собственность</p>
            <p>Вложил 100 000 ₽</p>
            <p>Месяц прошёл →</p>
            <p>Страницы остались.</p>
            <p>Работают через год.</p>
            <p>Работают через пять лет.</p>
            <p style="margin-top: 12px">
              SEO-страница — это актив, а не расход.
            </p>
          </div>
        </div>

        <p
          class="vn-prez-body vn-prez-body--ondark"
          style="text-align: center; margin-top: 32px;"
        >
          Сайт собран так, чтобы его можно было развивать бесконечно:<br />
          добавлять страницы по Крыму, районам, ЖК, вопросам НИС<br />
          и любым новым сценариям покупки.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 06 — После запуска
    ═══════════════════════════════════════════════ -->
    <section id="next" class="vn-prez-section vn-prez-section--gray">
      <div class="vn-container">
        <span class="vn-label-mono">ПЛАН ПОСЛЕ ЗАПУСКА</span>
        <h2 class="vn-prez-h2">Сайт готов.<br />Что делать дальше?</h2>
        <p class="vn-prez-lead">
          Сайт после запуска — это фундамент, который нужно усиливать.<br />
          Это нормально: ни один сильный сайт не стал таким за один день.
        </p>

        <div class="vn-prez-cards--2">
          <div class="vn-prez-card vn-prez-card--dark">
            <span class="vn-prez-card__num">01</span>
            <span class="vn-prez-card__title">SEO-СОПРОВОЖДЕНИЕ</span>
            <span class="vn-prez-card__body"
              >Регулярная работа с сайтом после запуска. Чтобы он не стоял на
              месте.</span
            >
          </div>
          <div class="vn-prez-card vn-prez-card--dark">
            <span class="vn-prez-card__num">02</span>
            <span class="vn-prez-card__title">НОВЫЕ SEO-СТРАНИЦЫ</span>
            <span class="vn-prez-card__body"
              >Новые точки входа из Яндекса. Каждая страница — отдельный запрос.</span
            >
          </div>
          <div class="vn-prez-card vn-prez-card--dark">
            <span class="vn-prez-card__num">03</span>
            <span class="vn-prez-card__title">КАТАЛОГ ЖК</span>
            <span class="vn-prez-card__body"
              >Переход к объектной платформе: карточки ЖК, фильтры, SEO под
              названия.</span
            >
          </div>
          <div class="vn-prez-card vn-prez-card--dark">
            <span class="vn-prez-card__num">04</span>
            <span class="vn-prez-card__title">ПОДДЕРЖКА</span>
            <span class="vn-prez-card__body"
              >Технические правки, обновление контента, добавление блоков.</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         РАЗДЕЛ 07 — SEO-робот
    ═══════════════════════════════════════════════ -->
    <section id="robot" class="vn-prez-section vn-prez-section--dark">
      <div class="vn-container">
        <div class="vn-grid-12">
          <div style="grid-column: 1 / 6">
            <span class="vn-label-mono" style="color: var(--color-accent-cta)"
              >ПРОДУКТ 01</span
            >
            <h2 class="vn-prez-h2 vn-prez-h2--ondark" style="margin-top: 12px">
              SEO-робот<br />сопровождения
            </h2>
            <span
              class="vn-prez-badge"
              style="background: color-mix(in srgb, var(--color-accent-cta) 15%, transparent); color: var(--color-accent-cta); margin-top: 12px; display: inline-block;"
              >Рекомендуемый первый шаг</span
            >
            <div class="vn-prez-price" style="margin-top: 24px">
              <p
                style="font-size: var(--fs-h3); font-weight: 600; color: var(--color-text-ondark); margin: 0"
              >
                16 000 ₽ <span
                  style="font-size: var(--fs-body-sm); font-weight: 400; color: var(--color-text-ondark-mute)"
                  >/ месяц</span
                >
              </p>
              <p
                style="font-size: var(--fs-body); color: var(--color-text-ondark); margin: 8px 0 0; font-weight: 500"
              >
                40 000 ₽ <span
                  style="font-size: var(--fs-body-sm); font-weight: 400; color: var(--color-text-ondark-mute)"
                  >/ 3 месяца</span
                >
              </p>
              <span
                class="vn-prez-badge"
