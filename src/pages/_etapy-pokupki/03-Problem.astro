---
const problems = [
  {
    num: '01',
    title: 'Сначала выбрали ЖК, потом поняли, что он не подходит',
    body: 'Объект может не совпасть со сценарием, сроками, условиями банка или документами.',
  },
  {
    num: '02',
    title: 'Посмотрели сумму, но не поняли задачу',
    body: 'Доступная сумма задаёт рамку, но не отвечает, какую квартиру стоит покупать.',
  },
  {
    num: '03',
    title: 'Решили, что все сделки проходят одинаково',
    body: 'Покупка для жизни, переезд позже и дистанционная сделка требуют разного маршрута.',
  },
  {
    num: '04',
    title: 'Не распределили зоны ответственности',
    body: 'Клиент, банк, застройщик и специалист участвуют в разных частях процесса.',
  },
];
---

<section id="section-etap-problem" class="vn-section vn-section--dark vn-etap-problem" aria-labelledby="vn-etap-problem-title">
  <div class="vn-container">
    <div class="vn-grid-12">
      <div class="vn-etap-problem__head" style="grid-column: 1 / 7">
        <span class="vn-label-mono vn-etap-problem__eyebrow">ПРОБЛЕМА / 03</span>
        <h2 class="vn-etap-problem__title" id="vn-etap-problem-title">
          Почему покупку по военной ипотеке нельзя начинать
          <span>с&nbsp;случайного шага</span>
        </h2>
      </div>

      <div class="vn-etap-problem__intro" style="grid-column: 7 / 13">
        <p>
          Военная ипотека связывает между собой задачу клиента, объект, банк,
          документы и сроки. Если начать только с банка, только с ЖК или только
          с калькулятора — можно быстро упереться в ограничения, которые не были
          учтены заранее.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Разобрать мой маршрут"
          class="vn-etap-problem__link"
        >
          Разобрать мой маршрут →
        </a>
      </div>

      <div class="vn-etap-problem__list vn-grid-12" style="grid-column: 1 / 13">
        {problems.map((problem, index) => (
          <article class="vn-etap-problem__item" style={`grid-column: ${index % 2 === 0 ? '1 / 7' : '7 / 13'}`}>
            <span class="vn-etap-problem__num">{problem.num}</span>
            <h3>{problem.title}</h3>
            <p>{problem.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .vn-etap-problem {
    padding: 96px 0 88px;
  }

  .vn-etap-problem__eyebrow {
    color: var(--color-text-ondark);
    opacity: 0.5;
  }

  .vn-etap-problem__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    line-height: 1.18;
    font-weight: 600;
    color: var(--color-text-ondark);
    text-wrap: balance;
  }

  .vn-etap-problem__title span {
    color: var(--color-accent-cta);
  }

  .vn-etap-problem__intro {
    display: grid;
    align-content: end;
    gap: 20px;
  }

  .vn-etap-problem__intro p {
    max-width: 520px;
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--color-text-ondark);
    opacity: 0.58;
    text-wrap: pretty;
  }

  .vn-etap-problem__link {
    width: fit-content;
    color: var(--color-text-ondark);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .vn-etap-problem__link:hover {
    border-bottom-color: var(--color-accent-cta);
    color: var(--color-accent-cta);
  }

  .vn-etap-problem__list {
    margin-top: 56px;
  }

  .vn-etap-problem__item {
    padding: 28px 32px 28px 0;
    border-top: 1px solid var(--color-border-ondark);
  }

  .vn-etap-problem__item:nth-child(even) {
    padding-left: 32px;
    padding-right: 0;
    border-left: 1px solid var(--color-border-ondark);
  }

  .vn-etap-problem__num {
    display: block;
    margin-bottom: 16px;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-accent-cta);
    font-variant-numeric: tabular-nums;
  }

  .vn-etap-problem__item h3 {
    margin: 0 0 10px;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-text-ondark);
    text-wrap: balance;
  }

  .vn-etap-problem__item p {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-ondark);
    opacity: 0.54;
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .vn-etap-problem__head,
    .vn-etap-problem__intro,
    .vn-etap-problem__list {
      grid-column: 1 / -1 !important;
    }

    .vn-etap-problem__intro {
      margin-top: 20px;
    }

    .vn-etap-problem__item {
      grid-column: 1 / -1 !important;
      padding: 24px 0;
      border-left: none !important;
    }
  }

  @media (max-width: 640px) {
    .vn-etap-problem {
      padding: 72px 0 64px;
    }

    .vn-etap-problem__list {
      margin-top: 36px;
    }
  }
</style>
