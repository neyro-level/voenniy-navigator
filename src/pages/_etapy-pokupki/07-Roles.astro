---
const roles = [
  ['Клиент', 'Предоставить документы · Подтвердить данные · Принимать решения по объекту и условиям'],
  ['Михаил', 'Сопровождать маршрут · Координировать стороны · Объяснять последовательность · Показывать слабые места'],
  ['Банк', 'Проверять условия · Проверять объект · Документы · Порядок ипотечной части'],
  ['Застройщик', 'Предоставлять документы объекта · Согласовывать условия · Вести свою часть сделки'],
  ['Партнёры', 'Доверенность · Юрпроверка · Приёмка · Ремонт · Аренда — по отдельной договорённости'],
];

const checks = [
  'Условия банка',
  'Документы клиента',
  'Документы объекта',
  'Аккредитация объекта',
  'Согласования сторон',
  'Формат подписания',
  'Регистрация',
];
---

<section id="section-etap-roles" class="vn-section vn-section--secondary vn-etap-roles" aria-labelledby="vn-etap-roles-title">
  <div class="vn-container">
    <div class="vn-grid-12">
      <div class="vn-etap-roles__head" style="grid-column: 1 / 8">
        <span class="vn-label-mono">ЗОНЫ ОТВЕТСТВЕННОСТИ / 06</span>
        <h2 id="vn-etap-roles-title">Кто за что отвечает: банк, документы и сделка</h2>
        <p>
          После выбора объекта начинается координация сделки. В ней участвуют
          несколько сторон: клиент, специалист, банк, застройщик, иногда
          юристы и партнёры. Ошибки возникают, когда непонятно, кто должен
          подготовить документ, согласовать этап или проверить условие.
        </p>
      </div>

      <div class="vn-etap-roles__lanes" style="grid-column: 1 / 13">
        {roles.map(([role, body]) => (
          <article class:list={['vn-etap-roles__card', role === 'Михаил' && 'vn-etap-roles__card--main']}>
            <span class="vn-etap-roles__icon" aria-hidden="true"></span>
            <h3>{role}</h3>
            <ul>
              {body.split(' · ').map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="vn-etap-roles__check" style="grid-column: 2 / 12">
        <span class="vn-label-mono">ЧТО ОБЫЧНО ПРОВЕРЯЕТСЯ НА ЭТАПЕ СДЕЛКИ</span>
        <div class="vn-etap-roles__check-grid">
          {checks.map((item) => (
            <div class="vn-etap-roles__check-item">
              <span aria-hidden="true">✓</span>
              <strong>{item}</strong>
            </div>
          ))}
        </div>
        <p>
          Банковские условия и требования могут меняться.
          Конкретные сроки и условия уточняются под каждую сделку.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-etap-roles__head {
    margin-bottom: 48px;
  }

  .vn-etap-roles__head h2 {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    line-height: 1.18;
    font-weight: 600;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-etap-roles__head p {
    max-width: 660px;
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-etap-roles__lanes {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .vn-etap-roles__card {
    padding: 24px 20px;
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-card);
  }

  .vn-etap-roles__card--main {
    outline: 1px solid var(--color-accent-cta);
    outline-offset: -1px;
  }

  .vn-etap-roles__icon {
    display: block;
    width: 28px;
    height: 2px;
    margin-bottom: 18px;
    background: var(--color-accent-cta);
    border-radius: 2px;
  }

  .vn-etap-roles__card h3 {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-etap-roles__card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vn-etap-roles__card li {
    padding: 9px 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
    line-height: 1.45;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-etap-roles__check {
    margin-top: 56px;
    padding: 32px 36px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-card);
  }

  .vn-etap-roles__check-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 36px;
    margin-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .vn-etap-roles__check-item {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .vn-etap-roles__check-item span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--color-accent-cta-soft);
    color: var(--color-accent-cta);
    font-size: 12px;
    font-weight: 600;
  }

  .vn-etap-roles__check-item strong {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .vn-etap-roles__check p {
    margin: 18px 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  @media (max-width: 1023px) {
    .vn-etap-roles__head,
    .vn-etap-roles__lanes,
    .vn-etap-roles__check {
      grid-column: 1 / -1 !important;
    }

    .vn-etap-roles__lanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .vn-etap-roles__lanes {
      grid-template-columns: 1fr;
    }

    .vn-etap-roles__check {
      padding: 28px 24px;
    }

    .vn-etap-roles__check-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
