            />

            <rect
              x="330"
              y="300"
              width="120"
              height="50"
              rx="14"
              fill="var(--color-bg-dark)"
              stroke="var(--color-border-ondark)"
              stroke-width="1"
              class="vn-krd-hero__animate-float-reverse"
              style="filter: drop-shadow(0 12px 24px rgba(0,0,0,0.5));"
            />
            <circle cx="358" cy="325" r="9" fill="var(--color-accent-cta)" />
            <path
              d="M354 325 L357 328 L362 322"
              stroke="var(--color-bg-dark)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <rect
              x="375"
              y="318"
              width="58"
              height="8"
              rx="4"
              fill="var(--color-text-ondark-mute)"
              opacity="0.7"
            />
            <rect
              x="375"
              y="332"
              width="42"
              height="6"
              rx="3"
              fill="var(--color-accent-cta)"
              opacity="0.8"
            />

            <defs>
              <radialGradient
                id="krd-glow"
                cx="0"
                cy="0"
                r="1"
                gradientUnits="userSpaceOnUse"
                gradientTransform="translate(250 190) rotate(90) scale(170)"
              >
                <stop stop-color="var(--color-accent-cta)" />
                <stop offset="1" stop-color="var(--color-accent-cta)" stop-opacity="0" />
              </radialGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-krd-hero {
    position: relative;
    overflow: hidden;
    min-height: 88svh;
    padding-top: 144px;
    padding-bottom: 72px;
    background: var(--color-bg-primary);
  }

  .vn-krd-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    z-index: 0;
  }

  .vn-krd-hero__radial {
    position: absolute;
    top: -180px;
    left: -180px;
    width: 800px;
    height: 800px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-bg-surface) 55%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .vn-krd-hero .vn-container,
  .vn-krd-hero .vn-grid-12 {
    position: relative;
    z-index: 1;
  }

  .vn-krd-hero__layout {
    align-items: center;
  }

  .vn-krd-hero__content {
    grid-column: 1 / 8;
    align-self: center;
    min-width: 0;
  }

  .vn-krd-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vn-krd-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-krd-hero__title {
    max-width: 720px;
    margin: 28px 0 0;
    color: var(--color-text-primary);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .vn-krd-hero__lead {
    max-width: 580px;
    margin: 28px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .vn-krd-hero__note {
    max-width: 580px;
    margin: 18px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .vn-krd-hero__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 36px;
  }

  .vn-krd-hero__primary,
  .vn-krd-hero__secondary {
    min-height: 54px;
    padding: 15px 26px;
    font-size: var(--fs-body);
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .vn-krd-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .vn-krd-hero__tag {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-surface) 60%, transparent);
    color: var(--color-text-secondary);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.3;
  }

  .vn-krd-hero__visual {
    grid-column: 8 / 13;
    align-self: center;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }

  .vn-krd-hero__visual-card {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 500 / 380;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
  }

  .vn-krd-hero__ui-mockup {
    width: 100%;
    height: 100%;
  }

  @keyframes krd-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes krd-float-slow {
    0%, 100% { transform: translateY(0) translateX(-8px); }
    50% { transform: translateY(-7px) translateX(-8px); }
  }

  @keyframes krd-float-reverse {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(7px); }
  }

  @keyframes krd-pulse-glow {
    0%, 100% { opacity: 0.12; transform: scale(1); }
    50% { opacity: 0.2; transform: scale(1.04); }
  }

  .vn-krd-hero__animate-float {
    animation: krd-float 6s ease-in-out infinite;
  }

  .vn-krd-hero__animate-float-slow {
    animation: krd-float-slow 8s ease-in-out infinite;
  }

  .vn-krd-hero__animate-float-reverse {
    animation: krd-float-reverse 7s ease-in-out infinite;
  }

  .vn-krd-hero__animate-pulse-glow {
    animation: krd-pulse-glow 4s ease-in-out infinite;
    transform-origin: center;
  }

  @media (max-width: 1023px) {
    .vn-krd-hero {
      min-height: auto;
      padding-top: 108px;
      padding-bottom: 56px;
    }

    .vn-krd-hero__content,
    .vn-krd-hero__visual {
      grid-column: 1 / -1;
    }

    .vn-krd-hero__visual {
      justify-content: center;
      margin-top: 56px;
    }

    .vn-krd-hero__visual-card {
      max-width: 460px;
    }
  }

  @media (max-width: 640px) {
    .vn-krd-hero {
      padding-top: 88px;
      padding-bottom: 48px;
    }

    .vn-krd-hero__title {
      margin-top: 20px;
      font-size: var(--fs-h1);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .vn-krd-hero__lead {
      margin-top: 20px;
      font-size: var(--fs-body-lg);
      line-height: 1.55;
    }

    .vn-krd-hero__note {
      margin-top: 14px;
      font-size: var(--fs-body);
      line-height: 1.5;
    }

    .vn-krd-hero__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      margin-top: 28px;
    }

    .vn-krd-hero__primary,
    .vn-krd-hero__secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .vn-krd-hero__tags {
      margin-top: 24px;
    }

    .vn-krd-hero__visual {
      margin-top: 32px;
    }

    .vn-krd-hero__visual-card {
      max-width: 100%;
    }
  }
</style>
