              height="10"
              rx="5"
              fill="var(--color-text-ondark-mute)"
              opacity="0.35"
            />

            <line
              x1="105"
              y1="118"
              x2="395"
              y2="118"
              stroke="var(--color-border-ondark)"
              stroke-width="1"
            />

            <circle
              cx="120"
              cy="148"
              r="10"
              fill="color-mix(in srgb, var(--color-accent-cta) 16%, transparent)"
              stroke="var(--color-accent-cta)"
              stroke-width="1.5"
            />
            <path
              d="M116 148 L119 151 L124 145"
              stroke="var(--color-accent-cta)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <rect
