              fill="color-mix(in srgb, var(--color-accent-cta) 16%, transparent)"
              stroke="var(--color-accent-cta)"
              stroke-width="1.5"
            />
            <path
              d="M116 188 L119 191 L124 185"
              stroke="var(--color-accent-cta)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <rect
              x="145"
              y="182"
              width="180"
              height="10"
              rx="5"
              fill="var(--color-text-ondark)"
              opacity="0.85"
            />

            <circle
              cx="120"
              cy="228"
              r="10"
              fill="color-mix(in srgb, var(--color-accent-cta) 16%, transparent)"
              stroke="var(--color-accent-cta)"
              stroke-width="1.5"
            />
            <path
              d="M116 228 L119 231 L124 225"
              stroke="var(--color-accent-cta)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <rect
              x="145"
              y="222"
              width="160"
              height="10"
              rx="5"
              fill="var(--color-text-ondark)"
              opacity="0.85"
            />

            <circle
              cx="120"
              cy="268"
              r="10"
              fill="color-mix(in srgb, var(--color-accent-cta) 16%, transparent)"
              stroke="var(--color-accent-cta)"
              stroke-width="1.5"
            />
            <path
              d="M116 268 L119 271 L124 265"
              stroke="var(--color-accent-cta)"
              stroke-width="2"
