<style>
  .vn-krym-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg-primary);
    padding-top: 160px;
    padding-bottom: 96px;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .vn-krym-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    z-index: 0;
  }

  .vn-krym-hero__radial {
    position: absolute;
    top: -220px;
    left: -220px;
    width: 860px;
    height: 860px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-bg-surface) 72%, transparent) 0%, transparent 68%);
    pointer-events: none;
    z-index: 0;
  }

  .vn-krym-hero__left {
    grid-column: 1 / 8;
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .vn-krym-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    color: var(--color-text-secondary);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vn-krym-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-krym-hero__h1 {
    margin: 0 0 24px;
    color: var(--color-text-primary);
    font-size: var(--fs-display);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .vn-krym-hero__h1-accent {
    color: var(--color-accent-primary);
  }

  .vn-krym-hero__sub {
    margin: 0 0 36px;
    max-width: 540px;
    color: var(--color-text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.5;
    text-wrap: balance;
  }

  .vn-krym-hero__cta-row {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .vn-krym-hero__btn {
    height: 52px;
    padding: 0 32px;
    font-size: 16px;
  }

  .vn-krym-hero__trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }

  .vn-krym-hero__trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    font-weight: 500;
  }

  .vn-krym-hero__trust-item:first-child {
    padding-left: 0;
  }

  .vn-krym-hero__trust-item svg {
    color: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-krym-hero__trust-divider {
    width: 1px;
    height: 16px;
    background-color: var(--color-border);
  }

  .vn-krym-hero__compact {
    display: none;
    margin-top: 24px;
    gap: 12px;
    align-items: center;
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    flex-wrap: wrap;
  }

  .vn-krym-hero__compact-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-accent-cta);
  }

  .vn-krym-hero__right {
    grid-column: 8 / 13;
    position: relative;
    z-index: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vn-krym-hero__visual {
    width: 100%;
    max-width: 480px;
    position: relative;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-bg-surface) 84%, transparent), color-mix(in srgb, var(--color-bg-surface) 62%, transparent)),
      var(--color-bg-surface-low);
    box-shadow: var(--shadow-xl);
  }

  .vn-krym-hero__visual-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 8px 14px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 12px;
  }

  .vn-krym-hero__visual-head span {
    color: var(--color-text-tertiary);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .vn-krym-hero__visual-head strong {
    color: var(--color-accent-primary);
    font-size: 14px;
    font-weight: 650;
  }

  .vn-krym-hero__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .vn-krym-hero__pin,
  .vn-krym-hero__office,
  .vn-krym-hero__label,
  .vn-krym-hero__legend,
  .vn-krym-hero__office-label {
    transform-box: fill-box;
    transform-origin: center;
  }

  .vn-krym-hero__pin {
    animation: krym-pin-float 5s ease-in-out infinite;
  }

  .vn-krym-hero__pin:nth-of-type(2) {
    animation-delay: 0.4s;
  }

  .vn-krym-hero__pin:nth-of-type(3) {
    animation-delay: 0.8s;
  }

  @keyframes krym-pin-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -3px; }
  }

  @media (max-width: 1023px) {
    .vn-krym-hero__left {
      grid-column: 1 / -1;
    }

    .vn-krym-hero__right {
      grid-column: 1 / -1;
      margin-top: 32px;
      max-width: 420px;
    }
  }

  @media (max-width: 640px) {
    .vn-krym-hero {
      padding-top: 100px;
      padding-bottom: 64px;
    }

    .vn-krym-hero__grid-bg {
      background-size: 48px 48px;
    }

    .vn-krym-hero__right {
      max-width: 100%;
      margin-top: 28px;
      margin-bottom: 0;
    }

    .vn-krym-hero__visual {
      max-width: 320px;
      margin: 0 auto;
      padding: 10px;
      border-radius: var(--radius-lg);
      box-shadow: 0 14px 40px color-mix(in srgb, var(--color-bg-dark) 10%, transparent);
    }

    .vn-krym-hero__visual-head {
      margin-bottom: 8px;
      padding-bottom: 10px;
    }

    .vn-krym-hero__btn {
      width: 100%;
      justify-content: center;
    }

    .vn-krym-hero__trust {
      display: none;
    }

    .vn-krym-hero__compact {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-krym-hero__pin {
      animation: none;
    }
  }
</style>
