              <text x="282" y="207" fill="var(--color-text-tertiary)" font-size="9" font-weight="600" letter-spacing="1.1">ЦЕНТР</text>
              <text x="282" y="223" fill="var(--color-text-primary)" font-size="13" font-weight="650">Симферополь</text>
            </g>
            <g class="vn-krym-hero__label">
              <rect x="52" y="154" width="98" height="38" rx="11" fill="var(--color-bg-surface)" stroke="var(--color-border)"/>
              <text x="67" y="178" fill="var(--color-text-primary)" font-size="12" font-weight="650">Евпатория</text>
