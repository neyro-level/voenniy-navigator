<!-- ══════════════════════════════════════════════
     БЛОК 03 — ПОЧЕМУ НЕЛЬЗЯ ВЫБИРАТЬ ТОЛЬКО ПО ЦЕНЕ
════════════════════════════════════════════════ -->
<section id="section-krym-problem" class="vn-section vn-section--secondary">
  <div class="vn-container">
    <div class="vn-grid-12">
      <!-- Header -->
      <div class="vn-krym-problem__header">
        <span class="vn-label-mono">Проблема выбора / 03</span>
        <h2 class="vn-krym-h2" style="margin-top: 16px; max-width: 720px;">
          Почему квартиру в Крыму по военной ипотеке нельзя выбирать только по цене
        </h2>
        <p class="vn-krym-sub" style="margin-top: 12px; max-width: 660px;">
          В Крыму цена и красивая локация не отвечают на главный вопрос: подходит
          ли объект под вашу задачу и маршрут военной ипотеки. Для семьи, сдачи,
          переезда позже и дистанционной покупки критерии будут разными.
        </p>
      </div>

      <!-- Card 1 -->
      <article class="vn-krym-problem__card" style="grid-column: span 3;">
        <span class="vn-krym-problem__tag">01</span>
        <div class="vn-krym-accent-line" style="margin: 12px 0 10px;"></div>
        <h3 class="vn-krym-problem__title">Цена не показывает пригодность объекта</h3>
        <p class="vn-krym-problem__body">Дешевле не значит лучше, если район неудобен для жизни, слаб для сдачи или сложен по логистике.</p>
      </article>

      <!-- Card 2 -->
      <article class="vn-krym-problem__card vn-krym-problem__card--stagger-1" style="grid-column: span 3;">
        <span class="vn-krym-problem__tag">02</span>
        <div class="vn-krym-accent-line" style="margin: 12px 0 10px;"></div>
        <h3 class="vn-krym-problem__title">Локация у моря не всегда решает задачу</h3>
        <p class="vn-krym-problem__body">Для жизни важны школа, медицина, транспорт и повседневная инфраструктура, а не только вид из окна.</p>
      </article>

      <!-- Card 3 -->
      <article class="vn-krym-problem__card vn-krym-problem__card--stagger-2" style="grid-column: span 3;">
        <span class="vn-krym-problem__tag">03</span>
        <div class="vn-krym-accent-line" style="margin: 12px 0 10px;"></div>
        <h3 class="vn-krym-problem__title">Симферополь и побережье — разные сценарии</h3>
        <p class="vn-krym-problem__body">Симферополь чаще логичен как городская база, побережье — как сценарий жизни, отдыха или аренды.</p>
      </article>

      <!-- Card 4 -->
      <article class="vn-krym-problem__card vn-krym-problem__card--stagger-3" style="grid-column: span 3;">
        <span class="vn-krym-problem__tag">04</span>
        <div class="vn-krym-accent-line" style="margin: 12px 0 10px;"></div>
        <h3 class="vn-krym-problem__title">Военная ипотека добавляет проверку маршрута</h3>
        <p class="vn-krym-problem__body">Нужно смотреть не только объект, но и банк, документы, формат сделки и готовность сторон.</p>
      </article>

      <!-- CTA -->
      <div class="vn-krym-problem__cta">
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Разобрать мою задачу"
          class="vn-krym-textlink"
        >
          Разобрать мою задачу →
        </a>
      </div>
    </div>
  </div>
</section>

