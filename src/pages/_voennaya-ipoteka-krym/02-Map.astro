---
import KrymDirectionTabs from './KrymDirectionTabs';
import KrymDirectionsMap from './KrymDirectionsMap';

const mapsApiKey = import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY || '';
---

<section class="vn-section vn-complexes-map-section">
  <div class="vn-container">
    <div class="vn-complexes-map-section__layout">
      <aside class="vn-complexes-map-section__panel">
        <div class="vn-complexes-map-section__panel-head">
          <span class="vn-complexes-map-section__eyebrow">Карта жилых комплексов</span>
          <h2 class="vn-complexes-map-section__title">Новостройки Крыма по военной ипотеке</h2>
        </div>

        <KrymDirectionTabs variant="map" client:load />
      </aside>

      <KrymDirectionsMap apiKey={mapsApiKey} client:load />
    </div>
  </div>
</section>

<style is:global>
  .vn-complexes-map-section {
    background: var(--color-bg-surface);
    padding-top: 64px;
    padding-bottom: 24px;
    scroll-margin-top: 108px;
  }

  .vn-complexes-map-section__layout {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .vn-complexes-map-section__panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    padding: 30px 30px 26px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--color-bg-secondary) 32%, white);
    border: 1px solid color-mix(in srgb, var(--color-border) 48%, white);
  }

  .vn-complexes-map-section__panel-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vn-complexes-map-section__eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 28px;
    padding: 0 11px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-secondary) 36%, white);
    color: var(--color-text-tertiary);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vn-complexes-map-section__title {
    margin: 0;
    font-size: var(--fs-h2);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-complexes-map-section__map {
    position: relative;
    min-width: 0;
  }

  .vn-krym-direction-tabs--map {
    width: 100%;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__list {
    display: grid;
    gap: 0;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    padding: 12px 0 12px 18px;
    border: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 42%, white);
    border-radius: 0;
    background: transparent;
    color: var(--color-text-secondary);
    text-align: left;
    cursor: pointer;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__list > :first-child {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 42%, white);
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__list > :last-child {
    border-bottom-color: color-mix(in srgb, var(--color-border) 34%, white);
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab::before {
    content: '';
    position: absolute;
    left: 0;
    top: 13px;
    bottom: 13px;
    width: 2px;
    border-radius: 999px;
    background: transparent;
    transition: background-color 0.2s ease;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab:hover {
    color: var(--color-text-primary);
    opacity: 0.9;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab.is-active {
    color: var(--color-text-primary);
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab.is-active::before {
    background: var(--color-accent-cta);
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab-label {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    padding: 0 0 0 8px;
    color: var(--color-text-tertiary);
    font-size: var(--fs-caption);
    font-weight: 600;
    line-height: 1;
    flex-shrink: 0;
  }

  .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab.is-active .vn-krym-direction-tabs__tab-count {
    color: var(--color-text-primary);
  }

  .vn-complexes-map-section__map-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-secondary) 24%, white);
    border: 1px solid color-mix(in srgb, var(--color-border) 48%, white);
    color: var(--color-text-primary);
    font-size: var(--fs-body-sm);
    font-weight: 500;
  }

  .vn-complexes-map__frame,
  .vn-complexes-map__fallback {
    position: relative;
    min-height: 560px;
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    background: color-mix(in srgb, var(--color-bg-secondary) 18%, white);
    border: 1px solid color-mix(in srgb, var(--color-border) 46%, white);
  }

  .vn-complexes-map__canvas {
    width: 100%;
    height: 560px;
  }

  .vn-complexes-map__static-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn-complexes-map__static-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .vn-complexes-map__static-marker {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 2px solid rgba(255, 255, 255, 0.95);
    border-radius: 999px;
    background: var(--color-accent-cta);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-accent-cta) 20%, transparent);
    color: white;
    font-size: var(--fs-body-sm);
    font-weight: 700;
    cursor: pointer;
    transform: translate(-50%, -100%);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .vn-complexes-map__static-marker:hover {
    background: var(--color-accent-hover);
    transform: translate(-50%, -100%) scale(1.04);
  }

  .vn-complexes-map__static-marker span {
    transform: translateY(0.5px);
  }

  .vn-complexes-map__notice {
    position: absolute;
    right: 18px;
    bottom: 18px;
    z-index: 3;
    max-width: min(340px, calc(100% - 36px));
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid color-mix(in srgb, var(--color-border) 48%, white);
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    line-height: 1.45;
    box-shadow: 0 16px 30px rgba(16, 24, 40, 0.08);
    backdrop-filter: blur(8px);
  }

  .vn-complexes-map__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .vn-complexes-map__fallback p {
    margin: 0;
    max-width: 32ch;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .vn-complexes-map__marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 2px solid rgba(255, 255, 255, 0.95);
    border-radius: 999px;
    background: var(--color-accent-cta);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-accent-cta) 20%, transparent);
    color: white;
    font-size: var(--fs-body-sm);
    font-weight: 700;
    cursor: pointer;
    transform: translate(-50%, -100%);
  }

  .vn-complexes-map__marker span {
    transform: translateY(0.5px);
  }

  .vn-complexes-map__marker:hover {
    background: var(--color-accent-hover);
  }

  @media (max-width: 1023px) {
    .vn-complexes-map-section {
      padding-top: 44px;
      padding-bottom: 18px;
      scroll-margin-top: 92px;
    }

    .vn-complexes-map-section__layout {
      grid-template-columns: 1fr;
    }

    .vn-complexes-map-section__panel {
      padding: 24px 22px;
      border-radius: 22px;
    }
  }

  @media (max-width: 640px) {
    .vn-complexes-map-section__title {
      line-height: 1.18;
    }

    .vn-complexes-map-section__panel {
      gap: 18px;
      padding: 22px 18px;
      border-radius: 20px;
    }

    .vn-complexes-map-section__map-badge {
      top: 14px;
      left: 14px;
    }

    .vn-krym-direction-tabs--map .vn-krym-direction-tabs__tab {
      min-height: 50px;
      padding: 11px 0 11px 16px;
    }

    .vn-complexes-map__frame,
    .vn-complexes-map__fallback {
      min-height: 420px;
      border-radius: 20px;
    }

    .vn-complexes-map__canvas {
      height: 420px;
    }

    .vn-complexes-map__notice {
      right: 14px;
      bottom: 14px;
      max-width: calc(100% - 28px);
      padding: 11px 12px;
      border-radius: 14px;
      font-size: var(--fs-caption);
    }

    .vn-complexes-map__marker {
      width: 32px;
      height: 32px;
      font-size: var(--fs-caption);
    }

    .vn-complexes-map__static-marker {
      width: 32px;
      height: 32px;
      font-size: var(--fs-caption);
    }
  }
</style>
