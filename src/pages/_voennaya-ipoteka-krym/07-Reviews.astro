---
const reviews = [
  {
    initials: 'АМ',
    author: 'Алексей М., майор',
    tag: 'Срочный подбор перед переездом',
    text: 'Получил назначение в Крым, времени на выбор квартиры было мало. Михаил за два дня собрал подборку из пяти объектов, объяснил, где лучше инфраструктура для семьи, а где просто красивая картинка. Сделку закрыли за три недели.',
  },
  {
    initials: 'ДС',
    author: 'Дмитрий С., старший лейтенант',
    tag: 'Дистанционно из другого региона',
    text: 'Я весь процесс проходил из Иркутска — смотрел квартиры по видео, документы подписывал дистанционно. Михаил проверял каждый объект лично, присылал видео с комментариями. Приехал уже на ключи.',
  },
  {
    initials: 'ЕА',
    author: 'Екатерина и Андрей',
    tag: 'Банк отказывал, нашли решение',
    text: 'Банк не соглашался на объект, который нам понравился. Михаил разобрался в причине, предложил альтернативный вариант в соседнем районе и помог согласовать условия. В итоге одобрили и сделку закрыли.',
  },
  {
    initials: 'СП',
    author: 'Сергей П., подполковник',
    tag: 'Для семьи с детьми',
    text: 'Нужна была квартира не просто под ипотеку, а с нормальными школами и детскими садами поблизости. Михаил отсеял три ЖК, которые выглядели привлекательно, но не подходили по инфраструктуре. Остановились на варианте, где реально удобно жить.',
  },
];
---

<section id="section-krym-reviews" class="vn-krd-reviews" aria-labelledby="vn-krym-reviews-title">
  <div class="vn-krd-reviews__grid-bg" aria-hidden="true"></div>

  <div class="vn-container vn-rel">
    <div class="vn-krd-reviews__header">
      <div class="vn-krd-reviews__head-left">
        <span class="vn-label-mono vn-krd-reviews__eyebrow">Отзывы</span>
        <h2 class="vn-krd-reviews__title" id="vn-krym-reviews-title">
          Что говорят те, кто уже прошёл путь
        </h2>
      </div>
      <div class="vn-krd-reviews__head-right">
        <p class="vn-krd-reviews__note">
          Реальные ситуации военнослужащих и их семей. Имена изменены по просьбе клиентов.
        </p>
      </div>
    </div>

    <div class="vn-krd-reviews__grid">
      {reviews.map((review) => (
        <article class="vn-krd-reviews__card">
          <div class="vn-krd-reviews__meta">
            <div class="vn-krd-reviews__avatar" aria-hidden="true">{review.initials}</div>
            <div>
              <span class="vn-krd-reviews__author">{review.author}</span>
              <span class="vn-krd-reviews__tag">{review.tag}</span>
            </div>
          </div>
          <blockquote class="vn-krd-reviews__quote">{review.text}</blockquote>
        </article>
      ))}
    </div>

    <div class="vn-krd-reviews__cta-row">
      <p class="vn-krd-reviews__cta-text">
        Хотите так же? Начните с первичного расчёта вашей задачи.
      </p>
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Разобрать покупку в Крыму"
        data-modal-subtitle="Уточню ваш запрос и задачу, а затем подготовлю ориентир по объектам и сценарию покупки в Крыму."
        class="vn-btn-primary vn-krd-reviews__cta"
      >
        Разобрать покупку в Крыму
      </a>
    </div>
  </div>
</section>

<style>
  .vn-krd-reviews {
    position: relative;
    padding-block: 96px;
    background: var(--color-bg-dark);
    overflow: hidden;
  }

  .vn-krd-reviews__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }

  .vn-krd-reviews .vn-container {
    position: relative;
    z-index: 1;
  }

  .vn-krd-reviews__header {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
  }

  .vn-krd-reviews__head-left {
    display: flex;
    flex-direction: column;
  }

  .vn-krd-reviews__eyebrow {
    color: var(--color-text-ondark);
    opacity: 0.5;
  }

  .vn-krd-reviews__eyebrow::before {
    content: '';
    display: inline-block;
    width: 32px;
    height: 2px;
    margin-right: 12px;
    background: var(--color-text-ondark);
    opacity: 0.4;
    vertical-align: middle;
  }

  .vn-krd-reviews__title {
    margin: 20px 0 0;
    max-width: 720px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-text-ondark);
    text-wrap: balance;
  }

  .vn-krd-reviews__head-right {
    display: flex;
    align-items: flex-end;
    padding-bottom: 4px;
  }

  .vn-krd-reviews__note {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--color-border-ondark);
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-ondark);
    opacity: 0.5;
    text-wrap: pretty;
  }

  .vn-krd-reviews__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }

  .vn-krd-reviews__card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid var(--color-border-ondark);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-dark-elev) 88%, transparent);
    min-height: 100%;
  }

  .vn-krd-reviews__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .vn-krd-reviews__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent-cta) 18%, var(--color-bg-dark-elev));
    color: var(--color-text-ondark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .vn-krd-reviews__author {
    display: block;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-text-ondark);
    opacity: 0.9;
  }

  .vn-krd-reviews__tag {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-cta);
  }

  .vn-krd-reviews__quote {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.62;
    color: var(--color-text-ondark);
    opacity: 0.72;
    font-style: italic;
    text-wrap: pretty;
  }

  .vn-krd-reviews__cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 24px;
    border: 1px solid var(--color-border-ondark);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-dark-elev) 46%, transparent);
  }

  .vn-krd-reviews__cta-text {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--color-text-ondark);
    opacity: 0.66;
  }

  .vn-krd-reviews__cta {
    flex-shrink: 0;
    min-height: 48px;
    padding: 13px 24px;
    font-size: var(--fs-body);
  }

  @media (max-width: 1023px) {
    .vn-krd-reviews {
      padding-block: 72px;
    }

    .vn-krd-reviews__header {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 48px;
    }

    .vn-krd-reviews__head-right {
      padding-bottom: 0;
      padding-top: 20px;
      border-top: 1px solid var(--color-border-ondark);
    }

    .vn-krd-reviews__note {
      padding-left: 0;
      border-left: none;
    }

    .vn-krd-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vn-krd-reviews__cta-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .vn-krd-reviews {
      padding-block: 64px;
    }

    .vn-krd-reviews__title {
      line-height: 1.18;
    }

    .vn-krd-reviews__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-krd-reviews__card {
      padding: 24px;
    }

    .vn-krd-reviews__quote {
      font-size: var(--fs-body-sm);
      line-height: 1.6;
    }

    .vn-krd-reviews__cta-row {
      padding: 20px;
      gap: 16px;
    }

    .vn-krd-reviews__cta {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
