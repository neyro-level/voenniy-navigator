<style is:global>
/* ─── Shared utilities ─── */
.vn-rel { position: relative; }

.vn-accent-line {
  width: 2px;
  height: 24px;
  background-color: var(--color-accent-cta);
  border-radius: 2px;
  display: block;
  flex-shrink: 0;
}

.vn-krd-h2 {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  margin: 0;
  text-wrap: balance;
}

.vn-krd-sub {
  font-size: var(--fs-lead);
  line-height: 1.55;
  color: var(--color-text-secondary);
  margin: 0;
}

.vn-krd-textlink {
  font-size: 15px;
  font-weight: 500;
  color: var(--color-text-primary);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s ease;
}
.vn-krd-textlink:hover { border-bottom-color: var(--color-text-primary); }

/* ─── Block 01: Hero ─── */
.vn-krd-hero {
  position: relative;
  overflow: hidden;
  background-color: var(--color-bg-primary);
  padding-top: 160px;
  padding-bottom: 96px;
  min-height: 100vh;
  display: flex;
  align-items: center;
}

.vn-krd-hero__grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
    linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
  z-index: 0;
}

.vn-krd-hero__radial {
  position: absolute;
  top: -200px;
  left: -200px;
  width: 800px;
  height: 800px;
  background: radial-gradient(circle, color-mix(in srgb, #fff 60%, transparent) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.vn-krd-hero__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  column-gap: 32px;
  align-items: center;
  width: 100%;
}

.vn-krd-hero__left { min-width: 0; }

.vn-krd-hero__eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: var(--fs-label);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-text-secondary);
  margin-bottom: 28px;
}
.vn-krd-hero__eyebrow::before {
  content: "";
  width: 32px;
  height: 2px;
  background: var(--color-accent-cta);
  flex-shrink: 0;
}

.vn-krd-hero__h1 {
  margin: 0 0 24px;
  font-size: var(--fs-display);
  line-height: 1.05;
  font-weight: 600;
  letter-spacing: -0.03em;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-krd-hero__h1-accent { color: var(--color-accent-primary); }

.vn-krd-hero__sub {
  margin: 0 0 36px;
  font-size: var(--fs-lead);
  line-height: 1.5;
  color: var(--color-text-secondary);
  max-width: 540px;
  text-wrap: balance;
}

.vn-krd-hero__cta-row {
  display: flex;
  gap: 12px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.vn-krd-hero__btn {
  height: 54px;
  padding: 0 40px;
  font-size: 16px;
}

.vn-krd-hero__btn-ghost { height: 54px; }

/* 3 дифференциатора */
.vn-krd-hero__diffs {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid var(--color-border);
}

.vn-krd-hero__diff {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px 0;
  border-bottom: 1px solid var(--color-border);
}

.vn-krd-hero__diff-line {
  width: 2px;
  height: 20px;
  background-color: var(--color-accent-cta);
  border-radius: 2px;
  flex-shrink: 0;
  margin-top: 1px;
}

.vn-krd-hero__diff-text {
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

/* Right: visual column */
.vn-krd-hero__right {
  grid-column: 8 / 13;
  position: relative;
  min-width: 0;
}

.vn-krd-hero__visual { position: relative; }

.vn-krd-hero__visual-frame {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  box-shadow:
    12px 12px 0 color-mix(in srgb, var(--color-accent-primary) 14%, transparent),
    0 20px 50px color-mix(in srgb, var(--color-text-primary) 12%, transparent);
}

/* Corner brackets */
.vn-krd-hero__bracket {
  position: absolute;
  width: 24px;
  height: 24px;
  pointer-events: none;
  z-index: 2;
}
.vn-krd-hero__bracket::before,
.vn-krd-hero__bracket::after {
  content: '';
  position: absolute;
  background-color: var(--color-accent-cta);
}
.vn-krd-hero__bracket::before { width: 100%; height: 2px; top: 0; left: 0; }
.vn-krd-hero__bracket::after  { width: 2px; height: 100%; top: 0; left: 0; }

.vn-krd-hero__bracket--tl { top: 12px; left: 12px; }
.vn-krd-hero__bracket--br {
  bottom: 12px;
  right: 12px;
  transform: rotate(180deg);
}

.vn-krd-hero__photo-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-surface) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.vn-krd-hero__placeholder-text {
  text-align: center;
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--color-text-tertiary);
  margin: 0;
}
.vn-krd-hero__placeholder-text span {
  font-size: var(--fs-caption);
  display: block;
  margin-top: 6px;
  color: var(--color-text-tertiary);
  opacity: 0.6;
}

@media (max-width: 1023px) {
  .vn-krd-hero__left  { grid-column: 1 / -1; }
  .vn-krd-hero__right { grid-column: 1 / -1; margin-top: 32px; max-width: 360px; }
  .vn-krd-hero__btn-ghost { display: none; }
}

@media (max-width: 640px) {
  .vn-krd-hero { padding-top: 100px; padding-bottom: 64px; }
  .vn-krd-hero__grid-bg { background-size: 48px 48px; }
  .vn-krd-hero__right { order: -1; max-width: 100%; }
  .vn-krd-hero__visual-frame { aspect-ratio: 16 / 9; border-radius: 10px; }
  .vn-krd-hero__btn { width: 100%; justify-content: center; }
}

/* ─── Block 02: No-vitrina ─── */
.vn-krd-novitr__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.vn-krd-novitr__card { padding: 28px; }

.vn-krd-novitr__title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 10px;
  line-height: 1.3;
}

.vn-krd-novitr__body {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

@media (max-width: 768px) {
  .vn-krd-novitr__grid { grid-template-columns: 1fr; }
}

/* ─── Block 03: Scenarios ─── */
.vn-krd-sc__grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

.vn-krd-sc__card {
  background-color: var(--color-bg-surface);
  border-radius: var(--radius-lg);
  padding: 24px;
}
.vn-krd-sc__card--low { background-color: var(--color-bg-surface-low); }

.vn-krd-sc__title {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 6px;
  line-height: 1.3;
}

.vn-krd-sc__desc {
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin: 0;
}

.vn-krd-sc__divider {
  height: 1px;
  background-color: var(--color-border);
  margin: 16px 0;
}

.vn-krd-sc__criteria {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.vn-krd-sc__criteria li {
  font-size: var(--fs-caption);
  line-height: 1.5;
  color: var(--color-text-secondary);
  padding-left: 12px;
  position: relative;
}
.vn-krd-sc__criteria li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: var(--color-accent-cta);
}

@media (max-width: 1100px) {
  .vn-krd-sc__grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
  .vn-krd-sc__grid { grid-template-columns: 1fr; }
}

/* ─── Block 04: Method ─── */
.vn-krd-method__steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  position: relative;
}

.vn-krd-method__steps::before {
  content: '';
  position: absolute;
  top: 14px;
  left: 14px;
  right: 14px;
  height: 1px;
  background: color-mix(in srgb, var(--color-accent-cta) 20%, transparent);
  z-index: 0;
}

.vn-krd-method__step {
  background-color: var(--color-bg-surface);
  border-radius: var(--radius-lg);
  padding: 24px;
  position: relative;
  z-index: 1;
}
.vn-krd-method__step--low { background-color: var(--color-bg-surface-low); }

.vn-krd-method__badge {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: var(--color-accent-primary);
  color: var(--color-text-ondark);
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vn-krd-method__title {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 6px;
  line-height: 1.3;
}

.vn-krd-method__body {
  font-size: var(--fs-body-sm);
  line-height: 1.55;
  color: var(--color-text-secondary);
  margin: 0;
}

/* 8 критериев */
.vn-krd-method__criteria {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.vn-krd-method__criterion {
  background-color: var(--color-bg-surface);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.vn-krd-method__crit-line {
  width: 3px;
  height: 100%;
  min-height: 36px;
  background-color: var(--color-accent-cta);
  border-radius: 2px;
  flex-shrink: 0;
}

.vn-krd-method__crit-name {
  font-size: var(--fs-body-sm);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 3px;
}

.vn-krd-method__crit-what {
  font-size: var(--fs-caption);
  line-height: 1.4;
  color: var(--color-text-secondary);
  margin: 0;
}

/* Сильная фраза */
.vn-krd-method__phrase {
  font-size: clamp(20px, 2.2vw, 28px);
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  margin: 64px 0 0;
  max-width: 720px;
  text-wrap: balance;
}

@media (max-width: 1100px) {
  .vn-krd-method__steps { grid-template-columns: repeat(3, 1fr); }
  .vn-krd-method__steps::before { display: none; }
  .vn-krd-method__criteria { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .vn-krd-method__steps { grid-template-columns: 1fr; }
  .vn-krd-method__criteria { grid-template-columns: 1fr; }
}

/* ─── Block 05: Local filter ─── */
.vn-krd-local__subblock { margin-bottom: 80px; }
.vn-krd-local__subblock:last-of-type { margin-bottom: 0; }

.vn-krd-local__subhead {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.vn-krd-local__subhead-line {
  width: 3px;
  height: 32px;
  background-color: var(--color-accent-cta);
  border-radius: 2px;
  flex-shrink: 0;
}

.vn-krd-local__grid4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.vn-krd-local__grid3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.vn-krd-local__card { padding: 28px; }
.vn-krd-local__card2 { padding: 28px; }
.vn-krd-local__card-cat { padding: 28px; }

.vn-krd-local__card-cat--warn {
  border: 1px solid color-mix(in srgb, var(--color-accent-primary) 15%, transparent);
}

.vn-krd-local__icon {
  color: var(--color-accent-primary);
  flex-shrink: 0;
}

.vn-krd-local__card-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 8px;
  line-height: 1.3;
}

.vn-krd-local__card-body {
  font-size: var(--fs-body-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

@media (max-width: 1100px) {
  .vn-krd-local__grid4 { grid-template-columns: repeat(2, 1fr); }
  .vn-krd-local__grid3 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .vn-krd-local__grid4 { grid-template-columns: 1fr; }
  .vn-krd-local__grid3 { grid-template-columns: 1fr; }
  .vn-krd-local__subblock { margin-bottom: 56px; }
}

/* ─── Block 06: Remote link ─── */
.vn-krd-remote__card {
  position: relative;
  padding: 40px;
  overflow: hidden;
}

.vn-krd-remote__accent-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background-color: var(--color-accent-cta);
  border-radius: 3px 0 0 3px;
}

.vn-krd-remote__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 32px;
  align-items: center;
}

.vn-krd-remote__title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 12px;
  line-height: 1.2;
}

.vn-krd-remote__body {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
  max-width: 560px;
}

.vn-krd-remote__link-col { flex-shrink: 0; }

.vn-krd-remote__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 500;
  color: var(--color-accent-cta);
  text-decoration: none;
  white-space: nowrap;
  transition: gap 0.15s ease;
}
.vn-krd-remote__link:hover { gap: 12px; }

@media (max-width: 768px) {
  .vn-krd-remote__inner { grid-template-columns: 1fr; }
  .vn-krd-remote__card { padding: 28px; }
}

/* ─── Block 07: First step ─── */
.vn-krd-fs__cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: start;
}

.vn-krd-fs__left { min-width: 0; }

.vn-krd-fs__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  counter-reset: step;
}

.vn-krd-fs__item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.vn-krd-fs__num {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: var(--color-accent-primary);
  color: var(--color-text-ondark);
  font-size: 12px;
  font-weight: 600;
}

.vn-krd-fs__item span:last-child {
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--color-text-secondary);
  padding-top: 3px;
}

.vn-krd-fs__right { padding: 32px; }

.vn-krd-fs__card-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 0 20px;
}

.vn-krd-fs__results {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.vn-krd-fs__result {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

/* Trust-полоса */
.vn-krd-fs__trust {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0;
  margin-top: 40px;
  padding-top: 28px;
  border-top: 1px solid var(--color-border);
}

.vn-krd-fs__trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 24px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
}
.vn-krd-fs__trust-item:first-child { padding-left: 0; }
.vn-krd-fs__trust-item svg { color: var(--color-accent-cta); }

.vn-krd-fs__trust-divider {
  width: 1px;
  height: 20px;
  background-color: var(--color-border);
}

.vn-krd-fs__note {
  font-size: var(--fs-body-sm);
  line-height: 1.6;
  color: var(--color-text-tertiary);
  margin: 20px 0 0;
  max-width: 640px;
}

@media (max-width: 1023px) {
  .vn-krd-fs__cols { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .vn-krd-fs__trust { flex-direction: column; align-items: flex-start; gap: 12px; }
  .vn-krd-fs__trust-divider { display: none; }
  .vn-krd-fs__trust-item { padding: 0; }
}

/* ─── Block 08: FAQ ─── */
.vn-krd-faq__chevron {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  transition: transform 0.2s ease;
}
details[open] .vn-krd-faq__chevron {
  transform: rotate(180deg);
}

/* ─── Block 09: Final CTA dark ─── */
.vn-krd-cta__grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-deco-grid-dark) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-deco-grid-dark) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
  z-index: 0;
}

.vn-krd-cta__radial {
  position: absolute;
  top: -100px;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 600px;
  background: radial-gradient(ellipse at center top, color-mix(in srgb, var(--color-accent-cta) 15%, transparent) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.vn-krd-cta__inner {
  position: relative;
  z-index: 1;
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
}

.vn-krd-cta__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-label);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-text-ondark-mute);
  margin-bottom: 24px;
}
.vn-krd-cta__eyebrow::before {
  content: '';
  width: 3px;
  height: 20px;
  background: var(--color-accent-cta);
  border-radius: 2px;
  flex-shrink: 0;
}

.vn-krd-cta__h2 {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text-ondark);
  margin: 0 0 20px;
  text-wrap: balance;
}

.vn-krd-cta__sub {
  font-size: var(--fs-lead);
  line-height: 1.55;
  color: var(--color-text-ondark-mute);
  margin: 0 0 36px;
  text-wrap: balance;
}

.vn-krd-cta__btn {
  font-size: 16px;
  height: 56px;
  padding: 0 40px;
  background-color: var(--color-accent-cta);
  border-color: var(--color-accent-cta);
}
.vn-krd-cta__btn:hover {
  background-color: #fff;
  color: var(--color-accent-cta);
}

.vn-krd-cta__alt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 20px;
  flex-wrap: wrap;
}

.vn-krd-cta__alt-text {
  font-size: var(--fs-body-sm);
  color: var(--color-text-ondark-mute);
}

.vn-krd-cta__messengers {
  display: flex;
  gap: 12px;
}

.vn-krd-cta__messenger-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--color-text-ondark);
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--color-text-ondark) 25%, transparent);
  transition: border-color 0.15s ease;
}
