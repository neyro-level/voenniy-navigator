---
import FinalCTA from '../../components/sections/FinalCTA.astro';
---

<FinalCTA
  title="Сначала разберём вашу цель,"
  accentText="потом будем выбирать новостройку"
  subtitle="На 30-минутной видеовстрече разберём вашу ситуацию, сценарий покупки и критерии выбора ЖК в Краснодаре. Это первый безопасный шаг — без обязательств."
  ctaText="Записаться на разбор цели покупки"
  ctaModalTitle="Записаться на разбор цели покупки"
  showStats={true}
  showUsefulLinks={false}
/>

<style>
.vn-krd-cta__grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-deco-grid-dark) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-deco-grid-dark) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
  z-index: 0;
}

.vn-krd-cta__radial {
  position: absolute;
  top: -100px;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 600px;
  background: radial-gradient(ellipse at center top, color-mix(in srgb, var(--color-accent-cta) 15%, transparent) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.vn-krd-cta__inner {
  position: relative;
  z-index: 1;
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
}

.vn-krd-cta__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-label);
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-text-ondark-mute);
  margin-bottom: 24px;
}
.vn-krd-cta__eyebrow::before {
  content: '';
  width: 3px;
  height: 20px;
  background: var(--color-accent-cta);
  border-radius: 2px;
  flex-shrink: 0;
}

.vn-krd-cta__h2 {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text-ondark);
  margin: 0 0 20px;
  text-wrap: balance;
}

.vn-krd-cta__sub {
  font-size: var(--fs-lead);
  line-height: 1.55;
  color: var(--color-text-ondark-mute);
  margin: 0 0 36px;
  text-wrap: balance;
}

.vn-krd-cta__btn {
  font-size: 16px;
  height: 56px;
  padding: 0 40px;
  background-color: var(--color-accent-cta);
  border-color: var(--color-accent-cta);
}
.vn-krd-cta__btn:hover {
  background-color: var(--color-bg-surface);
  color: var(--color-accent-cta);
}

.vn-krd-cta__alt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 20px;
  flex-wrap: wrap;
}

.vn-krd-cta__alt-text {
  font-size: var(--fs-body-sm);
  color: var(--color-text-ondark-mute);
}

.vn-krd-cta__messengers {
  display: flex;
  gap: 12px;
}

.vn-krd-cta__messenger-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--color-text-ondark);
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--color-text-ondark) 25%, transparent);
  transition: border-color 0.15s ease;
}
.vn-krd-cta__messenger-link:hover { border-bottom-color: var(--color-text-ondark); }

/* Stats strip */
.vn-krd-cta__stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid var(--color-border-ondark);
}

.vn-krd-cta__stat {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 28px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--color-text-ondark);
}
.vn-krd-cta__stat:first-child { padding-left: 0; }
.vn-krd-cta__stat:last-child  { padding-right: 0; }
.vn-krd-cta__stat svg { color: var(--color-accent-cta); }

.vn-krd-cta__stat-divider {
  width: 1px;
  height: 24px;
  background-color: var(--color-border-ondark);
}

@media (max-width: 768px) {
  .vn-krd-cta__inner { text-align: left; }
  .vn-krd-cta__eyebrow { justify-content: flex-start; }
  .vn-krd-cta__btn { width: 100%; justify-content: center; }
  .vn-krd-cta__alt { justify-content: flex-start; }
  .vn-krd-cta__stats { flex-direction: column; align-items: flex-start; gap: 16px; }
  .vn-krd-cta__stat-divider { display: none; }
  .vn-krd-cta__stat { padding: 0; }
}
</style>
