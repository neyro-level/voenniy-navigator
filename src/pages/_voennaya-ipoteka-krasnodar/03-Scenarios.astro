---
import OptimizedImage from '../../components/ui/OptimizedImage.astro';

const examples = [
  {
    number: '01',
    label: 'Для жизни с семьей',
    title: 'Готовая среда вокруг дома',
    text: 'Смотрим школы, детские сады, дворы, транспорт и повседневную инфраструктуру.',
    checks: ['район', 'двор', 'инфраструктура'],
    position: '50% 42%',
  },
  {
    number: '02',
    label: 'Под аренду',
    title: 'Понятный спрос на квартиру',
    text: 'Проверяем локацию, формат квартиры и то, насколько район интересен арендаторам.',
    checks: ['локация', 'формат', 'спрос'],
    position: '32% 50%',
  },
  {
    number: '03',
    label: 'Для инвестиций',
    title: 'Ликвидность и запас прочности',
    text: 'Разбираем застройщика, срок сдачи, развитие района и планировки внутри комплекса.',
    checks: ['застройщик', 'сроки', 'планировки'],
    position: '68% 50%',
  },
];
---

<section id="section-krd-scenarios" class="vn-krd-scenarios">
  <div class="vn-container">
    <div class="vn-krd-scenarios__head">
      <p class="vn-label-mono">Что войдет в подборку</p>
      <div class="vn-grid-12">
        <h2>Какие ЖК покажем внутри подборки</h2>
        <p>
          Не просто список новостроек. Внутри будет короткий разбор: для какой цели подходит комплекс,
          что в нем сильного и какие квартиры смотреть внимательнее.
        </p>
      </div>
    </div>

    <div class="vn-krd-scenarios__cards vn-grid-12" aria-label="Примеры жилых комплексов в подборке">
      {examples.map((item) => (
        <article class="vn-krd-scenarios__card">
          <div class="vn-krd-scenarios__media">
            <OptimizedImage
              src="/images/krasnodar-newbuild-hero.png"
              alt={`Пример жилого комплекса в Краснодаре: ${item.label}`}
              loading="lazy"
              width={640}
              height={360}
              class="vn-krd-scenarios__media-img"
              style={`object-position: ${item.position}`}
            />
            <span>{item.number}</span>
          </div>

          <div class="vn-krd-scenarios__content">
            <p class="vn-krd-scenarios__label">Пример {item.number}</p>
            <h3>{item.label}</h3>
            <strong>{item.title}</strong>
            <p>{item.text}</p>

            <div class="vn-krd-scenarios__checks" aria-label={`Что проверяем: ${item.label}`}>
              {item.checks.map((check) => (
                <span>{check}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="vn-krd-scenarios__footer">
      <p>В полной подборке — 12 ЖК с пояснением, какие варианты смотреть первыми под вашу цель.</p>
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Получить подборку 12 ЖК"
        class="vn-btn-primary vn-krd-scenarios__cta"
      >
        Получить подборку 12 ЖК
      </a>
    </div>
  </div>
</section>

<style>
  .vn-krd-scenarios {
    position: relative;
    overflow: hidden;
    padding: 104px 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-bg-dark) 92%, var(--color-accent-primary)), var(--color-bg-dark));
    color: var(--color-text-ondark);
  }

  .vn-krd-scenarios::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid-dark) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid-dark) 1px, transparent 1px);
    background-size: 72px 72px;
    opacity: 0.75;
    pointer-events: none;
  }

  .vn-krd-scenarios .vn-container {
    position: relative;
    z-index: 1;
  }

  .vn-krd-scenarios__head h2 {
    grid-column: 1 / 8;
    margin: 24px 0 0;
    color: var(--color-text-ondark);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .vn-krd-scenarios__head p:not(.vn-label-mono) {
    grid-column: 8 / 13;
    align-self: end;
    max-width: 420px;
    margin: 24px 0 4px;
    color: var(--color-text-ondark-mute);
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  .vn-krd-scenarios__cards {
    margin-top: 44px;
    align-items: stretch;
  }

  .vn-krd-scenarios__card {
    display: grid;
    grid-template-rows: 190px minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--color-border-ondark);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-dark-elev) 92%, var(--color-bg-surface));
    box-shadow: 0 18px 46px color-mix(in srgb, var(--color-bg-dark) 42%, transparent);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      background-color 0.22s ease;
  }

  .vn-krd-scenarios__card:nth-child(1) {
    grid-column: 1 / 5;
  }

  .vn-krd-scenarios__card:nth-child(2) {
    grid-column: 5 / 9;
  }

  .vn-krd-scenarios__card:nth-child(3) {
    grid-column: 9 / 13;
  }

  .vn-krd-scenarios__media {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-dark);
  }

  .vn-krd-scenarios__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 42%, color-mix(in srgb, var(--color-bg-dark) 82%, transparent)),
      linear-gradient(90deg, color-mix(in srgb, var(--color-accent-primary) 20%, transparent), transparent 62%);
    pointer-events: none;
  }

  .vn-krd-scenarios__media img,
  .vn-krd-scenarios__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.04);
    transform: scale(1.03);
    transition: transform 0.24s ease;
  }

  .vn-krd-scenarios__media span {
    position: absolute;
    right: 18px;
    bottom: 16px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid color-mix(in srgb, var(--color-text-ondark) 28%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-dark) 72%, transparent);
    color: var(--color-text-ondark);
    font-size: var(--fs-body-sm);
    font-weight: 600;
  }

  .vn-krd-scenarios__content {
    display: grid;
    align-content: start;
    padding: 24px;
  }

  .vn-krd-scenarios__label {
    margin: 0 0 12px;
    color: color-mix(in srgb, var(--color-accent-cta) 84%, var(--color-text-ondark));
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: var(--lh-ui);
    text-transform: uppercase;
  }

  .vn-krd-scenarios__content h3 {
    margin: 0;
    color: var(--color-text-ondark);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-title);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .vn-krd-scenarios__content strong {
    display: block;
    margin-top: 10px;
    color: var(--color-text-ondark);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: var(--lh-title);
  }

  .vn-krd-scenarios__content p:not(.vn-krd-scenarios__label) {
    margin: 12px 0 0;
    color: var(--color-text-ondark-mute);
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .vn-krd-scenarios__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border-ondark);
  }

  .vn-krd-scenarios__checks span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-text-ondark-mute);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: var(--lh-ui);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .vn-krd-scenarios__checks span::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-accent-cta);
  }

  .vn-krd-scenarios__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border-ondark);
  }

  .vn-krd-scenarios__footer p {
    max-width: 560px;
    margin: 0;
    color: var(--color-text-ondark-mute);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .vn-krd-scenarios__cta {
    min-height: 52px;
    padding: 14px 24px;
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-krd-scenarios__card:hover {
      border-color: color-mix(in srgb, var(--color-accent-cta) 46%, transparent);
      background: color-mix(in srgb, var(--color-bg-dark-elev) 86%, var(--color-accent-cta));
      transform: translateY(-4px);
    }

    .vn-krd-scenarios__card:hover .vn-krd-scenarios__media img {
      transform: scale(1.08);
    }
  }

  @media (max-width: 1023px) {
    .vn-krd-scenarios {
      padding: 80px 0;
    }

    .vn-krd-scenarios__head h2,
    .vn-krd-scenarios__head p:not(.vn-label-mono),
    .vn-krd-scenarios__card,
    .vn-krd-scenarios__card:nth-child(1),
    .vn-krd-scenarios__card:nth-child(2),
    .vn-krd-scenarios__card:nth-child(3) {
      grid-column: 1 / -1;
    }

    .vn-krd-scenarios__head p:not(.vn-label-mono) {
      max-width: 640px;
      margin-top: 20px;
    }

    .vn-krd-scenarios__cards {
      row-gap: 18px;
      margin-top: 38px;
    }

    .vn-krd-scenarios__card {
      grid-template-columns: minmax(220px, 38%) minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .vn-krd-scenarios__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .vn-krd-scenarios {
      padding: 64px 0;
    }

    .vn-krd-scenarios__cards {
      margin-top: 32px;
    }

    .vn-krd-scenarios__card {
      grid-template-columns: 1fr;
      grid-template-rows: 180px auto;
    }

    .vn-krd-scenarios__content {
      padding: 22px;
    }

    .vn-krd-scenarios__footer {
      margin-top: 28px;
      padding-top: 24px;
    }

    .vn-krd-scenarios__cta {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .vn-krd-scenarios__checks {
      gap: 8px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-krd-scenarios__card,
    .vn-krd-scenarios__media img {
      transform: none;
      transition: none;
    }
  }
</style>
