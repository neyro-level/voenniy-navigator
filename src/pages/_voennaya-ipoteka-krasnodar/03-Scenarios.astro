<!-- ══════════════════════════════════════════════
     БЛОК 03 — СЦЕНАРИИ
════════════════════════════════════════════════ -->
<section id="section-krd-scenarios" class="vn-section">
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">СЦЕНАРИИ / 03</span>
    <h2 class="vn-krd-h2" style="max-width:600px; margin-top:16px;">
      Что меняет ваш сценарий покупки
    </h2>
    <p class="vn-krd-sub" style="max-width:560px; margin-top:12px; margin-bottom:48px;">
      Разные цели требуют разных решений. Вот что становится приоритетным
      для каждого типичного сценария военнослужащего.
    </p>

    <div class="vn-krd-sc__grid">

      <article class="vn-krd-sc__card">
        <span class="vn-tag">01</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Для жизни (семья переезжает сразу)</h3>
        <p class="vn-krd-sc__desc">Квартира, в которой реально удобно жить семье с детьми.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Район с готовой инфраструктурой: школа, садик, поликлиника</li>
          <li>Удобный двор, транспортная доступность</li>
          <li>Готовая или близкая к сдаче новостройка</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card vn-krd-sc__card--low">
        <span class="vn-tag">02</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Переезд позже (через 2–3 года)</h3>
        <p class="vn-krd-sc__desc">Покупают сейчас, а переезжать будут через 2–3 года.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Срок сдачи под план переезда</li>
          <li>Ликвидность и резерв роста района</li>
          <li>Каким район будет к моменту переезда — важнее, чем сейчас</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card">
        <span class="vn-tag">03</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Под сдачу до переезда</h3>
        <p class="vn-krd-sc__desc">Квартира должна работать и приносить доход до переезда.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Арендный спрос района: вузы, бизнес-зоны, транспортные узлы</li>
          <li>Ремонтопригодная планировка (студии и 1-комнатные)</li>
          <li>Не «престижный», а «рентабельный» район</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card vn-krd-sc__card--low">
        <span class="vn-tag">04</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Дистанционная покупка</h3>
        <p class="vn-krd-sc__desc">Нет возможности постоянно приезжать в Краснодар.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Понятный процесс проверки на месте</li>
          <li>Видео-показы и контроль документов</li>
          <li>Локальный взгляд на ЖК и район</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card">
        <span class="vn-tag">05</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Сложный маршрут сделки</h3>
        <p class="vn-krd-sc__desc">Сжатые сроки НИС, нестандартная ситуация, документы.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Совместимость объекта с банком</li>
          <li>Реалистичный темп сделки</li>
          <li>Координация всех сторон</li>
        </ul>
      </article>

    </div>

    <div style="margin-top:36px;">
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Разобрать мой сценарий"
        class="vn-krd-textlink"
      >
        Разобрать ваш сценарий →
      </a>
    </div>
  </div>
</section>
