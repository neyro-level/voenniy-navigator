---
import { faqItems } from './pageData';
---

<!-- ══════════════════════════════════════════════
     БЛОК 08 — FAQ
════════════════════════════════════════════════ -->
<section id="section-krd-faq" class="vn-section vn-section--secondary">
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ВОПРОСЫ / 07</span>
    <h2 class="vn-section-h2" style="max-width:600px; margin-top:16px; margin-bottom:8px;">
      Частые вопросы по выбору новостройки
    </h2>
    <p class="vn-section-sub" style="max-width:600px; margin-bottom:40px;">
      Ответы на самые частые рациональные вопросы. Если вашего вопроса нет — задайте его на разборе.
    </p>

    <div class="vn-krd-faq__list" style="max-width:800px;">
      {faqItems.map((item) => (
        <details class="vn-faq-item">
          <summary class="vn-faq-question">
            {item.q}
            <svg class="vn-krd-faq__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="vn-faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div style="margin-top:32px;">
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Задать вопрос на разборе"
        class="vn-textlink"
      >
        Не нашли свой вопрос? Задайте на разборе →
      </a>
    </div>
  </div>
</section>

<style>
.vn-krd-faq__chevron {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  transition: transform 0.2s ease;
}
details[open] .vn-krd-faq__chevron {
  transform: rotate(180deg);
}
</style>
