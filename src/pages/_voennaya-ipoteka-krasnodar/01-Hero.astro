---
---

<section id="section-krd-hero" class="vn-krd-hero">
  <div class="vn-krd-hero__grid-bg" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12">
      <div class="vn-krd-hero__content">
        <p class="vn-label-mono">Военная ипотека в Краснодаре / 12 ЖК с видеоразбором</p>

        <h1 class="vn-krd-hero__title">Военная ипотека в Краснодаре: квартиры и новостройки</h1>

        <p class="vn-krd-hero__lead">
          Получите подборку 12 проверенных ЖК Краснодара с видеоразбором: комплексы для жизни,
          аренды и инвестиций, условия военной ипотеки, район, ликвидность и квартиры,
          которые стоит смотреть первыми.
        </p>

        <div class="vn-krd-hero__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Получить 12 ЖК с видеоразбором"
            class="vn-btn-primary vn-krd-hero__primary"
          >
            Получить 12 ЖК с видеоразбором
          </a>
          <a href="#section-krd-selection" class="vn-btn-ghost vn-krd-hero__secondary">
            Как проходит отбор
          </a>
        </div>

        <dl class="vn-krd-hero__proof" aria-label="Что проверяется в подборке">
          <div class="vn-krd-hero__proof-item">
            <dt>Видеоразбор</dt>
            <dd>Почему ЖК попал в подборку</dd>
          </div>
          <div class="vn-krd-hero__proof-item">
            <dt>Район</dt>
            <dd>Инфраструктура, транспорт и цель семьи</dd>
          </div>
          <div class="vn-krd-hero__proof-item">
            <dt>Ликвидность</dt>
            <dd>Для жизни, аренды и инвестиций</dd>
          </div>
          <div class="vn-krd-hero__proof-item">
            <dt>Квартира</dt>
            <dd>Планировка, этаж, корпус и скидки</dd>
          </div>
        </dl>
      </div>

      <div class="vn-krd-hero__visual" aria-label="Превью каталога 12 жилых комплексов">
        <div class="vn-krd-hero__catalog">
          <div class="vn-krd-hero__sheet vn-krd-hero__sheet--back" aria-hidden="true"></div>
          <div class="vn-krd-hero__sheet vn-krd-hero__sheet--mid" aria-hidden="true"></div>

          <div class="vn-krd-hero__cover">
            <div class="vn-krd-hero__cover-top">
              <span>Каталог + видеоразбор</span>
              <span>Краснодар</span>
            </div>

            <div class="vn-krd-hero__cover-main">
              <strong>12</strong>
              <p>ЖК Краснодара по военной ипотеке</p>
            </div>

            <div class="vn-krd-hero__map" aria-hidden="true">
              <span class="vn-krd-hero__pin vn-krd-hero__pin--one"></span>
              <span class="vn-krd-hero__pin vn-krd-hero__pin--two"></span>
              <span class="vn-krd-hero__pin vn-krd-hero__pin--three"></span>
              <span class="vn-krd-hero__route vn-krd-hero__route--one"></span>
              <span class="vn-krd-hero__route vn-krd-hero__route--two"></span>
            </div>

            <div class="vn-krd-hero__chips" aria-hidden="true">
              <span>банк</span>
              <span>район</span>
              <span>квартира</span>
            </div>
          </div>

          <div class="vn-krd-hero__floating vn-krd-hero__floating--left" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="vn-krd-hero__floating vn-krd-hero__floating--right" aria-hidden="true">
            <strong>VIDEO</strong>
            <span>разбор</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-krd-hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    padding-top: 160px;
    padding-bottom: 96px;
    background: var(--color-bg-primary);
  }

  .vn-krd-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }

  .vn-krd-hero .vn-container,
  .vn-krd-hero .vn-grid-12 {
    position: relative;
    z-index: 1;
  }

  .vn-krd-hero__content {
    grid-column: 1 / 8;
    align-self: center;
  }

  .vn-krd-hero__title {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--color-text-primary);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .vn-krd-hero__lead {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.65;
  }

  .vn-krd-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .vn-krd-hero__primary,
  .vn-krd-hero__secondary {
    min-height: 54px;
    padding: 15px 26px;
    font-size: var(--fs-body);
  }

  .vn-krd-hero__proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    max-width: 760px;
    margin: 44px 0 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .vn-krd-hero__proof-item {
    min-width: 0;
    padding: 18px 18px 18px 0;
    border-right: 1px solid var(--color-border);
  }

  .vn-krd-hero__proof-item:last-child {
    border-right: 0;
  }

  .vn-krd-hero__proof dt {
    margin: 0 0 6px;
    color: var(--color-accent-primary);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vn-krd-hero__proof dd {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    line-height: 1.45;
  }

  .vn-krd-hero__visual {
    grid-column: 8 / 13;
    align-self: center;
    min-width: 0;
  }

  .vn-krd-hero__catalog {
    position: relative;
    min-height: 560px;
  }

  .vn-krd-hero__sheet,
  .vn-krd-hero__cover {
    position: absolute;
    inset: 44px 24px 0 34px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-xl);
  }

  .vn-krd-hero__sheet--back {
    transform: translate(28px, -24px) rotate(6deg);
    opacity: 0.42;
  }

  .vn-krd-hero__sheet--mid {
    transform: translate(14px, -12px) rotate(3deg);
    opacity: 0.72;
  }

  .vn-krd-hero__cover {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    overflow: hidden;
    background:
      linear-gradient(145deg, var(--color-bg-surface) 0%, var(--color-bg-surface-low) 52%, var(--color-bg-secondary) 100%);
  }

  .vn-krd-hero__cover::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  .vn-krd-hero__cover-top,
  .vn-krd-hero__cover-main,
  .vn-krd-hero__map,
  .vn-krd-hero__chips {
    position: relative;
    z-index: 1;
  }

  .vn-krd-hero__cover-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 30px 0;
    color: var(--color-text-tertiary);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vn-krd-hero__cover-main {
    display: grid;
    align-content: center;
    padding: 28px 30px 20px;
  }

  .vn-krd-hero__cover-main strong {
    display: block;
    color: var(--color-accent-primary);
    /* type-exception: decorative/catalog-cover-number */
    font-size: clamp(88px, 12vw, 148px);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: 0;
  }

  .vn-krd-hero__cover-main p {
    max-width: 280px;
    margin: 18px 0 0;
    color: var(--color-text-primary);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }

  .vn-krd-hero__map {
    min-height: 150px;
    margin: 0 30px 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(90deg, transparent 49%, var(--color-border) 50%, transparent 51%),
      linear-gradient(0deg, transparent 49%, var(--color-border) 50%, transparent 51%),
      var(--color-bg-surface-low);
    background-size: 72px 72px;
  }

  .vn-krd-hero__pin {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 3px solid var(--color-bg-surface);
    border-radius: var(--radius-full);
    background: var(--color-accent-cta);
    box-shadow: 0 0 0 8px var(--color-accent-cta-soft);
  }

  .vn-krd-hero__pin--one {
    top: 34px;
    left: 22%;
  }

  .vn-krd-hero__pin--two {
    top: 76px;
    left: 57%;
  }

  .vn-krd-hero__pin--three {
    top: 104px;
    left: 78%;
  }

  .vn-krd-hero__route {
    position: absolute;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-primary) 28%, transparent);
    transform-origin: left center;
  }

  .vn-krd-hero__route--one {
    top: 48px;
    left: 25%;
    width: 34%;
    transform: rotate(17deg);
  }

  .vn-krd-hero__route--two {
    top: 90px;
    left: 59%;
    width: 22%;
    transform: rotate(18deg);
  }

  .vn-krd-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 30px 30px;
  }

  .vn-krd-hero__chips span {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    padding: 8px 11px;
    color: var(--color-text-secondary);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .vn-krd-hero__floating {
    position: absolute;
    z-index: 2;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg-surface) 88%, transparent);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--color-text-primary) 13%, transparent);
    backdrop-filter: blur(10px);
  }

  .vn-krd-hero__floating--left {
    left: 0;
    bottom: 84px;
    display: grid;
    gap: 8px;
    width: 118px;
    padding: 14px;
  }

  .vn-krd-hero__floating--left span {
    display: block;
    height: 7px;
    border-radius: 99px;
    background: var(--color-accent-soft);
  }

  .vn-krd-hero__floating--left span:nth-child(2) {
    width: 74%;
  }

  .vn-krd-hero__floating--left span:nth-child(3) {
    width: 52%;
  }

  .vn-krd-hero__floating--right {
    right: 0;
    top: 72px;
    display: grid;
    gap: 2px;
    min-width: 88px;
    padding: 14px 16px;
    text-align: center;
  }

  .vn-krd-hero__floating--right strong {
    color: var(--color-accent-cta);
    font-size: var(--fs-body);
    font-weight: 600;
  }

  .vn-krd-hero__floating--right span {
    color: var(--color-text-tertiary);
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 1023px) {
    .vn-krd-hero {
      min-height: auto;
      padding-top: 112px;
      padding-bottom: 64px;
    }

    .vn-krd-hero__content,
    .vn-krd-hero__visual {
      grid-column: 1 / -1;
    }

    .vn-krd-hero__visual {
      margin-top: 40px;
    }

    .vn-krd-hero__proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .vn-krd-hero__proof-item:nth-child(2) {
      border-right: 0;
    }

    .vn-krd-hero__proof-item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-border);
    }

    .vn-krd-hero__catalog {
      max-width: 520px;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .vn-krd-hero {
      padding-top: 96px;
      padding-bottom: 56px;
    }

    .vn-krd-hero .vn-label-mono {
      display: none;
    }

    .vn-krd-hero__title {
      margin-top: 0;
    }

    .vn-krd-hero__lead {
      margin-top: 20px;
      font-size: var(--fs-lead);
      line-height: 1.6;
    }

    .vn-krd-hero__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      margin-top: 26px;
    }

    .vn-krd-hero__primary,
    .vn-krd-hero__secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .vn-krd-hero__secondary {
      display: none;
    }

    .vn-krd-hero__proof {
      display: none;
    }

    .vn-krd-hero__visual {
      margin-top: 34px;
    }

    .vn-krd-hero__catalog {
      min-height: 430px;
    }

    .vn-krd-hero__sheet,
    .vn-krd-hero__cover {
      inset: 28px 12px 0;
    }

    .vn-krd-hero__cover-top,
    .vn-krd-hero__cover-main,
    .vn-krd-hero__chips {
      padding-inline: 20px;
    }

    .vn-krd-hero__cover-top {
      padding-top: 22px;
    }

    .vn-krd-hero__cover-main {
      padding-top: 20px;
      padding-bottom: 16px;
    }

    .vn-krd-hero__cover-main strong {
      /* type-exception: decorative/catalog-cover-number */
      font-size: clamp(78px, 24vw, 96px);
    }

    .vn-krd-hero__cover-main p {
      max-width: 230px;
      margin-top: 14px;
      font-size: var(--fs-h3);
    }

    .vn-krd-hero__map {
      min-height: 118px;
      margin-inline: 22px;
      margin-bottom: 18px;
    }

    .vn-krd-hero__floating--left {
      display: none;
    }

    .vn-krd-hero__floating--right {
      right: 4px;
      top: 46px;
    }
  }
</style>
