---
import PageLayout from '../layouts/PageLayout.astro';
import ComplexCatalog from '../components/sections/ComplexCatalog.astro';
import ComplexesMapSection from '../components/sections/ComplexesMapSection.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTALight from '../components/sections/FinalCTALight.astro';
import Hero from './_voennaya-ipoteka-krasnodar/01-Hero.astro';
import HowWeWork from './_voennaya-ipoteka-krasnodar/05-HowWeWork.astro';
import Reviews from './_voennaya-ipoteka-krasnodar/07-Reviews.astro';
import SoftCTA from './_voennaya-ipoteka-krasnodar/04-SoftCTA.astro';
import Trust from './_voennaya-ipoteka-krasnodar/06-Trust.astro';
import { faqItems, pageMeta, schemas } from './_voennaya-ipoteka-krasnodar/pageData';
---

<PageLayout {...pageMeta} schema={schemas}>
  <Hero />
  <ComplexesMapSection />
  <ComplexCatalog />
  <SoftCTA />
  <HowWeWork />
  <Trust />
  <Reviews />
  <FAQ
    items={faqItems}
    eyebrow="Частые вопросы"
    title="Ответы на вопросы по военной ипотеке в Краснодаре"
    lead="Собрали ответы на вопросы, которые чаще всего возникают при выборе квартиры и новостройки по военной ипотеке в Краснодаре."
    linkText="Не нашли свой вопрос? Задайте при расчёте →"
    linkHref="/contacts/#request"
    linkModalTitle="Задать вопрос при расчёте"
  />
  <FinalCTALight />
</PageLayout>
