---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, CONTACTS } from '../lib/constants';
import { organizationSchema, breadcrumbSchema, faqSchema, serviceSchema } from '../lib/seo';

const faqItems = [
  {
    q: 'Можно ли купить любую новостройку Краснодара по военной ипотеке?',
    a: 'Не любую. Объект должен быть в реестре аккредитованных банком, который работает с НИС. Часть застройщиков и ЖК не проходят аккредитацию, часть — только у определённых банков. Это первый фильтр, который мы проверяем сразу: если ЖК вам нравится, но он не аккредитован — вариант не работает, как бы он ни выглядел.',
  },
  {
    q: 'С чего начинать выбор: с района, ЖК или бюджета?',
    a: 'С цели покупки. Бюджет, район и ЖК — это инструменты под цель, не наоборот. Семья, которая переезжает сразу, начинает с района и инфраструктуры. Покупка под сдачу до переезда — с арендной ликвидности. Переезд позже — со срока сдачи и резерва роста района. Поэтому первый шаг всегда — разобрать задачу, а не открыть каталог.',
  },
  {
    q: 'Какие районы Краснодара подходят для семьи военнослужащего?',
    a: 'Не существует «лучшего семейного района» в отрыве от вашей ситуации. Я работаю с несколькими категориями районов: с готовой инфраструктурой (школы, садики, поликлиники в шаговой доступности), с быстро развивающейся инфраструктурой (для тех, кто переезжает через 2–3 года) и спорными — куда не рекомендую заходить семье без понимания ограничений. На разборе мы определим, какая категория подходит именно вам.',
  },
  {
    q: 'Что важнее при выборе: цена, срок сдачи или ликвидность?',
    a: 'Зависит от сценария. Для жизни сразу — цена и срок сдачи (нужна готовая или близкая к сдаче квартира). Для переезда позже — срок сдачи и ликвидность к моменту переезда. Под сдачу — арендная ликвидность и ремонтопригодность. Универсального ответа нет, но есть универсальная логика: сначала сценарий, потом приоритеты.',
  },
  {
    q: 'Можно ли выбрать квартиру под сдачу до переезда?',
    a: 'Да, это рабочий сценарий, но он требует своих критериев. Не любая «хорошая» квартира арендуется быстро. Нужно смотреть арендный спрос района (близость к университетам, бизнес-зонам, транспортным узлам), планировку (студии и 1-комнатные арендуются быстрее), готовность под минимальный ремонт. Покупка под сдачу — это другая логика, чем покупка для жизни, и часто это другие районы и другие планировки.',
  },
  {
    q: 'Как понять, что ЖК не подходит под мою задачу?',
    a: 'По нескольким признакам: район не совпадает с инфраструктурой, нужной под сценарий; срок сдачи не вписывается в ваш план; ЖК не аккредитован вашим банком; планировка не работает под цель; темпы стройки или окружающей застройки создают риски. Часть этих факторов видна сразу, часть — только при локальной проверке. На разборе мы пройдём по этим точкам конкретно для вашего случая.',
  },
];

const schemas = [
  organizationSchema,
  serviceSchema({
    name: 'Подбор новостройки по военной ипотеке в Краснодаре',
    description: 'Подбор новостроек Краснодара по военной ипотеке. Не витрина — отбор под задачу: район, ликвидность, семья, переезд, дистанционная покупка.',
    url: `${SITE.url}/voennaya-ipoteka-krasnodar/`,
    areaServed: 'Краснодар',
  }),
  faqSchema(faqItems),
  breadcrumbSchema([
    { name: 'Главная', url: `${SITE.url}/` },
    { name: 'Новостройки Краснодара', url: `${SITE.url}/voennaya-ipoteka-krasnodar/` },
  ]),
];
---

<PageLayout
  title="Новостройки Краснодара по военной ипотеке: подбор под задачу"
  description="Подбор новостроек Краснодара по военной ипотеке. Не витрина — отбор под задачу: район, ликвидность, семья, переезд, дистанционная покупка."
  canonical={`${SITE.url}/voennaya-ipoteka-krasnodar/`}
  ogImage={`${SITE.url}/og/voennaya-ipoteka-krasnodar.jpg`}
  schema={schemas}
>

<!-- ══════════════════════════════════════════════
     БЛОК 01 — HERO
════════════════════════════════════════════════ -->
<section id="section-krd-hero" class="vn-krd-hero">
  <div class="vn-krd-hero__grid-bg" aria-hidden="true"></div>
  <div class="vn-krd-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-krd-hero__inner">

      <!-- Левая колонка: 7 из 12 -->
      <div class="vn-krd-hero__left vn-col-7">
        <div class="vn-krd-hero__eyebrow">НОВОСТРОЙКИ КРАСНОДАРА / 01</div>

        <h1 class="vn-krd-hero__h1">
          Новостройки Краснодара по военной ипотеке:
          <span class="vn-krd-hero__h1-accent"> сначала цель, потом выбор ЖК</span>
        </h1>

        <p class="vn-krd-hero__sub">
          Помогаю военнослужащим и их семьям разобраться, какую новостройку
          в Краснодаре смотреть под их задачу: для жизни, переезда позже,
          сдачи до переезда или дистанционной покупки.
        </p>

        <div class="vn-krd-hero__cta-row">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Начать разбор цели покупки"
            class="vn-btn-primary vn-krd-hero__btn"
          >
            Начать разбор
          </a>
          <a
            href={CONTACTS.vk}
            target="_blank"
            rel="noopener noreferrer"
            class="vn-btn-ghost vn-krd-hero__btn-ghost"
            aria-label="Посмотреть разборы новостроек в VK"
          >
            Разборы в VK
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <!-- 3 дифференциатора -->
        <div class="vn-krd-hero__diffs" role="list">
          <div class="vn-krd-hero__diff" role="listitem">
            <div class="vn-krd-hero__diff-line" aria-hidden="true"></div>
            <span class="vn-krd-hero__diff-text">Только военная ипотека. Не «тоже работаем с НИС», а исключительно с 2016 года.</span>
          </div>
          <div class="vn-krd-hero__diff" role="listitem">
            <div class="vn-krd-hero__diff-line" aria-hidden="true"></div>
            <span class="vn-krd-hero__diff-text">Сначала цель, потом варианты. Неподходящие ЖК отсекаем до просмотра, не после.</span>
          </div>
          <div class="vn-krd-hero__diff" role="listitem">
            <div class="vn-krd-hero__diff-line" aria-hidden="true"></div>
            <span class="vn-krd-hero__diff-text">Дистанционно. Подбор и сделка без приезда в Краснодар.</span>
          </div>
        </div>
      </div>

      <!-- Правая колонка: 5 из 12 -->
      <div class="vn-krd-hero__right vn-col-5">
        <div class="vn-krd-hero__visual">
          <div class="vn-krd-hero__visual-frame">
            <!-- Corner brackets -->
            <span class="vn-krd-hero__bracket vn-krd-hero__bracket--tl" aria-hidden="true"></span>
            <span class="vn-krd-hero__bracket vn-krd-hero__bracket--br" aria-hidden="true"></span>
            <!-- Placeholder: фото новостроек Краснодара -->
            <div class="vn-krd-hero__photo-placeholder">
              <p class="vn-krd-hero__placeholder-text">Архитектурная схема критериев отбора<br><span>Дизайнер добавит изображение</span></p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 02 — ПОЧЕМУ НЕ С ВИТРИНЫ
════════════════════════════════════════════════ -->
<section id="section-krd-novitr" class="vn-section vn-section--secondary">
  <span class="vn-section-marker vn-krd-pos-tr" aria-hidden="true">02</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ОШИБКА ВЫБОРА / 02</span>
    <h2 class="vn-krd-h2" style="max-width:600px; margin-top:16px;">
      Почему не стоит начинать с витрины ЖК
    </h2>
    <p class="vn-krd-sub" style="max-width:560px; margin-top:12px; margin-bottom:48px;">
      Витрина показывает варианты. Но она не отвечает на вопрос, подходит ли объект именно вам.
      Эти четыре ошибки повторяются при выборе новостройки чаще всего.
    </p>

    <div class="vn-krd-novitr__grid">

      <article class="vn-card vn-krd-novitr__card">
        <span class="vn-tag">ОШИБКА 01</span>
        <div class="vn-accent-line" style="margin:16px 0 12px;" aria-hidden="true"></div>
        <h3 class="vn-krd-novitr__title">Смотреть только на цену</h3>
        <p class="vn-krd-novitr__body">Низкая цена не равна правильному выбору. Дешёвая квартира может быть неудобной для семьи, иметь слабую ликвидность для сдачи или находиться в районе с медленным развитием инфраструктуры.</p>
      </article>

      <article class="vn-card vn-krd-novitr__card" style="background-color:var(--color-bg-surface-low);">
        <span class="vn-tag">ОШИБКА 02</span>
        <div class="vn-accent-line" style="margin:16px 0 12px;" aria-hidden="true"></div>
        <h3 class="vn-krd-novitr__title">Выбирать по рекламе ЖК</h3>
        <p class="vn-krd-novitr__body">Реклама продаёт объект, а не вашу задачу. Рендеры и презентационные ролики настроены на эмоцию, а не на пригодность под ваш сценарий покупки.</p>
      </article>

      <article class="vn-card vn-krd-novitr__card" style="background-color:var(--color-bg-surface-low);">
        <span class="vn-tag">ОШИБКА 03</span>
        <div class="vn-accent-line" style="margin:16px 0 12px;" aria-hidden="true"></div>
        <h3 class="vn-krd-novitr__title">Сравнивать только планировки</h3>
        <p class="vn-krd-novitr__body">Планировка важна, но без района, срока сдачи и ликвидности картина неполная. Удачная планировка в неудачном районе теряет в цене и удобстве жизни.</p>
      </article>

      <article class="vn-card vn-krd-novitr__card">
        <span class="vn-tag">ОШИБКА 04</span>
        <div class="vn-accent-line" style="margin:16px 0 12px;" aria-hidden="true"></div>
        <h3 class="vn-krd-novitr__title">Опираться на советы знакомых</h3>
        <p class="vn-krd-novitr__body">У каждой семьи и сценария свои критерии. Совет «бери в районе X» от друга, который покупал для жизни, не работает, если вы покупаете под сдачу до переезда.</p>
      </article>

    </div>

    <div style="margin-top:36px;">
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Разобрать мою задачу сначала"
        class="vn-krd-textlink"
      >
        Сначала разберём вашу задачу, потом посмотрим ЖК →
      </a>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 03 — СЦЕНАРИИ
════════════════════════════════════════════════ -->
<section id="section-krd-scenarios" class="vn-section">
  <span class="vn-section-marker vn-krd-pos-bl" aria-hidden="true">03</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">СЦЕНАРИИ / 03</span>
    <h2 class="vn-krd-h2" style="max-width:600px; margin-top:16px;">
      Что меняет ваш сценарий покупки
    </h2>
    <p class="vn-krd-sub" style="max-width:560px; margin-top:12px; margin-bottom:48px;">
      Разные цели требуют разных решений. Вот что становится приоритетным
      для каждого типичного сценария военнослужащего.
    </p>

    <div class="vn-krd-sc__grid">

      <article class="vn-krd-sc__card">
        <span class="vn-tag">01</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Для жизни (семья переезжает сразу)</h3>
        <p class="vn-krd-sc__desc">Квартира, в которой реально удобно жить семье с детьми.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Район с готовой инфраструктурой: школа, садик, поликлиника</li>
          <li>Удобный двор, транспортная доступность</li>
          <li>Готовая или близкая к сдаче новостройка</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card vn-krd-sc__card--low">
        <span class="vn-tag">02</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Переезд позже (через 2–3 года)</h3>
        <p class="vn-krd-sc__desc">Покупают сейчас, а переезжать будут через 2–3 года.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Срок сдачи под план переезда</li>
          <li>Ликвидность и резерв роста района</li>
          <li>Каким район будет к моменту переезда — важнее, чем сейчас</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card">
        <span class="vn-tag">03</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Под сдачу до переезда</h3>
        <p class="vn-krd-sc__desc">Квартира должна работать и приносить доход до переезда.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Арендный спрос района: вузы, бизнес-зоны, транспортные узлы</li>
          <li>Ремонтопригодная планировка (студии и 1-комнатные)</li>
          <li>Не «престижный», а «рентабельный» район</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card vn-krd-sc__card--low">
        <span class="vn-tag">04</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Дистанционная покупка</h3>
        <p class="vn-krd-sc__desc">Нет возможности постоянно приезжать в Краснодар.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Понятный процесс проверки на месте</li>
          <li>Видео-показы и контроль документов</li>
          <li>Локальный взгляд на ЖК и район</li>
        </ul>
      </article>

      <article class="vn-krd-sc__card">
        <span class="vn-tag">05</span>
        <div class="vn-accent-line" style="margin:12px 0 10px;" aria-hidden="true"></div>
        <h3 class="vn-krd-sc__title">Сложный маршрут сделки</h3>
        <p class="vn-krd-sc__desc">Сжатые сроки НИС, нестандартная ситуация, документы.</p>
        <div class="vn-krd-sc__divider" aria-hidden="true"></div>
        <ul class="vn-krd-sc__criteria">
          <li>Совместимость объекта с банком</li>
          <li>Реалистичный темп сделки</li>
          <li>Координация всех сторон</li>
        </ul>
      </article>

    </div>

    <div style="margin-top:36px;">
      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Разобрать мой сценарий"
        class="vn-krd-textlink"
      >
        Разобрать ваш сценарий →
      </a>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     БЛОК 04 — МЕТОД ОТБОРА
════════════════════════════════════════════════ -->
<section id="section-krd-method" class="vn-section vn-section--secondary">
  <span class="vn-section-marker vn-krd-pos-tr" aria-hidden="true">04</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">МЕТОД ОТБОРА / 04</span>
    <h2 class="vn-krd-h2" style="max-width:600px; margin-top:16px;">
      Как я отбираю варианты
    </h2>
    <p class="vn-krd-sub" style="max-width:560px; margin-top:12px; margin-bottom:48px;">
      Подбор начинается не с поиска по витрине, а с фильтра. Вот пять этапов,
      через которые проходит ваш запрос.
    </p>

    <!-- 5 этапов -->
    <div class="vn-krd-method__steps">

      <div class="vn-krd-method__step">
        <div class="vn-krd-method__badge">01</div>
        <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
        <h3 class="vn-krd-method__title">Разбираем цель покупки</h3>
        <p class="vn-krd-method__body">Жить, переехать позже, сдавать или сохранить актив. От ответа зависят все следующие шаги. Без этого подбор — случайная выборка из каталога.</p>
      </div>

      <div class="vn-krd-method__step vn-krd-method__step--low">
        <div class="vn-krd-method__badge">02</div>
        <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
        <h3 class="vn-krd-method__title">Определяем сценарий и ограничения</h3>
        <p class="vn-krd-method__body">Бюджет, сроки, банк, документы, регион проживания. Какие риски надо учесть, какие сценарии исключить.</p>
      </div>

      <div class="vn-krd-method__step">
        <div class="vn-krd-method__badge">03</div>
        <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
        <h3 class="vn-krd-method__title">Отсекаем неподходящие варианты</h3>
        <p class="vn-krd-method__body">Ключевой этап: что <strong>не смотрим</strong>. Районы, форматы и ЖК, не подходящие под задачу, исключаются до просмотра — это главная экономия вашего времени.</p>
      </div>

      <div class="vn-krd-method__step vn-krd-method__step--low">
        <div class="vn-krd-method__badge">04</div>
        <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
        <h3 class="vn-krd-method__title">Собираем короткий список</h3>
        <p class="vn-krd-method__body">3–5 вариантов, которые проходят по всем критериям. Не «список из 20 ЖК», а отобранная подборка под задачу.</p>
      </div>

      <div class="vn-krd-method__step">
        <div class="vn-krd-method__badge">05</div>
        <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
        <h3 class="vn-krd-method__title">Объясняем плюсы, ограничения и риски</h3>
        <p class="vn-krd-method__body">По каждому варианту — что в нём сильно, что компромиссно, что рискованно. Решение принимаете вы, моя задача — дать честную картину.</p>
      </div>

    </div>

    <!-- 8 критериев -->
    <div style="margin-top:64px;">
      <span class="vn-label-mono" style="margin-bottom:24px; display:inline-flex;">
        ЧТО Я СМОТРЮ ПО КАЖДОМУ ВАРИАНТУ
      </span>
      <div class="vn-krd-method__criteria">

