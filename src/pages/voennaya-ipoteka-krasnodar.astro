<!-- ══════════════════════════════════════════════
     БЛОК 05 — ЛОКАЛЬНЫЙ ФИЛЬТР КРАСНОДАРА
════════════════════════════════════════════════ -->
<section id="section-krd-local" class="vn-section">
  <span class="vn-section-marker vn-krd-pos-bl" aria-hidden="true">05</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ЛОКАЛЬНЫЙ ВЗГЛЯД / 05</span>
    <h2 class="vn-krd-h2" style="max-width:640px; margin-top:16px;">
      Локальный фильтр Краснодара
    </h2>
    <p class="vn-krd-sub" style="max-width:580px; margin-top:12px; margin-bottom:64px;">
      Сайт ЖК показывает идеальную картинку. Реальность видна только на месте —
      и часто отличается от презентации. Вот что я проверяю и какие закономерности
      вижу системно при работе с новостройками Краснодара.
    </p>

    <!-- Подблок 1: Что я проверяю на месте -->
    <div class="vn-krd-local__subblock">
      <div class="vn-krd-local__subhead">
        <div class="vn-krd-local__subhead-line" aria-hidden="true"></div>
        <span class="vn-label-mono" style="color:var(--color-text-secondary);">ЛОКАЛЬНАЯ ПРОВЕРКА</span>
      </div>

      <div class="vn-krd-local__grid4">

        <div class="vn-card vn-krd-local__card">
          <svg class="vn-krd-local__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h1m18 0h1M12 2v1m0 18v1M4.93 4.93l.7.7m12.74 12.74l.7.7M4.93 19.07l.7-.7m12.74-12.74l.7-.7"/><circle cx="12" cy="12" r="4"/></svg>
          <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Уровень шума</h3>
          <p class="vn-krd-local__card-body">Близость к промзонам, шоссе, аэропорту, ж/д. На карточке ЖК это не видно. После переезда становится главной проблемой, особенно для семьи с детьми.</p>
        </div>

        <div class="vn-card vn-krd-local__card" style="background-color:var(--color-bg-surface-low);">
          <svg class="vn-krd-local__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h5l2 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Реальная дорога в час пик</h3>
          <p class="vn-krd-local__card-body">Пробки в Краснодаре имеют локальную специфику. «25 минут» на карте в 14:00 — это может быть 1.5 часа в 8:30 утра. Особенно важно для рабочих маршрутов.</p>
        </div>

        <div class="vn-card vn-krd-local__card">
          <svg class="vn-krd-local__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Состояние двора у соседних домов</h3>
          <p class="vn-krd-local__card-body">Лучший прогноз того, как будет выглядеть ваш двор через 2–3 года. Сданные дома того же застройщика рядом — показывают, что получится у вас.</p>
        </div>

        <div class="vn-card vn-krd-local__card" style="background-color:var(--color-bg-surface-low);">
          <svg class="vn-krd-local__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          <div class="vn-accent-line" style="margin:10px 0 8px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Темпы стройки и окружающих ЖК</h3>
          <p class="vn-krd-local__card-body">Стройка может стоять годами или, наоборот, район быстро застраивается. Это меняет всё: вид из окна, шум, инфраструктуру, ликвидность через 3–5 лет.</p>
        </div>

      </div>
    </div>

    <!-- Подблок 2: Типовые ошибки иногородних -->
    <div class="vn-krd-local__subblock">
      <div class="vn-krd-local__subhead">
        <div class="vn-krd-local__subhead-line" aria-hidden="true"></div>
        <span class="vn-label-mono" style="color:var(--color-text-secondary);">ТИПОВЫЕ ОШИБКИ ИНОГОРОДНИХ</span>
      </div>

      <div class="vn-krd-local__grid3">

        <div class="vn-card vn-krd-local__card2">
          <span class="vn-tag">ОШИБКА 01</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Выбор района по близости к центру</h3>
          <p class="vn-krd-local__card-body">В Краснодаре «центр» не равно «удобно». Пробки и развязки часто делают «спальные» районы быстрее по транспорту. Иногда выгоднее жить в 15 км от центра, чем в 5 км через пробку.</p>
        </div>

        <div class="vn-card vn-krd-local__card2" style="background-color:var(--color-bg-surface-low);">
          <span class="vn-tag">ОШИБКА 02</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Недооценка инфраструктуры школ и садов</h3>
          <p class="vn-krd-local__card-body">В новых районах часто не хватает мест в государственных учреждениях. Купив квартиру у «престижного парка», семья может оказаться без садика в шаговой доступности.</p>
        </div>

        <div class="vn-card vn-krd-local__card2">
          <span class="vn-tag">ОШИБКА 03</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Игнорирование темпа застройки</h3>
          <p class="vn-krd-local__card-body">Сегодня ЖК стоит на пустыре с видом на простор. Через 2 года это окно в стройку соседнего комплекса с 15-летней перспективой пыли и шума. Видно только по генплану района.</p>
        </div>

      </div>
    </div>

    <!-- Подблок 3: Категории районов -->
    <div class="vn-krd-local__subblock">
      <div class="vn-krd-local__subhead">
        <div class="vn-krd-local__subhead-line" aria-hidden="true"></div>
        <span class="vn-label-mono" style="color:var(--color-text-secondary);">КАТЕГОРИИ РАЙОНОВ</span>
      </div>
      <p class="vn-krd-sub" style="margin-bottom:32px; margin-top:8px;">
        Мы не делим Краснодар на «лучшие» и «худшие» районы — у каждого своя задача.
        Деление по категориям под сценарии покупки.
      </p>

      <div class="vn-krd-local__grid4">

        <div class="vn-card vn-krd-local__card-cat">
          <span class="vn-tag">КАТЕГОРИЯ 01</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Семейные районы</h3>
          <p class="vn-krd-local__card-body">Готовая инфраструктура: школы, садики, поликлиники, парки, безопасные дворы. Подходят для сценария «жить сразу».</p>
        </div>

        <div class="vn-card vn-krd-local__card-cat" style="background-color:var(--color-bg-surface-low);">
          <span class="vn-tag">КАТЕГОРИЯ 02</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Инвестиционные и арендные</h3>
          <p class="vn-krd-local__card-body">Высокий арендный спрос: близость к вузам, бизнес-зонам, транспортным узлам. Подходят для сценария «сдача до переезда».</p>
        </div>

        <div class="vn-card vn-krd-local__card-cat" style="background-color:var(--color-bg-surface-low);">
          <span class="vn-tag">КАТЕГОРИЯ 03</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Под переезд позже</h3>
          <p class="vn-krd-local__card-body">Развивающиеся районы с резервом роста. К моменту переезда через 2–3 года квартира будет в лучшем районе, чем сейчас.</p>
        </div>

        <div class="vn-card vn-krd-local__card-cat vn-krd-local__card-cat--warn">
          <span class="vn-tag">КАТЕГОРИЯ 04</span>
          <div class="vn-accent-line" style="margin:14px 0 10px;" aria-hidden="true"></div>
          <h3 class="vn-krd-local__card-title">Спорные районы</h3>
          <p class="vn-krd-local__card-body">Выглядят выгодно по цене, но имеют скрытые ограничения — транспорт, инфраструктура, темп развития, экологические факторы. Рассматриваем только при понимании задачи.</p>
        </div>

      </div>
    </div>

    <div style="margin-top:36px;">
