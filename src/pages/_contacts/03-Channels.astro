---
import { CONTACTS } from '../../lib/constants';
---

<section id="section-contacts-channels" class="vn-contacts-channels">
  <div class="vn-container">
    <div class="vn-grid-12">
      <div class="vn-contacts-channels__header">
        <h2 class="vn-contacts-channels__h2">Как связаться с&nbsp;Михаилом</h2>
        <p class="vn-contacts-channels__lead">
          Для первичного обращения удобнее написать в мессенджер или оставить заявку
          на разбор. После обращения Михаил уточнит ситуацию и согласует удобное
          время разговора.
        </p>
      </div>

      <div class="vn-contacts-channels__cards">
        <!-- Phone -->
        <div class="vn-contacts-channels__card">
          <div class="vn-contacts-channels__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.95.38 1.88.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.93.32 1.86.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="vn-contacts-channels__card-accent"></div>
          <h3 class="vn-contacts-channels__card-title">Телефон</h3>
          <p class="vn-contacts-channels__card-value">{CONTACTS.phone}</p>
          <a href={`tel:${CONTACTS.phone.replace(/[^\d+]/g, '')}`} class="vn-contacts-channels__card-link">
            Позвонить
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

        <!-- Telegram -->
        <div class="vn-contacts-channels__card">
          <div class="vn-contacts-channels__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9 22,2"/></svg>
          </div>
          <div class="vn-contacts-channels__card-accent"></div>
          <h3 class="vn-contacts-channels__card-title">Telegram</h3>
          <p class="vn-contacts-channels__card-value">@Mikhail_khryapin</p>
          <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="vn-contacts-channels__card-link">
            Написать в TG
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

        <!-- Max -->
        <div class="vn-contacts-channels__card">
          <div class="vn-contacts-channels__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <div class="vn-contacts-channels__card-accent"></div>
          <h3 class="vn-contacts-channels__card-title">Max</h3>
          <p class="vn-contacts-channels__card-value">{CONTACTS.max.startsWith('[') ? 'Скоро' : CONTACTS.max}</p>
          <a href={CONTACTS.max.startsWith('[') ? '#' : CONTACTS.max} target="_blank" rel="noopener noreferrer" class="vn-contacts-channels__card-link">
            Написать в Max
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

        <!-- VK -->
        <div class="vn-contacts-channels__card">
          <div class="vn-contacts-channels__card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </div>
          <div class="vn-contacts-channels__card-accent"></div>
          <h3 class="vn-contacts-channels__card-title">ВКонтакте</h3>
          <p class="vn-contacts-channels__card-value">{CONTACTS.vk.startsWith('[') ? 'Скоро' : CONTACTS.vk}</p>
          <a href={CONTACTS.vk.startsWith('[') ? '#' : CONTACTS.vk} target="_blank" rel="noopener noreferrer" class="vn-contacts-channels__card-link">
            Перейти в VK
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <div class="vn-contacts-channels__cta">
        <span>Или заполните форму — Михаил свяжется сам:</span>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Записаться на разбор"
          class="vn-btn-primary"
        >
          Записаться на разбор
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-contacts-channels {
    background-color: var(--color-bg-secondary);
    padding: 80px 0;
  }

  .vn-contacts-channels__header {
    grid-column: 1 / -1;
    max-width: 560px;
  }

  .vn-contacts-channels__h2 {
    margin: 0 0 16px;
    font-size: var(--fs-h2);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-contacts-channels__lead {
    margin: 0 0 40px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-contacts-channels__cards {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .vn-contacts-channels__card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease;
  }
  .vn-contacts-channels__card:hover {
    box-shadow: var(--shadow-card-hover);
  }

  .vn-contacts-channels__card-icon {
    color: var(--color-accent-primary);
    margin-bottom: 16px;
  }

  .vn-contacts-channels__card-accent {
    width: 2px;
    height: 18px;
    background: var(--color-accent-cta);
    border-radius: 2px;
    margin-bottom: 12px;
  }

  .vn-contacts-channels__card-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .vn-contacts-channels__card-value {
    margin: 0 0 16px;
    font-size: 14px;
    color: var(--color-text-secondary);
    word-break: break-word;
  }

  .vn-contacts-channels__card-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent-cta);
    text-decoration: none;
    transition: gap 150ms ease;
  }
  .vn-contacts-channels__card-link:hover {
    gap: 10px;
  }

  .vn-contacts-channels__cta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 40px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 1023px) {
    .vn-contacts-channels__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .vn-contacts-channels {
      padding: 64px 0;
    }
    .vn-contacts-channels__cta {
      flex-direction: column;
      text-align: center;
    }
    .vn-contacts-channels__cta .vn-btn-primary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
