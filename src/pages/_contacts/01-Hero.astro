---
import { CONTACTS } from "../../lib/constants";
import { getConfiguredValue } from "../../lib/utils";

const telegramHref = getConfiguredValue(CONTACTS.telegram);
const phoneClean = CONTACTS.phone.replace(/[^\d+]/g, "");
---

<section id="section-contacts-hero" class="vn-contacts-hero">
  <div class="vn-contacts-hero__grid" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-contacts-hero__inner">
      <h1 class="vn-contacts-hero__h1">Контакты Военного навигатора в Краснодаре и Крыму</h1>

      <p class="vn-contacts-hero__sub">
        Свяжитесь, чтобы рассчитать варианты покупки новостройки по военной ипотеке или уточнить вопрос.
        Встречи возможны по предварительной договорённости в Краснодаре и Бахчисарае.
      </p>

      <div class="vn-contacts-hero__cta-row">
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Рассчитать варианты"
          class="vn-btn-primary vn-contacts-hero__btn"
        >
          Рассчитать варианты
        </a>

        {telegramHref && (
          <a
            href={telegramHref}
            target="_blank"
            rel="noopener noreferrer"
            class="vn-contacts-hero__secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            Написать в Telegram
          </a>
        )}

        <a href={`tel:${phoneClean}`} class="vn-contacts-hero__secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Позвонить
        </a>
      </div>

      <div class="vn-contacts-hero__trust" role="list">
        <span role="listitem">Краснодар</span>
        <span class="vn-contacts-hero__trust-divider" aria-hidden="true"></span>
        <span role="listitem">Крым</span>
        <span class="vn-contacts-hero__trust-divider" aria-hidden="true"></span>
        <span role="listitem">Дистанционно</span>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-contacts-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-primary);
    padding-top: 160px;
    padding-bottom: 96px;
  }

  .vn-contacts-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }

  .vn-contacts-hero .vn-container {
    position: relative;
    z-index: 1;
  }

  .vn-contacts-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .vn-contacts-hero__h1 {
    margin: 0;
    font-size: var(--fs-h1);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-contacts-hero__sub {
    margin: 20px 0 0;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 600px;
    text-wrap: pretty;
  }

  .vn-contacts-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .vn-contacts-hero__btn {
    height: 48px;
    padding: 0 28px;
    font-size: var(--fs-body);
  }

  .vn-contacts-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }
  .vn-contacts-hero__secondary:hover {
    border-color: var(--color-accent-cta);
    background: var(--color-accent-soft);
    color: var(--color-text-primary);
  }
  .vn-contacts-hero__secondary svg {
    flex-shrink: 0;
  }

  .vn-contacts-hero__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 32px;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .vn-contacts-hero__trust span[role="listitem"] {
    padding: 0 14px;
  }
  .vn-contacts-hero__trust-divider {
    width: 1px;
    height: 12px;
    background-color: var(--color-border);
  }

  @media (max-width: 640px) {
    .vn-contacts-hero {
      padding-top: 120px;
      padding-bottom: 72px;
    }
    .vn-contacts-hero__h1 {
      font-size: var(--fs-h1-mobile, var(--fs-h1));
    }
    .vn-contacts-hero__cta-row {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .vn-contacts-hero__btn,
    .vn-contacts-hero__secondary {
      width: 100%;
      justify-content: center;
    }
    .vn-contacts-hero__trust {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 0;
    }
    .vn-contacts-hero__trust span[role="listitem"] {
      padding: 0;
    }
    .vn-contacts-hero__trust-divider {
      display: none;
    }
  }
</style>
