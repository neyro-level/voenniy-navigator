---
import { CONTACTS } from '../../lib/constants';
---

<section id="section-contacts-hero" class="vn-contacts-hero">
  <div class="vn-container">
    <div class="vn-grid-12">
      <div class="vn-contacts-hero__inner">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="vn-contacts-hero__breadcrumb">
          <a href="/">Главная</a>
          <span>/</span>
          <span>Контакты</span>
        </nav>

        <!-- Eyebrow -->
        <div class="vn-contacts-hero__eyebrow">Контакты / Михаил Хряпин</div>

        <!-- H1 -->
        <h1 class="vn-contacts-hero__h1">Контакты Михаила Хряпина</h1>

        <!-- Subtitle -->
        <p class="vn-contacts-hero__sub">
          Свяжитесь, чтобы записаться на разбор цели покупки или уточнить вопрос
          по&nbsp;новостройкам Краснодара и&nbsp;военной ипотеке. Встречи возможны
          по&nbsp;предварительной договорённости в&nbsp;Краснодаре и&nbsp;Бахчисарае (Крым).
        </p>

        <!-- CTA Row -->
        <div class="vn-contacts-hero__cta-row">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Записаться на разбор"
            class="vn-btn-primary vn-contacts-hero__btn"
          >
            Записаться на разбор
          </a>
          <a
            href={CONTACTS.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="vn-btn-ghost vn-contacts-hero__btn-ghost"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Написать в Telegram
          </a>
          <a
            href={`tel:${CONTACTS.phone.replace(/[^\d+]/g, '')}`}
            class="vn-btn-ghost vn-contacts-hero__btn-ghost"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Позвонить: {CONTACTS.phone}
          </a>
        </div>

        <!-- Trust row -->
        <div class="vn-contacts-hero__trust" role="list">
          <span role="listitem">Новостройки Краснодара</span>
          <span class="vn-contacts-hero__trust-divider" aria-hidden="true"></span>
          <span role="listitem">Военная ипотека</span>
          <span class="vn-contacts-hero__trust-divider" aria-hidden="true"></span>
          <span role="listitem">Дистанционное сопровождение</span>
          <span class="vn-contacts-hero__trust-divider vn-contacts-hero__trust-divider--hide-mobile" aria-hidden="true"></span>
          <span class="vn-contacts-hero__trust-item--hide-mobile" role="listitem">Офисы в Краснодаре и Бахчисарае</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-contacts-hero {
    background-color: var(--color-bg-primary);
    padding-top: 160px;
    padding-bottom: 96px;
  }

  .vn-contacts-hero__inner {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .vn-contacts-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-tertiary);
    margin-bottom: 24px;
  }
  .vn-contacts-hero__breadcrumb a {
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .vn-contacts-hero__breadcrumb a:hover {
    color: var(--color-accent-cta);
  }
  .vn-contacts-hero__breadcrumb span:last-child {
    color: var(--color-text-secondary);
  }

  .vn-contacts-hero__eyebrow {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: 20px;
  }

  .vn-contacts-hero__h1 {
    margin: 0;
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-contacts-hero__sub {
    margin: 16px 0 0;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 560px;
    text-wrap: pretty;
  }

  .vn-contacts-hero__cta-row {
    display: flex;
    gap: 12px;
    margin-top: 40px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .vn-contacts-hero__btn {
    height: 48px;
    padding: 0 28px;
    font-size: 15px;
  }
  .vn-contacts-hero__btn-ghost {
    height: 48px;
    padding: 0 20px;
    font-size: 14px;
  }

  .vn-contacts-hero__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 32px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .vn-contacts-hero__trust span[role="listitem"] {
    padding: 0 12px;
  }

  .vn-contacts-hero__trust-divider {
    width: 1px;
    height: 12px;
    background-color: var(--color-border);
  }

  @media (max-width: 640px) {
    .vn-contacts-hero {
      padding-top: 100px;
      padding-bottom: 64px;
    }
    .vn-contacts-hero__h1 {
      font-size: 36px;
    }
    .vn-contacts-hero__cta-row {
      flex-direction: column;
      width: 100%;
    }
    .vn-contacts-hero__btn,
    .vn-contacts-hero__btn-ghost {
      width: 100%;
      justify-content: center;
    }
    .vn-contacts-hero__trust {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 0;
      text-align: center;
    }
    .vn-contacts-hero__trust span[role="listitem"] {
      padding: 0 4px;
    }
    .vn-contacts-hero__trust-divider {
      display: none;
    }
    .vn-contacts-hero__trust-item--hide-mobile,
    .vn-contacts-hero__trust-divider--hide-mobile {
      display: none;
    }
  }
</style>
