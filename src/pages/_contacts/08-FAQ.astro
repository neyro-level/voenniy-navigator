---
import { CONTACTS } from '../../lib/constants';
import { faqItems } from './pageData';
---

<section id="section-contacts-faq" class="vn-section">
  <div class="vn-container">
    <div class="vn-grid-12">
      <!-- Left: header -->
      <div class="vn-contacts-faq__header">
        <span class="vn-label-mono">Вопросы</span>
        <h2 class="vn-contacts-faq__h2">Частые вопросы о встречах и связи</h2>
        <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="vn-contacts-faq__micro-cta">
          Другой вопрос? Напишите в Telegram →
        </a>
      </div>

      <!-- Right: accordion -->
      <div class="vn-contacts-faq__list">
        {faqItems.map((item) => (
          <details class="vn-faq-item">
            <summary class="vn-faq-question">{item.q}</summary>
            <div class="vn-faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .vn-contacts-faq__header {
    grid-column: 1 / 5;
  }

  .vn-contacts-faq__h2 {
    margin: 16px 0 20px;
    font-size: var(--fs-h2);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-contacts-faq__micro-cta {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent-cta);
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .vn-contacts-faq__micro-cta:hover {
    opacity: 0.7;
  }

  .vn-contacts-faq__list {
    grid-column: 5 / 13;
  }

  @media (max-width: 1023px) {
    .vn-contacts-faq__header,
    .vn-contacts-faq__list {
      grid-column: 1 / -1;
    }
    .vn-contacts-faq__header {
      margin-bottom: 32px;
    }
  }
</style>
