---
import PageLayout from '../layouts/PageLayout.astro';
import FinalCTALight from '../components/sections/FinalCTALight.astro';
import FAQ from '../components/sections/FAQ.astro';
import Hero from './_voennaya-ipoteka-krym/01-Hero.astro';
import Map from './_voennaya-ipoteka-krym/02-Map.astro';
import Catalog from './_voennaya-ipoteka-krym/03-Catalog.astro';
import SoftCTA from './_voennaya-ipoteka-krym/04-SoftCTA.astro';
import HowWeWork from './_voennaya-ipoteka-krym/05-HowWeWork.astro';
import Trust from './_voennaya-ipoteka-krym/06-Trust.astro';
import Reviews from './_voennaya-ipoteka-krym/07-Reviews.astro';
import { pageMeta, schemas, faqItems } from './_voennaya-ipoteka-krym/pageData';
---

<PageLayout {...pageMeta} schema={schemas}>
  <Hero />
  <Map />
  <Catalog />
  <SoftCTA />
  <HowWeWork />
  <Trust />
  <Reviews />
  <FAQ
    items={faqItems}
    eyebrow="ЧАСТЫЕ ВОПРОСЫ"
    title="Ответы на частые вопросы по Крыму"
    lead="Вопросы о дистанционной покупке, выборе города и условиях военной ипотеки в Крыму."
    linkText="Не нашли ответ? Задайте вопрос при расчёте →"
    linkHref="/contacts/#request"
    linkModalTitle="Разобрать покупку в Крыму"
  />
  <FinalCTALight />
</PageLayout>
