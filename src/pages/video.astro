---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizForm from '../components/quiz/QuizForm';
import VideoPrivacyPopup from '../components/legal/VideoPrivacyPopup.astro';
import { CONTACTS } from '../lib/constants';
import '../components/quiz/quiz.css';

const showTelegram = CONTACTS.telegram && !CONTACTS.telegram.includes('[TELEGRAM');
---

<BaseLayout
  title="Закрытый разбор новостроек Краснодара — Михаил Хряпин"
  description="Получите бесплатный 30-минутный разбор новостроек Краснодара по военной ипотеке: ЖК, районы, риски и проверка до покупки."
  noindex={true}
>
  <div class="vn-video-page">
    <!-- Mini Header -->
    <header class="vn-video-header">
      <div class="vn-container">
        <div class="vn-video-header__inner">
          <a href="/" class="vn-video-header__logo" aria-label="Военный навигатор — на главную">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none"
                 class="vn-video-logo-mark" aria-hidden="true">
              <circle cx="20" cy="20" r="9"
                stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))"
                stroke-width="0.7" stroke-dasharray="2.2 2.2"/>
              <path d="M7 13 L7 7 L13 7"
                stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M27 7 L33 7 L33 13"
                stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 27 L7 33 L13 33"
                stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M27 33 L33 33 L33 27"
                stroke="var(--logo-bracket-color, color-mix(in srgb, var(--color-text-ondark) 82%, transparent))"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="20" cy="20" r="2.8" fill="var(--color-accent-cta)"/>
            </svg>
            <span class="vn-video-header__logo-text">
              <span class="vn-video-header__brand">Военный навигатор</span>
              <span class="vn-video-header__name">Михаил Хряпин</span>
            </span>
          </a>
          {showTelegram && (
            <a
              href={CONTACTS.telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="vn-video-header__tg"
            >
              Подписаться на канал →
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Зона 1: Hero -->
    <section class="vn-video-hero">
      <div class="vn-container">
        <div class="vn-grid-12">
          <div class="vn-video-hero__left" style="grid-column: 1 / 8">
            <span class="vn-label-mono" style="color: var(--color-accent-cta)">ВОЕННАЯ ИПОТЕКА · НОВОСТРОЙКИ</span>
            <h1 class="vn-video-hero__title">
              Получите закрытый разбор новостроек Краснодара
              <span class="vn-video-hero__title-accent">по военной ипотеке</span>
            </h1>
            <ul class="vn-video-hero__bullets" aria-label="Что вы получите в разборе">
              <li>Какие ЖК действительно стоит рассмотреть в&nbsp;2026&nbsp;году</li>
              <li>Какие районы подходят под жизнь, переезд или вложение</li>
              <li>Что проверить до покупки, чтобы не зайти в слабый объект</li>
            </ul>
            <div class="vn-video-hero__sep" aria-hidden="true"></div>
            <a href="#quiz" class="vn-btn-primary vn-video-hero__cta">
              Получить видеоразбор бесплатно
            </a>
          </div>
          <div class="vn-video-hero__right" style="grid-column: 8 / 13">
            <div class="vn-video-hero__photo-wrap">
              <img
                src="/images/mikhail-hero.png"
                alt="Михаил Хряпин — навигатор по военной ипотеке"
                width="380"
                height="440"
                loading="eager"
                class="vn-video-hero__photo"
              />
            </div>
            <p class="vn-video-hero__trust">
              ★★★★★ 65&nbsp;сделок по военной&nbsp;ипотеке
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Зона 2: Quiz -->
    <section class="vn-video-quiz" id="quiz">
      <div class="vn-container">
        <div class="vn-video-quiz__head vn-grid-12">
          <h2 class="vn-video-quiz__title" style="grid-column: 3 / 11">
            Ответьте на 4 вопроса и получите видеоразбор новостроя Краснодара
          </h2>
          <p class="vn-video-quiz__sub" style="grid-column: 4 / 10">
            Квиз займёт меньше минуты. После отправки Михаил пришлёт закрытый разбор и увидит вашу задачу покупки.
          </p>
        </div>
        <div class="vn-video-quiz__grid vn-grid-12">
          <div class="vn-video-quiz__form-shell" style="grid-column: 3 / 11">
            <QuizForm client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Зона 3: Trust -->
    <section class="vn-video-trust-block">
      <div class="vn-container">
        <div class="vn-video-trust-block__grid vn-grid-12">
          <div class="vn-video-trust-block__left" style="grid-column: 1 / 6">
            <h2 class="vn-video-trust-block__title">
              Почему разбор стоит посмотреть до выбора ЖК
            </h2>
            <p class="vn-video-trust-block__text">
              Витрины новостроек показывают планировки и цены. Разбор помогает понять,
              подходит ли объект под вашу задачу, бюджет и маршрут покупки по военной ипотеке.
            </p>
            <a href="#quiz" class="vn-btn-primary vn-video-trust-block__cta">
              Получить закрытый разбор
            </a>
          </div>

          <div class="vn-video-trust-block__right" style="grid-column: 6 / 13">
            <article class="vn-video-trust-row">
              <span class="vn-video-trust-row__num">01</span>
              <div>
                <h3>Не витрина застройщика</h3>
                <p>Фокус не на рекламе ЖК, а на том, что проверять до покупки: район, срок сдачи, ликвидность и ограничения по военной ипотеке.</p>
              </div>
            </article>
            <article class="vn-video-trust-row">
              <span class="vn-video-trust-row__num">02</span>
              <div>
                <h3>Под задачу, а не “самый красивый объект”</h3>
                <p>Для жизни, переезда и вложения подходят разные районы и форматы квартир. Ошибка здесь стоит дороже, чем кажется на старте.</p>
              </div>
            </article>
            <article class="vn-video-trust-row">
              <span class="vn-video-trust-row__num">03</span>
              <div>
                <h3>Военная ипотека добавляет ограничения</h3>
                <p>Важно учитывать банк, НИС, сроки, документы и формат сделки. Не каждый красивый вариант проходит спокойным маршрутом.</p>
              </div>
            </article>
            <article class="vn-video-trust-row">
              <span class="vn-video-trust-row__num">04</span>
              <div>
                <h3>Практика Михаила</h3>
                <p>65 сделок по военной ипотеке. Михаил видит, где покупатели теряют время, выбирают слабый объект или заходят в сделку без проверки.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Зона 5: Mini Footer -->
    <footer class="vn-video-footer">
      <div class="vn-container">
        <div class="vn-video-footer__inner">
          <span>© 2026 Военный навигатор · Михаил Хряпин</span>
          <button type="button" data-video-policy-open>Политика конфиденциальности</button>
        </div>
      </div>
    </footer>

    <VideoPrivacyPopup />
  </div>
</BaseLayout>

<style>
/* ─── Video page ─── */
.vn-video-page {
  background: var(--color-bg-dark);
  min-height: 100vh;
}

/* Mini Header */
.vn-video-header {
  background: var(--color-bg-dark);
  border-bottom: 1px solid var(--color-border-ondark);
  padding: 0;
}

.vn-video-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60px;
}

.vn-video-header__logo {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--color-text-ondark);
  text-decoration: none;
}

.vn-video-logo-mark {
  flex: 0 0 36px;
}

.vn-video-header__logo-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.vn-video-header__brand {
  color: var(--color-text-ondark);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.05;
}

.vn-video-header__name {
  color: var(--color-text-ondark-mute);
  font-size: 11px;
  font-weight: 500;
  line-height: 1.1;
}

.vn-video-header__tg {
  padding: 8px 16px;
  border: 1px solid rgba(241, 243, 245, 0.2);
  border-radius: var(--radius-md);
  color: var(--color-text-ondark);
  font-size: 13px;
  text-decoration: none;
  transition: border-color 150ms ease, background 150ms ease;
}

.vn-video-header__tg:hover {
  border-color: var(--color-accent-cta);
  background: var(--color-accent-cta-soft);
}

/* Hero */
.vn-video-hero {
  position: relative;
  overflow: hidden;
  padding: 76px 0 72px;
  background:
    radial-gradient(circle at 18% 18%, color-mix(in srgb, var(--color-accent-cta) 10%, transparent) 0%, transparent 36%),
    var(--color-bg-dark);
}

.vn-video-hero__left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  grid-column: 1 / 8;
}

.vn-video-hero__photo-wrap {
  position: relative;
  border-radius: 14px;
  isolation: isolate;
  max-width: 380px;
  margin-left: auto;
  background: var(--color-bg-dark-elev);
  box-shadow: var(--shadow-xl);
}

.vn-video-hero__photo-wrap::before,
.vn-video-hero__photo-wrap::after {
  content: '';
  position: absolute;
  inset: -10px;
  pointer-events: none;
  border: 1px solid color-mix(in srgb, var(--color-accent-cta) 32%, transparent);
  border-radius: 18px;
  z-index: -1;
}

.vn-video-hero__photo-wrap::after {
  inset: 14px;
  z-index: 2;
  border-color: color-mix(in srgb, var(--color-text-ondark) 10%, transparent);
}

.vn-video-hero__photo {
  width: 100%;
  height: auto;
  aspect-ratio: 380 / 440;
  object-fit: cover;
  object-position: center top;
  display: block;
  border-radius: 14px;
}

.vn-video-hero__trust {
  margin: 16px 0 0;
  font-size: 13px;
  color: var(--color-text-ondark-mute);
  text-align: center;
  max-width: 380px;
  margin-left: auto;
}

.vn-video-hero__right {
  grid-column: 8 / 13;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vn-video-hero__title {
  margin: 16px 0 0;
  font-size: clamp(34px, 4vw, 52px);
  font-weight: 600;
  color: var(--color-text-ondark);
  line-height: 1.1;
  letter-spacing: 0;
  text-wrap: balance;
}

.vn-video-hero__title-accent {
  display: block;
  color: color-mix(in srgb, var(--color-text-ondark) 76%, var(--color-accent-cta));
}

.vn-video-hero__bullets {
  max-width: 560px;
  margin: 24px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  list-style: none;
}

.vn-video-hero__bullets li {
  position: relative;
  padding-left: 26px;
  color: var(--color-text-ondark-mute);
  font-size: 15px;
  line-height: 1.55;
  text-wrap: pretty;
}

.vn-video-hero__bullets li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  background: var(--color-accent-cta);
  box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent-cta) 16%, transparent);
}

.vn-video-hero__sep {
  width: 40px;
  height: 2px;
  background: var(--color-accent-cta);
  margin: 20px 0;
}

.vn-video-hero__cta {
  align-self: flex-start;
}

/* Quiz section */
.vn-video-quiz {
  position: relative;
  overflow: hidden;
  padding: 104px 0;
  background: var(--color-bg-primary);
}

.vn-video-quiz::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
    linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
}

.vn-video-quiz__head,
.vn-video-quiz__grid {
  position: relative;
  z-index: 1;
}

.vn-video-quiz__head {
  margin-bottom: 42px;
  text-align: center;
}

.vn-video-quiz__grid {
  align-items: start;
}

.vn-video-quiz__title {
  margin: 0;
  color: var(--color-text-primary);
  font-size: clamp(28px, 3.2vw, 40px);
  font-weight: 600;
  line-height: 1.12;
  text-wrap: balance;
}

.vn-video-quiz__sub {
  max-width: 640px;
  margin: 16px auto 0;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
  line-height: 1.65;
  text-wrap: pretty;
}

.vn-video-quiz__form-shell {
  position: relative;
}

/* Trust block */
.vn-video-trust-block {
  position: relative;
  overflow: hidden;
  padding: 104px 0;
  background:
    radial-gradient(circle at 20% 8%, color-mix(in srgb, var(--color-accent-cta) 12%, transparent) 0%, transparent 36%),
    var(--color-bg-dark);
}

.vn-video-trust-block::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, var(--color-deco-grid-dark) 1px, transparent 1px),
    linear-gradient(to bottom, var(--color-deco-grid-dark) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
}

.vn-video-trust-block__grid {
  position: relative;
  z-index: 1;
  align-items: start;
}

.vn-video-trust-block__left {
  position: sticky;
  top: 32px;
}

.vn-video-trust-block__title {
  margin: 0;
  color: var(--color-text-ondark);
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 600;
  line-height: 1.12;
  text-wrap: balance;
}

.vn-video-trust-block__text {
  max-width: 480px;
  margin: 22px 0 0;
  color: var(--color-text-ondark-mute);
  font-size: var(--fs-lead);
  line-height: 1.65;
  text-wrap: pretty;
}

.vn-video-trust-block__cta {
  margin-top: 32px;
}

.vn-video-trust-block__right {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--color-border-ondark);
}

.vn-video-trust-row {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 24px;
  padding: 28px 0;
  border-bottom: 1px solid var(--color-border-ondark);
}

.vn-video-trust-row__num {
  color: var(--color-accent-cta);
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.08em;
  line-height: 1.5;
}

.vn-video-trust-row h3 {
  margin: 0;
  color: var(--color-text-ondark);
  font-size: 18px;
  font-weight: 600;
  line-height: 1.25;
  text-wrap: balance;
}

.vn-video-trust-row p {
  max-width: 620px;
  margin: 10px 0 0;
  color: var(--color-text-ondark-mute);
  font-size: var(--fs-body);
  line-height: 1.65;
  text-wrap: pretty;
}

/* Footer */
.vn-video-footer {
  background: var(--color-bg-dark);
  border-top: 1px solid var(--color-border-ondark);
}

.vn-video-footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  font-size: 12px;
  color: rgba(241, 243, 245, 0.35);
}

.vn-video-footer__inner button {
  padding: 0;
  border: none;
  background: transparent;
  color: inherit;
  font: inherit;
  text-decoration: none;
  transition: color 150ms ease;
  cursor: pointer;
}

.vn-video-footer__inner button:hover {
  color: var(--color-text-ondark);
}

/* Mobile */
@media (max-width: 1023px) {
  .vn-video-hero__left,
  .vn-video-hero__right {
    grid-column: 1 / -1 !important;
  }
  .vn-video-hero__right {
    order: 2;
  }
  .vn-video-hero__photo-wrap {
    max-width: 320px;
    margin: 0 auto;
  }
  .vn-video-hero__trust {
    margin-left: auto;
    margin-right: auto;
  }
  .vn-video-hero__right {
    margin-top: 32px;
  }
  .vn-video-quiz__form-shell {
    grid-column: 1 / -1 !important;
  }
  .vn-video-trust-block__left,
  .vn-video-trust-block__right {
    grid-column: 1 / -1 !important;
  }
  .vn-video-trust-block__left {
    position: static;
  }
  .vn-video-trust-block__right {
    margin-top: 40px;
  }
}

@media (max-width: 640px) {
  .vn-video-hero {
    padding: 48px 0 40px;
  }
  .vn-video-hero__title {
    font-size: 34px;
  }
  .vn-video-hero__cta {
    width: 100%;
    justify-content: center;
  }
  .vn-video-header__brand {
    font-size: 13px;
  }
  .vn-video-header__name {
    font-size: 10px;
  }
  .vn-video-quiz {
    padding: 56px 0;
  }
  .vn-video-quiz__head {
    margin-bottom: 32px;
  }
  .vn-video-quiz__title,
  .vn-video-quiz__sub {
    grid-column: 1 / -1 !important;
  }
  .vn-video-quiz__title {
    font-size: 28px;
  }
  .vn-video-quiz__sub {
    font-size: 15px;
  }
  .vn-video-trust-block {
    padding: 56px 0;
  }
  .vn-video-trust-block__text {
    font-size: 16px;
  }
  .vn-video-trust-block__cta {
    width: 100%;
    justify-content: center;
  }
  .vn-video-trust-row {
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 22px 0;
  }
  .vn-video-footer__inner {
    flex-direction: column;
    height: auto;
    padding: 16px 0;
    gap: 6px;
    text-align: center;
  }
  .vn-video-header__tg {
    display: none;
  }
}

/* Spin animation for loader */
@keyframes spin {
  to { transform: rotate(360deg); }
}

:global(.spin) {
  animation: spin 1s linear infinite;
}
</style>
