---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';

const points = [
  {
    title: 'Практика на реальных сделках',
    desc: '180 сделок с недвижимостью, из них 65 — по военной ипотеке. Опыт с 2016 года.'
  },
  {
    title: 'Персональная ответственность',
    desc: 'Клиент не передаёт по цепочке. Михаил лично формирует стратегию и контролирует каждый этап.'
  },
  {
    title: 'Разбор до выбора объекта',
    desc: 'Сначала проверяет статус НИС, ограничения банка и реальный бюджет — и только потом подбирает варианты.'
  }
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-role-of-mikhail" class="vn-section vn-role" aria-labelledby="vn-role-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-role__layout">

        <!-- Левая часть: Фото -->
        <div class="vn-role__photo-col" style="grid-column: 1 / 6">
          <div class="vn-role__photo-card">
            <div class="vn-role__photo-frame">
              <span class="vn-role__bracket vn-role__bracket--tl" aria-hidden="true"></span>
              <span class="vn-role__bracket vn-role__bracket--tr" aria-hidden="true"></span>
              <span class="vn-role__bracket vn-role__bracket--bl" aria-hidden="true"></span>
              <span class="vn-role__bracket vn-role__bracket--br" aria-hidden="true"></span>

              <div class="vn-role__photo-wrap">
                <OptimizedImage
                  src="/images/mikhail-hero.jpg"
                  alt="Михаил Хряпин — эксперт по военной ипотеке"
                  width={560}
                  height={680}
                  loading="eager"
                  fetchpriority="high"
                  class="vn-role__photo"
                />
              </div>
            </div>
            <div class="vn-role__caption">
              <p class="vn-role__name">Михаил Хряпин</p>
              <p class="vn-role__role">Главный эксперт сервиса</p>
            </div>
          </div>
        </div>

        <!-- Правая часть: Контент -->
        <div class="vn-role__content-col" style="grid-column: 7 / 13">
          <span class="vn-role__eyebrow">Экспертиза</span>

          <h2 class="vn-role__title" id="vn-role-title">
            Первичный разбор ведёт Михаил Хряпин —
            <span class="vn-role__title-accent">главный эксперт сервиса.</span>
          </h2>

          <p class="vn-role__lead">
            Михаил лично проводит первичный разбор: проверяет статус НИС, ограничения банка и реальный бюджет, чтобы сразу отсечь неподходящие варианты.
          </p>

          <div class="vn-role__points">
            {points.map((point) => (
              <div class="vn-role__point">
                <h3 class="vn-role__point-title">{point.title}</h3>
                <p class="vn-role__point-desc">{point.desc}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-role {
    padding-block: 120px;
    background: var(--color-bg-surface);
  }

  .vn-role__layout {
    align-items: center;
    gap: 64px;
  }

  /* Photo */
  .vn-role__photo-card {
    display: grid;
    gap: 18px;
  }

  .vn-role__photo-frame {
    position: relative;
    padding: 16px;
  }

  .vn-role__bracket {
    position: absolute;
    width: 20px;
    height: 20px;
    pointer-events: none;
    z-index: 2;
  }

  .vn-role__bracket::before,
  .vn-role__bracket::after {
    content: '';
    position: absolute;
    background: color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }

  .vn-role__bracket--tl { top: 0; left: 0; }
  .vn-role__bracket--tl::before { top: 0; left: 0; width: 12px; height: 1px; }
  .vn-role__bracket--tl::after { top: 0; left: 0; width: 1px; height: 12px; }

  .vn-role__bracket--tr { top: 0; right: 0; }
  .vn-role__bracket--tr::before { top: 0; right: 0; width: 12px; height: 1px; }
  .vn-role__bracket--tr::after { top: 0; right: 0; width: 1px; height: 12px; }

  .vn-role__bracket--bl { bottom: 0; left: 0; }
  .vn-role__bracket--bl::before { bottom: 0; left: 0; width: 12px; height: 1px; }
  .vn-role__bracket--bl::after { bottom: 0; left: 0; width: 1px; height: 12px; }

  .vn-role__bracket--br { bottom: 0; right: 0; }
  .vn-role__bracket--br::before { bottom: 0; right: 0; width: 12px; height: 1px; }
  .vn-role__bracket--br::after { bottom: 0; right: 0; width: 1px; height: 12px; }

  .vn-role__photo-wrap {
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-bg-dark) 8%, transparent);
  }

  :global(.vn-role__photo) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .vn-role__caption {
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg-secondary);
  }

  .vn-role__name {
    margin: 0 0 6px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-role__role {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Content */
  .vn-role__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vn-role__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
  }

  .vn-role__title {
    margin: 24px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-role__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-role__lead {
    margin: 20px 0 0;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-role__points {
    display: grid;
    gap: 0;
    margin-top: 40px;
  }

  .vn-role__point {
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }

  .vn-role__point:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .vn-role__point-title {
    margin: 0 0 8px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-role__point-desc {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* Tablet */
  @media (max-width: 1023px) {
    .vn-role {
      padding-block: 96px;
    }

    .vn-role__layout {
      gap: 48px;
    }

    .vn-role__photo-col,
    .vn-role__content-col {
      grid-column: 1 / -1 !important;
    }

    .vn-role__photo-col {
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .vn-role {
      padding-block: 64px;
    }

    .vn-role__layout {
      gap: 32px;
    }

    .vn-role__photo-frame {
      padding: 12px;
    }

    .vn-role__caption {
      padding: 14px 16px;
    }

    .vn-role__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
      line-height: 1.2;
    }

    .vn-role__lead {
      font-size: var(--fs-body);
      line-height: 1.55;
      margin-top: 16px;
    }

    .vn-role__points {
      margin-top: 28px;
    }

    .vn-role__point {
      padding: 16px 0;
    }

    .vn-role__point-title {
      font-size: var(--fs-body-sm);
      margin-bottom: 6px;
    }

    .vn-role__point-desc {
      font-size: var(--fs-body-xs);
      line-height: 1.5;
    }
  }
</style>
