---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const cards = [
  {
    label: 'Не каталог',
    title: 'Сервис начинается не с витрины',
    text: 'Военный навигатор не строит маршрут от случайного списка объектов. Сначала нужно понять, что именно вы решаете покупкой.',
  },
  {
    label: 'Не агрегатор',
    title: 'Логика важнее количества вариантов',
    text: 'Сервис помогает отсеять неподходящие сценарии ещё до подбора, чтобы не тратить время на витрину без критериев.',
  },
  {
    label: 'Что получает клиент',
    title: 'Понятный маршрут покупки',
    text: 'После первого обращения становится яснее, с чего начать: считать, подбирать, готовить сделку или скорректировать ожидания.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-what-is-service" class="vn-section vn-about-service" aria-labelledby="vn-about-service-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-about-service__header">
        <div style="grid-column: 1 / 4">
          <span class="vn-label-mono">What is service</span>
        </div>
        <div style="grid-column: 4 / 9">
          <h2 class="vn-about-service__title" id="vn-about-service-title">
            Что такое Военный навигатор
          </h2>
        </div>
        <div style="grid-column: 9 / 13">
          <p class="vn-about-service__lead">
            Это сервис выбора новостройки и сопровождения покупки по военной ипотеке, где главный первый шаг — разбор ситуации до выбора объекта.
          </p>
        </div>
      </div>

      <div class="vn-about-service__cards vn-grid-12">
        {cards.map((card, index) => (
          <article class="vn-about-service__card" style={`grid-column: ${index === 0 ? '1 / 5' : index === 1 ? '5 / 9' : '9 / 13'}`}>
            <span class="vn-about-service__label">{card.label}</span>
            <h3 class="vn-about-service__card-title">{card.title}</h3>
            <p class="vn-about-service__text">{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-about-service__header {
    align-items: start;
    margin-bottom: 32px;
  }

  .vn-about-service__title {
    margin: 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
  }

  .vn-about-service__lead {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .vn-about-service__cards {
    gap: 16px 24px;
  }

  .vn-about-service__card {
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface-lowest);
  }

  .vn-about-service__label {
    display: inline-flex;
    margin-bottom: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .vn-about-service__card-title {
    margin: 0 0 10px;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.32;
    color: var(--color-text-primary);
  }

  .vn-about-service__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .vn-about-service__header > div {
      grid-column: 1 / -1 !important;
    }

    .vn-about-service__lead {
      margin-top: 16px;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-top: 16px;
    }

    .vn-about-service__cards > .vn-about-service__card:nth-child(odd) {
      grid-column: 1 / 7 !important;
    }

    .vn-about-service__cards > .vn-about-service__card:nth-child(even) {
      grid-column: 7 / 13 !important;
    }

    .vn-about-service__cards > .vn-about-service__card:nth-child(3) {
      grid-column: 1 / 7 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-about-service__cards > .vn-about-service__card:nth-child(n) {
      grid-column: 1 / -1 !important;
    }
  }
</style>
