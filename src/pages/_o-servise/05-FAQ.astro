---
interface FAQItem {
  q: string;
  a: string;
}

const items: FAQItem[] = [
  {
    q: 'Это агентство или сервис?',
    a: 'Военный навигатор — это сервис с прозрачным процессом. Мы не просто показываем каталог, а ведём вас от разбора ситуации до сделки, отсеивая неподходящие варианты ещё на этапе проверки.'
  },
  {
    q: 'Кто проводит первичный разбор?',
    a: 'Разбор лично проводит Михаил Хряпин. Он оценивает вашу ситуацию, статус НИС и ограничения банка, чтобы дать честную оценку шансов и бюджета, а не просто передать заявку рядовому менеджеру.'
  },
  {
    q: 'Что происходит после заявки?',
    a: 'Мы связываемся с вами в течение рабочего дня, чтобы назначить время для 30-минутного бесплатного разбора. После него вы получаете чёткий план действий и подборку реальных объектов.'
  },
  {
    q: 'Работаете только по Краснодару и Крыму?',
    a: 'Да, наша основная экспертиза сосредоточена на новостройках Краснодара и Крыма. Мы знаем специфику аккредитации местных застройщиков и точные требования банков в этих регионах.'
  },
  {
    q: 'Можно ли пройти разбор дистанционно?',
    a: 'Да. Первичный разбор и всё последующее сопровождение можно провести полностью дистанционно через видеосвязь и электронный документооборот.'
  },
  {
    q: 'Сколько стоит сервис?',
    a: 'Для покупателя сервис полностью бесплатен. Нашу работу оплачивает застройщик в рамках партнёрской программы, цена квартиры для вас не увеличивается.'
  }
];
---

<section id="section-faq" class="vn-home-faq" aria-labelledby="vn-home-faq-title">
  <div class="vn-container">
    <div class="vn-grid-12 vn-home-faq__grid">
      <div class="vn-home-faq__left" style="grid-column: 1 / 5">
        <span class="vn-label-mono">FAQ</span>
        <h2 class="vn-home-faq__title" id="vn-home-faq-title">
          Вопросы о сервисе и первом разборе
        </h2>
        <p class="vn-home-faq__lead">
          Здесь собраны ответы о сервисе, разборе ситуации, регионах работы и моменте перехода к подбору объекта.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Получить разбор ситуации"
          class="vn-home-faq__more-link"
        >
          Не нашли свой вопрос? Разберите ситуацию на первом шаге&nbsp;→
        </a>
      </div>

      <div class="vn-home-faq__right" style="grid-column: 5 / 13" itemscope itemtype="https://schema.org/FAQPage">
        {items.map((item, i) => (
          <details
            class="vn-home-faq__item"
            itemscope
            itemprop="mainEntity"
            itemtype="https://schema.org/Question"
          >
            <summary class="vn-home-faq__question">
              <span class="vn-home-faq__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="vn-home-faq__question-text" itemprop="name">{item.q}</span>
              <svg
                class="vn-home-faq__icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="vn-home-faq__answer-wrap">
              <div class="vn-home-faq__answer-inner" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p class="vn-home-faq__answer-text" itemprop="text">{item.a}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .vn-home-faq {
    padding: 96px 0;
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
  }

  .vn-home-faq__grid {
    align-items: start;
  }

  .vn-home-faq__left {
    position: sticky;
    top: 104px;
  }

  .vn-home-faq__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.18;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-faq__lead {
    margin: 14px 0 0;
    max-width: 340px;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .vn-home-faq__more-link {
    display: inline-flex;
    margin-top: 28px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-accent-cta);
    text-decoration: none;
  }

  .vn-home-faq__right {
    display: flex;
    flex-direction: column;
  }

  .vn-home-faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .vn-home-faq__item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .vn-home-faq__question {
    width: 100%;
    min-height: 56px;
    padding: 28px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    list-style: none;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    border-radius: var(--radius-lg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .vn-home-faq__question::-webkit-details-marker {
    display: none;
  }

  .vn-home-faq__question:hover {
    background-color: color-mix(in srgb, var(--color-accent-cta) 4%, transparent);
  }

  .vn-home-faq__num {
    flex-shrink: 0;
    width: 32px;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent-cta);
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  .vn-home-faq__question-text {
    flex: 1;
    color: var(--color-text-primary);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.4;
    text-wrap: pretty;
    transition: color 0.2s ease;
  }

  .vn-home-faq__question:hover .vn-home-faq__question-text {
    color: var(--color-accent-cta);
  }

  .vn-home-faq__icon {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }

  .vn-home-faq__item[open] .vn-home-faq__question {
    background-color: color-mix(in srgb, var(--color-accent-cta) 6%, transparent);
  }

  .vn-home-faq__item[open] .vn-home-faq__icon {
    transform: rotate(180deg);
    color: var(--color-accent-cta);
  }

  .vn-home-faq__item[open] .vn-home-faq__question-text {
    color: var(--color-accent-cta);
  }

  .vn-home-faq__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.17, 0.84, 0.44, 1);
  }

  .vn-home-faq__item[open]:not(.is-closing) .vn-home-faq__answer-wrap {
    grid-template-rows: 1fr;
  }

  .vn-home-faq__answer-inner {
    overflow: hidden;
  }

  .vn-home-faq__answer-text {
    margin: 0;
    padding: 0 0 24px 44px;
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .vn-home-faq__left {
      grid-column: 1 / -1 !important;
      position: static;
      margin-bottom: 40px;
    }

    .vn-home-faq__right {
      grid-column: 1 / -1 !important;
    }

    .vn-home-faq__lead {
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
    .vn-home-faq {
      padding: 56px 0;
    }

    .vn-home-faq__question {
      padding: 16px 0;
      gap: 12px;
      min-height: 48px;
    }

    .vn-home-faq__question-text {
      font-size: var(--fs-body);
      line-height: 1.4;
    }

    .vn-home-faq__answer-text {
      padding: 0 0 20px 36px;
      font-size: var(--fs-body-sm);
      line-height: 1.55;
    }
  }
</style>

<script>
  (function () {
    function hasAnalyticsConsent() {
      try {
        return window.localStorage.getItem('vn_cookie_consent') === 'accepted';
      } catch (_) {
        return false;
      }
    }

    const container = document.querySelector('.vn-home-faq__right');
    if (!container) return;

    const items = container.querySelectorAll<HTMLDetailsElement>('.vn-home-faq__item');
    const DURATION = 400;

    items.forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.vn-home-faq__question');
      const content = details.querySelector<HTMLElement>('.vn-home-faq__answer-wrap');
      if (!summary || !content) return;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = details.hasAttribute('open');

        if (!isOpen && hasAnalyticsConsent() && window.ym) {
          const cid = parseInt(document.querySelector('meta[name="ym-counter-id"]')?.getAttribute('content') || '0', 10);
          if (cid) window.ym(cid, 'reachGoal', 'faq_open');
        }

        items.forEach((sibling) => {
          if (sibling !== details && sibling.hasAttribute('open')) {
            const siblingContent = sibling.querySelector<HTMLElement>('.vn-home-faq__answer-wrap');
            if (siblingContent) {
              sibling.classList.add('is-closing');
              siblingContent.style.gridTemplateRows = '0fr';
              window.setTimeout(() => {
                sibling.removeAttribute('open');
                sibling.classList.remove('is-closing');
                siblingContent.style.gridTemplateRows = '';
              }, DURATION);
            }
          }
        });

        if (isOpen) {
          details.classList.add('is-closing');
          content.style.gridTemplateRows = '0fr';
          window.setTimeout(() => {
            details.removeAttribute('open');
            details.classList.remove('is-closing');
            content.style.gridTemplateRows = '';
          }, DURATION);
        } else {
          details.setAttribute('open', '');
          requestAnimationFrame(() => {
            content.style.gridTemplateRows = '1fr';
            window.setTimeout(() => {
              content.style.gridTemplateRows = '';
            }, DURATION);
          });
        }
      });
    });
  })();
</script>
