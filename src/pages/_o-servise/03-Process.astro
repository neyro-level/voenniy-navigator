---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const steps = [
  {
    num: '01',
    title: 'Первичный разбор',
    subtitle: '30 минут, бесплатно',
    desc: 'Выясняем задачу, проверяем статус НИС и ограничения банка. Даём честную оценку шансов и бюджета.',
  },
  {
    num: '02',
    title: 'Точечный подбор новостроек',
    subtitle: 'Только подходящие объекты',
    desc: 'Отсеиваем неподходящие ЖК на этапе аккредитации и сроков сдачи. Оставляем только те варианты, которые реально одобрят.',
  },
  {
    num: '03',
    title: 'Помощь с ипотекой',
    subtitle: 'Бесплатно для вас',
    desc: 'Готовим пакет документов, подаём заявки в нужные банки и добиваемся одобрения по военной ипотеке.',
  },
  {
    num: '04',
    title: 'Сопровождение сделки',
    subtitle: 'До получения ключей',
    desc: 'Контролируем договор, проверку объекта и регистрацию. Вы получаете ключи, мы закрываем задачу.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-process" class="vn-section vn-process" aria-labelledby="vn-process-title">
    <div class="vn-container">
      <!-- Section header -->
      <div class="vn-process__header">
        <span class="vn-process__eyebrow">Процесс</span>
        <h2 class="vn-process__title" id="vn-process-title">
          Четыре шага от первичного разбора до сделки
        </h2>
        <p class="vn-process__lead">
          Сначала определяем вашу реальную ситуацию, затем подбираем только те варианты, которые проходят по условиям военной ипотеки, и сопровождаем до регистрации права.
        </p>
      </div>

      <!-- Steps timeline -->
      <div class="vn-process__timeline">
        {steps.map((step) => (
          <div class="vn-process__card">
            <span class="vn-process__card-num">{step.num}</span>
            <div class="vn-process__card-content">
              <h3 class="vn-process__card-title">{step.title}</h3>
              <span class="vn-process__card-subtitle">{step.subtitle}</span>
              <p class="vn-process__card-desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-process {
    padding-block: 120px;
    background: var(--color-bg-secondary);
  }

  /* Header */
  .vn-process__header {
    max-width: 720px;
    margin-bottom: 64px;
  }

  .vn-process__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vn-process__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
  }

  .vn-process__title {
    margin: 24px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-process__lead {
    margin: 20px 0 0;
    max-width: 640px;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Timeline grid */
  .vn-process__timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 24px;
  }

  .vn-process__timeline::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    z-index: 0;
  }

  /* Card */
  .vn-process__card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .vn-process__card-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: 56px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent-cta);
    font-variant-numeric: tabular-nums;
  }

  .vn-process__card-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px 28px 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
  }

  .vn-process__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .vn-process__card-subtitle {
    font-size: var(--fs-body-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-accent-primary);
  }

  .vn-process__card-desc {
    margin: 8px 0 0;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Tablet */
  @media (max-width: 1023px) {
    .vn-process {
      padding-block: 96px;
    }

    .vn-process__header {
      margin-bottom: 48px;
    }

    .vn-process__timeline {
      gap: 40px 20px;
    }

    .vn-process__timeline::before {
      top: 20px;
    }

    .vn-process__card-num {
      height: 40px;
      min-width: 52px;
      padding: 0 12px;
    }

    .vn-process__card-content {
      padding: 24px;
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .vn-process {
      padding-block: 64px;
    }

    .vn-process__header {
      margin-bottom: 32px;
    }

    .vn-process__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
      line-height: 1.2;
    }

    .vn-process__lead {
      font-size: var(--fs-body);
      line-height: 1.55;
    }

    .vn-process__timeline {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-left: 28px;
    }

    .vn-process__timeline::before {
      top: 0;
      bottom: 0;
      left: 0;
      right: auto;
      width: 1px;
      height: auto;
    }

    .vn-process__card {
      flex-direction: row;
      gap: 16px;
    }

    .vn-process__card-num {
      flex-shrink: 0;
      align-self: flex-start;
      width: 44px;
      min-width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 50%;
      font-size: var(--fs-body-sm);
    }

    .vn-process__card-content {
      flex: 1;
      padding: 20px;
      gap: 4px;
    }

    .vn-process__card-title {
      font-size: var(--fs-body-lg);
    }

    .vn-process__card-subtitle {
      font-size: var(--fs-body-xs);
    }

    .vn-process__card-desc {
      margin-top: 6px;
      font-size: var(--fs-body-sm);
      line-height: 1.5;
    }
  }
</style>
