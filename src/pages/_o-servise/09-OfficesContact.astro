---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import { CONTACTS, OFFICES } from '../../lib/constants';
import { getConfiguredValue } from '../../lib/utils';

const telegramHref = getConfiguredValue(CONTACTS.telegram);
const vkHref = getConfiguredValue(CONTACTS.vk);
const maxHref = getConfiguredValue(CONTACTS.max);
---

<RevealOnScroll mode="fade-up">
  <section id="section-offices-contact" class="vn-section vn-about-contacts" aria-labelledby="vn-about-contacts-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-about-contacts__layout">
        <div style="grid-column: 1 / 5">
          <span class="vn-label-mono">Offices and contact</span>
          <h2 class="vn-about-contacts__title" id="vn-about-contacts-title">
            Где находится сервис и как связаться
          </h2>
          <p class="vn-about-contacts__lead">
            Физические точки контакта усиливают доверие, но сам маршрут может начинаться дистанционно — с первичного разбора ситуации.
          </p>
        </div>

        <div style="grid-column: 5 / 13" class="vn-about-contacts__content">
          <div class="vn-about-contacts__offices">
            {OFFICES.map((office) => (
              <article class="vn-about-contacts__office">
                <h3>{office.city}</h3>
                <p>{office.address}{office.detail ? `, ${office.detail}` : ''}</p>
                <span>{office.note}</span>
              </article>
            ))}
          </div>

          <div class="vn-about-contacts__actions">
            <a href={`tel:${CONTACTS.phone}`} class="vn-about-contacts__action-link">Позвонить: {CONTACTS.phone}</a>
            {telegramHref && <a href={telegramHref} target="_blank" rel="noopener noreferrer" class="vn-about-contacts__action-link">Написать в Telegram</a>}
            {vkHref && <a href={vkHref} target="_blank" rel="noopener noreferrer" class="vn-about-contacts__action-link">Разборы в VK</a>}
            {maxHref && <a href={maxHref} target="_blank" rel="noopener noreferrer" class="vn-about-contacts__action-link">Max</a>}
            <a href="/contacts/" class="vn-about-contacts__action-link">Все контакты и офисы →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-about-contacts__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
  }

  .vn-about-contacts__lead {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .vn-about-contacts__content {
    display: grid;
    gap: 24px;
  }

  .vn-about-contacts__offices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .vn-about-contacts__office {
    display: grid;
    gap: 8px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
  }

  .vn-about-contacts__office h3 {
    margin: 0;
    font-size: var(--fs-h3);
    color: var(--color-text-primary);
  }

  .vn-about-contacts__office p,
  .vn-about-contacts__office span {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .vn-about-contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .vn-about-contacts__action-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-surface-lowest);
    color: var(--color-text-primary);
    font-size: var(--fs-body-sm);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .vn-about-contacts__action-link:hover {
    border-color: color-mix(in srgb, var(--color-accent-cta) 24%, var(--color-border));
    color: var(--color-accent-cta);
    background: var(--color-accent-cta-soft);
  }

  @media (max-width: 1023px) {
    .vn-about-contacts__layout > div {
      grid-column: 1 / -1 !important;
    }

    .vn-about-contacts__content {
      margin-top: 28px;
    }
  }

  @media (max-width: 640px) {
    .vn-about-contacts__offices {
      grid-template-columns: 1fr;
    }

    .vn-about-contacts__actions {
      flex-direction: column;
    }
  }
</style>
