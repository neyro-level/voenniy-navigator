---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const factors = [
  'НИС и стадия накоплений',
  'Банк и ограничения программы',
  'Бюджет и сценарий платежей',
  'Срок покупки и срок сдачи объекта',
  'Регион покупки и формат сделки',
  'Цель покупки: для жизни, позже или как вложение',
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-why-military" class="vn-section vn-section--secondary vn-about-why" aria-labelledby="vn-about-why-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-about-why__layout">
        <div style="grid-column: 1 / 7">
          <span class="vn-label-mono">Why for military families</span>
          <h2 class="vn-about-why__title" id="vn-about-why-title">
            Почему военнослужащему нужен маршрут, а не случайная подборка
          </h2>
          <p class="vn-about-why__lead">
            При покупке по военной ипотеке выбор редко строится только от цены или картинки объекта.
            На решение одновременно влияют программа, сроки, банк, регион и жизненная задача семьи.
          </p>
        </div>

        <div style="grid-column: 8 / 13">
          <div class="vn-about-why__panel">
            <p class="vn-about-why__panel-label">Что влияет на маршрут</p>
            <ul class="vn-about-why__list">
              {factors.map((factor) => (
                <li>{factor}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-about-why__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-about-why__lead {
    margin: 0;
    max-width: 560px;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .vn-about-why__panel {
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--color-bg-surface);
  }

  .vn-about-why__panel-label {
    margin: 0 0 16px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .vn-about-why__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vn-about-why__list li {
    position: relative;
    padding-left: 18px;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .vn-about-why__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-cta);
    transform: translateY(-50%);
  }

  @media (max-width: 1023px) {
    .vn-about-why__layout > div {
      grid-column: 1 / -1 !important;
    }

    .vn-about-why__panel {
      margin-top: 28px;
    }
  }

  @media (max-width: 640px) {
    .vn-about-why__panel {
      padding: 22px;
    }
  }
</style>
