---
---

<section id="section-o-service-hero" class="vn-about-hero">
  <div class="vn-about-hero__grid" aria-hidden="true"></div>
  <div class="vn-about-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12 vn-about-hero__layout">
      <div class="vn-about-hero__content" style="grid-column: 1 / 8">
        <span class="vn-about-hero__eyebrow">О сервисе</span>

        <h1 class="vn-about-hero__title">
          Военный навигатор — сервис, который ведёт покупку новостройки по военной ипотеке
          <span class="vn-about-hero__title-accent">от разбора до сделки.</span>
        </h1>

        <p class="vn-about-hero__lead">
          Проверяем статус НИС, сравниваем банки и подбираем новостройки, которые реально одобрят. Без комиссии для покупателя.
        </p>

        <div class="vn-about-hero__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Получить первичный разбор"
            class="vn-btn-primary vn-about-hero__cta"
          >
            Получить первичный разбор
          </a>
        </div>

        <div class="vn-about-hero__trust-row">
          <span class="vn-about-hero__trust-item">65 сделок по военной ипотеке</span>
          <span class="vn-about-hero__trust-divider" aria-hidden="true"></span>
          <span class="vn-about-hero__trust-item">180 сделок с недвижимостью</span>
          <span class="vn-about-hero__trust-divider" aria-hidden="true"></span>
          <span class="vn-about-hero__trust-item">С 2016 года</span>
        </div>
      </div>

      <div class="vn-about-hero__aside" style="grid-column: 8 / 13">
        <div class="vn-about-hero__route">
          <span class="vn-about-hero__route-label">Маршрут сервиса</span>
          <ol class="vn-about-hero__route-list">
            <li class="vn-about-hero__route-item">
              <span class="vn-about-hero__route-num">01</span>
              <span class="vn-about-hero__route-name">Разбор ситуации</span>
            </li>
            <li class="vn-about-hero__route-item">
              <span class="vn-about-hero__route-num">02</span>
              <span class="vn-about-hero__route-name">Подбор новостроек</span>
            </li>
            <li class="vn-about-hero__route-item">
              <span class="vn-about-hero__route-num">03</span>
              <span class="vn-about-hero__route-name">Помощь с ипотекой</span>
            </li>
            <li class="vn-about-hero__route-item">
              <span class="vn-about-hero__route-num">04</span>
              <span class="vn-about-hero__route-name">Сопровождение сделки</span>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-about-hero {
    position: relative;
    overflow: hidden;
    padding-top: 132px;
    padding-bottom: 96px;
    background: var(--color-bg-primary);
  }

  .vn-about-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    z-index: 0;
  }

  .vn-about-hero__radial {
    position: absolute;
    top: -240px;
    right: -180px;
    width: 880px;
    height: 880px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-primary) 10%, transparent) 0%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .vn-about-hero__layout {
    position: relative;
    z-index: 1;
    align-items: center;
  }

  .vn-about-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vn-about-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
  }

  .vn-about-hero__title {
    margin: 24px 0 0;
    max-width: 760px;
    font-size: var(--fs-display);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-about-hero__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-about-hero__lead {
    margin: 24px 0 0;
    max-width: 620px;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .vn-about-hero__trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .vn-about-hero__trust-item {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .vn-about-hero__trust-divider {
    display: inline-block;
    width: 1px;
    height: 16px;
    margin: 0 20px;
    background: var(--color-border);
  }

  .vn-about-hero__route {
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
  }

  .vn-about-hero__route-label {
    display: block;
    margin-bottom: 24px;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .vn-about-hero__route-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vn-about-hero__route-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .vn-about-hero__route-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--color-accent-cta-soft);
    color: var(--color-accent-cta);
    font-size: var(--fs-body-sm);
    font-weight: 600;
    flex-shrink: 0;
  }

  .vn-about-hero__route-name {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  @media (max-width: 1023px) {
    .vn-about-hero {
      padding-top: 100px;
      padding-bottom: 64px;
    }

    .vn-about-hero__content,
    .vn-about-hero__aside {
      grid-column: 1 / -1 !important;
    }

    .vn-about-hero__aside {
      margin-top: 40px;
      max-width: 480px;
    }

    .vn-about-hero__trust-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
      align-items: stretch;
    }

    .vn-about-hero__trust-item {
      white-space: normal;
    }

    .vn-about-hero__trust-divider {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .vn-about-hero {
      padding-top: 88px;
      padding-bottom: 48px;
    }

    .vn-about-hero__grid {
      background-size: 48px 48px;
    }

    .vn-about-hero__title {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .vn-about-hero__lead {
      font-size: var(--fs-body);
      line-height: 1.55;
    }

    .vn-about-hero__actions {
      flex-direction: column;
    }

    .vn-about-hero__cta {
      width: 100%;
      text-align: center;
    }

    .vn-about-hero__trust-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-top: 20px;
    }

    .vn-about-hero__trust-item {
      font-size: var(--fs-body-sm);
    }

    .vn-about-hero__aside {
      max-width: none;
    }

    .vn-about-hero__route {
      padding: 24px;
    }

    .vn-about-hero__route-item {
      gap: 12px;
    }

    .vn-about-hero__route-name {
      font-size: var(--fs-body-sm);
    }
  }
</style>
