---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import { OFFICES } from '../../lib/constants';

const proofItems = [
  {
    title: 'Два офиса и дистанционный формат',
    text: 'Краснодар, Бахчисарай и удалённый маршрут для тех, кто не может приехать лично.',
  },
  {
    title: 'Сервисный фокус на новостройках',
    text: 'Публичный фокус страницы и маршрута — новостройки, квартиры и покупка по военной ипотеке.',
  },
  {
    title: 'Первый шаг — разбор ситуации',
    text: 'Сервис начинается с понятного первого шага, а не с обещания быстрого подбора без контекста.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-proof-layer" class="vn-section vn-section--secondary vn-about-proof" aria-labelledby="vn-about-proof-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-about-proof__header">
        <div style="grid-column: 1 / 8">
          <span class="vn-label-mono">Proof layer</span>
          <h2 class="vn-about-proof__title" id="vn-about-proof-title">
            Какие факты уже можно проверить
          </h2>
        </div>
        <div style="grid-column: 8 / 13">
          <p class="vn-about-proof__lead">
            На этой странице используются только базовые подтверждаемые факты. Усиление статистики, внешних профилей и расширенного media-layer требует отдельного подтверждения.
          </p>
        </div>
      </div>

      <div class="vn-about-proof__grid vn-grid-12">
        {proofItems.map((item, index) => (
          <article class="vn-about-proof__card" style={`grid-column: ${index === 0 ? '1 / 5' : index === 1 ? '5 / 9' : '9 / 13'}`}>
            <h3 class="vn-about-proof__card-title">{item.title}</h3>
            <p class="vn-about-proof__text">{item.text}</p>
          </article>
        ))}
      </div>

      <div class="vn-about-proof__offices">
        {OFFICES.map((office) => (
          <div class="vn-about-proof__office">
            <strong>{office.city}</strong>
            <span>{office.address}{office.detail ? `, ${office.detail}` : ''}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-about-proof__header {
    align-items: end;
    margin-bottom: 36px;
  }

  .vn-about-proof__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
  }

  .vn-about-proof__lead {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .vn-about-proof__grid {
    gap: 16px 24px;
  }

  .vn-about-proof__card {
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
  }

  .vn-about-proof__card-title {
    margin: 0 0 10px;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.32;
    color: var(--color-text-primary);
  }

  .vn-about-proof__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vn-about-proof__offices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .vn-about-proof__office {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface-lowest);
  }

  .vn-about-proof__office strong {
    font-size: var(--fs-body);
    color: var(--color-text-primary);
  }

  .vn-about-proof__office span {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .vn-about-proof__header > div {
      grid-column: 1 / -1 !important;
    }

    .vn-about-proof__lead {
      margin-top: 16px;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-top: 16px;
    }

    .vn-about-proof__grid > .vn-about-proof__card:nth-child(n) {
      grid-column: 1 / -1 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-about-proof__offices {
      grid-template-columns: 1fr;
    }
  }
</style>
