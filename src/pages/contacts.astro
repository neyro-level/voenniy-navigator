---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, OFFICES } from '../lib/constants';
import { localBusinessKrasnodar, localBusinessCrimea, breadcrumbSchema } from '../lib/seo';

const schema = [
  localBusinessKrasnodar,
  localBusinessCrimea,
  breadcrumbSchema([
    { name: 'Главная', url: `${SITE.url}/` },
    { name: 'Контакты', url: `${SITE.url}/contacts/` },
  ]),
];
---
<PageLayout
  title="Контакты — Михаил Хряпин, военная ипотека Краснодар"
  description="Контакты Михаила Хряпина: офисы в Краснодаре и Бахчисарае (Крым). Телефон, Telegram, адрес. Записаться на разбор цели покупки."
  canonical={`${SITE.url}/contacts/`}
  ogImage={`${SITE.url}/og/contacts.jpg`}
  schema={schema}
>
  <!-- TODO: сборка блоков по PAGE_CONTACTS.md -->
  <section class="vn-section" id="request">
    <div class="vn-container">
      <h1>Контакты</h1>

      <div style="margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 800px;">
        <div class="vn-card">
          <div class="vn-label-mono" style="margin-bottom: 16px;">Краснодар</div>
          <p style="font-size: 15px; color: var(--color-text-secondary);">{OFFICES[0].address}</p>
          <!-- TODO: [PRIMARY_PHONE], [TELEGRAM] -->
        </div>
        <div class="vn-card">
          <div class="vn-label-mono" style="margin-bottom: 16px;">Крым</div>
          <p style="font-size: 15px; color: var(--color-text-secondary);">{OFFICES[1].address}</p>
        </div>
      </div>

      <div style="margin-top: 40px;">
        <a href="/contacts/#request" data-modal-open data-modal-title="Записаться на разбор" class="vn-btn-primary">
          Записаться на разбор
        </a>
      </div>
    </div>
  </section>
</PageLayout>
