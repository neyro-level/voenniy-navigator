---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const scenarios = [
  {
    title: 'Переезд в другой регион',
    text: 'Вы покупаете квартиру сейчас, а переезжаете позже. Мы подбираем объект с хорошей отдачей от аренды и сопровождаем сделку полностью удалённо.'
  },
  {
    title: 'Покупка для семьи',
    text: 'Главный фокус — безопасность, район и инфраструктура. Мы отсеиваем проблемных застройщиков и проверяем документы до того, как вы внесёте задаток.'
  },
  {
    title: 'Инвестиция и сохранение средств',
    text: 'Оцениваем не только цену входа, но и реальный потенциал роста цены, ликвидность и сроки сдачи, чтобы ваши средства работали эффективно.'
  },
  {
    title: 'Дистанционная сделка',
    text: 'Проводим все этапы согласования онлайн, организуем показ доверенным лицом и готовим документы, чтобы вам не пришлось летать на встречи.'
  }
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-scenarios" class="vn-home-scenarios" aria-labelledby="vn-home-scenarios-title">
    <div class="vn-container">
      <div class="vn-home-scenarios__header">
        <span class="vn-label-mono">Живые сценарии</span>
        <h2 class="vn-home-scenarios__title" id="vn-home-scenarios-title">
          Мы уже помогали в таких ситуациях
        </h2>
        <p class="vn-home-scenarios__lead">
          Не важно, на каком этапе вы сейчас. Мы не требуем от вас быть экспертом в ипотеке. 
          Достаточно описать свою задачу — мы подстроим маршрут под вашу реальную ситуацию.
        </p>
      </div>

      <div class="vn-home-scenarios__grid">
        {scenarios.map((scenario) => (
          <article class="vn-home-scenarios__card">
            <h3 class="vn-home-scenarios__card-title">{scenario.title}</h3>
            <p class="vn-home-scenarios__text">{scenario.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-scenarios {
    padding-block: 96px;
    background: var(--color-bg-primary);
  }

  .vn-home-scenarios__header {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .vn-home-scenarios__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-scenarios__lead {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-scenarios__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .vn-home-scenarios__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .vn-home-scenarios__card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-bg-dark) 6%, transparent);
  }

  .vn-home-scenarios__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-home-scenarios__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Мобильная адаптация */
  @media (max-width: 1023px) {
    .vn-home-scenarios {
      padding-block: 72px;
    }

    .vn-home-scenarios__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-home-scenarios__card {
      padding: 24px;
    }
  }

  @media (max-width: 640px) {
    .vn-home-scenarios {
      padding-block: 56px;
    }

    .vn-home-scenarios__header {
      margin-bottom: 40px;
    }

    .vn-home-scenarios__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
    }
  }
</style>
