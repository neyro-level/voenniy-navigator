---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const scenarios = [
  {
    tag: 'Цель покупки',
    title: 'Для жизни',
    text: 'Важны район, планировка, инфраструктура и удобство на каждый день для семьи.',
  },
  {
    tag: 'Ситуация',
    title: 'Переезд позже',
    text: 'Квартиру покупаете сейчас, а использовать планируете позже. Нужно понять, что делать с объектом до переезда.',
  },
  {
    tag: 'Цель покупки',
    title: 'Как вложение',
    text: 'Нужно оценить ликвидность, срок, район и сценарий использования, а не только цену входа.',
  },
  {
    tag: 'Формат сделки',
    title: 'Дистанционная покупка',
    text: 'Важно заранее понять, какие этапы можно пройти удалённо и где потребуется личное участие.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-scenarios" class="vn-section vn-home-scenarios" aria-labelledby="vn-home-scenarios-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-home-scenarios__header">
        <div style="grid-column: 1 / 8">
          <span class="vn-label-mono">Scenarios</span>
          <h2 class="vn-home-scenarios__title" id="vn-home-scenarios-title">
            Для какой ситуации нужен сервис
          </h2>
        </div>
        <div style="grid-column: 8 / 13">
          <p class="vn-home-scenarios__lead">
            Не нужно заранее знать объект или район. Достаточно понимать, какую задачу вы решаете покупкой
            и что уже ограничивает выбор по сделке.
          </p>
        </div>
      </div>

      <div class="vn-home-scenarios__grid vn-grid-12">
        {scenarios.map((scenario, index) => (
          <article class="vn-home-scenarios__card" style={`grid-column: ${index % 2 === 0 ? '1 / 7' : '7 / 13'}`}>
            <span class="vn-home-scenarios__tag">{scenario.tag}</span>
            <h3 class="vn-home-scenarios__card-title">{scenario.title}</h3>
            <p class="vn-home-scenarios__text">{scenario.text}</p>
          </article>
        ))}
      </div>

      <div class="vn-home-scenarios__footer">
        <p>
          Если вы не уверены, как назвать свою ситуацию, это нормально. На разборе сервис сначала раскладывает задачу,
          а потом определяет самый логичный маршрут покупки.
        </p>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-scenarios__header {
    align-items: end;
    margin-bottom: 40px;
  }

  .vn-home-scenarios__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-scenarios__lead {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .vn-home-scenarios__grid {
    gap: 16px 24px;
  }

  .vn-home-scenarios__card {
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
  }

  .vn-home-scenarios__tag {
    display: inline-flex;
    margin-bottom: 12px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-text-tertiary);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vn-home-scenarios__card-title {
    margin: 0 0 10px;
    font-size: var(--fs-h3);
    line-height: 1.32;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-home-scenarios__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-scenarios__footer {
    margin-top: 24px;
    padding: 20px 0 0;
    border-top: 1px solid var(--color-border);
  }

  .vn-home-scenarios__footer p {
    margin: 0;
    max-width: 780px;
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 1023px) {
    .vn-home-scenarios__header > div {
      grid-column: 1 / -1 !important;
    }

    .vn-home-scenarios__lead {
      margin-top: 16px;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-top: 16px;
    }

    .vn-home-scenarios__grid > .vn-home-scenarios__card:nth-child(n) {
      grid-column: 1 / -1 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-home-scenarios__card {
      padding: 20px;
    }
  }
</style>
