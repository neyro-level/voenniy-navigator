---
import { Icon } from 'astro-icon/components';
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const scenarios = [
  {
    marker: '01',
    icon: 'home',
    title: 'Квартира для жизни',
    text: 'Подбираем под ваш ритм жизни: район, инфраструктура, срок сдачи и планировку. Проверяем застройщика и документы до задатка.',
  },
  {
    marker: '02',
    icon: 'compass',
    title: 'Переезд позже',
    text: 'Покупаете сейчас, переезжаете потом. Ищем объект с арендным потенциалом и ведём сделку удалённо, если вы в другом городе.',
  },
  {
    marker: '03',
    icon: 'percent',
    title: 'Вложение средств',
    text: 'Считаем не только цену входа, но и ликвидность, потенциал роста и сроки сдачи. Цель — чтобы деньги работали, а не лежали.',
  },
  {
    marker: '04',
    icon: 'globe',
    title: 'Дистанционная покупка',
    text: 'Все этапы — онлайн. Показы организуем доверенным лицом, документы готовим так, чтобы вам не пришлось летать на встречи.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section
    id="section-scenarios"
    class="vn-home-scenarios"
    aria-labelledby="vn-home-scenarios-title"
  >
    <div class="vn-container">
      <div class="vn-home-scenarios__layout">
        <div class="vn-home-scenarios__header">
          <span class="vn-label-mono">Живые ситуации</span>
          <h2 class="vn-home-scenarios__title" id="vn-home-scenarios-title">
            Ситуации, <span class="vn-home-scenarios__title-accent">которые закрываем</span>
          </h2>
          <p class="vn-home-scenarios__lead">
            Каждая ситуация требует своего решения. Вот самые частые — с фокусом на результат, 
            а не на обещания.
          </p>
        </div>

        <div class="vn-home-scenarios__grid">
          {
            scenarios.map((scenario) => (
              <article class="vn-home-scenarios__card">
                <div class="vn-home-scenarios__card-top">
                  <span class="vn-home-scenarios__card-icon" aria-hidden="true">
                    <Icon name={scenario.icon} size={24} />
                  </span>
                  <span class="vn-home-scenarios__card-marker" aria-hidden="true">
                    {scenario.marker}
                  </span>
                </div>

                <div class="vn-home-scenarios__card-accent" aria-hidden="true"></div>

                <h3 class="vn-home-scenarios__card-title">{scenario.title}</h3>
                <p class="vn-home-scenarios__text">{scenario.text}</p>
              </article>
            ))
          }
        </div>

        <div class="vn-home-scenarios__cta">
          <button
            type="button"
            class="vn-btn-primary"
            data-modal-open
            data-modal-title="Обсудить мою ситуацию"
            data-modal-subtitle="Расскажите, в какой ситуации вы сейчас — мы подберём решение под вашу задачу."
          >
            Обсудить мою ситуацию
          </button>
        </div>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-scenarios {
    padding-block: var(--spacing-section);
    background: var(--color-bg-primary);
  }

  .vn-home-scenarios__layout {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .vn-home-scenarios__header {
    max-width: 720px;
  }

  .vn-home-scenarios__header > .vn-label-mono {
    color: var(--color-accent-cta);
    font-weight: 600;
  }

  .vn-home-scenarios__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-title);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-scenarios__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-home-scenarios__lead {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-scenarios__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .vn-home-scenarios__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .vn-home-scenarios__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    box-shadow: 0 16px 40px color-mix(in srgb, var(--color-accent-primary) 6%, transparent);
  }

  .vn-home-scenarios__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .vn-home-scenarios__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--color-accent-cta);
    background: color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-primary));
  }

  .vn-home-scenarios__card-marker {
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
    color: var(--color-text-primary);
    opacity: 0.05;
    font-variant-numeric: tabular-nums;
  }

  .vn-home-scenarios__card-accent {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent-cta);
  }

  .vn-home-scenarios__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-home-scenarios__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-scenarios__cta {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  /* Мобильная адаптация */
  @media (max-width: 1160px) {
    .vn-home-scenarios__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .vn-home-scenarios__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-home-scenarios__card {
      padding: 24px;
    }

    .vn-home-scenarios__title {
      font-size: var(--fs-h2);
    }

    .vn-home-scenarios__lead {
      font-size: var(--fs-body);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-home-scenarios__card {
      transition: none;
    }

    .vn-home-scenarios__card:hover {
      transform: none;
    }
  }
</style>
