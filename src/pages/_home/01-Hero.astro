---
// Визуальный элемент: минималистичный UI-мокет интерфейса сервиса
---

<section id="section-hero" class="vn-home-hero">
  <div class="vn-home-hero__grid" aria-hidden="true"></div>
  <div class="vn-home-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12 vn-home-hero__layout">
      <div class="vn-home-hero__content" style="grid-column: 1 / 8">
        <span class="vn-home-hero__eyebrow">Военный навигатор · сервис выбора новостройки по военной ипотеке</span>

        <h1 class="vn-home-hero__title">
          Сервис выбора новостройки
          <span class="vn-home-hero__title-accent">по военной ипотеке под вашу задачу</span>
        </h1>

        <p class="vn-home-hero__lead">
          Помогаем найти и безопасно оформить новостройку. Проверяем ограничения банка, ликвидность объекта и реальные сроки сдачи до того, как вы потратите время на просмотр случайных объявлений.
        </p>

        <div class="vn-home-hero__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Рассчитать варианты"
            class="vn-btn-primary vn-home-hero__cta"
          >
            Рассчитать варианты
          </a>
          <a href="/kalkulyator-voennoy-ipoteki/" class="vn-home-hero__secondary">
            Рассчитать ипотеку
          </a>
        </div>

        <div class="vn-home-hero__signals" role="list" aria-label="Преимущества подхода">
          <div class="vn-home-hero__signal" role="listitem">
            <svg class="vn-home-hero__signal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div class="vn-home-hero__signal-content">
              <span class="vn-home-hero__signal-label">Точный подбор</span>
              <span class="vn-home-hero__signal-value">Показываем только те объекты, которые реально одобрит банк под ваш сертификат.</span>
            </div>
          </div>
          <div class="vn-home-hero__signal" role="listitem">
            <svg class="vn-home-hero__signal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div class="vn-home-hero__signal-content">
              <span class="vn-home-hero__signal-label">Прозрачный маршрут</span>
              <span class="vn-home-hero__signal-value">От первичного расчёта вариантов до сделки, без скрытых условий и навязанных услуг.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="vn-home-hero__aside" style="grid-column: 8 / 13">
        <div class="vn-home-hero__visual-card">
          <!-- Премиальный UI-мокет с многослойностью и анимацией -->
          <svg viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="vn-home-hero__ui-mockup" aria-hidden="true">
            <!-- Фоновое свечение -->
            <circle cx="250" cy="200" r="180" fill="url(#glow-gradient)" opacity="0.15" class="animate-pulse-glow" />
            
            <!-- Задняя карточка (для глубины) -->
            <rect x="30" y="50" width="360" height="300" rx="20" fill="var(--color-bg-dark)" stroke="var(--color-border-ondark)" stroke-width="1" opacity="0.5" class="animate-float-slow" />
            
            <!-- Основная карточка -->
            <rect x="70" y="30" width="400" height="340" rx="24" fill="var(--color-bg-dark-elev)" stroke="var(--color-border-ondark)" stroke-width="1" class="animate-float" style="filter: drop-shadow(0 32px 64px rgba(0,0,0,0.4));" />
            
            <!-- Заголовок мокета -->
            <rect x="100" y="60" width="160" height="16" rx="8" fill="var(--color-text-ondark)" opacity="0.8" />
            <rect x="100" y="88" width="220" height="10" rx="5" fill="var(--color-text-ondark-mute)" opacity="0.3" />
            
            <!-- Разделитель -->
            <line x1="100" y1="120" x2="440" y2="120" stroke="var(--color-border-ondark)" stroke-width="1" />
            
            <!-- Секция "Бюджет" -->
            <rect x="100" y="140" width="100" height="12" rx="6" fill="var(--color-text-ondark)" opacity="0.7" />
            <rect x="100" y="168" width="340" height="10" rx="5" fill="var(--color-border-ondark)" />
            <rect x="100" y="168" width="240" height="10" rx="5" fill="var(--color-accent-cta)" opacity="0.8" class="animate-progress" />
            <circle cx="340" cy="173" r="12" fill="var(--color-accent-cta)" class="animate-pulse-dot" />
            
            <!-- Секция "Статус" -->
            <rect x="100" y="210" width="140" height="12" rx="6" fill="var(--color-text-ondark)" opacity="0.7" />
            <rect x="100" y="238" width="160" height="40" rx="12" fill="color-mix(in srgb, var(--color-accent-cta) 12%, transparent)" stroke="var(--color-accent-cta)" stroke-width="1.5" opacity="0.8" />
            <circle cx="120" cy="258" r="8" fill="var(--color-accent-cta)" />
            <path d="M116 258 L119 261 L124 255" stroke="var(--color-bg-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="140" y="254" width="100" height="10" rx="5" fill="var(--color-accent-cta)" opacity="0.9" />

            <!-- Плавающий бейдж -->
            <rect x="310" y="250" width="140" height="48" rx="14" fill="var(--color-bg-dark)" stroke="var(--color-border-ondark)" stroke-width="1" class="animate-float-reverse" style="filter: drop-shadow(0 12px 24px rgba(0,0,0,0.5));" />
            <rect x="328" y="266" width="80" height="10" rx="5" fill="var(--color-text-ondark-mute)" opacity="0.6" />
            <rect x="328" y="282" width="60" height="8" rx="4" fill="var(--color-accent-cta)" opacity="0.8" />

            <defs>
              <radialGradient id="glow-gradient" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(250 200) rotate(90) scale(180)">
                <stop stop-color="var(--color-accent-cta)" />
                <stop offset="1" stop-color="var(--color-accent-cta)" stop-opacity="0" />
              </radialGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-home-hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding-top: 152px;
    padding-bottom: 88px;
    background: var(--color-bg-primary);
    display: flex;
    align-items: center;
  }

  .vn-home-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    z-index: 0;
  }

  .vn-home-hero__radial {
    position: absolute;
    top: -220px;
    left: -200px;
    width: 840px;
    height: 840px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-bg-surface) 60%, transparent) 0%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .vn-home-hero__layout {
    position: relative;
    z-index: 1;
    align-items: start;
  }

  .vn-home-hero__content {
    min-width: 0;
  }

  .vn-home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vn-home-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-home-hero__title {
    margin: 28px 0 0;
    max-width: 780px;
    font-size: var(--fs-display);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-hero__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-home-hero__lead {
    margin: 28px 0 0;
    max-width: 620px;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .vn-home-hero__cta {
    min-height: 54px;
    padding-inline: 36px;
  }

  .vn-home-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg-surface) 74%, transparent);
    color: var(--color-text-primary);
    font-size: var(--fs-body);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .vn-home-hero__secondary:hover {
    background: var(--color-accent-cta-soft);
    border-color: color-mix(in srgb, var(--color-accent-cta) 24%, var(--color-border));
    color: var(--color-accent-cta);
  }

  .vn-home-hero__note {
    margin: 14px 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--color-text-tertiary);
  }

  .vn-home-hero__signals {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
    max-width: 560px;
  }

  .vn-home-hero__signal {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-surface) 60%, transparent);
  }

  .vn-home-hero__signal-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: var(--color-accent-cta);
    margin-top: 2px;
  }

  .vn-home-hero__signal-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .vn-home-hero__signal-label {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-home-hero__signal-value {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .vn-home-hero__aside {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vn-home-hero__visual-card {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 500 / 400;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
  }

  .vn-home-hero__ui-mockup {
    width: 100%;
    height: 100%;
    max-width: 500px;
  }

  /* Премиальные анимации */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  
  @keyframes float-slow {
    0%, 100% { transform: translateY(0px) translateX(-10px); }
    50% { transform: translateY(-8px) translateX(-10px); }
  }

  @keyframes float-reverse {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(8px); }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.15; transform: scale(1); }
    50% { opacity: 0.25; transform: scale(1.05); }
  }

  @keyframes progress-load {
    0% { width: 0; }
    100% { width: 240px; }
  }

  @keyframes pulse-dot {
    0%, 100% { r: 12; opacity: 1; }
    50% { r: 14; opacity: 0.8; }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  
  .animate-float-slow {
    animation: float-slow 8s ease-in-out infinite;
  }

  .animate-float-reverse {
    animation: float-reverse 7s ease-in-out infinite;
  }

  .animate-pulse-glow {
    animation: pulse-glow 4s ease-in-out infinite;
  }

  .animate-progress {
    animation: progress-load 2s ease-out forwards;
  }

  .animate-pulse-dot {
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @media (max-width: 1023px) {
    .vn-home-hero {
      min-height: auto;
      padding-top: 120px;
    }

    .vn-home-hero__content,
    .vn-home-hero__aside {
      grid-column: 1 / -1 !important;
    }

    .vn-home-hero__aside {
      margin-top: 48px;
    }
    
    .vn-home-hero__visual-card {
      max-width: 480px;
    }
  }

  @media (max-width: 640px) {
    .vn-home-hero {
      padding-top: 96px;
      padding-bottom: 64px;
    }

    .vn-home-hero__grid {
      background-size: 48px 48px;
    }

    .vn-home-hero__title {
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .vn-home-hero__actions {
      flex-direction: column;
    }

    .vn-home-hero__cta,
    .vn-home-hero__secondary {
      width: 100%;
    }

    .vn-home-hero__signal {
      padding: 14px 16px;
    }
    
    .vn-home-hero__visual-card {
      max-width: 340px;
      margin-bottom: 12px;
    }
    
    .vn-home-hero__aside {
      margin-top: 32px;
    }
  }
</style>
