---
import { Icon } from 'astro-icon/components';

type HeroRoute = {
  title: string;
  subtitle: string;
  modalTitle: string;
  modalSubtitle: string;
  modalSource: string;
  image: string;
  imagePosition?: string;
};

const ROUTES: HeroRoute[] = [
  {
    title: 'Новостройки',
    subtitle: 'Квартиры от застройщика',
    modalTitle: 'Подберём лучшие новостройки под военную ипотеку бесплатно',
    modalSubtitle:
      'Уточним бюджет, банк и регион, а затем соберём короткий список новостроек, которые реально подходят под вашу программу. Без комиссий для вас.',
    modalSource: 'home-hero-route-newbuild',
    image: '/images/complexes/samolet/samolet-1.jpg',
  },
  {
    title: 'Дома',
    subtitle: 'Коттеджи и таунхаусы',
    modalTitle: 'Поможем подобрать дом под вашу задачу покупки бесплатно',
    modalSubtitle:
      'Разберём, подходит ли вам формат дома, какие ограничения есть по банку и бюджету, и подскажем, какие варианты стоит смотреть в первую очередь.',
    modalSource: 'home-hero-route-houses',
    image: '/images/cottages-hero.jpg',
  },
  {
    title: 'Вторичка',
    subtitle: 'Готовые квартиры',
    modalTitle: 'Поможем подобрать готовую квартиру на вторичном рынке бесплатно',
    modalSubtitle:
      'Поймём вашу задачу, проверим бюджет и ограничения по ипотеке, а затем подскажем, какие готовые квартиры имеет смысл рассматривать без лишних просмотров.',
    modalSource: 'home-hero-route-secondary',
    image: '/images/secondary-hero.jpg',
  },
  {
    title: 'Ипотека',
    subtitle: 'Условия и одобрение',
    modalTitle: 'Поможем с военной ипотекой бесплатно',
    modalSubtitle:
      'Проверим лимиты, объясним, как сейчас пройти одобрение спокойнее, и подскажем следующий шаг по банку, ставке и порядку действий по покупке.',
    modalSource: 'home-hero-route-mortgage',
    image: '/images/mortgage-consultation.png',
    imagePosition: '58% center',
  },
];

const FEATURED_IMAGE = '/images/krasnodar-newbuild-hero.png';
---

<section id="section-hero" class="vn-home-hero">
  <div class="vn-home-hero__grid" aria-hidden="true"></div>
  <div class="vn-home-hero__radial" aria-hidden="true"></div>

  <div class="vn-container vn-home-hero__container">
    <div class="vn-home-hero__layout">
      <!-- Левая плита: текст + CTA -->
      <div class="vn-home-hero__content">
        <span class="vn-home-hero__eyebrow">
          Военный навигатор · бесплатно для военнослужащих
        </span>

        <h1 class="vn-home-hero__title">
          <span class="vn-home-hero__title-line">Подбираем новостройки</span>
          <span class="vn-home-hero__title-line">
            <span class="vn-home-hero__title-accent">по военной ипотеке</span>{' '}
            бесплатно
          </span>
        </h1>

        <p class="vn-home-hero__lead">
          Проверяем одобрение банков, ликвидность и сроки сдачи до первого просмотра.
        </p>

        <div class="vn-home-hero__actions">
          <a
            href="/contacts/#request"
            class="vn-btn-primary vn-home-hero__cta"
            data-modal-open
            data-modal-title="Получить разбор ситуации"
            data-modal-subtitle="Уточним вашу цель, бюджет и ограничения по военной ипотеке, а затем подскажем, какой порядок действий по покупке сейчас самый разумный."
            data-modal-source="home-hero-primary-cta"
          >
            Получить подборку
            <Icon name="arrow-up-right" class="vn-home-hero__cta-icon" />
          </a>
        </div>

        <p class="vn-home-hero__micro-trust" aria-label="Краткие гарантии">
          Бесплатно для военнослужащих · Работаем с 8 банками
        </p>
      </div>

      <!-- Правая плита: featured-card -->
      <div class="vn-home-hero__featured">
        <div class="vn-home-hero__featured-card">
          <img
            src={FEATURED_IMAGE}
            alt="Современный жилой комплекс в Краснодаре для военной ипотеки"
            class="vn-home-hero__featured-image"
            loading="eager"
            decoding="async"
            width="760"
            height="520"
          />
          <div class="vn-home-hero__featured-badges">
            <span class="vn-home-hero__featured-badge vn-home-hero__featured-badge--accent">
              Бесплатно
            </span>
            <span class="vn-home-hero__featured-badge">
              Сопровождение сделки
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Нижний ряд: route-cards -->
    <nav class="vn-home-hero__routes" aria-label="Быстрые разделы">
      {
        ROUTES.map((route) => (
          <button
            type="button"
            class:list={[
              'vn-home-hero__route',
              'vn-home-hero__route--photo',
            ]}
            data-modal-open
            data-modal-title={route.modalTitle}
            data-modal-subtitle={route.modalSubtitle}
            data-modal-source={route.modalSource}
          >
            <img
              src={route.image}
              alt=""
              class="vn-home-hero__route-image"
              style={route.imagePosition ? `object-position: ${route.imagePosition};` : undefined}
              loading="lazy"
              decoding="async"
            />

            <div class="vn-home-hero__route-overlay"></div>

            <div class="vn-home-hero__route-arrow" aria-hidden="true">
              <Icon name="arrow-up-right" class="vn-home-hero__route-arrow-icon" />
            </div>

            <div class="vn-home-hero__route-text">
              <span class="vn-home-hero__route-kicker">Бесплатно для вас</span>
              <span class="vn-home-hero__route-title">{route.title}</span>
              <span class="vn-home-hero__route-subtitle">{route.subtitle}</span>
            </div>
          </button>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .vn-home-hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding-top: 152px;
    padding-bottom: 64px;
    background: var(--color-bg-primary);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .vn-home-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    z-index: 0;
  }

  .vn-home-hero__radial {
    position: absolute;
    top: -220px;
    left: -200px;
    width: 840px;
    height: 840px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-bg-surface) 60%, transparent) 0%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .vn-home-hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .vn-home-hero__layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }

  .vn-home-hero__content {
    min-width: 0;
  }

  .vn-home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vn-home-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-home-hero__title {
    margin: 28px 0 0;
    max-width: 720px;
    font-size: var(--fs-display);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .vn-home-hero__title-line {
    display: block;
  }

  .vn-home-hero__title-accent {
    color: var(--color-accent-primary);
    font-weight: 400;
  }

  .vn-home-hero__lead {
    margin: 24px 0 0;
    max-width: 560px;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .vn-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .vn-home-hero__cta {
    min-height: 54px;
    padding-inline: 32px;
  }

  .vn-home-hero__cta-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .vn-home-hero__cta:hover .vn-home-hero__cta-icon {
    transform: translate(1px, -1px);
  }

  .vn-home-hero__micro-trust {
    margin-top: 20px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  .vn-home-hero__featured {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .vn-home-hero__featured-card {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg-dark);
    box-shadow:
      0 28px 80px color-mix(in srgb, var(--color-text-primary) 18%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-bg-surface) 18%, transparent) inset;
  }

  .vn-home-hero__featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .vn-home-hero__featured-card:hover .vn-home-hero__featured-image {
    transform: scale(1.03);
  }

  .vn-home-hero__featured-badges {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vn-home-hero__featured-badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-dark) 72%, transparent);
    border: 1px solid var(--color-border-ondark);
    color: var(--color-text-ondark);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  .vn-home-hero__featured-badge--accent {
    background: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
    color: var(--color-bg-surface);
  }

  .vn-home-hero__routes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .vn-home-hero__route {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 140px;
    padding: 16px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    text-align: left;
    cursor: pointer;
    appearance: none;
    width: 100%;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .vn-home-hero__route--photo {
    min-height: 160px;
  }

  .vn-home-hero__route--calculator {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent-primary) 12%, transparent);
  }

  .vn-home-hero__route:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: color-mix(in srgb, var(--color-accent-cta) 24%, var(--color-border));
  }

  .vn-home-hero__route-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vn-home-hero__route--photo:hover .vn-home-hero__route-image {
    transform: scale(1.05);
  }

  .vn-home-hero__route-icon-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-accent-soft) 0%, transparent 100%);
  }

  .vn-home-hero__route-main-icon {
    width: 44px;
    height: 44px;
    color: var(--color-accent-cta);
    opacity: 0.9;
  }

  .vn-home-hero__route-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg-dark) 72%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }

  .vn-home-hero__route--calculator .vn-home-hero__route-overlay {
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg-surface) 90%, transparent) 0%, transparent 70%);
  }

  .vn-home-hero__route-arrow {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg-surface) 90%, transparent);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .vn-home-hero__route:hover .vn-home-hero__route-arrow {
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    border-color: var(--color-accent-cta);
    transform: translate(1px, -1px);
  }

  .vn-home-hero__route-arrow-icon {
    width: 16px;
    height: 16px;
  }

  .vn-home-hero__route-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .vn-home-hero__route-kicker {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-bottom: 6px;
    padding: 4px 8px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-surface) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bg-surface) 18%, transparent);
    color: color-mix(in srgb, var(--color-bg-surface) 90%, transparent);
    font-size: var(--fs-caption);
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(6px);
  }

  .vn-home-hero__route-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-bg-surface);
    line-height: 1.2;
  }

  .vn-home-hero__route--calculator .vn-home-hero__route-title {
    color: var(--color-text-primary);
  }

  .vn-home-hero__route-subtitle {
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: color-mix(in srgb, var(--color-bg-surface) 80%, transparent);
    line-height: 1.4;
  }

  .vn-home-hero__route--calculator .vn-home-hero__route-subtitle {
    color: var(--color-text-secondary);
  }

  @media (max-width: 1200px) {
    .vn-home-hero__title {
      max-width: 640px;
    }

    .vn-home-hero__lead {
      max-width: 520px;
    }

    .vn-home-hero__layout {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .vn-home-hero__featured-card {
      max-width: 100%;
    }
  }

  @media (max-width: 1023px) {
    .vn-home-hero {
      min-height: auto;
      padding-top: 120px;
    }

    .vn-home-hero__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .vn-home-hero__featured {
      justify-content: center;
    }

    .vn-home-hero__featured-card {
      max-width: 560px;
      aspect-ratio: 16 / 10;
    }

    .vn-home-hero__routes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .vn-home-hero {
      padding-top: 96px;
      padding-bottom: 48px;
    }

    .vn-home-hero__grid {
      background-size: 48px 48px;
    }

    .vn-home-hero__title {
      max-width: none;
      font-size: clamp(2.6rem, 10.8vw, 3.9rem);
      line-height: 1.08;
      letter-spacing: -0.02em;
      text-wrap: pretty;
    }

    .vn-home-hero__lead {
      max-width: none;
      font-size: clamp(1.0625rem, 4.4vw, 1.1875rem);
    }

    .vn-home-hero__actions {
      flex-direction: column;
    }

    .vn-home-hero__cta {
      width: 100%;
      justify-content: center;
    }

    .vn-home-hero__micro-trust {
      text-align: left;
    }

    .vn-home-hero__featured-card {
      aspect-ratio: 4 / 3;
    }

    .vn-home-hero__featured-badges {
      left: 12px;
      right: 12px;
      bottom: 12px;
    }

    .vn-home-hero__featured-badge {
      padding: 6px 10px;
      font-size: var(--fs-caption);
    }

    .vn-home-hero__routes {
      grid-template-columns: 1fr;
    }

    .vn-home-hero__route--photo,
    .vn-home-hero__route--calculator {
      min-height: 120px;
    }

    .vn-home-hero__route-kicker {
      margin-bottom: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-home-hero__featured-image,
    .vn-home-hero__route-image,
    .vn-home-hero__route,
    .vn-home-hero__route-arrow,
    .vn-home-hero__cta-icon {
      transition: none;
    }

    .vn-home-hero__featured-card:hover .vn-home-hero__featured-image,
    .vn-home-hero__route--photo:hover .vn-home-hero__route-image,
    .vn-home-hero__route:hover,
    .vn-home-hero__route:hover .vn-home-hero__route-arrow,
    .vn-home-hero__cta:hover .vn-home-hero__cta-icon {
      transform: none;
    }
  }
</style>
