<!-- ══════════════════════════════════════════════
     БЛОК 06 — ПЕРВЫЙ ШАГ
════════════════════════════════════════════════ -->
<section id="section-first-step" class="vn-section vn-home-fs" aria-labelledby="vn-home-fs-title">
  <div class="vn-container">
    <div class="vn-grid-12 vn-home-fs__grid">

      <!-- ── Left: как проходит ── -->
      <div class="vn-home-fs__left" style="grid-column: 1 / 6">

        <span class="vn-label-mono">ПЕРВЫЙ ШАГ</span>
        <h2 class="vn-home-fs__h2" id="vn-home-fs-title">Получите первичный разбор без обязательств</h2>

        <ul class="vn-home-fs__list">
          <li class="vn-home-fs__item">
            <span class="vn-home-fs__check" aria-hidden="true">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            Можно начать с сообщения или короткого звонка
          </li>
          <li class="vn-home-fs__item">
            <span class="vn-home-fs__check" aria-hidden="true">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            Я уточню вашу задачу, бюджет, сроки и ограничения по военной ипотеке
          </li>
          <li class="vn-home-fs__item">
            <span class="vn-home-fs__check" aria-hidden="true">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            После этого подскажу, с чего лучше начать выбор новостройки
          </li>
        </ul>

        <blockquote class="vn-home-fs__quote">
          Первичный разбор не обязывает продолжать работу. Его задача — дать вам
          понятный следующий шаг.
        </blockquote>

        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Получить первичный разбор"
          class="vn-btn-primary vn-home-fs__cta"
        >
          Получить первичный разбор
        </a>

      </div>

      <!-- ── Right: dark shape / results ── -->
      <div class="vn-home-fs__right" style="grid-column: 7 / 13">
        <div class="vn-home-fs__card">

          <!-- glow inside card -->
          <div class="vn-home-fs__glow" aria-hidden="true"></div>

          <p class="vn-home-fs__card-eyebrow">После первичного разбора</p>

          <ol class="vn-home-fs__results">
            <li class="vn-home-fs__result" data-fs-item>
              <span class="vn-home-fs__rnum">01</span>
              <span>
                <strong>Поймёте цель покупки</strong>
                <small>Для жизни, как вложение или смешанный сценарий.</small>
              </span>
            </li>
            <li class="vn-home-fs__result" data-fs-item>
              <span class="vn-home-fs__rnum">02</span>
              <span>
                <strong>Увидите ограничения</strong>
                <small>Бюджет, банк, НИС, сроки и документы.</small>
              </span>
            </li>
            <li class="vn-home-fs__result" data-fs-item>
              <span class="vn-home-fs__rnum">03</span>
              <span>
                <strong>Получите критерии выбора</strong>
                <small>Какие районы, новостройки и сроки сдачи стоит смотреть.</small>
              </span>
            </li>
            <li class="vn-home-fs__result" data-fs-item>
              <span class="vn-home-fs__rnum">04</span>
              <span>
                <strong>Поймёте формат сделки</strong>
                <small>Лично, дистанционно или смешанно.</small>
              </span>
            </li>
            <li class="vn-home-fs__result" data-fs-item>
              <span class="vn-home-fs__rnum">05</span>
              <span>
                <strong>Увидите следующий шаг</strong>
                <small>Что делать дальше: смотреть варианты, уточнять документы или готовить маршрут сделки.</small>
              </span>
            </li>
          </ol>

          <div class="vn-home-fs__card-footer" data-fs-item>
            <span class="vn-home-fs__meta">
              Без обязательств
            </span>
            <span class="vn-home-fs__meta">
              Можно дистанционно
            </span>
            <span class="vn-home-fs__meta">
              Первый шаг
            </span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 06: First Step ─── */

/* Stretch grid rows so dark card fills section height */
.vn-home-fs__grid {
  align-items: stretch;
}

/* ── Left column ── */
.vn-home-fs__left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 16px;
}

.vn-home-fs__h2 {
  margin: 16px 0 24px;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.15;
  color: var(--color-text-primary);
  text-wrap: balance;
}

/* Checklist */
.vn-home-fs__list {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.vn-home-fs__item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.vn-home-fs__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  min-width: 22px;
  border-radius: 50%;
  background: var(--color-accent-cta-soft);
  color: var(--color-accent-cta);
  margin-top: 1px;
  flex-shrink: 0;
}

/* Quote */
.vn-home-fs__quote {
  margin: 0 0 28px;
  padding: 18px 20px;
  border-left: 3px solid var(--color-accent-cta);
  border-radius: 0 8px 8px 0;
  background: var(--color-accent-cta-soft);
  font-style: normal;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.vn-home-fs__cta { align-self: flex-start; }

/* ── Right column: dark shape ── */
.vn-home-fs__right {
  display: flex;
  align-items: stretch;
}

.vn-home-fs__card {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 36px 36px 32px;
  background: var(--color-accent-primary); /* #0F2547 deep navy */
  border-radius: 18px;
  overflow: hidden;
}

/* Radial glow inside dark card */
.vn-home-fs__glow {
  position: absolute;
  top: -60px;
  right: -60px;
  width: 320px;
  height: 320px;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-cta) 22%, transparent), transparent 65%);
  pointer-events: none;
}

/* Card label */
.vn-home-fs__card-eyebrow {
  position: relative;
  z-index: 1;
  margin: 0 0 8px;
  font-size: var(--fs-label);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-text-ondark-mute);
}

/* Results list */
.vn-home-fs__results {
  position: relative;
  z-index: 1;
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.vn-home-fs__result {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid var(--color-border-ondark);
  font-size: var(--fs-body);
  color: var(--color-text-ondark);
  line-height: 1.45;
}

.vn-home-fs__result:last-child { border-bottom: none; }

.vn-home-fs__rnum {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-accent-cta);
  opacity: 0.8;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  padding-top: 2px;
}

.vn-home-fs__result strong {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-ondark);
}

.vn-home-fs__result small {
  display: block;
  margin-top: 4px;
  font-size: var(--fs-body-sm);
  font-weight: 400;
  line-height: 1.55;
  color: var(--color-text-ondark-mute);
}

/* Card footer */
.vn-home-fs__card-footer {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 20px;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid rgba(241, 243, 245, 0.09);
  flex-wrap: wrap;
}

.vn-home-fs__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 500;
  color: var(--color-text-ondark-mute);
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-fs__left  { grid-column: 1 / -1 !important; padding-right: 0; }
  .vn-home-fs__right {
    grid-column: 1 / -1 !important;
    margin-top: 48px;
  }
  .vn-home-fs__card  { min-height: auto; }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-fs__right { margin-top: 40px; }
  .vn-home-fs__card { padding: 28px 24px 24px; }
}

/* ── Animated items ── */
[data-fs-item] {
  opacity: 0;
  transform: translateY(14px);
  transition:
    opacity 0.45s ease,
    transform 0.45s ease;
}

.vn-home-fs--visible .vn-home-fs__results [data-fs-item]:nth-child(1) { opacity: 1; transform: none; transition-delay:  80ms; }
.vn-home-fs--visible .vn-home-fs__results [data-fs-item]:nth-child(2) { opacity: 1; transform: none; transition-delay: 200ms; }
.vn-home-fs--visible .vn-home-fs__results [data-fs-item]:nth-child(3) { opacity: 1; transform: none; transition-delay: 320ms; }
.vn-home-fs--visible .vn-home-fs__results [data-fs-item]:nth-child(4) { opacity: 1; transform: none; transition-delay: 440ms; }
.vn-home-fs--visible .vn-home-fs__results [data-fs-item]:nth-child(5) { opacity: 1; transform: none; transition-delay: 560ms; }
.vn-home-fs--visible .vn-home-fs__card-footer[data-fs-item]           { opacity: 1; transform: none; transition-delay: 680ms; }

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .vn-home-fs__glow { display: none; }
  [data-fs-item] { opacity: 1; transform: none; transition: none; }
}
</style>

<script>
  const fs = document.getElementById('section-first-step');
  if (fs) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          fs.classList.add('vn-home-fs--visible');
          observer.disconnect();
        }
      },
      { threshold: 0.15 },
    );
    observer.observe(fs);
  }
</script>
