---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const steps = [
  {
    number: '01',
    title: 'Разбор ситуации',
    description: 'Выясняем цель покупки, бюджет, сроки и реальные ограничения по вашей программе военной ипотеки.'
  },
  {
    number: '02',
    title: 'Фильтр объектов',
    description: 'Отсеиваем неподходящие варианты на бумаге. Вы получаете только те новостройки, которые реально одобрит банк под ваш сертификат.'
  },
  {
    number: '03',
    title: 'Сопровождение сделки',
    description: 'Помогаем с документами, банком и застройщиком, чтобы вы не ходили по кругу и не теряли время на бюрократию.'
  }
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-steps" class="vn-home-steps" aria-labelledby="vn-home-steps-title">
    <div class="vn-container">
      <div class="vn-home-steps__header">
        <span class="vn-label-mono">Как это работает</span>
        <h2 class="vn-home-steps__title" id="vn-home-steps-title">
          Маршрут покупки: 3 шага от расчёта вариантов до сделки
        </h2>
        <div class="vn-home-steps__trust-note">
          <svg class="vn-home-steps__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Первичный расчёт и подбор новостройки — без комиссий для вас</span>
        </div>
      </div>

      <div class="vn-home-steps__grid">
        {steps.map((step) => (
          <article class="vn-home-steps__card">
            <div class="vn-home-steps__card-header">
              <span class="vn-home-steps__number">{step.number}</span>
            </div>
            <h3 class="vn-home-steps__card-title">{step.title}</h3>
            <p class="vn-home-steps__card-text">{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-steps {
    padding-block: 96px;
    background: var(--color-bg-surface); /* Чистый светлый фон для премиального контраста */
  }

  .vn-home-steps__header {
    max-width: 640px;
    margin-bottom: 56px;
  }

  .vn-home-steps__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-steps__trust-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--color-accent-cta) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 15%, transparent);
    border-radius: var(--radius-md);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .vn-home-steps__trust-icon {
    width: 16px;
    height: 16px;
    color: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-home-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .vn-home-steps__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .vn-home-steps__card:hover {
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    transform: translateY(-4px);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-bg-dark) 8%, transparent);
  }

  .vn-home-steps__card-header {
    display: flex;
    align-items: center;
  }

  .vn-home-steps__number {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-cta);
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .vn-home-steps__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-home-steps__card-text {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Мобильная адаптация: вертикальный таймлайн */
  @media (max-width: 1023px) {
    .vn-home-steps {
      padding-block: 72px;
    }

    .vn-home-steps__grid {
      grid-template-columns: 1fr;
      gap: 0; /* Убираем gap для бесшовной вертикальной линии */
    }

    .vn-home-steps__card {
      padding: 24px 24px 24px 72px; /* Отступ слева под номер и линию */
      border: none;
      border-bottom: 1px solid var(--color-border);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      transform: none !important; /* Отключаем hover-подъём на мобильных для чистоты */
    }

    .vn-home-steps__card:last-child {
      border-bottom: none;
    }

    .vn-home-steps__card::before {
      content: '';
      position: absolute;
      left: 23px; /* Центрируем относительно номера */
      top: 40px;
      bottom: -1px;
      width: 1px;
      background: var(--color-border);
      z-index: 0;
    }

    .vn-home-steps__card:last-child::before {
      display: none;
    }

    .vn-home-steps__number {
      position: absolute;
      left: 0;
      top: 24px;
      font-size: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .vn-home-steps {
      padding-block: 56px;
    }

    .vn-home-steps__header {
      margin-bottom: 40px;
    }

    .vn-home-steps__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
    }

    .vn-home-steps__card {
      padding: 20px 20px 20px 64px;
    }

    .vn-home-steps__card::before {
      left: 19px;
      top: 36px;
    }

    .vn-home-steps__number {
      top: 20px;
      font-size: 1.25rem;
    }
  }
</style>
