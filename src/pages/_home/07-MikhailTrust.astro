---
import { Icon } from 'astro-icon/components';
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';

const trustPoints = [
  {
    icon: 'users',
    title: 'Личный разбор',
    text: 'Первичную консультацию проводит сам Михаил, чтобы понять ситуацию и критерии, а не передать вопрос менеджеру.',
  },
  {
    icon: 'building-check',
    title: 'Проверка объектов',
    text: 'Перед показом отсеиваются неликвидные и рискованные варианты: проверяется застройщик, сроки сдачи и соответствие банку.',
  },
  {
    icon: 'file-text',
    title: 'Прозрачные условия',
    text: 'Чётко объясняем ограничения программы, реальные сроки и следующие шаги — без пустых обещаний и скрытых комиссий.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section
    id="section-mikhail-trust"
    class="vn-home-trust"
    aria-labelledby="vn-home-trust-title"
  >
    <div class="vn-container">
      <div class="vn-home-trust__layout">
        <div class="vn-home-trust__photo-wrap">
          <div class="vn-home-trust__photo-panel">
            <div class="vn-home-trust__photo-frame">
              <OptimizedImage
                src="/images/mikhail-desk.png"
                alt="Михаил Хряпин — главный навигатор сервиса Военный навигатор"
                width={480}
                height={460}
                loading="lazy"
                class="vn-home-trust__photo"
              />
            </div>

            <div class="vn-home-trust__corner vn-home-trust__corner--tl" aria-hidden="true"></div>
            <div class="vn-home-trust__corner vn-home-trust__corner--tr" aria-hidden="true"></div>
            <div class="vn-home-trust__corner vn-home-trust__corner--bl" aria-hidden="true"></div>
            <div class="vn-home-trust__corner vn-home-trust__corner--br" aria-hidden="true"></div>

            <div class="vn-home-trust__photo-caption">
              <p class="vn-home-trust__photo-name">Михаил Хряпин</p>
              <p class="vn-home-trust__photo-role">
                Главный навигатор сервиса · персональный подбор и сопровождение
              </p>
            </div>
          </div>
        </div>

        <div class="vn-home-trust__content">
          <span class="vn-label-mono">Лицо сервиса и ваш главный навигатор</span>
          <h2 class="vn-home-trust__title" id="vn-home-trust-title">
            Михаил Хряпин: <span class="vn-home-trust__title-accent">экспертиза, которой можно доверять</span>
          </h2>
          <p class="vn-home-trust__lead">
            За сервисом стоит человек, который лично разбирает каждую ситуацию. 
            Задача Михаила — не показать как можно больше объектов, а предложить те варианты, 
            которые реально одобрит банк и которые решат задачу клиента.
          </p>

          <div class="vn-home-trust__points">
            {
              trustPoints.map((point) => (
                <div class="vn-home-trust__point">
                  <span class="vn-home-trust__point-icon" aria-hidden="true">
                    <Icon name={point.icon} size={22} />
                  </span>
                  <div class="vn-home-trust__point-body">
                    <h3 class="vn-home-trust__point-title">{point.title}</h3>
                    <p class="vn-home-trust__point-text">{point.text}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="vn-home-trust__actions">
            <button
              type="button"
              class="vn-btn-primary vn-home-trust__cta"
              data-modal-open
              data-modal-title="Обсудить мою ситуацию"
              data-modal-subtitle="Расскажите, какая у вас задача — Михаил лично разберёт ситуацию и предложит решение."
            >
              Обсудить мою ситуацию
            </button>
            <a href="/o-servise/" class="vn-home-trust__more">
              Подробнее о сервисе и подходе <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-trust {
    padding-block: var(--spacing-section);
    background: var(--color-bg-surface);
  }

  .vn-home-trust__layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }

  .vn-home-trust__photo-wrap {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .vn-home-trust__photo-panel {
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .vn-home-trust__photo-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-bg-dark);
    border: 1px solid var(--color-border);
  }

  :global(.vn-home-trust__photo) {
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .vn-home-trust__corner {
    position: absolute;
    width: 20px;
    height: 20px;
    border-color: var(--color-accent-primary);
    opacity: 0.55;
    pointer-events: none;
  }

  .vn-home-trust__corner--tl {
    top: -10px;
    left: -10px;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .vn-home-trust__corner--tr {
    top: -10px;
    right: -10px;
    border-top: 1px solid;
    border-right: 1px solid;
  }

  .vn-home-trust__corner--bl {
    bottom: -10px;
    left: -10px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }

  .vn-home-trust__corner--br {
    bottom: -10px;
    right: -10px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }

  .vn-home-trust__photo-caption {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    padding: 16px 18px;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: color-mix(in srgb, var(--color-bg-dark) 84%, transparent);
    box-shadow: 0 16px 32px color-mix(in srgb, var(--color-bg-dark) 18%, transparent);
    backdrop-filter: blur(12px);
  }

  .vn-home-trust__photo-name {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-ondark);
  }

  .vn-home-trust__photo-role {
    margin: 6px 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.45;
    color: var(--color-text-ondark-mute);
    text-wrap: pretty;
  }

  .vn-home-trust__content > .vn-label-mono {
    color: var(--color-accent-cta);
    font-weight: 600;
  }

  .vn-home-trust__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-title);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-trust__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-home-trust__lead {
    margin: 0;
    max-width: 560px;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-trust__points {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 40px;
  }

  .vn-home-trust__point {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .vn-home-trust__point:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 25%, var(--color-border));
  }

  .vn-home-trust__point-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--color-accent-cta);
    background: color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-surface));
  }

  .vn-home-trust__point-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .vn-home-trust__point-title {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-home-trust__point-text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-trust__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .vn-home-trust__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-accent-cta);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .vn-home-trust__more:hover {
    gap: 10px;
  }

  /* Мобильная адаптация */
  @media (max-width: 1023px) {
    .vn-home-trust__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .vn-home-trust__photo-wrap {
      max-width: 420px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .vn-home-trust__photo-wrap {
      max-width: none;
    }

    .vn-home-trust__photo-frame {
      border-radius: var(--radius-lg);
    }

    :global(.vn-home-trust__photo) {
      aspect-ratio: 1 / 1.16;
    }

    .vn-home-trust__photo-caption {
      left: 16px;
      right: 16px;
      bottom: 16px;
      padding: 14px;
      border-radius: var(--radius-md);
    }

    .vn-home-trust__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .vn-home-trust__cta {
      width: 100%;
      justify-content: center;
    }

    .vn-home-trust__more {
      justify-content: center;
    }

    .vn-home-trust__point {
      padding: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-home-trust__point {
      transition: none;
    }

    .vn-home-trust__point:hover {
      transform: none;
    }

    .vn-home-trust__more {
      transition: none;
    }
  }
</style>
