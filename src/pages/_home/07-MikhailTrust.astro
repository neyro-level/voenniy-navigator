---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';

const trustPoints = [
  {
    title: 'Личный расчёт',
    text: 'Я лично провожу первичную консультацию, чтобы понять вашу ситуацию, а не делегирую это менеджерам.'
  },
  {
    title: 'Фильтр рисков',
    text: 'Отсеиваю неликвидные объекты и сложные сделки до того, как вы потратите время на их просмотр.'
  },
  {
    title: 'Полная прозрачность',
    text: 'Чётко объясняю ограничения программы и реальные сроки, без пустых обещаний и скрытых комиссий.'
  }
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-mikhail-trust" class="vn-home-trust" aria-labelledby="vn-home-trust-title">
    <div class="vn-container">
      <div class="vn-home-trust__layout">
        <div class="vn-home-trust__photo-wrap">
          <div class="vn-home-trust__photo-panel">
            <div class="vn-home-trust__photo-frame">
              <OptimizedImage
                src="/images/mikhail-desk.png"
                alt="Михаил Хряпин — главный навигатор сервиса Военный навигатор"
                width={480}
                height={580}
                loading="lazy"
                class="vn-home-trust__photo"
              />
            </div>

            <div class="vn-home-trust__photo-caption">
              <p class="vn-home-trust__photo-name">Михаил Хряпин</p>
              <p class="vn-home-trust__photo-role">Главный навигатор сервиса · первичный расчёт и фильтр рисков</p>
            </div>
          </div>
        </div>

        <div class="vn-home-trust__content">
          <span class="vn-label-mono">Лицо сервиса и ваш главный навигатор</span>
          <h2 class="vn-home-trust__title" id="vn-home-trust-title">
            Михаил Хряпин: экспертиза, которой можно доверять
          </h2>
          <p class="vn-home-trust__lead">
            Я не просто показываю объекты из каталога. Моя задача — защитить ваши интересы: 
            проверить лимиты банка, оценить ликвидность и предложить только те варианты, 
            которые реально одобрят и которые решат вашу задачу.
          </p>

          <div class="vn-home-trust__points">
            {trustPoints.map((point) => (
              <div class="vn-home-trust__point">
                <h3 class="vn-home-trust__point-title">{point.title}</h3>
                <p class="vn-home-trust__point-text">{point.text}</p>
              </div>
            ))}
          </div>

          <div class="vn-home-trust__actions">
            <a href="/contacts/#request" data-modal-open data-modal-title="Обсудить мою ситуацию" class="vn-btn-primary vn-home-trust__cta">
              Обсудить мою ситуацию
            </a>
            <a href="/o-servise/" class="vn-home-trust__more">
              Подробнее о сервисе и подходе <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-trust {
    padding-block: 96px;
    background: var(--color-bg-surface);
  }

  .vn-home-trust__layout {
    display: grid;
    grid-template-columns: 4fr 7fr;
    gap: 48px;
    align-items: center;
  }

  .vn-home-trust__photo-wrap {
    position: relative;
    display: flex;
    align-items: stretch;
    isolation: isolate;
  }

  .vn-home-trust__photo-wrap::before {
    content: '';
    position: absolute;
    inset: 28px -18px -26px 26px;
    border-radius: calc(var(--radius-xl) + 8px);
    background:
      linear-gradient(145deg,
        color-mix(in srgb, var(--color-accent-cta) 9%, var(--color-bg-surface)) 0%,
        color-mix(in srgb, var(--color-bg-primary) 84%, white) 58%,
        color-mix(in srgb, var(--color-accent-primary) 7%, var(--color-bg-surface)) 100%);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 14%, var(--color-border));
    z-index: 0;
  }

  .vn-home-trust__photo-wrap::after {
    content: '';
    position: absolute;
    top: -26px;
    right: -18px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 18%, transparent) 0%,
      transparent 72%
    );
    z-index: 0;
    pointer-events: none;
  }

  .vn-home-trust__photo-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 14px;
    border-radius: calc(var(--radius-xl) + 6px);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, var(--color-border));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-primary) 92%, white) 0%,
      color-mix(in srgb, var(--color-bg-surface) 96%, white) 100%
    );
    box-shadow:
      0 30px 70px color-mix(in srgb, var(--color-bg-dark) 10%, transparent),
      0 10px 26px color-mix(in srgb, var(--color-bg-dark) 6%, transparent);
  }

  .vn-home-trust__photo-frame {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius-xl) - 2px);
    background: var(--color-bg-dark);
    border: 1px solid color-mix(in srgb, var(--color-bg-dark) 14%, var(--color-border));
  }

  .vn-home-trust__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 48 / 58;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .vn-home-trust__photo-caption {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 26px;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--color-border-ondark) 56%, transparent);
    background: color-mix(in srgb, var(--color-bg-dark) 76%, transparent);
    box-shadow: 0 16px 32px color-mix(in srgb, var(--color-bg-dark) 22%, transparent);
    backdrop-filter: blur(14px);
  }

  .vn-home-trust__photo-name {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-ondark);
  }

  .vn-home-trust__photo-role {
    margin: 6px 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.45;
    color: var(--color-text-ondark-mute);
    text-wrap: pretty;
  }

  .vn-home-trust__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-trust__lead {
    margin: 0;
    max-width: 560px;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-trust__points {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }

  .vn-home-trust__point {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .vn-home-trust__point:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .vn-home-trust__point-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-home-trust__point-text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vn-home-trust__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .vn-home-trust__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-accent-cta);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .vn-home-trust__more:hover {
    gap: 10px;
  }

  /* Мобильная адаптация */
  @media (max-width: 1023px) {
    .vn-home-trust {
      padding-block: 72px;
    }

    .vn-home-trust__layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .vn-home-trust__photo-wrap {
      max-width: 560px;
    }

    .vn-home-trust__photo-wrap::before {
      inset: 22px -12px -18px 18px;
    }

    .vn-home-trust__photo-wrap::after {
      top: -18px;
      right: -10px;
      width: 150px;
      height: 150px;
    }

    .vn-home-trust__photo-panel {
      padding: 12px;
    }

    .vn-home-trust__photo-caption {
      left: 22px;
      right: 22px;
      bottom: 20px;
    }
  }

  @media (max-width: 640px) {
    .vn-home-trust {
      padding-block: 56px;
    }

    .vn-home-trust__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
    }

    .vn-home-trust__photo-wrap {
      max-width: none;
    }

    .vn-home-trust__photo-wrap::before {
      inset: 18px -8px -14px 14px;
      border-radius: calc(var(--radius-lg) + 8px);
    }

    .vn-home-trust__photo-wrap::after {
      top: -12px;
      right: -4px;
      width: 112px;
      height: 112px;
    }

    .vn-home-trust__photo-panel {
      padding: 10px;
      border-radius: calc(var(--radius-lg) + 4px);
    }

    .vn-home-trust__photo-frame {
      border-radius: var(--radius-lg);
    }

    .vn-home-trust__photo {
      min-height: 0;
      aspect-ratio: 1 / 1.16;
    }

    .vn-home-trust__photo-caption {
      left: 18px;
      right: 18px;
      bottom: 16px;
      padding: 14px 14px 13px;
      border-radius: 16px;
    }

    .vn-home-trust__photo-name {
      font-size: 1rem;
    }

    .vn-home-trust__photo-role {
      font-size: 0.875rem;
    }

    .vn-home-trust__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .vn-home-trust__cta {
      width: 100%;
      justify-content: center;
    }

    .vn-home-trust__more {
      justify-content: center;
    }
  }
</style>
