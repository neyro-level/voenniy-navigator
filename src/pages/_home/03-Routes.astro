---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const routes = [
  {
    number: '01',
    title: 'Краснодар',
    label: 'Гео-маршрут',
    description: 'Выбор новостройки по военной ипотеке под задачу покупки в Краснодаре.',
    href: '/voennaya-ipoteka-krasnodar/',
  },
  {
    number: '02',
    title: 'Крым',
    label: 'Гео-маршрут',
    description: 'Сценарии покупки в Крыму: от первого разбора до понятного маршрута сделки.',
    href: '/voennaya-ipoteka-krym/',
  },
  {
    number: '03',
    title: 'Калькулятор',
    label: 'Расчёт',
    description: 'Получить ориентир по сумме и уже с цифрами перейти к разбору ситуации.',
    href: '/kalkulyator-voennoy-ipoteki/',
  },
  {
    number: '04',
    title: 'Условия',
    label: 'Правила программы',
    description: 'Разобраться в банках, суммах, документах и ограничениях до выбора объекта.',
    href: '/usloviya-voennoy-ipoteki/',
  },
  {
    number: '05',
    title: 'Семейная + военная',
    label: 'Комбинированный сценарий',
    description: 'Проверить, можно ли совместить программы и как это влияет на бюджет.',
    href: '/semeynaya-voennaya-ipoteka/',
  },
  {
    number: '06',
    title: 'Подбор / разбор',
    label: 'Первый шаг',
    description: 'Перейти к персональному маршруту, когда задача уже созрела и нужен следующий шаг.',
    href: '/podbor/',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-routes" class="vn-section vn-section--secondary vn-home-routes" aria-labelledby="vn-home-routes-title">
    <div class="vn-container">
      <div class="vn-grid-12 vn-home-routes__header">
        <div style="grid-column: 1 / 8">
          <span class="vn-label-mono">Маршруты сервиса</span>
          <h2 class="vn-home-routes__title" id="vn-home-routes-title">
            Куда можно перейти после первого понимания задачи
          </h2>
        </div>
        <div style="grid-column: 8 / 13">
          <p class="vn-home-routes__lead">
            Главная объясняет логику сервиса, а дальше вы переходите в нужный маршрут:
            географию, расчёт, правила программы или прямой разбор ситуации.
          </p>
        </div>
      </div>

      <div class="vn-home-routes__grid vn-grid-12">
        {routes.map((route, index) => (
          <a
            class="vn-home-routes__card"
            style={`grid-column: ${index % 3 === 0 ? '1 / 5' : index % 3 === 1 ? '5 / 9' : '9 / 13'}`}
            href={route.href}
          >
            <span class="vn-home-routes__num">{route.number}</span>
            <span class="vn-home-routes__label">{route.label}</span>
            <h3 class="vn-home-routes__card-title">{route.title}</h3>
            <p class="vn-home-routes__text">{route.description}</p>
            <span class="vn-home-routes__link">Открыть маршрут →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-routes__header {
    margin-bottom: 40px;
    align-items: end;
  }

  .vn-home-routes__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-routes__lead {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .vn-home-routes__grid {
    gap: 16px 24px;
  }

  .vn-home-routes__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .vn-home-routes__card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 24%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-cta-soft) 34%, var(--color-bg-surface));
  }

  .vn-home-routes__num {
    margin-bottom: 10px;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-accent-cta);
    opacity: 0.7;
  }

  .vn-home-routes__label {
    margin-bottom: 8px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .vn-home-routes__card-title {
    margin: 0 0 10px;
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-home-routes__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-routes__link {
    margin-top: auto;
    padding-top: 18px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-accent-cta);
  }

  @media (max-width: 1023px) {
    .vn-home-routes__header > div {
      grid-column: 1 / -1 !important;
    }

    .vn-home-routes__lead {
      margin-top: 16px;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-top: 16px;
    }

    .vn-home-routes__grid > .vn-home-routes__card:nth-child(odd) {
      grid-column: 1 / 7 !important;
    }

    .vn-home-routes__grid > .vn-home-routes__card:nth-child(even) {
      grid-column: 7 / 13 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-home-routes__grid > .vn-home-routes__card:nth-child(n) {
      grid-column: 1 / -1 !important;
    }

    .vn-home-routes__card {
      padding: 20px;
    }
  }
</style>
