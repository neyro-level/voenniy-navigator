---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const mainRoutes = [
  {
    title: 'Персональный расчёт и подбор',
    description: 'Вы уже примерно понимаете задачу и готовы к индивидуальному маршруту подбора новостройки под ваш сертификат.',
    href: '/podbor/',
    isPrimary: true,
  },
  {
    title: 'Рассчитать бюджет онлайн',
    description: 'Получите точные цифры по сумме, платежу и доступным объектам до разговора с экспертом.',
    href: '/kalkulyator-voennoy-ipoteki/',
    isPrimary: false,
  }
];

const secondaryRoutes = [
  { title: 'Новостройки Краснодара', href: '/voennaya-ipoteka-krasnodar/' },
  { title: 'Новостройки Крыма', href: '/voennaya-ipoteka-krym/' },
  { title: 'Условия и банки', href: '/usloviya-voennoy-ipoteki/' },
  { title: 'Семейная ипотека', href: '/semeynaya-voennoy-ipoteka/' },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-routes" class="vn-home-routes" aria-labelledby="vn-home-routes-title">
    <div class="vn-container">
      <div class="vn-home-routes__header">
        <span class="vn-label-mono">Навигация по сервису</span>
        <h2 class="vn-home-routes__title" id="vn-home-routes-title">
          Куда двигаться дальше: основные направления
        </h2>
      </div>

      <!-- Верхний ряд: Главные действия -->
      <div class="vn-home-routes__main-grid">
        {mainRoutes.map((route) => (
          <a class={`vn-home-routes__card vn-home-routes__card--main ${route.isPrimary ? 'vn-home-routes__card--primary' : ''}`} href={route.href}>
            <h3 class="vn-home-routes__card-title">{route.title}</h3>
            <p class="vn-home-routes__card-text">{route.description}</p>
            <span class="vn-home-routes__link">Перейти <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>

      <!-- Нижний ряд: Дополнительные направления -->
      <div class="vn-home-routes__secondary-grid">
        {secondaryRoutes.map((route) => (
          <a class="vn-home-routes__card vn-home-routes__card--secondary" href={route.href}>
            <span class="vn-home-routes__card-title">{route.title}</span>
            <span class="vn-home-routes__link" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-routes {
    padding-block: 96px;
    background: var(--color-bg-primary);
  }

  .vn-home-routes__header {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .vn-home-routes__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-routes__main-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 24px;
  }

  .vn-home-routes__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
  }

  .vn-home-routes__card--main {
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    gap: 16px;
  }

  .vn-home-routes__card--main:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-bg-dark) 6%, transparent);
  }

  .vn-home-routes__card--primary {
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-cta) 4%, var(--color-bg-surface));
  }

  .vn-home-routes__card--primary:hover {
    background: color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-surface));
  }

  .vn-home-routes__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-home-routes__card-text {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vn-home-routes__link {
    margin-top: auto;
    padding-top: 8px;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-accent-cta);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .vn-home-routes__secondary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .vn-home-routes__card--secondary {
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: transparent;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .vn-home-routes__card--secondary:hover {
    border-color: var(--color-accent-cta);
    background: var(--color-bg-surface);
  }

  .vn-home-routes__card--secondary .vn-home-routes__card-title {
    font-size: var(--fs-body);
    font-weight: 500;
  }

  .vn-home-routes__card--secondary .vn-home-routes__link {
    margin-top: 0;
    padding-top: 0;
    font-size: var(--fs-body);
  }

  /* Мобильная адаптация */
  @media (max-width: 1023px) {
    .vn-home-routes {
      padding-block: 72px;
    }

    .vn-home-routes__main-grid {
      grid-template-columns: 1fr;
    }

    .vn-home-routes__secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .vn-home-routes {
      padding-block: 56px;
    }

    .vn-home-routes__header {
      margin-bottom: 32px;
    }

    .vn-home-routes__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
    }

    .vn-home-routes__card--main {
      padding: 24px;
    }

    .vn-home-routes__secondary-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .vn-home-routes__card--secondary {
      padding: 16px 20px;
    }
  }
</style>
