---
import { Icon } from 'astro-icon/components';
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const cards = [
  {
    type: 'risk',
    icon: 'x',
    title: 'Обычный поиск',
    items: [
      'Объекты без фильтра по вашей военной ипотеке',
      'Заявка в банк до проверки реальных лимитов',
      'Скрытые риски с застройщиком и ликвидностью',
      'Потеря времени на варианты, которые не одобрят',
    ],
  },
  {
    type: 'solution',
    icon: 'check',
    title: 'Военный навигатор',
    items: [
      'Разбор ситуации, бюджета и ограничений на старте',
      'Проверка ликвидности, сроков и надёжности застройщика',
      'Короткий список из 3–5 объектов под ваш сертификат',
      'Сопровождение от первого расчёта до сделки',
    ],
  },
];
---

<RevealOnScroll mode="fade-up">
  <section
    id="section-comparison"
    class="vn-home-comparison"
    aria-labelledby="vn-home-comparison-title"
  >
    <div class="vn-container">
      <div class="vn-home-comparison__header">
        <span class="vn-label-mono">Подход</span>
        <h2 class="vn-home-comparison__title" id="vn-home-comparison-title">
          Не каталог, а <span class="vn-home-comparison__title-accent">проверенный маршрут</span> от ситуации к объекту
        </h2>
        <p class="vn-home-comparison__lead">
          Агрегаторы продают клики. Мы работаем на результат: сначала проверяем ваши лимиты, 
          потом отбираем только те новостройки, которые реально одобрят.
        </p>
      </div>

      <div class="vn-home-comparison__grid">
        {
          cards.map((card) => (
            <article
              class={`vn-home-comparison__card vn-home-comparison__card--${card.type}`}
            >
              <div class="vn-home-comparison__card-header">
                <span class="vn-home-comparison__icon-bg" aria-hidden="true">
                  <Icon name={card.icon} size={18} />
                </span>
                <h3 class="vn-home-comparison__card-title">{card.title}</h3>
              </div>

              <ul class="vn-home-comparison__list">
                {card.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-comparison {
    position: relative;
    padding-block: var(--spacing-section);
    background: var(--color-bg-primary);
    overflow: hidden;
  }

  .vn-home-comparison__header {
    position: relative;
    max-width: 720px;
    margin-bottom: 56px;
  }

  .vn-home-comparison__header > .vn-label-mono {
    color: var(--color-accent-cta);
    font-weight: 600;
  }

  .vn-home-comparison__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-title);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-comparison__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-home-comparison__lead {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-comparison__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    position: relative;
  }

  .vn-home-comparison__card {
    position: relative;
    padding: 32px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .vn-home-comparison__card:hover {
    transform: translateY(-3px);
  }

  .vn-home-comparison__card--risk {
    background: var(--color-bg-surface);
    border-color: var(--color-border);
  }

  .vn-home-comparison__card--risk:hover {
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-bg-dark) 5%, transparent);
  }

  .vn-home-comparison__card--solution {
    background: var(--color-bg-surface);
    border-color: color-mix(in srgb, var(--color-accent-cta) 35%, var(--color-border));
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-accent-primary) 3%, transparent),
      0 24px 48px color-mix(in srgb, var(--color-accent-primary) 5%, transparent);
  }

  .vn-home-comparison__card--solution:hover {
    border-color: color-mix(in srgb, var(--color-accent-cta) 55%, var(--color-border));
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-accent-primary) 4%, transparent),
      0 28px 56px color-mix(in srgb, var(--color-accent-primary) 7%, transparent);
  }

  .vn-home-comparison__card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .vn-home-comparison__icon-bg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .vn-home-comparison__card--risk .vn-home-comparison__icon-bg {
    background: color-mix(in srgb, var(--color-text-tertiary) 12%, transparent);
    color: var(--color-text-tertiary);
  }

  .vn-home-comparison__card--solution .vn-home-comparison__icon-bg {
    background: color-mix(in srgb, var(--color-accent-cta) 12%, transparent);
    color: var(--color-accent-cta);
  }

  .vn-home-comparison__card-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-home-comparison__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vn-home-comparison__list li {
    position: relative;
    padding-left: 22px;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-comparison__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .vn-home-comparison__card--risk .vn-home-comparison__list li::before {
    background: var(--color-text-tertiary);
    opacity: 0.5;
  }

  .vn-home-comparison__card--solution .vn-home-comparison__list li::before {
    background: var(--color-accent-cta);
  }

  /* Мобильная адаптация */
  @media (max-width: 1023px) {
    .vn-home-comparison__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-home-comparison__card {
      padding: 24px;
    }

    .vn-home-comparison__card-header {
      margin-bottom: 24px;
      padding-bottom: 16px;
    }
  }

  @media (max-width: 640px) {
    .vn-home-comparison__header {
      margin-bottom: 40px;
    }

    .vn-home-comparison__title {
      font-size: var(--fs-h2);
    }

    .vn-home-comparison__lead {
      font-size: var(--fs-body);
    }

    .vn-home-comparison__list li {
      font-size: var(--fs-body-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-home-comparison__card {
      transition: none;
    }

    .vn-home-comparison__card:hover {
      transform: none;
    }
  }
</style>
