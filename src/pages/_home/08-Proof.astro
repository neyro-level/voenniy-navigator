---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const proofCards = [
  {
    label: 'Отзывы',
    title: 'Понятный маршрут вместо хаоса',
    text: 'В отзывах чаще всего повторяется не количество объектов, а ощущение порядка: что делать, когда и почему именно так.',
  },
  {
    label: 'Прозрачность',
    title: 'Подбор строится от задачи клиента',
    text: 'В новостройках сопровождение обычно оплачивает застройщик, но рекомендации должны оставаться привязанными к задаче покупки.',
  },
  {
    label: 'Офисы и формат',
    title: 'Краснодар, Крым, дистанционно',
    text: 'Сервис работает через два офиса и дистанционный формат, чтобы человек мог пройти маршрут без лишней привязки к месту.',
  },
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-proof" class="vn-section vn-section--dark vn-home-proof" aria-labelledby="vn-home-proof-title">
    <div class="vn-deco-grid vn-deco-grid--dark" aria-hidden="true"></div>
    <div class="vn-container vn-rel">
      <div class="vn-grid-12 vn-home-proof__header">
        <div style="grid-column: 1 / 8">
          <span class="vn-label-mono vn-home-proof__eyebrow">Proof / Reviews</span>
          <h2 class="vn-home-proof__title" id="vn-home-proof-title">
            Что помогает доверить сервису первый разбор
          </h2>
        </div>
        <div style="grid-column: 8 / 13">
          <p class="vn-home-proof__lead">
            На главной остаётся компактный слой доказательств. Подробный trust-слой, роль Михаила и сервисная фактура раскрываются на странице «О Военном навигаторе».
          </p>
        </div>
      </div>

      <div class="vn-home-proof__grid vn-grid-12">
        {proofCards.map((card, index) => (
          <article class="vn-home-proof__card" style={`grid-column: ${index === 0 ? '1 / 5' : index === 1 ? '5 / 9' : '9 / 13'}`}>
            <span class="vn-home-proof__label">{card.label}</span>
            <h3 class="vn-home-proof__card-title">{card.title}</h3>
            <p class="vn-home-proof__text">{card.text}</p>
          </article>
        ))}
      </div>

      <div class="vn-home-proof__footer">
        <a href="/o-servise/" class="vn-btn-primary vn-home-proof__cta">О сервисе</a>
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-proof {
    position: relative;
    padding: 96px 0 88px;
    overflow: hidden;
  }

  .vn-home-proof .vn-deco-grid--dark {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .vn-home-proof__header {
    position: relative;
    z-index: 1;
    align-items: end;
    margin-bottom: 40px;
  }

  .vn-home-proof__eyebrow {
    color: var(--color-text-ondark);
    opacity: 0.5;
  }

  .vn-home-proof__title {
    margin: 16px 0 0;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-ondark);
    text-wrap: balance;
  }

  .vn-home-proof__lead {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--color-border-ondark);
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--color-text-ondark-mute);
  }

  .vn-home-proof__grid {
    position: relative;
    z-index: 1;
    gap: 16px 24px;
  }

  .vn-home-proof__card {
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--color-border-ondark);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-dark-elev) 78%, transparent);
  }

  .vn-home-proof__label {
    display: inline-flex;
    margin-bottom: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent-cta);
  }

  .vn-home-proof__card-title {
    margin: 0 0 10px;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.32;
    color: var(--color-text-ondark);
  }

  .vn-home-proof__text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-ondark-mute);
    text-wrap: pretty;
  }

  .vn-home-proof__footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: flex-start;
    margin-top: 24px;
  }

  .vn-home-proof__cta {
    text-decoration: none;
  }

  @media (max-width: 1023px) {
    .vn-home-proof__header > div {
      grid-column: 1 / -1 !important;
    }

    .vn-home-proof__lead {
      margin-top: 16px;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--color-border-ondark);
      padding-top: 16px;
    }

    .vn-home-proof__grid > .vn-home-proof__card:nth-child(odd) {
      grid-column: 1 / 7 !important;
    }

    .vn-home-proof__grid > .vn-home-proof__card:nth-child(even) {
      grid-column: 7 / 13 !important;
    }

    .vn-home-proof__grid > .vn-home-proof__card:nth-child(3) {
      grid-column: 1 / 7 !important;
    }
  }

  @media (max-width: 640px) {
    .vn-home-proof {
      padding: 72px 0 64px;
    }

    .vn-home-proof__grid > .vn-home-proof__card:nth-child(n) {
      grid-column: 1 / -1 !important;
    }

    .vn-home-proof__card {
      padding: 20px;
    }

    .vn-home-proof__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
