---
import OptimizedImage from '../../components/ui/OptimizedImage.astro';
import { CONTACTS } from '../../lib/constants';
import { getConfiguredValue } from '../../lib/utils';

const vkHref = getConfiguredValue(CONTACTS.vk);
const telegramHref = getConfiguredValue(CONTACTS.telegram);
---

<!-- ══════════════════════════════════════════════
     БЛОК 08 — ОПЫТ И ДОВЕРИЕ
════════════════════════════════════════════════ -->
<section id="section-trust" class="vn-section vn-section--secondary vn-home-trust" aria-labelledby="vn-home-trust-title">
  <div class="vn-container">
    <div class="vn-grid-12 vn-home-trust__grid">

      <!-- ── Left: photo ── -->
      <div class="vn-home-trust__photo-wrap" style="grid-column: 1 / 5">
        <OptimizedImage
          src="/images/mikhail-desk.png"
          alt="Михаил Хряпин — эксперт по новостройкам и военной ипотеке"
          width={480}
          height={580}
          loading="lazy"
          class="vn-home-trust__photo"
        />
      </div>

      <!-- ── Right: content ── -->
      <div class="vn-home-trust__content" style="grid-column: 5 / 13">

        <span class="vn-label-mono">Опыт и доверие</span>
        <h2 class="vn-home-trust__h2" id="vn-home-trust-title">
          Мы помогаем пройти весь маршрут: от выбора новостройки до регистрации сделки
        </h2>
        <p class="vn-home-trust__lead">
          С 2016 года мы сопровождаем сделки по военной ипотеке.
          Не просто показываем варианты — помогаем выбрать правильно,
          объясняем риски и отсекаем плохие решения.
        </p>

        <!-- Stats with CountUp animation -->
        <div class="vn-home-trust__stats">
          <div class="vn-home-trust__stat">
            <span class="vn-home-trust__stat-num" data-count-up data-count-value="65">0</span>
            <span class="vn-home-trust__stat-label">сделок по военной ипотеке</span>
          </div>
          <div class="vn-home-trust__stat-divider" aria-hidden="true"></div>
          <div class="vn-home-trust__stat">
            <span class="vn-home-trust__stat-num" data-count-up data-count-value="180">0</span>
            <span class="vn-home-trust__stat-label">проведённых сделок с недвижимостью</span>
          </div>
          <div class="vn-home-trust__stat-divider" aria-hidden="true"></div>
          <div class="vn-home-trust__stat">
            <span class="vn-home-trust__stat-num">с&nbsp;2016</span>
            <span class="vn-home-trust__stat-label">в недвижимости</span>
          </div>
        </div>

        <!-- Transparency note -->
        <div class="vn-home-trust__transparency">
          Модель интересов простая: в новостройках платит застройщик,
          но подбор строится на задаче клиента. Если объект не подходит
          под район, ликвидность или семейный сценарий — мы его не рекомендуем,
          даже если застройщик платит больше.
        </div>

        <!-- Quote -->
        <blockquote class="vn-home-trust__quote">
          Важно заранее объяснить ограничения,
          отсечь неподходящие варианты и довести сделку до результата.
        </blockquote>

        <!-- CTA -->
        <div class="vn-home-trust__cta-row">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Получить первичный разбор"
            class="vn-btn-primary vn-home-trust__cta"
          >
            Получить первичный разбор
          </a>
          <span class="vn-home-trust__cta-note">Мы уточним вашу задачу и подскажем, с чего начать.</span>
        </div>

        <!-- Media links -->
        <div class="vn-home-trust__media">
          <span class="vn-home-trust__media-label">Где посмотреть подход в работе:</span>
          {vkHref && (
            <a href={vkHref} target="_blank" rel="noopener noreferrer"
               class="vn-home-trust__link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M15.07 2H8.93C3.33 2 2 3.33 2 8.93v6.14C2 20.67 3.33 22 8.93 22h6.14C20.67 22 22 20.67 22 15.07V8.93C22 3.33 20.67 2 15.07 2zm3.08 13.5h-1.59c-.6 0-.79-.48-1.87-1.57-1-.95-1.39-.95-1.63-.95-.33 0-.42.1-.42.56v1.43c0 .4-.13.64-1.18.64-1.74 0-3.67-1.05-5.03-3.02C4.7 10.01 4.17 8.1 4.17 7.7c0-.24.1-.46.56-.46h1.6c.42 0 .58.19.74.64.82 2.37 2.19 4.44 2.75 4.44.21 0 .31-.1.31-.63V9.59c-.07-1.14-.67-1.23-.67-1.64 0-.19.16-.4.42-.4h2.5c.35 0 .47.19.47.6v3.22c0 .35.16.47.26.47.21 0 .38-.12.76-.51 1.18-1.32 2.01-3.35 2.01-3.35.11-.24.31-.46.73-.46h1.6c.48 0 .59.25.48.6-.2.93-2.14 3.67-2.14 3.67-.17.28-.23.4 0 .71.17.24.72.74 1.09 1.18.67.78 1.19 1.44 1.33 1.89.14.44-.09.67-.53.67z"/>
              </svg>
              Разборы в VK
            </a>
          )}
          {telegramHref && (
            <a href={telegramHref} target="_blank" rel="noopener noreferrer"
               class="vn-home-trust__link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8l-1.69 7.96c-.12.56-.46.7-.93.43l-2.57-1.9-1.24 1.19c-.14.14-.25.25-.51.25l.18-2.6 4.72-4.26c.2-.18-.04-.28-.32-.1L7.46 14.5l-2.52-.79c-.55-.17-.56-.55.12-.81l9.84-3.79c.46-.17.86.11.74.69z"/>
              </svg>
              Telegram-канал
            </a>
          )}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
/* ─── Block 08: Trust ─── */

.vn-home-trust {
  scroll-margin-top: 104px;
}

.vn-home-trust__grid {
  align-items: stretch;
}

/* ── Photo ── */
.vn-home-trust__photo-wrap {
  display: flex;
  align-items: stretch;
}

.vn-home-trust__photo {
  width: 100%;
  height: 100%;
  min-height: 480px;
  object-fit: cover;
  object-position: center top;
  border-radius: 16px;
  display: block;
}

/* ── Content ── */
.vn-home-trust__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 16px;
}

.vn-home-trust__h2 {
  margin: 16px 0 12px;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-trust__lead {
  margin: 0 0 36px;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  max-width: 520px;
}

/* ── Stats ── */
.vn-home-trust__stats {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 32px;
  padding: 28px 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.vn-home-trust__stat {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
  padding: 0 28px;
}

.vn-home-trust__stat:first-child {
  padding-left: 0;
}

.vn-home-trust__stat-divider {
  width: 1px;
  height: 48px;
  background: var(--color-border);
  flex-shrink: 0;
}

.vn-home-trust__stat-num {
  /* type-exception: metric/stat-number */
  font-size: var(--fs-stat);
  font-weight: 650;
  line-height: 1;
  color: var(--color-accent-primary);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.vn-home-trust__stat-label {
  font-size: var(--fs-label);
  line-height: 1.45;
  color: var(--color-text-tertiary);
}

/* ── Transparency ── */
.vn-home-trust__transparency {
  margin: 0 0 24px;
  padding: 18px 20px;
  border-left: 3px solid var(--color-accent-cta);
  border-radius: 0 8px 8px 0;
  background: var(--color-accent-cta-soft);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ── Quote ── */
.vn-home-trust__quote {
  margin: 0 0 28px;
  padding: 0 0 0 16px;
  border-left: 2px solid var(--color-border);
  font-size: var(--fs-body-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
  font-style: normal;
}

/* ── CTA ── */
.vn-home-trust__cta-row {
  margin-bottom: 28px;
}

.vn-home-trust__cta {
  display: inline-flex;
}

.vn-home-trust__cta-note {
  display: block;
  margin-top: 10px;
  font-size: var(--fs-body-sm);
  line-height: 1.55;
  color: var(--color-text-tertiary);
}

/* ── Media links ── */
.vn-home-trust__media {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.vn-home-trust__media-label {
  font-size: var(--fs-label);
  color: var(--color-text-tertiary);
}

.vn-home-trust__link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: color 0.15s ease;
}

.vn-home-trust__link:hover {
  color: var(--color-accent-cta);
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-trust__photo-wrap { grid-column: 1 / -1 !important; }
  .vn-home-trust__content    { grid-column: 1 / -1 !important; padding-left: 0; }
  .vn-home-trust__photo      { min-height: 360px; height: 360px; }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-trust {
    scroll-margin-top: 88px;
  }

  .vn-home-trust__photo {
    min-height: 340px;
    height: 340px;
    object-position: center 18%;
  }

  .vn-home-trust__stats {
    display: grid;
    gap: 0;
    margin-bottom: 24px;
    padding: 12px 0;
  }

  .vn-home-trust__stat {
    display: grid;
    grid-template-columns: 84px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .vn-home-trust__stat:nth-of-type(5) {
    border-bottom: none;
  }

  .vn-home-trust__stat-divider { display: none; }
}
</style>

<script is:inline>
  (function () {
    const easeOutCubic = (x) => 1 - Math.pow(1 - x, 3);

    function animateValue(element, target, duration) {
      const startTimestamp = performance.now();
      const formatNumber = (num) => num.toString();

      const step = (timestamp) => {
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        const easedProgress = easeOutCubic(progress);
        const currentValue = Math.floor(easedProgress * target);
        element.textContent = formatNumber(currentValue);
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          element.textContent = formatNumber(target);
        }
      };

      requestAnimationFrame(step);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ isIntersecting, target }) => {
        if (isIntersecting) {
          const targetValue = parseInt(target.getAttribute('data-count-value') || '0', 10);
          if (!isNaN(targetValue) && targetValue > 0) {
            animateValue(target, targetValue, 2000);
          }
          observer.unobserve(target);
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('[data-count-up]').forEach((el) => {
      observer.observe(el);
    });
  })();
</script>
