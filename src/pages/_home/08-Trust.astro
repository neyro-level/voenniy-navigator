---
import { CONTACTS } from '../../lib/constants';
---

<!-- ══════════════════════════════════════════════
     БЛОК 08 — ПОЧЕМУ МИХАИЛ
════════════════════════════════════════════════ -->
<section id="section-trust" class="vn-section vn-section--secondary vn-home-trust" aria-labelledby="vn-home-trust-title">
  <div class="vn-container">
    <div class="vn-grid-12 vn-home-trust__grid">

      <!-- ── Left: photo ── -->
      <div class="vn-home-trust__photo-wrap" style="grid-column: 1 / 5">
        <img
          src="/images/mikhail-desk.png"
          alt="Михаил Хряпин — эксперт по военной ипотеке в Краснодаре"
          width="480"
          height="580"
          loading="lazy"
          class="vn-home-trust__photo"
        />
      </div>

      <!-- ── Right: content ── -->
      <div class="vn-home-trust__content" style="grid-column: 5 / 13">

        <span class="vn-label-mono">ПОЧЕМУ МИХАИЛ / 08</span>
        <h2 class="vn-home-trust__h2" id="vn-home-trust-title">
          65 сделок по НИС — и каждая доведена до регистрации
        </h2>
        <p class="vn-home-trust__lead">
          Михаил сопровождает покупку новостроек в Краснодаре, на побережье
          и в Крыму. Знает, какие ЖК подходят под военную ипотеку,
          где скрытые риски и как пройти маршрут без потерь.
        </p>

        <!-- Stats -->
        <div class="vn-home-trust__stats">
          <div class="vn-home-trust__stat">
            <span class="vn-home-trust__stat-num">65</span>
            <span class="vn-home-trust__stat-label">сделок по военной ипотеке</span>
          </div>
          <div class="vn-home-trust__stat-divider" aria-hidden="true"></div>
          <div class="vn-home-trust__stat">
            <span class="vn-home-trust__stat-num">180<span class="vn-home-trust__stat-plus">+</span></span>
            <span class="vn-home-trust__stat-label">сделок в недвижимости</span>
          </div>
          <div class="vn-home-trust__stat-divider" aria-hidden="true"></div>
          <div class="vn-home-trust__stat">
            <span class="vn-home-trust__stat-num">с&nbsp;2016</span>
            <span class="vn-home-trust__stat-label">работает в Краснодаре</span>
          </div>
        </div>

        <!-- Quote -->
        <blockquote class="vn-home-trust__quote">
          Михаил Хряпин — эксперт по сопровождению покупки новостроек
          для военнослужащих по программе НИС. Работает в Краснодаре,
          на Черноморском побережье и в Крыму.
        </blockquote>

        <!-- Media links -->
        <div class="vn-home-trust__media">
          <span class="vn-home-trust__media-label">Разборы и материалы:</span>
          <a href={CONTACTS.vk} target="_blank" rel="noopener noreferrer"
             class="vn-home-trust__link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M15.07 2H8.93C3.33 2 2 3.33 2 8.93v6.14C2 20.67 3.33 22 8.93 22h6.14C20.67 22 22 20.67 22 15.07V8.93C22 3.33 20.67 2 15.07 2zm3.08 13.5h-1.59c-.6 0-.79-.48-1.87-1.57-1-.95-1.39-.95-1.63-.95-.33 0-.42.1-.42.56v1.43c0 .4-.13.64-1.18.64-1.74 0-3.67-1.05-5.03-3.02C4.7 10.01 4.17 8.1 4.17 7.7c0-.24.1-.46.56-.46h1.6c.42 0 .58.19.74.64.82 2.37 2.19 4.44 2.75 4.44.21 0 .31-.1.31-.63V9.59c-.07-1.14-.67-1.23-.67-1.64 0-.19.16-.4.42-.4h2.5c.35 0 .47.19.47.6v3.22c0 .35.16.47.26.47.21 0 .38-.12.76-.51 1.18-1.32 2.01-3.35 2.01-3.35.11-.24.31-.46.73-.46h1.6c.48 0 .59.25.48.6-.2.93-2.14 3.67-2.14 3.67-.17.28-.23.4 0 .71.17.24.72.74 1.09 1.18.67.78 1.19 1.44 1.33 1.89.14.44-.09.67-.53.67z"/>
            </svg>
            Разборы в VK
          </a>
          <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer"
             class="vn-home-trust__link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8l-1.69 7.96c-.12.56-.46.7-.93.43l-2.57-1.9-1.24 1.19c-.14.14-.25.25-.51.25l.18-2.6 4.72-4.26c.2-.18-.04-.28-.32-.1L7.46 14.5l-2.52-.79c-.55-.17-.56-.55.12-.81l9.84-3.79c.46-.17.86.11.74.69z"/>
            </svg>
            Telegram-канал
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
/* ─── Block 08: Trust ─── */

.vn-home-trust__grid {
  align-items: stretch;
}

/* ── Photo ── */
.vn-home-trust__photo-wrap {
  display: flex;
  align-items: stretch;
}

.vn-home-trust__photo {
  width: 100%;
  height: 100%;
  min-height: 480px;
  object-fit: cover;
  object-position: center top;
  border-radius: 16px;
  display: block;
}

/* ── Content ── */
.vn-home-trust__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 16px;
}

.vn-home-trust__h2 {
  margin: 16px 0 12px;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-trust__lead {
  margin: 0 0 36px;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  max-width: 520px;
}

/* ── Stats ── */
.vn-home-trust__stats {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 32px;
  padding: 28px 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.vn-home-trust__stat {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
  padding: 0 28px;
}

.vn-home-trust__stat:first-child {
  padding-left: 0;
}

.vn-home-trust__stat-divider {
  width: 1px;
  height: 48px;
  background: var(--color-border);
  flex-shrink: 0;
}

.vn-home-trust__stat-num {
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 700;
  line-height: 1;
  color: var(--color-accent-primary);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.vn-home-trust__stat-plus {
  font-size: 0.65em;
  vertical-align: super;
  font-weight: 600;
}

.vn-home-trust__stat-label {
  font-size: 12px;
  line-height: 1.45;
  color: var(--color-text-tertiary);
}

/* ── Quote ── */
.vn-home-trust__quote {
  margin: 0 0 28px;
  padding: 0 0 0 16px;
  border-left: 2px solid var(--color-border);
  font-size: var(--fs-body-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
  font-style: normal;
}

/* ── Media links ── */
.vn-home-trust__media {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.vn-home-trust__media-label {
  font-size: 12px;
  color: var(--color-text-tertiary);
}

.vn-home-trust__link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: color 0.15s ease;
}

.vn-home-trust__link:hover {
  color: var(--color-accent-cta);
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-trust__photo-wrap { grid-column: 1 / -1 !important; }
  .vn-home-trust__content    { grid-column: 1 / -1 !important; padding-left: 0; }
  .vn-home-trust__photo      { min-height: 360px; height: 360px; }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-trust__photo { min-height: 280px; height: 280px; }
  .vn-home-trust__stats { flex-wrap: wrap; gap: 20px; }
  .vn-home-trust__stat  { flex: none; min-width: 120px; padding: 0; }
  .vn-home-trust__stat-divider { display: none; }
}
</style>
