---
import { CONTACTS } from '../../lib/constants';
---

<!-- ══════════════════════════════════════════════
     БЛОК 08 — ПОЧЕМУ МОЖНО ДОВЕРЯТЬ
════════════════════════════════════════════════ -->
<section id="section-trust" class="vn-section">
  <span class="vn-section-marker vn-pos-bl" aria-hidden="true">08</span>
  <div class="vn-container vn-rel">
    <span class="vn-label-mono">ПОЧЕМУ МИХАИЛ / 08</span>
    <h2 class="vn-home-h2" style="margin-top:16px; margin-bottom:40px;">
      Почему можно доверять
    </h2>

    <div class="vn-home-trust__cols">

      <!-- Left: факты + entity -->
      <div>
        <h3 class="vn-home-fs__col-title" style="margin-bottom:24px;">Опыт и специализация</h3>
        <div class="vn-home-trust__facts">
          <div class="vn-home-trust__fact">
            <div class="vn-accent-line" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"></div>
            <div>
              <!-- TODO: заменить [ГОД] на реальный год -->
              <p class="vn-home-trust__fact-main">В новостройках Краснодара с [ГОД] года</p>
              <p class="vn-home-trust__fact-sub">Специализация на первичном рынке</p>
            </div>
          </div>
          <div class="vn-home-trust__fact">
            <div class="vn-accent-line" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"></div>
            <div>
              <p class="vn-home-trust__fact-main">65 сделок по военной ипотеке</p>
              <p class="vn-home-trust__fact-sub">Накопленный опыт</p>
            </div>
          </div>
          <div class="vn-home-trust__fact">
            <div class="vn-accent-line" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"></div>
            <div>
              <p class="vn-home-trust__fact-main">180+ сделок в недвижимости всего</p>
              <p class="vn-home-trust__fact-sub">Суммарный результат</p>
            </div>
          </div>
          <div class="vn-home-trust__fact">
            <div class="vn-accent-line" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"></div>
            <div>
              <p class="vn-home-trust__fact-main">Только Краснодар. Только новостройки. Только военная ипотека.</p>
              <p class="vn-home-trust__fact-sub">Узкая специализация — глубокое знание</p>
            </div>
          </div>
        </div>

        <blockquote class="vn-home-trust__entity">
          Михаил Хряпин — частный специалист по сопровождению покупки
          новостроек Краснодара для военнослужащих по программе
          военной ипотеки (НИС).
        </blockquote>
      </div>

      <!-- Right: фото + медиа -->
      <div class="vn-home-trust__col-right">
        <img
          src="/images/mikhail-hero.png"
          alt="Михаил Хряпин"
          width="400"
          height="460"
          loading="lazy"
          class="vn-home-trust__photo"
        />
        <div class="vn-home-trust__media">
          <a href={CONTACTS.vk} target="_blank" rel="noopener noreferrer" class="vn-home-trust__pill">
            Разборы в VK
          </a>
          <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="vn-home-trust__pill">
            Telegram-канал
          </a>
        </div>
      </div>

    </div>

    <!-- Медиа-полоса -->
    <div class="vn-home-trust__strip">
      <span class="vn-label-mono">МИХАИЛ В МЕДИА</span>
      <p class="vn-home-sub" style="max-width:560px; margin-top:12px;">
        Михаил регулярно разбирает объекты и сделки по военной ипотеке
        в открытых форматах — видео, посты, разборы. Это помогает
        понять подход до первого звонка.
      </p>
      <a href={CONTACTS.vk} target="_blank" rel="noopener noreferrer" class="vn-home-textlink" style="margin-top:12px;">
        Посмотреть разборы в VK →
      </a>
    </div>
  </div>
</section>

<style>
/* ─── Block 08: Trust ─── */
.vn-home-trust__cols {
  display: grid;
  grid-template-columns: 55fr 45fr;
  gap: 48px;
  align-items: start;
}

.vn-home-trust__facts {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.vn-home-trust__fact {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.vn-home-trust__fact-main {
  font-size: 15px;
  font-weight: 500;
  color: var(--color-text-primary);
  margin: 0 0 2px;
}

.vn-home-trust__fact-sub {
  font-size: 12px;
  color: var(--color-text-tertiary);
  margin: 0;
}

.vn-home-trust__entity {
  margin: 28px 0 0;
  padding: 22px 24px;
  background-color: var(--color-bg-surface);
  border-left: 3px solid var(--color-accent-primary);
  border-radius: var(--radius-lg);
  font-size: 15px;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.vn-home-trust__col-right { display: flex; flex-direction: column; }

.vn-home-trust__photo {
  width: 100%;
  max-width: 400px;
  height: 460px;
  object-fit: cover;
  object-position: center top;
  border-radius: 14px;
  box-shadow: 0 8px 32px rgba(15,20,25,0.10);
  display: block;
}

.vn-home-trust__media {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  flex-wrap: wrap;
}

.vn-home-trust__pill {
  padding: 8px 16px;
  background-color: var(--color-accent-soft);
  color: var(--color-accent-primary);
  font-size: 13px;
  font-weight: 500;
  border-radius: var(--radius-full);
  text-decoration: none;
  transition: background-color 0.15s ease;
}

.vn-home-trust__pill:hover { background-color: rgba(15,37,71,0.14); }

.vn-home-trust__strip {
  margin-top: 64px;
  padding-top: 48px;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

@media (max-width: 768px) {
  .vn-home-trust__cols { grid-template-columns: 1fr; }
  .vn-home-trust__photo { max-width: 100%; height: 280px; }
}
</style>
