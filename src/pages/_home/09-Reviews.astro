<style>
/* ─── Block 09: Reviews (dark, bank style) ─── */
.vn-home-reviews {
  position: relative;
  padding: 96px 0 88px;
  overflow: hidden;
  scroll-margin-top: 104px;
}

.vn-home-reviews .vn-deco-grid--dark {
  position: absolute;
  inset: 0;
  z-index: 0;
}

/* ── Header ── */
.vn-home-reviews__header {
  margin-bottom: 56px;
  align-items: end;
}

.vn-home-reviews__head-left {
  display: flex;
  flex-direction: column;
}

.vn-home-reviews__eyebrow {
  color: var(--color-text-ondark);
  opacity: 0.5;
}

.vn-home-reviews__h2 {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-ondark);
  text-wrap: balance;
}

.vn-home-reviews__head-right {
  display: flex;
  align-items: flex-end;
  padding-bottom: 4px;
}

.vn-home-reviews__note {
  margin: 0;
  font-size: var(--fs-body-sm);
  line-height: 1.65;
  color: var(--color-text-ondark);
  opacity: 0.4;
  padding-left: 24px;
  border-left: 1px solid var(--color-border-ondark);
  text-wrap: pretty;
}

/* ── Featured stories (3 cards) ── */
.vn-home-reviews__featured {
  position: relative;
  z-index: 1;
  margin-bottom: 24px;
}

.vn-home-reviews__feat-card {
  background: color-mix(in srgb, var(--color-bg-dark-elev) 88%, transparent);
  border-radius: var(--radius-lg);
  padding: 28px;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  border: 1px solid var(--color-border-ondark);
}

.vn-home-reviews__feat-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.vn-home-reviews__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--color-accent-cta-soft);
  color: var(--color-text-ondark);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body-sm);
  font-weight: 600;
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

.vn-home-reviews__author {
  display: block;
  font-size: var(--fs-body-sm);
  font-weight: 600;
  color: var(--color-text-ondark);
  opacity: 0.9;
}

.vn-home-reviews__tag {
  display: block;
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-accent-cta);
  margin-top: 4px;
}

.vn-home-reviews__quote {
  margin: 0;
  font-size: var(--fs-body);
  line-height: 1.62;
  color: var(--color-text-ondark);
  opacity: 0.72;
  font-style: italic;
  text-wrap: pretty;
}

/* ── Media strip ── */
.vn-home-reviews__media {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px 24px;
  border: 1px solid var(--color-border-ondark);
  border-radius: var(--radius-lg);
  background: color-mix(in srgb, var(--color-bg-dark-elev) 46%, transparent);
}

.vn-home-reviews__media-text {
  margin: 0;
  font-size: var(--fs-body-sm);
  line-height: 1.55;
  color: var(--color-text-ondark);
  opacity: 0.66;
}

.vn-home-reviews__cta {
  flex-shrink: 0;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-reviews__head-left  { grid-column: 1 / -1 !important; }
  .vn-home-reviews__head-right { grid-column: 1 / -1 !important; padding-left: 0; padding-top: 16px; border-top: 1px solid var(--color-border-ondark); }
  .vn-home-reviews__note { padding-left: 0; border-left: none; }

  .vn-home-reviews__featured > .vn-home-reviews__feat-card:nth-child(1) { grid-column: 1 / 7 !important; }
  .vn-home-reviews__featured > .vn-home-reviews__feat-card:nth-child(2) { grid-column: 7 / 13 !important; }
  .vn-home-reviews__featured > .vn-home-reviews__feat-card:nth-child(3) { grid-column: 1 / 7 !important; }

  .vn-home-reviews__media {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-reviews {
    padding: 72px 0 64px;
    scroll-margin-top: 88px;
  }
  .vn-home-reviews__featured > .vn-home-reviews__feat-card:nth-child(n) { grid-column: 1 / -1 !important; }
  .vn-home-reviews__featured { margin-bottom: 20px; }
  .vn-home-reviews__feat-card { padding: 24px; }
  .vn-home-reviews__h2 { font-size: var(--fs-h2); }
  .vn-home-reviews__note { font-size: var(--fs-body-sm); line-height: 1.55; }
  .vn-home-reviews__quote { font-size: var(--fs-body-sm); line-height: 1.6; }

  .vn-home-reviews__media {
    padding: 20px;
    gap: 16px;
    flex-direction: column;
    align-items: flex-start;
  }

  .vn-home-reviews__cta {
    width: 100%;
    justify-content: center;
  }
}
</style>
