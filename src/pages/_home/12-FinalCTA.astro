---
import { CONTACTS } from '../../lib/constants';
---

<!-- ══════════════════════════════════════════════
     БЛОК 12 — ФИНАЛЬНЫЙ CTA (DARK)
════════════════════════════════════════════════ -->
<section id="section-cta-final" class="vn-section vn-section--dark vn-home-final">
  <div class="vn-deco-grid vn-deco-grid--dark" aria-hidden="true"></div>
  <div class="vn-home-final__radial" aria-hidden="true"></div>
  <span class="vn-section-marker vn-home-final__marker" aria-hidden="true">12</span>

  <div class="vn-container vn-rel">
    <div class="vn-home-final__center">

      <span class="vn-label-mono" style="color:var(--color-text-ondark-mute);">
        ГОТОВЫ К ПЕРВОМУ ШАГУ?
      </span>

      <h2 class="vn-home-final__h2">
        Начнём с разбора<br />
        <span style="color:var(--color-accent-cta);">вашей ситуации</span>
      </h2>

      <p class="vn-home-final__sub">
        За 30 минут разберём цель покупки, подходящий сценарий
        и критерии выбора ЖК в Краснодаре. Без обязательств продолжать.
      </p>

      <a
        href="/contacts/#request"
        data-modal-open
        data-modal-title="Записаться на разбор цели покупки"
        class="vn-btn-primary vn-home-final__cta"
      >
        Записаться на разбор цели покупки
      </a>

      <p class="vn-home-final__alt">
        Или напишите напрямую:
        <!-- TODO: заменить [TELEGRAM] и [MAX_LINK] на реальные ссылки -->
        <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="vn-home-final__alt-link">Telegram</a>
        <a href={CONTACTS.max} target="_blank" rel="noopener noreferrer" class="vn-home-final__alt-link">Max</a>
      </p>

      <!-- Stats strip -->
      <div class="vn-home-final__stats">
        <div class="vn-home-final__stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>30 минут</span>
        </div>
        <div class="vn-home-final__stat-div" aria-hidden="true"></div>
        <div class="vn-home-final__stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>В удобное время</span>
        </div>
        <div class="vn-home-final__stat-div" aria-hidden="true"></div>
        <div class="vn-home-final__stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Бесплатно</span>
        </div>
      </div>

      <!-- Полезные страницы -->
      <div class="vn-home-final__pages">
        <span class="vn-label-mono" style="color:var(--color-text-ondark-mute);">ПОЛЕЗНЫЕ СТРАНИЦЫ</span>
        <div class="vn-home-final__pages-list">
          <a href="/voennaya-ipoteka-krasnodar/" class="vn-home-final__page-link">
            <span>Новостройки Краснодара по военной ипотеке</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/distancionnaya-pokupka/" class="vn-home-final__page-link">
            <span>Дистанционная покупка новостройки</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/etapy-pokupki/" class="vn-home-final__page-link">
            <span>Этапы покупки по военной ипотеке</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 12: Final CTA ─── */
.vn-home-final { padding-block: 120px; }

.vn-home-final__radial {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 1000px 500px at 50% 0%, rgba(37,99,235,0.08), transparent);
  pointer-events: none;
  z-index: 0;
}

.vn-home-final__marker {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: rgba(255,255,255,0.03);
  font-size: 280px;
}

.vn-home-final__center {
  position: relative;
  z-index: 1;
  max-width: 640px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.vn-home-final__h2 {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text-ondark);
  margin: 14px 0 0;
  max-width: 560px;
}

.vn-home-final__sub {
  font-size: 18px;
  color: var(--color-text-ondark-mute);
  max-width: 480px;
  margin: 14px 0 40px;
  line-height: 1.6;
}

.vn-home-final__cta {
  font-size: 16px;
  height: 56px;
  padding: 16px 32px;
  width: 100%;
  max-width: 420px;
  justify-content: center;
}

.vn-home-final__alt {
  margin-top: 20px;
  font-size: 14px;
  color: var(--color-text-ondark-mute);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.vn-home-final__alt-link {
  color: var(--color-text-ondark);
  text-decoration: underline;
  text-underline-offset: 3px;
  font-weight: 500;
}

.vn-home-final__alt-link:hover { color: var(--color-accent-cta); }

.vn-home-final__stats {
  display: flex;
  align-items: center;
  margin-top: 32px;
  padding-top: 28px;
  border-top: 1px solid var(--color-border-ondark);
  width: 100%;
  justify-content: center;
}

.vn-home-final__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 0 28px;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-text-ondark);
}

.vn-home-final__stat svg { color: var(--color-accent-cta); }

.vn-home-final__stat-div {
  width: 1px;
  height: 32px;
  background-color: var(--color-border-ondark);
  flex-shrink: 0;
}

.vn-home-final__pages {
  width: 100%;
  margin-top: 32px;
  padding-top: 28px;
  border-top: 1px solid var(--color-border-ondark);
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.vn-home-final__pages-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.vn-home-final__page-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background-color: var(--color-bg-dark-elev);
  border: 1px solid var(--color-border-ondark);
  border-radius: var(--radius-lg);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  color: var(--color-text-ondark);
  text-align: left;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.vn-home-final__page-link svg { color: var(--color-text-ondark-mute); flex-shrink: 0; }

.vn-home-final__page-link:hover {
  border-color: rgba(37,99,235,0.4);
  background-color: rgba(37,99,235,0.06);
}

@media (max-width: 768px) {
  .vn-home-final { padding-block: 80px; }
  .vn-home-final__stats { flex-direction: column; gap: 16px; padding-top: 20px; }
  .vn-home-final__stat { flex-direction: row; gap: 10px; padding: 0; }
  .vn-home-final__stat-div { width: 32px; height: 1px; }
}
</style>
