---
import { CONTACTS } from '../../lib/constants';
---

<!-- ══════════════════════════════════════════════
     БЛОК 12 — ФИНАЛЬНЫЙ CTA
════════════════════════════════════════════════ -->
<section id="section-cta-final" class="vn-home-final">
  <div class="vn-deco-grid vn-deco-grid--dark" aria-hidden="true"></div>
  <div class="vn-home-final__radial" aria-hidden="true"></div>

  <div class="vn-container vn-rel">
    <div class="vn-grid-12 vn-home-final__grid">

      <!-- ── Left: headline + CTA ── -->
      <div class="vn-home-final__left" style="grid-column: 1 / 8">
        <span class="vn-label-mono vn-home-final__eyebrow">ГОТОВЫ К ПЕРВОМУ ШАГУ?</span>
        <h2 class="vn-home-final__h2">
          Начнём с разбора<br>
          <span class="vn-home-final__h2-accent">вашей ситуации</span>
        </h2>
        <p class="vn-home-final__sub">
          За 30 минут разберём цель покупки, подходящий сценарий
          и критерии выбора ЖК. Без обязательств продолжать.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Записаться на разбор цели покупки"
          class="vn-btn-primary vn-home-final__cta"
        >
          Записаться на разбор цели покупки
        </a>
        <p class="vn-home-final__alt">
          Или напишите напрямую:
          <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="vn-home-final__alt-link">Telegram</a>
          <a href={CONTACTS.max} target="_blank" rel="noopener noreferrer" class="vn-home-final__alt-link">Max</a>
        </p>
      </div>

      <!-- ── Right: stats + useful pages ── -->
      <div class="vn-home-final__right" style="grid-column: 8 / 13">

        <!-- Stats -->
        <div class="vn-home-final__stats">
          <div class="vn-home-final__stat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>30 минут</span>
          </div>
          <div class="vn-home-final__stat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>В удобное время</span>
          </div>
          <div class="vn-home-final__stat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Бесплатно</span>
          </div>
        </div>

        <!-- Useful pages -->
        <div class="vn-home-final__pages">
          <span class="vn-label-mono vn-home-final__pages-label">ПОЛЕЗНЫЕ СТРАНИЦЫ</span>
          <div class="vn-home-final__pages-list">
            <a href="/voennaya-ipoteka-krasnodar/" class="vn-home-final__page-link">
              <span>Новостройки Краснодара по военной ипотеке</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            <a href="/distancionnaya-pokupka/" class="vn-home-final__page-link">
              <span>Дистанционная покупка новостройки</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            <a href="/etapy-pokupki/" class="vn-home-final__page-link">
              <span>Этапы покупки по военной ипотеке</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 12: Final CTA ─── */
.vn-home-final {
  background: #0f1419;
  padding-top: 120px;
  padding-bottom: 64px;
  position: relative;
  overflow: hidden;
  font-family: var(--font-family-base);
}

.vn-home-final__radial {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 900px 400px at 30% 0%, rgba(37,99,235,0.07), transparent);
  pointer-events: none;
  z-index: 0;
}

.vn-home-final__grid {
  align-items: center;
}

/* ── Left column ── */
.vn-home-final__left {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.vn-home-final__eyebrow {
  color: rgba(241,243,245,0.5);
}

.vn-home-final__h2 {
  margin: 16px 0 0;
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #f1f3f5;
  text-wrap: balance;
}

.vn-home-final__h2-accent {
  color: var(--color-accent-cta);
}

.vn-home-final__sub {
  margin: 16px 0 36px;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: rgba(241,243,245,0.6);
  max-width: 440px;
}

.vn-home-final__cta {
  font-size: 15px;
  padding: 14px 28px;
}

.vn-home-final__alt {
  margin-top: 16px;
  font-size: 13px;
  color: rgba(241,243,245,0.4);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.vn-home-final__alt-link {
  color: rgba(241,243,245,0.7);
  text-decoration: underline;
  text-underline-offset: 3px;
  font-weight: 500;
  transition: color 0.15s ease;
}
.vn-home-final__alt-link:hover { color: var(--color-accent-cta); }

/* ── Right column ── */
.vn-home-final__right {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-left: 48px;
  border-left: 1px solid rgba(241,243,245,0.08);
}

/* Stats */
.vn-home-final__stats {
  display: flex;
  flex-direction: column;
  padding-bottom: 32px;
  border-bottom: 1px solid rgba(241,243,245,0.08);
  margin-bottom: 32px;
}

.vn-home-final__stat {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  font-size: 14px;
  font-weight: 500;
  color: rgba(241,243,245,0.8);
  border-bottom: 1px solid rgba(241,243,245,0.06);
}
.vn-home-final__stat:last-child { border-bottom: none; }
.vn-home-final__stat svg { color: var(--color-accent-cta); flex-shrink: 0; }

/* Pages */
.vn-home-final__pages-label {
  color: rgba(241,243,245,0.4);
  display: block;
  margin-bottom: 12px;
}

.vn-home-final__pages-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.vn-home-final__page-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 12px 14px;
  background: rgba(241,243,245,0.04);
  border: 1px solid rgba(241,243,245,0.08);
  border-radius: 8px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  color: rgba(241,243,245,0.75);
  transition: border-color 0.15s ease, background 0.15s ease;
}
.vn-home-final__page-link svg { color: rgba(241,243,245,0.3); flex-shrink: 0; }
.vn-home-final__page-link:hover {
  border-color: rgba(37,99,235,0.4);
  background: rgba(37,99,235,0.06);
  color: #f1f3f5;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-final__left  { grid-column: 1 / -1 !important; }
  .vn-home-final__right {
    grid-column: 1 / -1 !important;
    padding-left: 0;
    border-left: none;
    border-top: 1px solid rgba(241,243,245,0.08);
    padding-top: 40px;
    margin-top: 8px;
  }
  .vn-home-final__stats { flex-direction: row; gap: 24px; flex-wrap: wrap; }
  .vn-home-final__stat  { border-bottom: none; padding: 0; }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-final { padding-top: 72px; padding-bottom: 48px; }
  .vn-home-final__stats { flex-direction: column; gap: 0; }
  .vn-home-final__stat  { padding: 10px 0; border-bottom: 1px solid rgba(241,243,245,0.06); }
  .vn-home-final__stat:last-child { border-bottom: none; }
}
</style>
