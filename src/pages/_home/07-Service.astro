<style>
/* ─── Block 07: Service ─── */

.vn-home-svc {
  background: var(--color-bg-surface);
  scroll-margin-top: 104px;
}

/* ── Header ── */
.vn-home-svc__header {
  margin-bottom: 48px;
  align-items: end;
}

.vn-home-svc__head-left {
  display: flex;
  flex-direction: column;
}

.vn-home-svc__h2 {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-svc__head-right {
  display: flex;
  align-items: flex-end;
  padding-bottom: 4px;
}

.vn-home-svc__pricing {
  margin: 0;
  font-size: var(--fs-body-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
  padding-left: 24px;
  border-left: 2px solid var(--color-border);
}

.vn-home-svc__mobile-text {
  display: none;
}

/* ── Items grid ── */
.vn-home-svc__items {
  border-top: 1px solid var(--color-border);
}

.vn-home-svc__item {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 0 16px;
  align-items: start;
  padding: 24px 32px 24px 0;
  border-bottom: 1px solid var(--color-border);
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 0.4s ease, transform 0.4s ease;
}

@media (min-width: 1024px) {
  .vn-home-svc__items.vn-grid-12 > .vn-home-svc__item:nth-child(odd) { grid-column: 1 / 7; }
  .vn-home-svc__items.vn-grid-12 > .vn-home-svc__item:nth-child(even) { grid-column: 7 / 13; padding-left: 32px; padding-right: 0; border-left: 1px solid var(--color-border); }
}

/* Stagger */
.vn-home-svc--visible .vn-home-svc__item:nth-child(1) { opacity: 1; transform: none; transition-delay:   0ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(2) { opacity: 1; transform: none; transition-delay:  60ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(3) { opacity: 1; transform: none; transition-delay: 120ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(4) { opacity: 1; transform: none; transition-delay: 180ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(5) { opacity: 1; transform: none; transition-delay: 240ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(6) { opacity: 1; transform: none; transition-delay: 300ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(7) { opacity: 1; transform: none; transition-delay: 360ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(8) { opacity: 1; transform: none; transition-delay: 420ms; }

.vn-home-svc__rnum {
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-accent-cta);
  opacity: 0.45;
  font-variant-numeric: tabular-nums;
  padding-top: 2px;
}

.vn-home-svc__rbody {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.vn-home-svc__rtitle {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.vn-home-svc__rdesc {
  font-size: var(--fs-body-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-svc__head-left  { grid-column: 1 / -1 !important; }
  .vn-home-svc__head-right { grid-column: 1 / -1 !important; padding-left: 0; border-left: none; border-top: 1px solid var(--color-border); padding-top: 16px; }
  .vn-home-svc__pricing    { padding-left: 0; border-left: none; }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-svc {
    scroll-margin-top: 88px;
  }

  .vn-home-svc__header { margin-bottom: 28px; }

  .vn-home-svc__head-right {
    padding-top: 18px;
  }

  .vn-home-svc__desktop-text {
    display: none;
  }

  .vn-home-svc__mobile-text {
    display: inline;
  }

  .vn-home-svc__items {
    border-top: 1px solid var(--color-border);
  }

  .vn-home-svc__item {
    grid-template-columns: 30px 1fr;
    gap: 0 12px;
    padding: 18px 0;
  }

  .vn-home-svc__rnum {
    padding-top: 1px;
  }

  .vn-home-svc__rbody {
    gap: 3px;
  }

  .vn-home-svc__rtitle {
    font-size: var(--fs-body);
    line-height: 1.32;
  }

  .vn-home-svc__rdesc {
    font-size: var(--fs-body-sm);
    line-height: 1.45;
  }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .vn-home-svc__item { opacity: 1; transform: none; transition: none; }
}
</style>

<script>
  const svc = document.getElementById('section-service');
  if (svc) {
    const items = svc.querySelector('.vn-home-svc__items');
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          svc.classList.add('vn-home-svc--visible');
          observer.disconnect();
        }
      },
      { threshold: 0.1 },
    );
    if (items) observer.observe(items);
  }
</script>
