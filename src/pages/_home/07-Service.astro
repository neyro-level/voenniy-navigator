<!-- ══════════════════════════════════════════════
     БЛОК 07 — СОПРОВОЖДЕНИЕ
════════════════════════════════════════════════ -->
<section id="section-service" class="vn-section vn-home-svc" aria-labelledby="vn-home-svc-title">
  <div class="vn-container">

    <!-- ── Header: full-width ── -->
    <div class="vn-grid-12 vn-home-svc__header">
      <div class="vn-home-svc__head-left" style="grid-column: 1 / 8">
        <span class="vn-label-mono">СОПРОВОЖДЕНИЕ / 07</span>
        <h2 class="vn-home-svc__h2" id="vn-home-svc-title">
          Полный маршрут сделки — под&nbsp;ключ
        </h2>
      </div>
      <div class="vn-home-svc__head-right" style="grid-column: 8 / 13">
        <p class="vn-home-svc__pricing">
          Бесплатно для клиента. Цена квартиры — та же, что в офисе продаж.
          Комиссию платит застройщик.
        </p>
      </div>
    </div>

    <!-- ── Items: 2-column grid ── -->
    <div class="vn-home-svc__items vn-grid-12">

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">01</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">Разбор цели и сценария</strong>
          <span class="vn-home-svc__rdesc">Определяем, что именно нужно купить и зачем.</span>
        </div>
      </div>

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">02</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">Отбор объектов</strong>
          <span class="vn-home-svc__rdesc">Отсекаем неподходящие, собираем короткий список под задачу.</span>
        </div>
      </div>

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">03</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">Локальная проверка</strong>
          <span class="vn-home-svc__rdesc">Район, ЖК, застройщик — глазами человека, который в Краснодаре.</span>
        </div>
      </div>

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">04</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">Показы и выезды</strong>
          <span class="vn-home-svc__rdesc">Видео-показы и при необходимости — выезд на объект.</span>
        </div>
      </div>

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">05</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">Документы и банк</strong>
          <span class="vn-home-svc__rdesc">Военная ипотека, НИС, координация с банком — весь документооборот.</span>
        </div>
      </div>

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">06</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">Координация сторон</strong>
          <span class="vn-home-svc__rdesc">Банк, застройщик, клиент — все участники движутся синхронно.</span>
        </div>
      </div>

      <div class="vn-home-svc__item" data-svc-row>
        <span class="vn-home-svc__rnum">07</span>
        <div class="vn-home-svc__rbody">
          <strong class="vn-home-svc__rtitle">До регистрации права</strong>
          <span class="vn-home-svc__rdesc">Сделка не закрыта, пока право собственности не зарегистрировано.</span>
        </div>
      </div>

      <!-- 8th cell: after-note -->
      <div class="vn-home-svc__note">
        После покупки — помощь с подрядчиком, приёмка квартиры, контроль сроков сдачи.
      </div>

    </div>

  </div>
</section>

<style>
/* ─── Block 07: Service ─── */

.vn-home-svc {
  background: var(--color-bg-surface);
}

/* ── Header ── */
.vn-home-svc__header {
  margin-bottom: 48px;
  align-items: end;
}

.vn-home-svc__head-left {
  display: flex;
  flex-direction: column;
}

.vn-home-svc__h2 {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-svc__head-right {
  display: flex;
  align-items: flex-end;
  padding-bottom: 4px;
}

.vn-home-svc__pricing {
  margin: 0;
  font-size: var(--fs-body-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
  padding-left: 24px;
  border-left: 2px solid var(--color-border);
}

/* ── Items grid ── */
.vn-home-svc__items {
  border-top: 1px solid var(--color-border);
}

.vn-home-svc__item {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 0 16px;
  align-items: start;
  padding: 24px 32px 24px 0;
  border-bottom: 1px solid var(--color-border);
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 0.4s ease, transform 0.4s ease;
}

@media (min-width: 1024px) {
  .vn-home-svc__items.vn-grid-12 > .vn-home-svc__item:nth-child(odd) { grid-column: 1 / 7; }
  .vn-home-svc__items.vn-grid-12 > .vn-home-svc__item:nth-child(even) { grid-column: 7 / 13; padding-left: 32px; padding-right: 0; border-left: 1px solid var(--color-border); }
  .vn-home-svc__items.vn-grid-12 > .vn-home-svc__note { grid-column: 7 / 13; }
}

/* Stagger */
.vn-home-svc--visible .vn-home-svc__item:nth-child(1) { opacity: 1; transform: none; transition-delay:   0ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(2) { opacity: 1; transform: none; transition-delay:  60ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(3) { opacity: 1; transform: none; transition-delay: 120ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(4) { opacity: 1; transform: none; transition-delay: 180ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(5) { opacity: 1; transform: none; transition-delay: 240ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(6) { opacity: 1; transform: none; transition-delay: 300ms; }
.vn-home-svc--visible .vn-home-svc__item:nth-child(7) { opacity: 1; transform: none; transition-delay: 360ms; }

.vn-home-svc__rnum {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-accent-cta);
  opacity: 0.45;
  font-variant-numeric: tabular-nums;
  padding-top: 2px;
}

.vn-home-svc__rbody {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.vn-home-svc__rtitle {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.vn-home-svc__rdesc {
  font-size: 13px;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* After-note cell */
.vn-home-svc__note {
  padding: 24px 0 0 32px;
  border-left: 1px solid var(--color-border);
  font-size: 12px;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-svc__head-left  { grid-column: 1 / -1 !important; }
  .vn-home-svc__head-right { grid-column: 1 / -1 !important; padding-left: 0; border-left: none; border-top: 1px solid var(--color-border); padding-top: 16px; }
  .vn-home-svc__pricing    { padding-left: 0; border-left: none; }
  .vn-home-svc__note       { padding-left: 0; border-left: none; }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-svc__header { margin-bottom: 32px; }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .vn-home-svc__item { opacity: 1; transform: none; transition: none; }
}
</style>

<script>
  const svc = document.getElementById('section-service');
  if (svc) {
    const items = svc.querySelector('.vn-home-svc__items');
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          svc.classList.add('vn-home-svc--visible');
          observer.disconnect();
        }
      },
      { threshold: 0.1 },
    );
    if (items) observer.observe(items);
  }
</script>
