---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
---
<!-- ══════════════════════════════════════════════
     БЛОК 03 — ГЛАВНАЯ ОШИБКА ВЫБОРА
════════════════════════════════════════════════ -->
<RevealOnScroll mode="fade-up">
<section id="section-problem" class="vn-section vn-section--dark vn-home-prob" aria-labelledby="vn-home-prob-title">
  <div class="vn-container">
    <div class="vn-grid-12">

      <div class="vn-home-prob__intro" style="grid-column: 1 / 6">
        <span class="vn-label-mono vn-home-prob__eyebrow">Ошибка выбора</span>
        <h2 class="vn-home-prob__title" id="vn-home-prob-title">
          Главная ошибка — выбирать новостройку без понятной задачи
        </h2>
        <p class="vn-home-prob__lead">
          Военная ипотека показывает рамки покупки: сумму, банк, сроки и документы.
          Но она не отвечает на главный вопрос — какая новостройка подходит именно вам.
        </p>
      </div>

      <div class="vn-home-prob__cards vn-grid-12" style="grid-column: 6 / 13">
        <article class="vn-home-prob__thesis" style="grid-column: 1 / 7">
          <span class="vn-home-prob__tnum">01</span>
          <h3 class="vn-home-prob__ttitle">
            Квартира для жизни и квартира как вложение выбираются по-разному
          </h3>
          <p class="vn-home-prob__tbody">
            Для жизни важны район, инфраструктура, транспорт и удобство семьи.
            Для вложения — срок сдачи, спрос на аренду и будущая продажа.
          </p>
        </article>

        <article class="vn-home-prob__thesis" style="grid-column: 7 / 13">
          <span class="vn-home-prob__tnum">02</span>
          <h3 class="vn-home-prob__ttitle">Реклама показывает объект, но не вашу ситуацию</h3>
          <p class="vn-home-prob__tbody">
            Застройщик продаёт конкретный жилой комплекс. Но презентация и акция
            не отвечают, подходит ли этот вариант под вашу задачу.
          </p>
        </article>

        <article class="vn-home-prob__thesis" style="grid-column: 1 / 7">
          <span class="vn-home-prob__tnum">03</span>
          <h3 class="vn-home-prob__ttitle">Низкая цена может скрывать слабое решение</h3>
          <p class="vn-home-prob__tbody">
            Дешевле не всегда лучше, если район неудобен, срок сдачи не подходит
            или квартиру будет сложно сдавать и продавать.
          </p>
        </article>

        <article class="vn-home-prob__thesis" style="grid-column: 7 / 13">
          <span class="vn-home-prob__tnum">04</span>
          <h3 class="vn-home-prob__ttitle">Список вариантов не заменяет выбор</h3>
          <p class="vn-home-prob__tbody">
            Большая подборка квартир часто только запутывает. Сначала нужно понять
            критерии, а уже потом смотреть конкретные новостройки.
          </p>
        </article>
      </div>

    </div>
  </div>
</section>
</RevealOnScroll>

<style>
/* ─── Block 03: Problem (dark, grid-12 compliant) ─── */
.vn-home-prob {
  padding: 96px 0 88px;
}

.vn-home-prob__eyebrow {
  color: var(--color-text-ondark);
  opacity: 0.5;
}

.vn-home-prob__title {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  line-height: 1.16;
  font-weight: 600;
  color: var(--color-text-ondark);
  text-wrap: balance;
}

.vn-home-prob__lead {
  margin: 22px 0 0;
  color: var(--color-text-ondark);
  opacity: 0.62;
  font-size: var(--fs-body);
  line-height: 1.7;
  max-width: 470px;
  text-wrap: pretty;
}

.vn-home-prob__cards {
  gap: 14px;
}

.vn-home-prob__thesis {
  min-height: 100%;
  padding: 24px;
  border: 1px solid var(--color-border-ondark);
  border-radius: var(--radius-lg);
  background: color-mix(in srgb, var(--color-bg-dark-elev) 72%, transparent);
}

.vn-home-prob__tnum {
  display: block;
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-accent-cta);
  opacity: 0.7;
  margin-bottom: 16px;
  font-variant-numeric: tabular-nums;
}

.vn-home-prob__ttitle {
  margin: 0 0 12px;
  font-size: var(--fs-h3);
  line-height: 1.4;
  font-weight: 600;
  color: var(--color-text-ondark);
  opacity: 0.92;
}

.vn-home-prob__tbody {
  margin: 0;
  color: var(--color-text-ondark);
  opacity: 0.5;
  font-size: var(--fs-body-sm);
  line-height: 1.65;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-prob__intro,
  .vn-home-prob__cards {
    grid-column: 1 / -1 !important;
  }

  .vn-home-prob__lead {
    max-width: 620px;
  }

  .vn-home-prob__cards {
    margin-top: 36px;
  }

  .vn-home-prob__thesis {
    padding: 24px;
  }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-prob { padding: 72px 0 64px; }

  .vn-home-prob__cards.vn-grid-12 > .vn-home-prob__thesis {
    grid-column: 1 / -1 !important;
    padding: 22px;
  }
}
</style>
