---
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';

const formulaSteps = [
  {
    number: '01',
    title: 'Анализ задачи и бюджета',
    text: 'Выясняем реальную цель покупки и формируем точный коридор возможностей, а не оперируем абстрактными цифрами.'
  },
  {
    number: '02',
    title: 'Фильтр ограничений',
    text: 'Проверяем требования банка, сроки и ликвидность, отсеивая неподходящие варианты ещё на этапе анализа.'
  },
  {
    number: '03',
    title: 'Готовый маршрут',
    text: 'Вы получаете короткий список новостроек, которые реально одобрят, и чёткий план следующих действий.',
    isResult: true
  }
];
---

<RevealOnScroll mode="fade-up">
  <section id="section-review" class="vn-home-review" aria-labelledby="vn-home-review-title">
    <div class="vn-container">
      <div class="vn-home-review__header">
        <span class="vn-label-mono">Первичный разбор</span>
        <h2 class="vn-home-review__title" id="vn-home-review-title">
          Как мы формируем ваш персональный маршрут покупки
        </h2>
        <p class="vn-home-review__lead">
          Это не просто консультация, а аналитический процесс. Мы проверяем всё на бумаге, 
          чтобы вы не теряли время на объекты, которые не пройдут одобрение банка.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Получить разбор ситуации"
          class="vn-btn-primary vn-home-review__cta"
        >
          Получить разбор ситуации
        </a>
      </div>

      <div class="vn-home-review__formula">
        {formulaSteps.map((step, index) => (
          <>
            <article class={`vn-home-review__step ${step.isResult ? 'vn-home-review__step--result' : ''}`}>
              <span class="vn-home-review__step-num">{step.number}</span>
              <h3 class="vn-home-review__step-title">{step.title}</h3>
              <p class="vn-home-review__step-text">{step.text}</p>
            </article>
            
            {index < formulaSteps.length - 1 && (
              <div class="vn-home-review__connector" aria-hidden="true"></div>
            )}
          </>
        ))}
      </div>
    </div>
  </section>
</RevealOnScroll>

<style>
  .vn-home-review {
    padding-block: 96px;
    background: var(--color-bg-surface);
  }

  .vn-home-review__header {
    max-width: 640px;
    margin-bottom: 56px;
  }

  .vn-home-review__title {
    margin: 16px 0 14px;
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-home-review__lead {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-home-review__cta {
    margin-top: 28px;
  }

  .vn-home-review__formula {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .vn-home-review__step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-primary);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .vn-home-review__step:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent-cta) 20%, var(--color-border));
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-bg-dark) 6%, transparent);
  }

  .vn-home-review__step--result {
    border-color: color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-cta) 4%, var(--color-bg-primary));
  }

  .vn-home-review__step--result:hover {
    background: color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-primary));
  }

  .vn-home-review__step-num {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-cta);
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .vn-home-review__step-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .vn-home-review__step-text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vn-home-review__connector {
    flex: 0 0 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .vn-home-review__connector::before {
    content: '';
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), color-mix(in srgb, var(--color-accent-cta) 30%, var(--color-border)), var(--color-border));
  }

  /* Мобильная адаптация: вертикальный таймлайн */
  @media (max-width: 1023px) {
    .vn-home-review {
      padding-block: 72px;
    }

    .vn-home-review__header {
      max-width: 720px;
      margin-bottom: 32px;
    }

    .vn-home-review__formula {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-home-review__connector {
      display: none;
    }

    .vn-home-review__step {
      position: relative;
      padding: 24px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-bg-primary);
      transform: none !important;
    }

    .vn-home-review__step--result {
      border-color: color-mix(in srgb, var(--color-accent-cta) 28%, var(--color-border));
      background: color-mix(in srgb, var(--color-accent-cta) 4%, var(--color-bg-primary));
    }

    .vn-home-review__step-num {
      position: static;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-width: 52px;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 1rem;
      line-height: 1;
      background: color-mix(in srgb, var(--color-accent-cta) 10%, var(--color-bg-primary));
      border: 1px solid color-mix(in srgb, var(--color-accent-cta) 16%, var(--color-border));
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .vn-home-review {
      padding-block: 56px;
    }

    .vn-home-review__header {
      margin-bottom: 40px;
    }

    .vn-home-review__title {
      font-size: clamp(1.5rem, 5vw, 1.75rem);
    }

    .vn-home-review__step {
      padding: 20px;
      gap: 12px;
    }

    .vn-home-review__step-num {
      min-width: 48px;
      padding: 7px 10px;
      font-size: 0.9375rem;
    }

    .vn-home-review__step-title {
      font-size: clamp(1.375rem, 5vw, 1.5rem);
      line-height: 1.28;
    }
  }
</style>
