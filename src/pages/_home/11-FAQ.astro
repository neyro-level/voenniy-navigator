---
interface FAQItem {
  q: string;
  a: string;
}
const { items } = Astro.props as { items: FAQItem[] };
---

<!-- ══════════════════════════════════════════════
     БЛОК 11 — FAQ (Air, details/summary, Schema.org FAQPage)
════════════════════════════════════════════════ -->
<section id="section-faq" class="vn-home-faq" aria-labelledby="vn-home-faq-title">
  <div class="vn-container">
    <div class="vn-grid-12 vn-home-faq__grid">

      <!-- ── Left: sticky header, no card ── -->
      <div class="vn-home-faq__left" style="grid-column: 1 / 5">
        <span class="vn-label-mono">ЧАСТЫЕ ВОПРОСЫ</span>
        <h2 class="vn-home-faq__title" id="vn-home-faq-title">
          Ответы на частые вопросы
        </h2>
        <p class="vn-home-faq__lead">
          Вопросы о первичном разборе, военной ипотеке и маршруте покупки новостройки.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Задать вопрос на разборе"
          class="vn-home-faq__more-link"
        >
          Не нашли свой вопрос? Задайте на разборе&nbsp;→
        </a>
      </div>

      <!-- ── Right: editorial accordion with Schema.org FAQPage microdata ── -->
      <div
        class="vn-home-faq__right"
        style="grid-column: 5 / 13"
        itemscope
        itemtype="https://schema.org/FAQPage"
      >
        {items.map((item, i) => (
          <details
            class="vn-home-faq__item"
            open={i === 0}
            itemscope
            itemprop="mainEntity"
            itemtype="https://schema.org/Question"
          >
            <summary class="vn-home-faq__question">
              <span class="vn-home-faq__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="vn-home-faq__question-text" itemprop="name">{item.q}</span>
              <svg
                class="vn-home-faq__icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="vn-home-faq__answer-wrap">
              <div class="vn-home-faq__answer-inner" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p class="vn-home-faq__answer-text" itemprop="text">{item.a}</p>
              </div>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 11: FAQ (Air) ─── */
.vn-home-faq {
  padding: 96px 0;
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-family: var(--font-family-base);
}

.vn-home-faq__grid {
  align-items: start;
}

/* ── Left sticky header ── */
.vn-home-faq__left {
  position: sticky;
  top: 104px;
}

.vn-home-faq__title {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-faq__lead {
  margin: 14px 0 0;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  max-width: 320px;
}

.vn-home-faq__more-link {
  display: inline-flex;
  margin-top: 28px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  line-height: 1.5;
  color: var(--color-accent-cta);
  text-decoration: none;
  transition: opacity 0.15s ease;
}
.vn-home-faq__more-link:hover { opacity: 0.7; }

/* ── Right accordion ── */
.vn-home-faq__right {
  display: flex;
  flex-direction: column;
}

/* Each item = border divider only */
.vn-home-faq__item {
  border-bottom: 1px solid var(--color-border);
}

.vn-home-faq__item:first-child {
  border-top: 1px solid var(--color-border);
}

/* Summary (question) */
.vn-home-faq__question {
  width: 100%;
  min-height: 48px;
  padding: 24px 0;
  display: flex;
  align-items: center;
  gap: 16px;
  list-style: none;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.vn-home-faq__question::-webkit-details-marker {
  display: none;
}

.vn-home-faq__num {
  flex-shrink: 0;
  width: 28px;
  font-size: var(--fs-label);
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.vn-home-faq__question-text {
  flex: 1;
  color: var(--color-text-primary);
  font-size: var(--fs-h3);
  font-weight: 500;
  line-height: 1.42;
  text-wrap: pretty;
}

.vn-home-faq__icon {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  transition: transform 0.35s ease, color 0.15s ease;
}

/* Hover states */
.vn-home-faq__question:hover .vn-home-faq__question-text {
  color: var(--color-accent-primary);
}

/* Open state */
.vn-home-faq__item[open] .vn-home-faq__icon {
  transform: rotate(180deg);
  color: var(--color-accent-cta);
}

/* Answer animation (CSS grid trick) */
.vn-home-faq__answer-wrap {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.4s cubic-bezier(0.17, 0.84, 0.44, 1);
}

.vn-home-faq__item[open]:not(.is-closing) .vn-home-faq__answer-wrap {
  grid-template-rows: 1fr;
}

.vn-home-faq__answer-inner {
  overflow: hidden;
}

.vn-home-faq__answer-text {
  margin: 0;
  padding: 0 0 24px 44px;
  color: var(--color-text-secondary);
  font-size: var(--fs-body);
  line-height: 1.65;
  text-wrap: pretty;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-faq__left  {
    grid-column: 1 / -1 !important;
    position: static;
    margin-bottom: 40px;
  }
  .vn-home-faq__right {
    grid-column: 1 / -1 !important;
  }
  .vn-home-faq__lead {
    max-width: 520px;
  }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-faq { padding: 72px 0; }

  .vn-home-faq__question {
    padding: 18px 0;
    gap: 12px;
  }

  .vn-home-faq__question-text {
    font-size: var(--fs-body);
  }

  .vn-home-faq__answer-text {
    padding: 0 0 20px 40px;
    font-size: var(--fs-body-sm);
  }

  .vn-home-faq__num {
    font-size: var(--fs-caption);
    width: 24px;
  }

  .vn-home-faq__icon {
    width: 14px;
    height: 14px;
  }
}
</style>

<script>
  (function () {
    const container = document.querySelector('.vn-home-faq__right');
    if (!container) return;

    const items = container.querySelectorAll<HTMLDetailsElement>('.vn-home-faq__item');
    const DURATION = 400;

    items.forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.vn-home-faq__question');
      const content = details.querySelector<HTMLElement>('.vn-home-faq__answer-wrap');
      if (!summary || !content) return;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = details.hasAttribute('open');

        // Close siblings (accordion behavior)
        items.forEach((sibling) => {
          if (sibling !== details && sibling.hasAttribute('open')) {
            const siblingContent = sibling.querySelector<HTMLElement>('.vn-home-faq__answer-wrap');
            if (siblingContent) {
              sibling.classList.add('is-closing');
              siblingContent.style.gridTemplateRows = '0fr';
              window.setTimeout(() => {
                sibling.removeAttribute('open');
                sibling.classList.remove('is-closing');
                siblingContent.style.gridTemplateRows = '';
              }, DURATION);
            }
          }
        });

        if (isOpen) {
          // Animate close
          details.classList.add('is-closing');
          content.style.gridTemplateRows = '0fr';
          window.setTimeout(() => {
            details.removeAttribute('open');
            details.classList.remove('is-closing');
            content.style.gridTemplateRows = '';
          }, DURATION);
        } else {
          // Animate open
          details.setAttribute('open', '');
          // Force reflow
          content.getBoundingClientRect();
          content.style.gridTemplateRows = '1fr';
          // Clean up inline style after transition
          window.setTimeout(() => {
            if (details.hasAttribute('open') && !details.classList.contains('is-closing')) {
              content.style.gridTemplateRows = '';
            }
          }, DURATION);
        }
      });
    });
  })();
</script>
