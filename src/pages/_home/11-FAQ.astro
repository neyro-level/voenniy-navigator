---
interface FAQItem {
  q: string;
  a: string;
}
const { items } = Astro.props as { items: FAQItem[] };
---

<!-- ══════════════════════════════════════════════
     БЛОК 11 — FAQ (Air, details/summary, SEO-ready)
════════════════════════════════════════════════ -->
<section id="section-faq" class="vn-home-faq" aria-labelledby="vn-home-faq-title">
  <div class="vn-container">
    <div class="vn-grid-12 vn-home-faq__grid">

      <!-- ── Left: sticky header, no card ── -->
      <div class="vn-home-faq__left" style="grid-column: 1 / 5">
        <span class="vn-label-mono">ЧАСТЫЕ ВОПРОСЫ / 11</span>
        <h2 class="vn-home-faq__title" id="vn-home-faq-title">
          Ответы на частые вопросы
        </h2>
        <p class="vn-home-faq__lead">
          Вопросы о военной ипотеке, работе с НИС и процессе покупки новостройки.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Задать вопрос на разборе"
          class="vn-home-faq__more-link"
        >
          Не нашли свой вопрос? Задайте на разборе&nbsp;→
        </a>
      </div>

      <!-- ── Right: editorial accordion ── -->
      <div class="vn-home-faq__right" style="grid-column: 5 / 13">
        {items.map((item, i) => (
          <details class="vn-home-faq__item" open={i === 0}>
            <summary class="vn-home-faq__question">
              <span class="vn-home-faq__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="vn-home-faq__question-text">{item.q}</span>
              <svg
                class="vn-home-faq__icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="vn-home-faq__answer-wrap">
              <div class="vn-home-faq__answer-inner">
                <p class="vn-home-faq__answer-text">{item.a}</p>
              </div>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 11: FAQ (Air) ─── */
.vn-home-faq {
  padding: 96px 0;
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-family: var(--font-family-base);
}

.vn-home-faq__grid {
  align-items: start;
}

/* ── Left sticky header ── */
.vn-home-faq__left {
  position: sticky;
  top: 104px;
}

.vn-home-faq__title {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.18;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-faq__lead {
  margin: 14px 0 0;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  max-width: 320px;
}

.vn-home-faq__more-link {
  display: inline-flex;
  margin-top: 28px;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.5;
  color: var(--color-accent-cta);
  text-decoration: none;
  transition: opacity 0.15s ease;
}
.vn-home-faq__more-link:hover { opacity: 0.7; }

/* ── Right accordion ── */
.vn-home-faq__right {
  display: flex;
  flex-direction: column;
}

/* Each item = border divider only */
.vn-home-faq__item {
  border-bottom: 1px solid var(--color-border);
}

.vn-home-faq__item:first-child {
  border-top: 1px solid var(--color-border);
}

/* Summary (question) */
.vn-home-faq__question {
  width: 100%;
  min-height: 48px;
  padding: 24px 0;
  display: flex;
  align-items: center;
  gap: 16px;
  list-style: none;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.vn-home-faq__question::-webkit-details-marker {
  display: none;
}

.vn-home-faq__num {
  flex-shrink: 0;
  width: 28px;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.vn-home-faq__question-text {
  flex: 1;
  color: var(--color-text-primary);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.42;
  text-wrap: pretty;
}

.vn-home-faq__icon {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  transition: transform 0.35s ease, color 0.15s ease;
}

/* Hover states */
.vn-home-faq__question:hover .vn-home-faq__question-text {
  color: var(--color-accent-primary);
}

/* Open state */
.vn-home-faq__item[open] .vn-home-faq__icon {
  transform: rotate(180deg);
  color: var(--color-accent-cta);
}

/* Answer animation (CSS grid trick) */
.vn-home-faq__answer-wrap {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.35s ease;
}

.vn-home-faq__item[open]:not(.is-closing) .vn-home-faq__answer-wrap {
  grid-template-rows: 1fr;
}

.vn-home-faq__answer-inner {
  overflow: hidden;
}

.vn-home-faq__answer-text {
  margin: 0;
  padding: 0 0 24px 44px;
  color: var(--color-text-secondary);
  font-size: 15px;
  line-height: 1.65;
  text-wrap: pretty;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-faq__left  {
    grid-column: 1 / -1 !important;
    position: static;
    margin-bottom: 40px;
  }
  .vn-home-faq__right {
    grid-column: 1 / -1 !important;
  }
  .vn-home-faq__lead {
    max-width: 520px;
  }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-faq { padding: 72px 0; }

  .vn-home-faq__question {
    padding: 18px 0;
    gap: 12px;
  }

  .vn-home-faq__question-text {
    font-size: 15px;
  }

  .vn-home-faq__answer-text {
    padding: 0 0 20px 40px;
    font-size: 14px;
  }

  .vn-home-faq__num {
    font-size: 11px;
    width: 24px;
  }

  .vn-home-faq__icon {
    width: 14px;
    height: 14px;
  }
}
</style>

<script>
  (function () {
    const items = document.querySelectorAll('.vn-home-faq__item');

    items.forEach((details) => {
      const summary = details.querySelector('.vn-home-faq__question');
      if (!summary) return;

      summary.addEventListener('click', (e) => {
        // Prevent native toggle so we can animate closing
        e.preventDefault();

        const isOpen = details.hasAttribute('open');

        if (isOpen) {
          // Animate close: force grid to 0fr, wait, then remove open
          details.classList.add('is-closing');
          setTimeout(() => {
            details.removeAttribute('open');
            details.classList.remove('is-closing');
          }, 350);
        } else {
          // Open: browser adds [open], CSS transitions grid to 1fr
          details.setAttribute('open', '');
        }
      });
    });
  })();
</script>
