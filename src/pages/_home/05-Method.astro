<!-- ══════════════════════════════════════════════
     БЛОК 05 — МЕТОД
════════════════════════════════════════════════ -->
<section id="section-method" class="vn-section vn-home-method" aria-labelledby="vn-home-method-title">
  <div class="vn-container">
    <div class="vn-grid-12">

      <!-- ── Left: copy + steps ── -->
      <div class="vn-home-method__copy" style="grid-column: 1 / 6">
        <span class="vn-label-mono">Метод работы</span>
        <h2 class="vn-home-method__h2" id="vn-home-method-title">
          Как я помогаю определить цель покупки и собрать понятный маршрут
        </h2>
        <p class="vn-home-method__lead">
          На первичном разборе сначала определяем цель покупки, условия сделки
          и желаемый сценарий. Это основа подбора: после неё становится понятно,
          какие новостройки действительно стоит смотреть.
        </p>

        <div class="vn-home-method__steps">
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">01</span>
            <strong class="vn-home-method__step-title">Цель</strong>
            <span class="vn-home-method__step-body">Для жизни, вложения или смешанного сценария</span>
          </div>
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">02</span>
            <strong class="vn-home-method__step-title">Условия</strong>
            <span class="vn-home-method__step-body">Бюджет, банк, НИС, сроки и документы</span>
          </div>
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">03</span>
            <strong class="vn-home-method__step-title">Критерии</strong>
            <span class="vn-home-method__step-body">Район, срок сдачи, планировка и формат сделки</span>
          </div>
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">04</span>
            <strong class="vn-home-method__step-title">Отбор</strong>
            <span class="vn-home-method__step-body">Подходящие новостройки под выбранную цель</span>
          </div>
        </div>
      </div>

      <!-- ── Right: before / after comparison ── -->
      <div class="vn-home-method__compare" style="grid-column: 7 / 13">

        <!-- Before: old way -->
        <div class="vn-home-method__path vn-home-method__path--old">
          <span class="vn-home-method__path-label">Как часто начинают</span>
          <div class="vn-home-method__flow">
            <span class="vn-home-method__pill">Новостройка</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Банк</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Документы</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill vn-home-method__pill--q">Подходит ли?</span>
          </div>
          <p class="vn-home-method__path-note">
            Сначала смотрят варианты, а потом сверяют покупку с реальной целью.
          </p>
        </div>

        <!-- Divider -->
        <div class="vn-home-method__divider" aria-hidden="true"></div>

        <!-- After: our way -->
        <div class="vn-home-method__path vn-home-method__path--new">
          <span class="vn-home-method__path-label">Как работаю я</span>
          <div class="vn-home-method__flow">
            <span class="vn-home-method__pill vn-home-method__pill--start">Цель</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Условия</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Критерии</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Отбор</span>
          </div>
          <p class="vn-home-method__path-note">
            Сначала определяем цель, потом подбираем подходящие варианты.
          </p>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 05: Method ─── */

.vn-home-method {
  background: var(--color-bg-surface);
}

/* ── Left column ── */
.vn-home-method__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vn-home-method__h2 {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.2;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-method__lead {
  margin: 18px 0 0;
  max-width: 520px;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--color-text-secondary);
  text-wrap: pretty;
}

/* ── Steps ── */
.vn-home-method__steps {
  margin-top: 30px;
  border-top: 1px solid var(--color-border);
}

.vn-home-method__step {
  display: grid;
  grid-template-columns: 28px 110px 1fr;
  gap: 0 14px;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--color-border);
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 0.4s ease,
    transform 0.4s ease;
}

.vn-home-method--visible .vn-home-method__step:nth-child(1) {
  opacity: 1; transform: translateY(0); transition-delay: 0ms;
}
.vn-home-method--visible .vn-home-method__step:nth-child(2) {
  opacity: 1; transform: translateY(0); transition-delay: 90ms;
}
.vn-home-method--visible .vn-home-method__step:nth-child(3) {
  opacity: 1; transform: translateY(0); transition-delay: 180ms;
}
.vn-home-method--visible .vn-home-method__step:nth-child(4) {
  opacity: 1; transform: translateY(0); transition-delay: 270ms;
}

.vn-home-method__step-num {
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--color-accent-cta);
  opacity: 0.4;
  font-variant-numeric: tabular-nums;
}

.vn-home-method__step-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.vn-home-method__step-body {
  font-size: var(--fs-body-sm);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

/* ── Right column: comparison ── */
.vn-home-method__compare {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding-left: 32px;
  border-left: 1px solid var(--color-border);
}

.vn-home-method__path {
  min-width: 0;
  padding: 32px 0;
}

.vn-home-method__divider {
  height: 1px;
  background: var(--color-border);
  margin: 0;
}

/* Labels */
.vn-home-method__path-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.vn-home-method__path--old .vn-home-method__path-label {
  color: var(--color-text-tertiary);
}
.vn-home-method__path--old .vn-home-method__path-label::before {
  content: '';
  width: 2px;
  height: 14px;
  border-radius: var(--radius-full);
  background: var(--color-border);
}

.vn-home-method__path--new .vn-home-method__path-label {
  color: var(--color-accent-cta);
}
.vn-home-method__path--new .vn-home-method__path-label::before {
  content: '';
  width: 2px;
  height: 14px;
  border-radius: var(--radius-full);
  background: var(--color-accent-cta);
}

/* Flow: pills + arrows */
.vn-home-method__flow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
  gap: 8px;
  margin-bottom: 14px;
}

.vn-home-method__sep {
  font-size: var(--fs-body-sm);
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* Pills */
.vn-home-method__pill {
  max-width: 100%;
  padding: 6px 13px;
  border-radius: 6px;
  font-size: var(--fs-body-sm);
  font-weight: 500;
  line-height: 1.2;
}

.vn-home-method__path--old .vn-home-method__pill {
  background: var(--color-accent-soft);
  color: var(--color-text-tertiary);
}

.vn-home-method__pill--q {
  background: var(--color-accent-soft) !important;
  color: var(--color-accent-primary) !important;
}

.vn-home-method__path--new .vn-home-method__pill {
  background: var(--color-accent-cta-soft);
  color: var(--color-accent-primary);
}

.vn-home-method__pill--start {
  background: var(--color-accent-cta) !important;
  color: var(--color-bg-surface) !important;
  font-weight: 600;
}

/* Note text */
.vn-home-method__path-note {
  margin: 0;
  font-size: var(--fs-label);
  line-height: 1.55;
}
.vn-home-method__path--old .vn-home-method__path-note {
  color: var(--color-text-tertiary);
}
.vn-home-method__path--new .vn-home-method__path-note {
  color: var(--color-text-secondary);
}

/* ── Animate compare on scroll ── */
.vn-home-method__compare {
  opacity: 0;
  transform: translateX(12px);
  transition: opacity 0.5s ease 0.15s, transform 0.5s ease 0.15s;
}
.vn-home-method--visible .vn-home-method__compare {
  opacity: 1;
  transform: none;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-method__copy    { grid-column: 1 / -1 !important; }
  .vn-home-method__compare {
    grid-column: 1 / -1 !important;
    padding-left: 0;
    border-left: none;
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
  }
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .vn-home-method__flow {
    gap: 7px 6px;
  }

  .vn-home-method__step {
    grid-template-columns: 28px 1fr;
    grid-template-rows: auto auto;
    gap: 4px 12px;
  }
  .vn-home-method__step-num { grid-row: 1 / 3; align-self: start; }
  .vn-home-method__step-title { grid-column: 2; grid-row: 1; }
  .vn-home-method__step-body { grid-column: 2; grid-row: 2; }
  .vn-home-method__pill {
    padding: 5px 10px;
    font-size: var(--fs-label);
  }

  .vn-home-method__sep {
    font-size: var(--fs-caption);
  }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .vn-home-method__step    { opacity: 1; transform: none; transition: none; }
  .vn-home-method__compare { opacity: 1; transform: none; transition: none; }
}
</style>

<script>
  const method = document.getElementById('section-method');
  if (method) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          method.classList.add('vn-home-method--visible');
          observer.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(method);
  }
</script>
