<!-- ══════════════════════════════════════════════
     БЛОК 05 — МЕТОД
════════════════════════════════════════════════ -->
<section id="section-method" class="vn-section vn-home-method">
  <div class="vn-container">
    <div class="vn-grid-12">

      <!-- ── Left: copy + steps ── -->
      <div class="vn-home-method__copy" style="grid-column: 1 / 6">
        <span class="vn-label-mono">МЕТОД / 05</span>
        <h2 class="vn-home-method__h2">
          Обычный подбор начинается с объекта.
          <span class="vn-home-method__h2-accent">Здесь&nbsp;— с цели покупки.</span>
        </h2>

        <div class="vn-home-method__steps">
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">01</span>
            <strong class="vn-home-method__step-title">Цель</strong>
            <span class="vn-home-method__step-body">Жить, сдавать или переехать позже</span>
          </div>
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">02</span>
            <strong class="vn-home-method__step-title">Сценарий</strong>
            <span class="vn-home-method__step-body">Бюджет, банк, сроки, НИС</span>
          </div>
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">03</span>
            <strong class="vn-home-method__step-title">Отбор</strong>
            <span class="vn-home-method__step-body">Неподходящие ЖК — до просмотра</span>
          </div>
          <div class="vn-home-method__step">
            <span class="vn-home-method__step-num">04</span>
            <strong class="vn-home-method__step-title">Сделка</strong>
            <span class="vn-home-method__step-body">Банк, документы, регистрация</span>
          </div>
        </div>
      </div>

      <!-- ── Right: before / after comparison ── -->
      <div class="vn-home-method__compare" style="grid-column: 7 / 13">

        <!-- Before: old way -->
        <div class="vn-home-method__path vn-home-method__path--old">
          <span class="vn-home-method__path-label">Обычный подбор</span>
          <div class="vn-home-method__flow">
            <span class="vn-home-method__pill">Объект</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Банк</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill vn-home-method__pill--q">Задача?</span>
          </div>
          <p class="vn-home-method__path-note">
            Начинают с объекта — и потом выясняют, подходит ли он
          </p>
        </div>

        <!-- Divider -->
        <div class="vn-home-method__divider" aria-hidden="true"></div>

        <!-- After: our way -->
        <div class="vn-home-method__path vn-home-method__path--new">
          <span class="vn-home-method__path-label">Здесь</span>
          <div class="vn-home-method__flow">
            <span class="vn-home-method__pill vn-home-method__pill--start">Цель</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Сценарий</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Объект</span>
            <span class="vn-home-method__sep" aria-hidden="true">→</span>
            <span class="vn-home-method__pill">Банк</span>
          </div>
          <p class="vn-home-method__path-note">
            Сначала понимают задачу — объект находят под неё
          </p>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
/* ─── Block 05: Method ─── */

.vn-home-method {
  background: var(--color-bg-surface);
}

/* ── Left column ── */
.vn-home-method__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vn-home-method__h2 {
  margin: 16px 0 0;
  font-size: var(--fs-h2);
  font-weight: 650;
  line-height: 1.2;
  color: var(--color-text-primary);
  text-wrap: balance;
}

.vn-home-method__h2-accent {
  color: var(--color-accent-cta);
}

/* ── Steps ── */
.vn-home-method__steps {
  margin-top: 28px;
  border-top: 1px solid var(--color-border);
}

.vn-home-method__step {
  display: grid;
  grid-template-columns: 28px 110px 1fr;
  gap: 0 14px;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--color-border);
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 0.4s ease,
    transform 0.4s ease;
}

.vn-home-method--visible .vn-home-method__step:nth-child(1) {
  opacity: 1; transform: translateY(0); transition-delay: 0ms;
}
.vn-home-method--visible .vn-home-method__step:nth-child(2) {
  opacity: 1; transform: translateY(0); transition-delay: 90ms;
}
.vn-home-method--visible .vn-home-method__step:nth-child(3) {
  opacity: 1; transform: translateY(0); transition-delay: 180ms;
}
.vn-home-method--visible .vn-home-method__step:nth-child(4) {
  opacity: 1; transform: translateY(0); transition-delay: 270ms;
}

.vn-home-method__step-num {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--color-accent-cta);
  opacity: 0.4;
  font-variant-numeric: tabular-nums;
}

.vn-home-method__step-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-primary);
}

.vn-home-method__step-body {
  font-size: var(--fs-body-sm);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

/* ── Right column: comparison ── */
.vn-home-method__compare {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 32px;
  border-left: 1px solid var(--color-border);
}

.vn-home-method__path {
  padding: 32px 0;
}

.vn-home-method__divider {
  height: 1px;
  background: var(--color-border);
  margin: 0;
}

/* Labels */
.vn-home-method__path-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.vn-home-method__path--old .vn-home-method__path-label {
  color: var(--color-text-tertiary);
}
.vn-home-method__path--old .vn-home-method__path-label::before {
  content: '✕';
  font-size: 9px;
  color: rgba(220, 38, 38, 0.55);
}

.vn-home-method__path--new .vn-home-method__path-label {
  color: var(--color-accent-cta);
}
.vn-home-method__path--new .vn-home-method__path-label::before {
  content: '✓';
  font-size: 11px;
  color: var(--color-accent-cta);
}

/* Flow: pills + arrows */
.vn-home-method__flow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.vn-home-method__sep {
  font-size: 13px;
  color: var(--color-text-tertiary);
  line-height: 1;
}

/* Pills */
.vn-home-method__pill {
  padding: 6px 13px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.2;
}

.vn-home-method__path--old .vn-home-method__pill {
  background: rgba(15, 37, 71, 0.05);
  color: var(--color-text-tertiary);
}

.vn-home-method__pill--q {
  background: rgba(220, 38, 38, 0.07) !important;
  color: rgba(220, 38, 38, 0.65) !important;
}

.vn-home-method__path--new .vn-home-method__pill {
  background: rgba(37, 99, 235, 0.08);
  color: var(--color-accent-primary);
}

.vn-home-method__pill--start {
  background: var(--color-accent-cta) !important;
  color: #fff !important;
  font-weight: 600;
}

/* Note text */
.vn-home-method__path-note {
  margin: 0;
  font-size: 12px;
  line-height: 1.55;
}
.vn-home-method__path--old .vn-home-method__path-note {
  color: var(--color-text-tertiary);
}
.vn-home-method__path--new .vn-home-method__path-note {
  color: var(--color-text-secondary);
}

/* ── Animate compare on scroll ── */
.vn-home-method__compare {
  opacity: 0;
  transform: translateX(12px);
  transition: opacity 0.5s ease 0.15s, transform 0.5s ease 0.15s;
}
.vn-home-method--visible .vn-home-method__compare {
  opacity: 1;
  transform: none;
}

/* ── Tablet ── */
@media (max-width: 1023px) {
  .vn-home-method__copy    { grid-column: 1 / -1 !important; }
  .vn-home-method__compare {
    grid-column: 1 / -1 !important;
    padding-left: 0;
    border-left: none;
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
  }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .vn-home-method__step    { opacity: 1; transform: none; transition: none; }
  .vn-home-method__compare { opacity: 1; transform: none; transition: none; }
}
</style>

<script>
  const method = document.getElementById('section-method');
  if (method) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          method.classList.add('vn-home-method--visible');
          observer.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(method);
  }
</script>
