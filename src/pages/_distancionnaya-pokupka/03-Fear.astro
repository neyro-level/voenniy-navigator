<!-- ══════════════════════════════════════════════
     БЛОК 03 — ПОЧЕМУ ТРЕВОЖИТ
════════════════════════════════════════════════ -->
<section id="section-dist-fear" class="vn-section vn-section--dark">
  <div class="vn-dist-deco-grid" aria-hidden="true"></div>

