---
import { CONTACTS } from '../../lib/constants';
---

<section id="section-dist-hero" class="vn-dist-hero">
  <div class="vn-dist-hero__grid-bg" aria-hidden="true"></div>
  <div class="vn-dist-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12">
      <!-- Левая колонка: 7 из 12 -->
      <div class="vn-dist-hero__left">
        <div class="vn-dist-hero__eyebrow">Дистанционная покупка / 01</div>

        <h1 class="vn-dist-hero__h1">
          <span class="vn-dist-hero__h1-accent">Дистанционная покупка</span> новостройки
          в&nbsp;Краснодаре по&nbsp;военной ипотеке
        </h1>

        <p class="vn-dist-hero__sub">
          Если вы не можете постоянно приезжать в Краснодар, важно заранее
          понять, как будет контролироваться выбор района, ЖК, документы,
          банк и каждый этап сделки.
        </p>

        <div class="vn-dist-hero__cta-row">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Начать разбор дистанционной покупки"
            class="vn-btn-primary vn-dist-hero__btn"
          >
            Разобрать дистанционную покупку
          </a>
          <a
            href={CONTACTS.vk}
            target="_blank"
            rel="noopener noreferrer"
            class="vn-btn-ghost vn-dist-hero__btn-ghost vn-hide-mobile"
            aria-label="Посмотреть разборы в VK"
          >
            Разборы в VK
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <div class="vn-dist-hero__trust" role="list">
          <div class="vn-dist-hero__trust-item" role="listitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Михаил находится в Краснодаре</span>
          </div>
          <div class="vn-dist-hero__trust-divider" aria-hidden="true"></div>
          <div class="vn-dist-hero__trust-item" role="listitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            <span>Видео и локальный взгляд</span>
          </div>
          <div class="vn-dist-hero__trust-divider" aria-hidden="true"></div>
          <div class="vn-dist-hero__trust-item" role="listitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Контроль маршрута сделки</span>
          </div>
          <div class="vn-dist-hero__trust-divider vn-hide-mobile" aria-hidden="true"></div>
          <div class="vn-dist-hero__trust-item vn-hide-mobile" role="listitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span>Разбор перед подбором</span>
          </div>
        </div>

        <!-- Mobile compact strip -->
        <div class="vn-dist-hero__compact" aria-hidden="true">
          <span>6 зон контроля</span>
          <span class="vn-dist-hero__compact-dot"></span>
          <span>Видео-показы</span>
          <span class="vn-dist-hero__compact-dot"></span>
          <span>Дистанционный маршрут</span>
        </div>
      </div>

      <!-- Правая колонка: 5 из 12 -->
      <div class="vn-dist-hero__right">
        <div class="vn-dist-hero__visual">
          <div class="vn-dist-hero__visual-frame">
            <span class="vn-dist-hero__bracket vn-dist-hero__bracket--tl" aria-hidden="true"></span>
            <span class="vn-dist-hero__bracket vn-dist-hero__bracket--br" aria-hidden="true"></span>

            <!-- Distance Map SVG -->
            <svg class="vn-dist-hero__svg" viewBox="0 0 400 480" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- Dashed path -->
              <path d="M60 80 Q200 120 180 240 T340 400" stroke="var(--color-accent-cta)" stroke-width="2" stroke-dasharray="6 6" opacity="0.35"/>

              <!-- Node 1: Район -->
              <circle cx="60" cy="80" r="14" fill="var(--color-bg-surface)" stroke="var(--color-accent-primary)" stroke-width="1" opacity="0.5"/>
              <text x="60" y="55" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10" font-family="Inter, sans-serif">Район</text>

              <!-- Node 2: ЖК -->
              <circle cx="140" cy="125" r="14" fill="var(--color-bg-surface)" stroke="var(--color-accent-primary)" stroke-width="1" opacity="0.5"/>
              <text x="140" y="150" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10" font-family="Inter, sans-serif">ЖК</text>

              <!-- Node 3: Квартира -->
              <circle cx="180" cy="200" r="14" fill="var(--color-bg-surface)" stroke="var(--color-accent-primary)" stroke-width="1" opacity="0.5"/>
              <text x="180" y="225" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10" font-family="Inter, sans-serif">Квартира</text>

              <!-- Node 4: Документы -->
              <circle cx="200" cy="280" r="14" fill="var(--color-bg-surface)" stroke="var(--color-accent-primary)" stroke-width="1" opacity="0.5"/>
              <text x="200" y="305" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10" font-family="Inter, sans-serif">Документы</text>

              <!-- Node 5: Банк -->
              <circle cx="260" cy="340" r="14" fill="var(--color-bg-surface)" stroke="var(--color-accent-primary)" stroke-width="1" opacity="0.5"/>
              <text x="260" y="365" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10" font-family="Inter, sans-serif">Банк</text>

              <!-- Node 6: Сроки -->
              <circle cx="340" cy="400" r="14" fill="var(--color-bg-surface)" stroke="var(--color-accent-primary)" stroke-width="1" opacity="0.5"/>
              <text x="340" y="425" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10" font-family="Inter, sans-serif">Сроки</text>

              <!-- Start badge -->
              <rect x="30" y="40" width="50" height="22" rx="11" fill="var(--color-accent-soft)"/>
              <text x="55" y="55" text-anchor="middle" fill="var(--color-accent-primary)" font-size="9" font-weight="600" font-family="Inter, sans-serif">ВЫ</text>

              <!-- End badge -->
              <rect x="295" y="375" width="90" height="22" rx="11" fill="var(--color-accent-primary)"/>
              <text x="340" y="390" text-anchor="middle" fill="var(--color-text-ondark)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Краснодар</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-dist-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg-primary);
    padding-top: 160px;
    padding-bottom: 96px;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .vn-dist-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-deco-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    z-index: 0;
  }

  .vn-dist-hero__radial {
    position: absolute;
    top: -200px;
    left: -200px;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-bg-surface) 60%, transparent) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .vn-dist-hero__left {
    grid-column: 1 / 8;
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .vn-dist-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 28px;
  }
  .vn-dist-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-dist-hero__h1 {
    margin: 0 0 24px;
    font-size: var(--fs-display);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-dist-hero__h1-accent { color: var(--color-accent-primary); }

  .vn-dist-hero__sub {
    margin: 0 0 36px;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 540px;
    text-wrap: balance;
  }

  .vn-dist-hero__cta-row {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .vn-dist-hero__btn { height: 54px; padding: 0 32px; font-size: 16px; }
  .vn-dist-hero__btn-ghost { height: 54px; }

  .vn-dist-hero__trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }

  .vn-dist-hero__trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .vn-dist-hero__trust-item:first-child { padding-left: 0; }
  .vn-dist-hero__trust-item svg { color: var(--color-accent-cta); flex-shrink: 0; }

  .vn-dist-hero__trust-divider {
    width: 1px;
    height: 16px;
    background-color: var(--color-border);
  }

  .vn-dist-hero__compact {
    display: none;
    margin-top: 24px;
    gap: 12px;
    align-items: center;
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    flex-wrap: wrap;
  }
  .vn-dist-hero__compact-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-accent-cta);
  }

  .vn-dist-hero__right {
    grid-column: 8 / 13;
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .vn-dist-hero__visual-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-surface) 100%);
    box-shadow:
      12px 12px 0 color-mix(in srgb, var(--color-accent-primary) 14%, transparent),
      0 20px 50px color-mix(in srgb, var(--color-text-primary) 12%, transparent);
  }

  .vn-dist-hero__bracket {
    position: absolute;
    width: 24px;
    height: 24px;
    pointer-events: none;
    z-index: 2;
  }
  .vn-dist-hero__bracket::before,
  .vn-dist-hero__bracket::after {
    content: '';
    position: absolute;
    background-color: var(--color-accent-cta);
  }
  .vn-dist-hero__bracket::before { width: 100%; height: 2px; top: 0; left: 0; }
  .vn-dist-hero__bracket::after  { width: 2px; height: 100%; top: 0; left: 0; }

  .vn-dist-hero__bracket--tl { top: 12px; left: 12px; }
  .vn-dist-hero__bracket--br {
    bottom: 12px;
    right: 12px;
    transform: rotate(180deg);
  }

  .vn-dist-hero__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 1023px) {
    .vn-dist-hero__left { grid-column: 1 / -1; }
    .vn-dist-hero__right { grid-column: 1 / -1; margin-top: 32px; max-width: 360px; }
    .vn-dist-hero__btn-ghost { display: none; }
  }

  @media (max-width: 640px) {
    .vn-dist-hero { padding-top: 100px; padding-bottom: 64px; }
    .vn-dist-hero__grid-bg { background-size: 48px 48px; }
    .vn-dist-hero__right { order: -1; max-width: 100%; }
    .vn-dist-hero__visual-frame { aspect-ratio: 16 / 10; border-radius: var(--radius-lg); }
    .vn-dist-hero__btn { width: 100%; justify-content: center; }
    .vn-dist-hero__trust { display: none; }
    .vn-dist-hero__compact { display: flex; }
  }
</style>
