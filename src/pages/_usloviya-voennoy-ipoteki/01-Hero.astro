---
// Компонент: 01-Hero.astro (Условия военной ипотеки)
// Задача: дать ясный, премиальный первый экран с фокусом на реальный бюджет, без визуального шума.
---

<section id="section-usl-hero" class="vn-usl-hero">
  <div class="vn-usl-hero__grid-bg" aria-hidden="true"></div>
  <div class="vn-usl-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-grid-12 vn-usl-hero__inner">
      
      <!-- Левая часть: Текст и CTA -->
      <div class="vn-usl-hero__content vn-col-7" data-reveal="fade-up">
        <p class="vn-label-mono">Условия / банки / суммы / 2026</p>

        <h1 class="vn-usl-hero__title">
          Условия военной ипотеки в 2026 году: 
          <span class="vn-usl-hero__title-accent">какой бюджет одобрит банк именно вам</span>
        </h1>

        <p class="vn-usl-hero__lead">
          Без воды и общих фраз. Разбираем реальные суммы, требования банков 
          и способы законно увеличить лимит под вашу конкретную ситуацию.
        </p>

        <div class="vn-usl-hero__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Получить разбор моей ситуации"
            class="vn-btn-primary vn-usl-hero__primary"
          >
            Получить разбор моей ситуации
          </a>
        </div>
      </div>

      <!-- Правая часть: Карточка потенциала -->
      <aside class="vn-usl-hero__visual vn-col-5" data-reveal="fade-in">
        <div class="vn-usl-potential-card">
          <div class="vn-usl-potential-card__row">
            <span class="vn-usl-potential-card__label">Базовый лимит по НИС</span>
            <span class="vn-usl-potential-card__value">~2,3 млн ₽</span>
          </div>
          
          <div class="vn-usl-potential-card__divider"></div>
          
          <div class="vn-usl-potential-card__row vn-usl-potential-card__row--accent">
            <span class="vn-usl-potential-card__label">Реальный бюджет</span>
            <span class="vn-usl-potential-card__value">до 6,0 млн ₽</span>
            <span class="vn-usl-potential-card__sublabel">при комбинировании программ</span>
          </div>

          <div class="vn-usl-potential-card__footer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Проверено в ПСБ, Сбер, ВТБ, ДОМ.РФ</span>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
  .vn-usl-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-primary);
    padding-top: 132px;
    padding-bottom: 96px;
  }

  .vn-usl-hero__grid-bg,
  .vn-usl-hero__radial {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vn-usl-hero__grid-bg {
    background-image:
      linear-gradient(to right, var(--color-deco-grid-light) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-deco-grid-light) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.6;
  }

  .vn-usl-hero__radial {
    inset: auto auto -200px 60%;
    width: 800px;
    height: 500px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-primary) 6%, transparent) 0%,
      transparent 70%
    );
    transform: translateX(-50%);
  }

  .vn-usl-hero__inner {
    align-items: center;
    gap: 48px;
  }

  .vn-usl-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vn-usl-hero__title {
    margin: 16px 0 20px;
    font-size: clamp(36px, 4.5vw, 56px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-usl-hero__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-usl-hero__lead {
    max-width: 580px;
    margin: 0 0 32px;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-usl-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* Карточка потенциала */
  .vn-usl-potential-card {
    width: 100%;
    max-width: 420px;
    padding: 32px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: 0 16px 40px color-mix(in srgb, var(--color-bg-dark) 4%, transparent);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .vn-usl-potential-card__row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vn-usl-potential-card__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .vn-usl-potential-card__value {
    font-size: 40px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .vn-usl-potential-card__row--accent .vn-usl-potential-card__value {
    color: var(--color-accent-cta);
  }

  .vn-usl-potential-card__sublabel {
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .vn-usl-potential-card__divider {
    height: 1px;
    background: var(--color-border);
  }

  .vn-usl-potential-card__footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-body-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .vn-usl-potential-card__footer svg {
    color: var(--color-accent-primary);
    flex-shrink: 0;
  }

  /* Адаптивность */
  @media (max-width: 1023px) {
    .vn-usl-hero {
      padding-top: 100px;
      padding-bottom: 64px;
    }

    .vn-usl-hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    .vn-usl-hero__content,
    .vn-usl-hero__visual {
      grid-column: 1 / -1;
    }

    .vn-usl-potential-card {
      max-width: 100%;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .vn-usl-hero {
      padding-top: 88px;
      padding-bottom: 48px;
    }

    .vn-usl-hero__grid-bg {
      background-size: 48px 48px;
    }

    .vn-usl-hero__radial {
      left: 50%;
      bottom: -240px;
      width: 600px;
      height: 400px;
    }

    .vn-usl-hero__title {
      margin: 12px 0 16px;
      font-size: 32px;
      line-height: 1.12;
    }

    .vn-usl-hero__lead {
      margin-bottom: 24px;
      font-size: var(--fs-body);
      line-height: 1.55;
    }

    .vn-usl-hero__actions .vn-btn-primary {
      width: 100%;
      justify-content: center;
    }

    .vn-usl-potential-card {
      padding: 24px;
      gap: 20px;
    }

    .vn-usl-potential-card__value {
      font-size: 32px;
    }
  }
</style>
