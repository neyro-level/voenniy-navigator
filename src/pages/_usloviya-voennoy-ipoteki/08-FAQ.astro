---
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { faqItems } from './pageData';
---

<section id="section-usl-faq" class="vn-faq" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-faq__inner">
      <div class="vn-faq__header">
        <h2 class="vn-faq__title">Частые вопросы о военной ипотеке</h2>
        <p class="vn-faq__lead">
          Короткие ответы на ключевые вопросы, которые возникают перед началом
          сделки. Если вашей ситуации здесь нет — задайте её на первичном
          разборе.
        </p>
      </div>

      <div class="vn-faq__list">
        {faqItems.map((item) => (
          <details class="vn-faq__item">
            <summary class="vn-faq__question">
              <span>{item.q}</span>
              <svg
                class="vn-faq__icon"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="6 9 12 15 18 9"></polyline></svg
              >
            </summary>
            <div class="vn-faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>

      <FinalCTA
        eyebrow="ОСТАЛИСЬ ВОПРОСЫ?"
        title="Разберите вашу ситуацию"
        accentText="на первичном разборе"
        subtitle="Общие ответы не заменяют анализа вашей конкретной ситуации. Уточним ваши исходные данные и подскажем, с чего именно вам стоит начать."
        ctaText="Получить разбор ситуации"
        ctaModalTitle="Получить разбор ситуации"
        showStats={false}
        showUsefulLinks={true}
        usefulLinks={[
          { label: 'Рассчитать сумму в калькуляторе', href: '/kalkulyator-voennoy-ipoteki/' }
        ]}
      />
    </div>
  </div>
</section>

<style>
  .vn-faq {
    padding: 96px 0;
    background: var(--color-bg-surface);
  }

  .vn-faq__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .vn-faq__header {
    text-align: left;
    margin-bottom: 48px;
  }

  .vn-faq__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .vn-faq__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }

  .vn-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 56px;
  }

  .vn-faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .vn-faq__item[open] {
    border-color: var(--color-accent-cta);
  }

  .vn-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    transition: background 0.2s ease;
  }

  .vn-faq__question::-webkit-details-marker {
    display: none;
  }

  .vn-faq__question:hover {
    background: color-mix(in srgb, var(--color-bg-surface) 50%, transparent);
  }

  .vn-faq__icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: var(--color-text-tertiary);
  }

  .vn-faq__item[open] .vn-faq__icon {
    transform: rotate(180deg);
    color: var(--color-accent-cta);
  }

  .vn-faq__answer {
    padding: 0 24px 24px;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-faq__answer p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .vn-faq {
      padding: 64px 0;
    }

    .vn-faq__header {
      margin-bottom: 32px;
    }

    .vn-faq__list {
      gap: 8px;
      margin-bottom: 40px;
    }

    .vn-faq__question {
      padding: 14px 16px;
      font-size: 14px;
      gap: 12px;
    }

    .vn-faq__answer {
      padding: 0 16px 16px;
      font-size: 13px;
      line-height: 1.4;
    }

    .vn-faq__cta-section {
      padding: 24px 20px;
      align-items: stretch;
      text-align: left;
    }

    .vn-faq__cta-actions {
      flex-direction: column;
    }

    .vn-faq__cta-primary,
    .vn-faq__cta-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
