---

---

<section id="section-usl-process" class="vn-process" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-process__inner">
      <div class="vn-process__header">
        <h2 class="vn-process__title">
          Как оформить военную ипотеку: понятный маршрут без хаоса
        </h2>
        <p class="vn-process__lead">
          Сделка по военной ипотеке кажется сложной только на первый взгляд.
          Когда есть четкий план, каждый шаг предсказуем. Мы берем на себя
          координацию, чтобы вы просто приходили на подписание.
        </p>
      </div>

      <div class="vn-process__timeline">
        <!-- Шаг 1 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">01</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Проверка НИС</h3>
            <p class="vn-process__step-text">
              Уточняем ваш текущий статус в реестре и право на использование
              накопительного взноса для покупки.
            </p>
          </div>
        </div>

        <!-- Шаг 2 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">02</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Первичный расчет</h3>
            <p class="vn-process__step-text">
              Определяем реальную сумму одобрения и выбираем оптимальный
              сценарий покупки под ваши цели.
            </p>
          </div>
        </div>

        <!-- Шаг 3 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">03</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Выбор банка</h3>
            <p class="vn-process__step-text">
              Сравниваем условия ПСБ, Сбера, ВТБ и Банка РОССИЯ, подбирая
              программу именно под ваши параметры.
            </p>
          </div>
        </div>

        <!-- Шаг 4 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">04</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Подбор объекта</h3>
            <p class="vn-process__step-text">
              Ищем новостройки или вторичное жилье, которые гарантированно
              пройдут одобрение выбранного банка.
            </p>
          </div>
        </div>

        <!-- Шаг 5 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">05</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Подача заявки</h3>
            <p class="vn-process__step-text">
              Готовим полный пакет документов, исправляем возможные ошибки и
              сопровождаем процесс одобрения.
            </p>
          </div>
        </div>

        <!-- Шаг 6 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">06</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Проверка объекта</h3>
            <p class="vn-process__step-text">
              Юридическая чистота: проверяем документы застройщика или продавца
              перед выходом на сделку.
            </p>
          </div>
        </div>

        <!-- Шаг 7 -->
        <div class="vn-process__step">
          <div class="vn-process__step-marker">07</div>
          <div class="vn-process__step-content">
            <h3 class="vn-process__step-title">Выход на сделку</h3>
            <p class="vn-process__step-text">
              Согласование даты, подписание кредитного договора и регистрация
              права собственности в Росреестре.
            </p>
          </div>
        </div>
      </div>

      <div class="vn-process__cta-section">
        <div class="vn-process__cta-content">
          <h3 class="vn-process__cta-title">
            Не пытайтесь пройти этот маршрут в одиночку
          </h3>
          <p class="vn-process__cta-text">
            Ошибка на любом из этапов может стоить вам времени, нервов и
            одобренной суммы. Давайте начнем с первого шага: мы проверим ваши
            исходные данные и составим персональный план действий.
          </p>
        </div>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Начать с первичного разбора"
          class="vn-btn-primary vn-process__cta-btn"
        >
          Начать с первичного разбора
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-process {
    padding: 96px 0;
    background: var(--color-bg-primary);
  }

  .vn-process__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .vn-process__header {
    text-align: left;
    margin-bottom: 56px;
  }

  .vn-process__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .vn-process__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }

  .vn-process__timeline {
    position: relative;
    padding-left: 32px;
    margin-bottom: 56px;
  }

  /* Вертикальная соединительная линия */
  .vn-process__timeline::before {
    content: "";
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 15px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-border),
      var(--color-accent-cta) 50%,
      var(--color-border)
    );
    border-radius: 1px;
  }

  .vn-process__step {
    position: relative;
    display: flex;
    gap: 24px;
    padding: 24px 0;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-process__step:hover {
      transform: translateX(4px);
    }
  }

  .vn-process__step-marker {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-bg-primary);
    border: 2px solid var(--color-border);
    font-size: var(--fs-body-sm);
    font-weight: 700;
    color: var(--color-text-tertiary);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-process__step:hover .vn-process__step-marker {
      border-color: var(--color-accent-cta);
      color: var(--color-accent-cta);
      background: color-mix(
        in srgb,
        var(--color-accent-cta-soft) 20%,
        var(--color-bg-primary)
      );
    }
  }

  .vn-process__step-content {
    flex: 1;
    padding-top: 4px;
  }

  .vn-process__step-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .vn-process__step-text {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-process__cta-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-dark);
    color: var(--color-text-ondark);
    position: relative;
    overflow: hidden;
  }

  .vn-process__cta-section::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 8%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .vn-process__cta-content {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }

  .vn-process__cta-title {
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-text-ondark);
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .vn-process__cta-text {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-ondark-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-process__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 28px;
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
    position: relative;
    z-index: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .vn-process__cta-btn:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .vn-process__cta-btn svg {
    transition: transform 0.2s ease;
  }

  .vn-process__cta-btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .vn-process {
      padding: 64px 0;
    }

    .vn-process__header {
      margin-bottom: 32px;
    }

    .vn-process__timeline {
      padding-left: 20px;
      margin-bottom: 32px;
    }

    .vn-process__timeline::before {
      left: 9px;
    }

    .vn-process__step {
      gap: 12px;
      padding: 12px 0;
    }

    .vn-process__step-marker {
      width: 20px;
      height: 20px;
      font-size: 11px;
    }

    .vn-process__step-title {
      font-size: 15px;
      margin-bottom: 4px;
    }

    .vn-process__step-text {
      font-size: 13px;
      line-height: 1.4;
    }

    .vn-process__cta-section {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
      padding: 24px 20px;
      gap: 20px;
    }

    .vn-process__cta-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
