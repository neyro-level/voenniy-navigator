---

---

<section
  id="section-usl-conditions"
  class="vn-conditions"
  data-reveal="fade-up"
>
  <div class="vn-container">
    <div class="vn-conditions__inner">
      <div class="vn-conditions__header">
        <h2 class="vn-conditions__title">
          Актуальные условия программы НИС на 2026 год
        </h2>
        <p class="vn-conditions__lead">
          Программа задаёт базовые рамки, но итоговое решение всегда принимает
          банк. Ниже — ключевые параметры, от которых строится любой расчет.
        </p>
      </div>

      <div class="vn-conditions__grid">
        <div class="vn-conditions__card">
          <div class="vn-conditions__card-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
              ></path><circle cx="9" cy="7" r="4"></circle><path
                d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
                d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
          </div>
          <h3 class="vn-conditions__card-title">Кто может получить</h3>
          <p class="vn-conditions__card-text">
            Участники НИС, состоящие в реестре не менее 3 лет.
          </p>
        </div>

        <div class="vn-conditions__card">
          <div class="vn-conditions__card-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M6 11h8a4 4 0 0 0 0-8H9v18"></path><path d="M6 15h8"
              ></path></svg
            >
          </div>
          <h3 class="vn-conditions__card-title">Ежегодный взнос государства</h3>
          <p class="vn-conditions__card-text">
            411 184,90 ₽ (фиксированная сумма индексации на 2026 год).
          </p>
        </div>

        <div class="vn-conditions__card">
          <div class="vn-conditions__card-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="5" width="20" height="14" rx="2"></rect><line
                x1="2"
                y1="10"
                x2="22"
                y2="10"></line></svg
            >
          </div>
          <h3 class="vn-conditions__card-title">
            Расчетный ежемесячный платеж
          </h3>
          <p class="vn-conditions__card-text">
            ≈ 34 265 ₽ / мес (покрывается государством в рамках лимита).
          </p>
        </div>

        <div class="vn-conditions__card">
          <div class="vn-conditions__card-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
          </div>
          <h3 class="vn-conditions__card-title">Стандартный срок кредита</h3>
          <p class="vn-conditions__card-text">
            До 20–25 лет (зависит от возраста заемщика на момент полного
            погашения).
          </p>
        </div>

        <div class="vn-conditions__card">
          <div class="vn-conditions__card-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
              ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
            >
          </div>
          <h3 class="vn-conditions__card-title">Допустимые объекты</h3>
          <p class="vn-conditions__card-text">
            Новостройки, вторичное жилье, частные дома (требования банка могут
            отличаться).
          </p>
        </div>

        <div class="vn-conditions__card vn-conditions__card--accent">
          <div class="vn-conditions__card-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path><polyline points="14 2 14 8 20 8"></polyline><line
                x1="16"
                y1="13"
                x2="8"
                y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
              ></line><polyline points="10 9 9 9 8 9"></polyline></svg
            >
          </div>
          <h3 class="vn-conditions__card-title">
            Что влияет на итоговую сумму
          </h3>
          <p class="vn-conditions__card-text">
            Возраст, срок кредита, тип объекта, программа конкретного банка и
            размер ваших накоплений.
          </p>
        </div>
      </div>

      <div class="vn-conditions__footer">
        <div class="vn-conditions__disclaimer">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><line
              x1="12"
              y1="8"
              x2="12"
              y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"
            ></line></svg
          >
          <p>
            <strong>Важно:</strong> итоговые параметры фиксируются банком. На одобренную
            сумму напрямую влияют возраст заемщика, желаемый срок, тип объекта и наличие
            собственных средств.
          </p>
        </div>

        <div class="vn-conditions__cta">
          <p class="vn-conditions__cta-text">
            Общие условия — это только старт. Чтобы понять вашу реальную сумму,
            нужен личный расчет.
          </p>
          <a
            href="/kalkulyator-voennoy-ipoteki/"
            class="vn-btn-secondary vn-conditions__btn"
          >
            Рассчитать свою сумму в калькуляторе
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-conditions {
    padding: 96px 0;
    background: var(--color-bg-surface);
  }

  .vn-conditions__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .vn-conditions__header {
    text-align: left;
    margin-bottom: 48px;
  }

  .vn-conditions__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .vn-conditions__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }

  .vn-conditions__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
  }

  .vn-conditions__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-conditions__card:hover {
      border-color: var(--color-accent-cta);
      transform: translateY(-2px);
    }
  }

  .vn-conditions__card--accent {
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 20%,
      var(--color-bg-primary)
    );
    border-color: color-mix(
      in srgb,
      var(--color-accent-cta) 30%,
      var(--color-border)
    );
  }

  .vn-conditions__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    color: var(--color-accent-primary);
  }

  .vn-conditions__card--accent .vn-conditions__card-icon {
    background: color-mix(in srgb, var(--color-accent-cta) 15%, transparent);
    color: var(--color-accent-cta);
  }

  .vn-conditions__card-title {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .vn-conditions__card-text {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-conditions__footer {
    display: grid;
    gap: 32px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-primary);
  }

  .vn-conditions__disclaimer {
    display: flex;
    gap: 12px;
    color: var(--color-text-secondary);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }

  .vn-conditions__disclaimer svg {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    margin-top: 2px;
  }

  .vn-conditions__disclaimer strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .vn-conditions__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .vn-conditions__cta-text {
    font-size: var(--fs-lead);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
    text-wrap: balance;
  }

  .vn-conditions__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-accent-cta);
    border: 1px solid var(--color-accent-cta);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .vn-conditions__btn:hover {
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
  }

  @media (max-width: 640px) {
    .vn-conditions {
      padding: 64px 0;
    }

    .vn-conditions__header {
      margin-bottom: 32px;
    }

    .vn-conditions__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .vn-conditions__card {
      padding: 16px;
      gap: 10px;
    }

    .vn-conditions__card-icon {
      width: 32px;
      height: 32px;
    }

    .vn-conditions__card-title {
      font-size: 14px;
    }

    .vn-conditions__card-text {
      font-size: 12px;
      line-height: 1.3;
    }

    .vn-conditions__footer {
      padding: 20px;
    }

    .vn-conditions__cta {
      align-items: stretch;
    }

    .vn-conditions__btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
