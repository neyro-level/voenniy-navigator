---

---

<section
  id="section-usl-conditions"
  class="vn-conditions"
  data-reveal="fade-up"
>
  <div class="vn-container">
    <div class="vn-conditions__inner">
      <div class="vn-conditions__header">
        <span class="vn-label-mono vn-conditions__eyebrow">
          Параметры одобрения
        </span>
        <h2 class="vn-conditions__title">
          Базовые условия, от которых зависит одобрение вашей заявки
        </h2>
        <p class="vn-conditions__lead">
          Программа НИС задает общие рамки, но итоговое решение всегда принимает
          банк. Мы проверяем эти 4 параметра до подачи документов, чтобы
          исключить отказ на старте.
        </p>
      </div>

      <div class="vn-conditions__grid">
        <article class="vn-conditions__card">
          <div class="vn-conditions__card-head">
            <div class="vn-conditions__icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
            </div>
            <span class="vn-conditions__card-number">01</span>
          </div>

          <h3 class="vn-conditions__card-title">Стаж в НИС</h3>
          <p class="vn-conditions__card-highlight">Минимум <strong>3 года</strong> в реестре участников.</p>
          <p class="vn-conditions__card-text">
            Мы проверяем ваш актуальный статус и остаток на счете до начала
            подбора, чтобы вы не тратили время на заведомо неподходящие
            варианты.
          </p>
        </article>

        <article class="vn-conditions__card">
          <div class="vn-conditions__card-head">
            <div class="vn-conditions__icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 7h16"></path>
                <path d="M6 4v6"></path>
                <path d="M18 4v6"></path>
                <rect x="3" y="7" width="18" height="13" rx="2"></rect>
                <path d="M8 13h8"></path>
                <path d="M8 16h5"></path>
              </svg>
            </div>
            <span class="vn-conditions__card-number">02</span>
          </div>

          <h3 class="vn-conditions__card-title">Ежегодный взнос государства</h3>
          <p class="vn-conditions__card-highlight"><strong>411 184,90 ₽</strong> в 2026 году.</p>
          <p class="vn-conditions__card-text">
            Это эквивалент <strong>~34 265 ₽/мес</strong>, которые банк
            автоматически направляет на погашение основного долга и процентов в
            рамках лимита.
          </p>
        </article>

        <article class="vn-conditions__card">
          <div class="vn-conditions__card-head">
            <div class="vn-conditions__icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 12h16"></path>
                <path d="M12 4v16"></path>
                <path d="M19 7l-7-3-7 3v5c0 4.5 3 7.5 7 8 4-.5 7-3.5 7-8V7z"></path>
              </svg>
            </div>
            <span class="vn-conditions__card-number">03</span>
          </div>

          <h3 class="vn-conditions__card-title">Срок кредитования</h3>
          <p class="vn-conditions__card-highlight">До <strong>20-25 лет</strong>.</p>
          <p class="vn-conditions__card-text">
            Банк строго рассчитывает ваш возраст на момент полного погашения,
            обычно не старше <strong>65-75 лет</strong>. Чем вы моложе, тем
            выше может быть сумма.
          </p>
        </article>

        <article class="vn-conditions__card">
          <div class="vn-conditions__card-head">
            <div class="vn-conditions__icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 10.5 12 3l9 7.5"></path>
                <path d="M5 9.5V20h14V9.5"></path>
                <path d="M9 20v-6h6v6"></path>
              </svg>
            </div>
            <span class="vn-conditions__card-number">04</span>
          </div>

          <h3 class="vn-conditions__card-title">Требования к объекту</h3>
          <p class="vn-conditions__card-highlight"><strong>Новостройки</strong> vs <strong>вторичка</strong>.</p>
          <p class="vn-conditions__card-text">
            Новостройки от аккредитованных застройщиков одобряются быстрее. Для
            вторичного жилья действуют строгие лимиты по году постройки и
            материалу стен.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-conditions {
    padding: 96px 0;
    background: var(--color-bg-surface);
  }

  .vn-conditions__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .vn-conditions__header {
    margin-bottom: 40px;
  }

  .vn-conditions__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    color: var(--color-text-tertiary);
  }

  .vn-conditions__eyebrow::before {
    content: "";
    width: 28px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-accent-cta);
  }

  .vn-conditions__title {
    max-width: 760px;
    margin: 0 0 16px;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-conditions__lead {
    max-width: 700px;
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-conditions__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .vn-conditions__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-conditions__card:hover {
      border-color: color-mix(
        in srgb,
        var(--color-accent-primary) 32%,
        var(--color-border)
      );
      background: color-mix(
        in srgb,
        var(--color-accent-primary-soft) 36%,
        var(--color-bg-surface)
      );
      transform: translateY(-2px);
    }
  }

  .vn-conditions__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .vn-conditions__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--color-accent-primary);
    background: color-mix(
      in srgb,
      var(--color-accent-primary-soft) 72%,
      var(--color-bg-surface)
    );
  }

  .vn-conditions__card-number {
    font-size: 12px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  .vn-conditions__card-title {
    margin: 0 0 12px;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-conditions__card-highlight {
    margin: 0 0 12px;
    font-size: 18px;
    line-height: 1.4;
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .vn-conditions__card-highlight strong,
  .vn-conditions__card-text strong {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-conditions__card-text {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .vn-conditions {
      padding: 64px 0;
    }

    .vn-conditions__header {
      margin-bottom: 32px;
    }

    .vn-conditions__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .vn-conditions__card {
      padding: 22px 20px;
    }

    .vn-conditions__card-head {
      margin-bottom: 16px;
    }

    .vn-conditions__icon {
      width: 36px;
      height: 36px;
    }

    .vn-conditions__card-title {
      font-size: 19px;
      margin-bottom: 10px;
    }

    .vn-conditions__card-highlight {
      font-size: 16px;
      margin-bottom: 10px;
    }
  }
</style>
