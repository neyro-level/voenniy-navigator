---

---

<section id="section-usl-amount" class="vn-amount" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-amount__inner">
      <div class="vn-amount__header">
        <h2 class="vn-amount__title">
          Сколько реально даст банк по военной ипотеке
        </h2>
        <p class="vn-amount__lead">
          Стандартный диапазон одобрения сейчас — около <strong
            >2,1–2,3 млн ₽</strong
          >. Но это лишь базовый ориентир. Банк считает не по общей таблице, а
          под вашу конкретную ситуацию.
        </p>
      </div>

      <div class="vn-amount__visual-block">
        <div class="vn-amount__highlight">
          <span class="vn-amount__highlight-label">Базовый ориентир</span>
          <span class="vn-amount__highlight-value">2,1 – 2,3 млн ₽</span>
          <span class="vn-amount__highlight-note"
            >Стандартная сумма при использовании только средств НИС</span
          >
        </div>

        <div class="vn-amount__factors">
          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Срок и возраст</h3>
              <p class="vn-amount__factor-text">
                Чем длиннее срок кредита, тем выше сумма. Банк строго смотрит на
                ваш возраст на момент полного погашения.
              </p>
            </div>
          </div>

          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="2" y="7" width="20" height="14" rx="2" ry="2"
                ></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"
                ></path></svg
              >
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Выбор банка</h3>
              <p class="vn-amount__factor-text">
                У Сбербанка, ВТБ, ПСБ и Банка РОССИЯ разные максимальные лимиты
                и требования к объекту недвижимости.
              </p>
            </div>
          </div>

          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                ></path><polyline points="9 22 9 12 15 12 15 22"
                ></polyline></svg
              >
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Тип недвижимости</h3>
              <p class="vn-amount__factor-text">
                Новостройки часто имеют более лояльные условия и расширенные
                лимиты по сравнению со вторичным рынком.
              </p>
            </div>
          </div>

          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M6 11h8a4 4 0 0 0 0-8H9v18"></path><path d="M6 15h8"
                ></path></svg
              >
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Дополнительные средства</h3>
              <p class="vn-amount__factor-text">
                Маткапитал или собственные накопления напрямую и значительно
                увеличивают итоговый бюджет покупки.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="vn-amount__cta-block">
        <p class="vn-amount__cta-text">
          Не гадайте по общим цифрам. Введите свои данные и получите точный
          расчет доступного бюджета.
        </p>
        <a
          href="/kalkulyator-voennoy-ipoteki/"
          class="vn-btn-primary vn-amount__btn"
        >
          Рассчитать свою сумму в калькуляторе
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-amount {
    padding: 96px 0;
    background: var(--color-bg-surface);
  }

  .vn-amount__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .vn-amount__header {
    text-align: left;
    margin-bottom: 40px;
  }

  .vn-amount__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .vn-amount__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }

  .vn-amount__lead strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .vn-amount__visual-block {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px;
    margin-bottom: 40px;
  }

  .vn-amount__highlight {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-dark);
    color: var(--color-text-ondark);
    border: 1px solid var(--color-border-dark);
  }

  .vn-amount__highlight-label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-ondark-secondary);
    margin-bottom: 12px;
  }

  .vn-amount__highlight-value {
    font-size: clamp(36px, 5vw, 48px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-accent-cta);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .vn-amount__highlight-note {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-ondark-secondary);
    margin: 0;
  }

  .vn-amount__factors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .vn-amount__factor {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-amount__factor:hover {
      border-color: var(--color-accent-cta);
      transform: translateY(-2px);
    }
  }

  .vn-amount__factor-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 30%,
      transparent
    );
    color: var(--color-accent-cta);
  }

  .vn-amount__factor-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vn-amount__factor-title {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .vn-amount__factor-text {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-amount__cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--color-bg-primary) 80%, transparent);
  }

  .vn-amount__cta-text {
    font-size: var(--fs-lead);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
    text-wrap: balance;
    max-width: 560px;
  }

  .vn-amount__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .vn-amount__btn:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .vn-amount {
      padding: 64px 0;
    }

    .vn-amount__header {
      margin-bottom: 32px;
    }

    .vn-amount__visual-block {
      grid-template-columns: 1fr;
    }

    .vn-amount__highlight {
      padding: 24px;
      text-align: center;
    }

    .vn-amount__factors {
      grid-template-columns: 1fr 1fr; /* Две колонки на мобильном для экономии места */
      gap: 12px;
    }

    .vn-amount__factor {
      padding: 12px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .vn-amount__factor-icon {
      width: 28px;
      height: 28px;
    }

    .vn-amount__factor-title {
      font-size: 13px;
    }

    .vn-amount__factor-text {
      font-size: 12px;
      line-height: 1.3;
    }

    .vn-amount__cta-block {
      padding: 24px;
      align-items: stretch;
      text-align: left;
    }

    .vn-amount__btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
