---

---

<section
  id="section-usl-eligibility"
  class="vn-eligibility"
  data-reveal="fade-up"
>
  <div class="vn-container">
    <div class="vn-eligibility__inner">
      <div class="vn-eligibility__header">
        <h2 class="vn-eligibility__title">
          Кто может получить военную ипотеку и какие документы нужны
        </h2>
        <p class="vn-eligibility__lead">
          Право на использование накоплений возникает не сразу после вступления
          в программу. Важно понимать базовые критерии и иметь под рукой
          актуальный пакет документов.
        </p>
      </div>

      <div class="vn-eligibility__grid">
        <!-- Левая колонка: Критерии -->
        <div class="vn-eligibility__card">
          <div class="vn-eligibility__card-head">
            <div class="vn-eligibility__icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                ></path><circle cx="9" cy="7" r="4"></circle><path
                  d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
                  d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
              >
            </div>
            <h3 class="vn-eligibility__card-title">Критерии участия</h3>
          </div>
          <ul class="vn-eligibility__list">
            <li class="vn-eligibility__list-item">
              <svg
                class="vn-eligibility__check"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span
                ><strong>Статус:</strong> Действующий участник накопительно-ипотечной
                системы (НИС).</span
              >
            </li>
            <li class="vn-eligibility__list-item">
              <svg
                class="vn-eligibility__check"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span
                ><strong>Срок:</strong> Минимум 3 года непрерывного членства в реестре.</span
              >
            </li>
            <li class="vn-eligibility__list-item">
              <svg
                class="vn-eligibility__check"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span
                ><strong>Возраст:</strong> От 21 года до момента полного погашения
                кредита (обычно до 65–75 лет, зависит от банка).</span
              >
            </li>
          </ul>
        </div>

        <!-- Правая колонка: Документы -->
        <div class="vn-eligibility__card">
          <div class="vn-eligibility__card-head">
            <div class="vn-eligibility__icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline><line
                  x1="16"
                  y1="13"
                  x2="8"
                  y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
                ></line><polyline points="10 9 9 9 8 9"></polyline></svg
              >
            </div>
            <h3 class="vn-eligibility__card-title">Пакет документов</h3>
          </div>
          <ul class="vn-eligibility__list">
            <li class="vn-eligibility__list-item">
              <svg
                class="vn-eligibility__file"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"
                ></path><polyline points="13 2 13 9 20 9"></polyline></svg
              >
              <span
                ><strong>Базовый:</strong> Паспорт РФ, свидетельство о праве на получение
                ЦЖЗ, предварительный договор или документы на объект.</span
              >
            </li>
            <li class="vn-eligibility__list-item">
              <svg
                class="vn-eligibility__file"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"
                ></path><polyline points="13 2 13 9 20 9"></polyline></svg
              >
              <span
                ><strong>Для расширения бюджета:</strong> Сертификат на материнский
                (семейный) капитал, свидетельство о браке (для совместного расчета),
                справки о доходах (при необходимости доплаты).</span
              >
            </li>
          </ul>
        </div>
      </div>

      <div class="vn-eligibility__footer">
        <div class="vn-eligibility__accent-box">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><line
              x1="12"
              y1="16"
              x2="12"
              y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg
          >
          <p>
            <strong>Важно:</strong> даже если вы уже участник НИС и собрали документы,
            итоговая сумма одобрения зависит от конкретного банка, вашей кредитной
            истории и выбранного объекта. Не гадайте — рассчитайте свой реальный сценарий.
          </p>
        </div>
        <a
          href="/kalkulyator-voennoy-ipoteki/"
          class="vn-btn-secondary vn-eligibility__btn"
        >
          Рассчитать свой сценарий в калькуляторе
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-eligibility {
    padding: 96px 0;
    background: var(--color-bg-primary);
  }

  .vn-eligibility__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .vn-eligibility__header {
    text-align: left;
    margin-bottom: 48px;
  }

  .vn-eligibility__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .vn-eligibility__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }

  .vn-eligibility__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 40px;
  }

  .vn-eligibility__card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-eligibility__card:hover {
      border-color: var(--color-accent-cta);
      box-shadow: 0 8px 24px
        color-mix(in srgb, var(--color-accent-cta) 5%, transparent);
    }
  }

  .vn-eligibility__card-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .vn-eligibility__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 30%,
      transparent
    );
    color: var(--color-accent-cta);
  }

  .vn-eligibility__card-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .vn-eligibility__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vn-eligibility__list-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-eligibility__list-item strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .vn-eligibility__check {
    flex-shrink: 0;
    color: var(--color-accent-cta);
    margin-top: 3px;
  }

  .vn-eligibility__file {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    margin-top: 3px;
  }

  .vn-eligibility__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 40px 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: color-mix(
      in srgb,
      var(--color-bg-surface) 60%,
      var(--color-bg-primary)
    );
  }

  .vn-eligibility__accent-box {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
    max-width: 720px;
  }

  .vn-eligibility__accent-box svg {
    flex-shrink: 0;
    color: var(--color-accent-cta);
    margin-top: 2px;
  }

  .vn-eligibility__accent-box p {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vn-eligibility__accent-box strong {
    color: var(--color-text-primary);
  }

  .vn-eligibility__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-accent-cta);
    border: 1px solid var(--color-accent-cta);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .vn-eligibility__btn:hover {
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
  }

  @media (max-width: 768px) {
    .vn-eligibility {
      padding: 64px 0;
    }

    .vn-eligibility__header {
      margin-bottom: 32px;
    }

    .vn-eligibility__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vn-eligibility__card {
      padding: 20px;
      gap: 16px;
    }

    .vn-eligibility__icon {
      width: 40px;
      height: 40px;
    }

    .vn-eligibility__list {
      gap: 12px;
    }

    .vn-eligibility__list-item {
      font-size: 13px;
      line-height: 1.4;
    }

    .vn-eligibility__footer {
      padding: 20px;
      align-items: stretch;
      text-align: left;
    }

    .vn-eligibility__accent-box {
      flex-direction: column;
      gap: 12px;
    }

    .vn-eligibility__btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
