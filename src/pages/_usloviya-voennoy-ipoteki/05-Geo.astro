---
---

<section id="section-usl-geo" class="vn-geo" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-geo__inner">
      <div class="vn-geo__header">
        <span class="vn-label-mono vn-geo__eyebrow">Условия в вашем регионе</span>
        <h2 class="vn-geo__title">
          Правила НИС одинаковы, но порядок действий по сделке в Краснодаре и Крыму разный
        </h2>
        <p class="vn-geo__lead">
          Сама программа НИС едина по всей России, но на практике меняются банки, набор аккредитованных объектов и логика подбора.
        </p>
      </div>

      <div class="vn-geo__grid">
        <a href="/voennaya-ipoteka-krasnodar/" class="vn-geo__card">
          <div class="vn-geo__card-body">
            <div class="vn-geo__card-top">
              <span class="vn-geo__card-icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                  <path d="M2 17l10 5 10-5"></path>
                  <path d="M2 12l10 5 10-5"></path>
                </svg>
              </span>
              <h3 class="vn-geo__card-title">Краснодар</h3>
            </div>
            <p class="vn-geo__card-text">
              Широкий выбор новостроек и вторички. Здесь проще сверить банк, бюджет и объект в одном поле решения.
            </p>
            <span class="vn-geo__card-cta">
              Подробнее о Краснодаре
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>

        <a href="/voennaya-ipoteka-krym/" class="vn-geo__card">
          <div class="vn-geo__card-body">
            <div class="vn-geo__card-top">
              <span class="vn-geo__card-icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20z"></path>
                  <path d="M2 12h20"></path>
                </svg>
              </span>
              <h3 class="vn-geo__card-title">Крым</h3>
            </div>
            <p class="vn-geo__card-text">
              Меньше аккредитованных объектов и банков. Важнее предварительно проверить банк и объект до старта сделки.
            </p>
            <span class="vn-geo__card-cta">
              Подробнее о Крыму
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-geo {
    padding-block: var(--spacing-section);
    background: var(--color-bg-primary);
  }

  .vn-geo__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .vn-geo__header {
    margin-bottom: 40px;
  }

  .vn-geo__eyebrow {
    margin-bottom: 16px;
  }

  .vn-geo__title {
    max-width: 760px;
    margin: 0 0 16px;
    font-size: var(--fs-h2);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-geo__lead {
    max-width: 760px;
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.62;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-geo__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .vn-geo__card {
    display: flex;
    gap: 20px;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-geo__card:hover {
      border-color: var(--color-accent-cta);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px
        color-mix(in srgb, var(--color-accent-cta) 5%, transparent);
    }
  }

  .vn-geo__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-accent-cta-soft);
    color: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-geo__card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .vn-geo__card-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vn-geo__card-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .vn-geo__card-text {
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-geo__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-accent-cta);
    transition: gap 0.2s ease;
  }

  .vn-geo__card:hover .vn-geo__card-cta {
    gap: 12px;
  }

  .vn-geo__card-cta svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .vn-geo {
      padding-block: var(--spacing-section-mobile);
    }

    .vn-geo__header {
      margin-bottom: 32px;
    }

    .vn-geo__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .vn-geo__card {
      padding: 20px;
      gap: 16px;
    }

    .vn-geo__card-icon {
      width: 36px;
      height: 36px;
    }
  }
</style>
