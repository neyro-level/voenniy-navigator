---

---

<section id="section-usl-scenarios" class="vn-scenarios" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-scenarios__inner">
      <div class="vn-scenarios__header">
        <h2 class="vn-scenarios__title">
          Как увеличить бюджет покупки сверх базового лимита
        </h2>
        <p class="vn-scenarios__lead">
          Военная ипотека — это не приговор к одной фиксированной сумме.
          Грамотное комбинирование источников позволяет существенно расширить
          бюджет и выбрать объект, который действительно решает вашу задачу.
        </p>
      </div>

      <div class="vn-scenarios__grid">
        <!-- Сценарий 1 -->
        <div class="vn-scenarios__card">
          <div class="vn-scenarios__card-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line
                x1="5"
                y1="12"
                x2="19"
                y2="12"></line></svg
            >
          </div>
          <h3 class="vn-scenarios__card-title">Собственные накопления</h3>
          <p class="vn-scenarios__card-text">
            Самый прямой способ. Дополнительный первоначальный взнос снижает
            ежемесячную нагрузку или позволяет рассмотреть объект классом выше
            без переплат.
          </p>
        </div>

        <!-- Сценарий 2 -->
        <div class="vn-scenarios__card">
          <div class="vn-scenarios__card-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
              ></path><circle cx="9" cy="7" r="4"></circle><path
                d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
                d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
          </div>
          <h3 class="vn-scenarios__card-title">Материнский капитал</h3>
          <p class="vn-scenarios__card-text">
            Можно направить на первоначальный взнос или досрочное погашение. Это
            легальный и самый быстрый способ значительно увеличить одобренную
            банком сумму.
          </p>
        </div>

        <!-- Сценарий 3 -->
        <div class="vn-scenarios__card vn-scenarios__card--highlight">
          <div class="vn-scenarios__card-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
              ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
            >
          </div>
          <h3 class="vn-scenarios__card-title">
            <a href="/semeynaya-voennaya-ipoteka/" class="vn-scenarios__link"
              >Семейная военная ипотека</a
            >
          </h3>
          <p class="vn-scenarios__card-text">
            Если у вас есть дети, подходящие под условия госпрограммы, можно
            комбинировать военную и семейную ипотеку. Это дает доступ к
            сниженной ставке и большему лимиту.
          </p>
        </div>

        <!-- Сценарий 4 -->
        <div class="vn-scenarios__card">
          <div class="vn-scenarios__card-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
              ></path><circle cx="9" cy="7" r="4"></circle><path
                d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
                d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
          </div>
          <h3 class="vn-scenarios__card-title">Два участника НИС</h3>
          <p class="vn-scenarios__card-text">
            Если оба супруга служат и являются участниками НИС, их лимиты
            суммируются. Это открывает доступ к гораздо более ликвидной и
            просторной недвижимости.
          </p>
        </div>
      </div>

      <div class="vn-scenarios__cta-section">
        <div class="vn-scenarios__cta-icon" aria-hidden="true">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M6 11h8a4 4 0 0 0 0-8H9v18"></path><path d="M6 15h8"
            ></path></svg
          >
        </div>
        <h3 class="vn-scenarios__cta-title">
          Узнайте ваш реальный бюджет на покупку
        </h3>
        <p class="vn-scenarios__cta-text">
          Не гадайте на общих цифрах. Мы проверим ваши исходные данные,
          сопоставим их с текущими программами банков и покажем конкретный путь
          к нужной квартире.
        </p>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Узнать мой реальный бюджет"
          class="vn-btn-primary vn-scenarios__cta-btn"
        >
          Узнать мой реальный бюджет
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-scenarios {
    padding: 96px 0;
    background: var(--color-bg-primary);
  }

  .vn-scenarios__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .vn-scenarios__header {
    text-align: left;
    margin-bottom: 40px;
  }

  .vn-scenarios__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .vn-scenarios__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
    max-width: 640px;
  }

  .vn-scenarios__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .vn-scenarios__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-scenarios__card:hover {
      border-color: var(--color-accent-cta);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px
        color-mix(in srgb, var(--color-accent-cta) 5%, transparent);
    }
  }

  .vn-scenarios__card--highlight {
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 15%,
      var(--color-bg-surface)
    );
    border-color: color-mix(
      in srgb,
      var(--color-accent-cta) 30%,
      var(--color-border)
    );
  }

  .vn-scenarios__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 30%,
      transparent
    );
    color: var(--color-accent-cta);
  }

  .vn-scenarios__card--highlight .vn-scenarios__card-icon {
    background: color-mix(in srgb, var(--color-accent-cta) 20%, transparent);
  }

  .vn-scenarios__card-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .vn-scenarios__link {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-accent-cta);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .vn-scenarios__link:hover {
    color: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
  }

  .vn-scenarios__card-text {
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-scenarios__cta-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 56px 40px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-dark);
    color: var(--color-text-ondark);
    position: relative;
    overflow: hidden;
  }

  .vn-scenarios__cta-section::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 8%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .vn-scenarios__cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent-cta) 15%, transparent);
    color: var(--color-accent-cta);
    position: relative;
    z-index: 1;
  }

  .vn-scenarios__cta-title {
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-text-ondark);
    margin: 0;
    text-wrap: balance;
    position: relative;
    z-index: 1;
  }

  .vn-scenarios__cta-text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-ondark-secondary);
    margin: 0;
    text-wrap: pretty;
    max-width: 560px;
    position: relative;
    z-index: 1;
  }

  .vn-scenarios__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: var(--color-accent-cta);
    color: var(--color-bg-surface);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
    position: relative;
    z-index: 1;
    margin-top: 8px;
  }

  .vn-scenarios__cta-btn:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .vn-scenarios__cta-btn svg {
    transition: transform 0.2s ease;
  }

  .vn-scenarios__cta-btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .vn-scenarios {
      padding: 64px 0;
    }

    .vn-scenarios__header {
      margin-bottom: 32px;
    }

    .vn-scenarios__grid {
      grid-template-columns: 1fr 1fr; /* Две колонки на мобильном для компактности */
      gap: 12px;
    }

    .vn-scenarios__card {
      padding: 16px;
      gap: 10px;
    }

    .vn-scenarios__card-icon {
      width: 32px;
      height: 32px;
    }

    .vn-scenarios__card-title {
      font-size: 14px;
    }

    .vn-scenarios__card-text {
      font-size: 12px;
      line-height: 1.3;
    }

    .vn-scenarios__cta-section {
      padding: 32px 24px;
      align-items: stretch;
      text-align: left;
    }

    .vn-scenarios__cta-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
