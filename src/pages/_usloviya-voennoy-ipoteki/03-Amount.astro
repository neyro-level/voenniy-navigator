---
---

<section id="section-usl-amount" class="vn-amount" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-amount__inner">
      <div class="vn-amount__header">
        <span class="vn-label-mono">Сколько даёт банк на практике</span>
        <h2 class="vn-amount__title">
          2,1–2,3 млн — но это не ваш финальный бюджет
        </h2>
        <p class="vn-amount__lead">
          Банк не одобряет по таблице. Он смотрит на возраст, срок кредита, банк, объект и дополнительные деньги в сделке. Ниже видно, как каждый из этих рычагов меняет реальный сценарий.
        </p>
      </div>

      <div class="vn-amount__visual-block">
        <div class="vn-amount__receipt">
          <div class="vn-amount__receipt-header">
            <span class="vn-amount__receipt-label">Базовый ориентир НИС, 2026</span>
          </div>
          <div class="vn-amount__receipt-body">
            <div class="vn-amount__receipt-row">
              <span class="vn-amount__receipt-item">Сумма НИС</span>
              <span class="vn-amount__receipt-value">2,1–2,3 млн ₽</span>
            </div>
            <div class="vn-amount__receipt-divider"></div>
            <div class="vn-amount__receipt-row vn-amount__receipt-row--bonus">
              <span class="vn-amount__receipt-item">+ Материнский капитал</span>
              <span class="vn-amount__receipt-value">+650 тыс ₽</span>
            </div>
            <div class="vn-amount__receipt-row vn-amount__receipt-row--bonus">
              <span class="vn-amount__receipt-item">+ Собственные средства</span>
              <span class="vn-amount__receipt-value">+500 тыс ₽</span>
            </div>
            <div class="vn-amount__receipt-row vn-amount__receipt-row--bonus">
              <span class="vn-amount__receipt-item">+ Семейная программа</span>
              <span class="vn-amount__receipt-value">по расчёту</span>
            </div>
            <div class="vn-amount__receipt-divider vn-amount__receipt-divider--thick"></div>
            <div class="vn-amount__receipt-row vn-amount__receipt-row--total">
              <span class="vn-amount__receipt-item">Итого</span>
              <span class="vn-amount__receipt-value">до 5 млн ₽</span>
            </div>
          </div>
          <div class="vn-amount__receipt-footer">
            <span>Итог зависит от банка, возраста и формата сделки</span>
          </div>
        </div>

        <div class="vn-amount__factors">
          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Срок кредита</h3>
              <p class="vn-amount__factor-text">
                Чем дольше срок и спокойнее возрастной запас, тем шире может быть доступная сумма.
              </p>
            </div>
          </div>

          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Банк</h3>
              <p class="vn-amount__factor-text">
                ПСБ, Сбер, ВТБ и Банк Россия по-разному смотрят на срок, взнос и сам формат сделки.
              </p>
            </div>
          </div>

          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Тип объекта</h3>
              <p class="vn-amount__factor-text">
                Новостройки обычно проходят проще, а вторичное жильё требует более внимательной проверки.
              </p>
            </div>
          </div>

          <div class="vn-amount__factor">
            <div class="vn-amount__factor-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ><path d="M6 11h8a4 4 0 0 0 0-8H9v18"></path><path d="M6 15h8"></path></svg>
            </div>
            <div class="vn-amount__factor-content">
              <h3 class="vn-amount__factor-title">Дополнительные средства</h3>
              <p class="vn-amount__factor-text">
                Маткапитал, семейная программа и собственные деньги напрямую расширяют итоговый бюджет.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="vn-amount__scenarios">
        <h3 class="vn-amount__scenarios-title">4 способа увеличить бюджет</h3>
        <div class="vn-amount__scenarios-grid">
          <div class="vn-amount__scenario">
            <span class="vn-amount__scenario-metric">+500 тыс ₽ и выше</span>
            <span class="vn-amount__scenario-name">Собственные накопления</span>
          </div>
          <div class="vn-amount__scenario">
            <span class="vn-amount__scenario-metric">+650 тыс ₽</span>
            <span class="vn-amount__scenario-name">Материнский капитал</span>
          </div>
          <div class="vn-amount__scenario vn-amount__scenario--highlight">
            <span class="vn-amount__scenario-metric">Ниже ставка и шире бюджет</span>
            <a href="/semeynaya-voennaya-ipoteka/" class="vn-amount__scenario-name vn-amount__scenario-link">Семейная + военная ипотека</a>
          </div>
          <div class="vn-amount__scenario">
            <span class="vn-amount__scenario-metric">Сумма из двух сценариев</span>
            <span class="vn-amount__scenario-name">Два участника НИС</span>
          </div>
        </div>
      </div>

      <div class="vn-amount__cta-block">
        <p class="vn-amount__cta-text">
          Не гадайте по общим цифрам. Лучше один раз посчитать сумму по вашим параметрам.
        </p>
        <a
          href="/kalkulyator-voennoy-ipoteki/"
          class="vn-btn-primary vn-amount__btn"
        >
          Рассчитать сумму
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-amount {
    padding-block: var(--spacing-section);
    background: var(--color-bg-primary);
  }

  .vn-amount__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .vn-amount__header {
    margin-bottom: 40px;
  }

  .vn-amount__title {
    max-width: 700px;
    margin: 16px 0 16px;
    font-size: var(--fs-h2);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-amount__lead {
    max-width: 700px;
    font-size: var(--fs-body);
    line-height: 1.62;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
  }

  .vn-amount__visual-block {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px;
    margin-bottom: 48px;
  }

  .vn-amount__receipt {
    display: flex;
    flex-direction: column;
    padding: 32px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-dark);
    color: var(--color-text-ondark);
    border: 1px solid var(--color-border-ondark);
    position: relative;
    overflow: hidden;
  }

  .vn-amount__receipt::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--color-accent-cta),
      color-mix(in srgb, var(--color-accent-cta) 60%, transparent)
    );
  }

  .vn-amount__receipt-header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px dashed color-mix(
      in srgb,
      var(--color-text-ondark-mute) 30%,
      transparent
    );
  }

  .vn-amount__receipt-label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-ondark-mute);
  }

  .vn-amount__receipt-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .vn-amount__receipt-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .vn-amount__receipt-row--bonus {
    opacity: 0.84;
  }

  .vn-amount__receipt-row--total {
    margin-top: 4px;
  }

  .vn-amount__receipt-item {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-ondark-mute);
  }

  .vn-amount__receipt-value {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-ondark);
    text-align: right;
    white-space: nowrap;
  }

  .vn-amount__receipt-row--total .vn-amount__receipt-item {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-ondark);
  }

  .vn-amount__receipt-row--total .vn-amount__receipt-value {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    color: var(--color-accent-cta);
    letter-spacing: -0.02em;
  }

  .vn-amount__receipt-divider {
    height: 1px;
    background: color-mix(
      in srgb,
      var(--color-text-ondark-mute) 20%,
      transparent
    );
    margin: 4px 0;
  }

  .vn-amount__receipt-divider--thick {
    height: 2px;
    background: color-mix(
      in srgb,
      var(--color-text-ondark-mute) 40%,
      transparent
    );
  }

  .vn-amount__receipt-footer {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed color-mix(
      in srgb,
      var(--color-text-ondark-mute) 30%,
      transparent
    );
    text-align: center;
  }

  .vn-amount__receipt-footer span {
    font-size: var(--fs-body-sm);
    color: var(--color-text-ondark-mute);
  }

  .vn-amount__factors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .vn-amount__factor {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-amount__factor:hover {
      border-color: var(--color-accent-cta);
      transform: translateY(-2px);
    }
  }

  .vn-amount__factor-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 30%,
      transparent
    );
    color: var(--color-accent-cta);
  }

  .vn-amount__factor-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vn-amount__factor-title {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .vn-amount__factor-text {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-amount__scenarios {
    margin-bottom: 40px;
  }

  .vn-amount__scenarios-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 20px;
    line-height: 1.3;
  }

  .vn-amount__scenarios-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .vn-amount__scenario {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .vn-amount__scenario:hover {
      border-color: var(--color-accent-cta);
      transform: translateY(-2px);
    }
  }

  .vn-amount__scenario--highlight {
    background: color-mix(
      in srgb,
      var(--color-accent-cta-soft) 15%,
      var(--color-bg-surface)
    );
    border-color: color-mix(
      in srgb,
      var(--color-accent-cta) 30%,
      var(--color-border)
    );
  }

  .vn-amount__scenario-metric {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-accent-cta);
    line-height: 1.4;
  }

  .vn-amount__scenario-name {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .vn-amount__scenario-link {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-accent-cta);
    font-weight: 600;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .vn-amount__scenario-link:hover {
    color: var(--color-accent-cta);
    border-color: var(--color-accent-cta);
  }

  .vn-amount__cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-surface);
  }

  .vn-amount__cta-text {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-primary);
    margin: 0;
    text-wrap: balance;
    max-width: 560px;
  }

  @media (max-width: 1024px) {
    .vn-amount__scenarios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .vn-amount {
      padding-block: var(--spacing-section-mobile);
    }

    .vn-amount__header {
      margin-bottom: 32px;
    }

    .vn-amount__visual-block {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }

    .vn-amount__receipt {
      padding: 24px;
    }

    .vn-amount__receipt-row--total .vn-amount__receipt-value {
      font-size: 24px;
    }

    .vn-amount__factors {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .vn-amount__factor {
      padding: 12px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .vn-amount__factor-icon {
      width: 28px;
      height: 28px;
    }

    .vn-amount__factor-title {
      font-size: var(--fs-body-sm);
    }

    .vn-amount__factor-text {
      font-size: var(--fs-body-sm);
      line-height: 1.45;
    }

    .vn-amount__scenarios {
      margin-bottom: 32px;
    }

    .vn-amount__scenarios-title {
      margin-bottom: 16px;
    }

    .vn-amount__scenarios-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .vn-amount__scenario {
      padding: 16px;
      gap: 8px;
    }

    .vn-amount__scenario-metric {
      font-size: var(--fs-body-sm);
    }

    .vn-amount__cta-block {
      padding: 24px;
      align-items: stretch;
      text-align: left;
    }

    .vn-amount__btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
