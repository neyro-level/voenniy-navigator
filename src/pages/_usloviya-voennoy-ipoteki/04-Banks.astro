---
---

<section id="section-usl-banks" class="vn-banks" data-reveal="fade-up">
  <div class="vn-container">
    <div class="vn-banks__inner">
      <div class="vn-banks__header">
        <span class="vn-label-mono vn-banks__eyebrow">Банки и программы</span>
        <h2 class="vn-banks__title">
          На сайтах банков сравнивают условия, а в реальной сделке решает ваша ситуация
        </h2>
        <p class="vn-banks__lead">
          Красивые цифры в рекламе не гарантируют реального одобрения. У банков отличаются срок, требования к объекту и первоначальному взносу — поэтому сравнивать нужно не только ставку, но и порядок действий по сделке целиком.
        </p>
      </div>

      <div class="vn-banks__table-wrapper" data-table="desktop">
        <table class="vn-banks__table">
          <thead>
            <tr>
              <th scope="col" class="vn-banks__th">Параметр</th>
              <th scope="col" class="vn-banks__th">ПСБ</th>
              <th scope="col" class="vn-banks__th">Сбер</th>
              <th scope="col" class="vn-banks__th">ВТБ</th>
              <th scope="col" class="vn-banks__th">Банк&nbsp;РОССИЯ</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="vn-banks__td vn-banks__td--label">Ставка</td>
              <td class="vn-banks__td">от 2%</td>
              <td class="vn-banks__td">от 2%</td>
              <td class="vn-banks__td">от 2%</td>
              <td class="vn-banks__td">от 2%</td>
            </tr>
            <tr>
              <td class="vn-banks__td vn-banks__td--label">Базовый ориентир по НИС</td>
              <td class="vn-banks__td">около 2,1–2,3 млн ₽</td>
              <td class="vn-banks__td">около 2,1–2,3 млн ₽</td>
              <td class="vn-banks__td">около 2,1–2,3 млн ₽</td>
              <td class="vn-banks__td">около 2,1–2,3 млн ₽</td>
            </tr>
            <tr>
              <td class="vn-banks__td vn-banks__td--label">Срок</td>
              <td class="vn-banks__td">до 25 лет</td>
              <td class="vn-banks__td">до 30 лет</td>
              <td class="vn-banks__td">до 30 лет</td>
              <td class="vn-banks__td">до 25 лет</td>
            </tr>
            <tr>
              <td class="vn-banks__td vn-banks__td--label">Первоначальный взнос</td>
              <td class="vn-banks__td">0–15%</td>
              <td class="vn-banks__td">10–20%</td>
              <td class="vn-banks__td">0–15%</td>
              <td class="vn-banks__td">5–15%</td>
            </tr>
            <tr>
              <td class="vn-banks__td vn-banks__td--label">Объекты</td>
              <td class="vn-banks__td">новостройки, вторичка</td>
              <td class="vn-banks__td">новостройки, вторичка</td>
              <td class="vn-banks__td">новостройки, вторичка, дома</td>
              <td class="vn-banks__td">новостройки, вторичка</td>
            </tr>
            <tr>
              <td class="vn-banks__td vn-banks__td--label">Возраст заёмщика</td>
              <td class="vn-banks__td">до 65 лет</td>
              <td class="vn-banks__td">до 65 лет</td>
              <td class="vn-banks__td">до 65 лет</td>
              <td class="vn-banks__td">до 65 лет</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="vn-banks__mobile-cards" data-table="mobile">
        <div class="vn-banks__m-card">
          <div class="vn-banks__m-head">
            <span class="vn-banks__m-name">ПСБ</span>
          </div>
          <div class="vn-banks__m-params">
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Ставка</span>
              <span class="vn-banks__m-value">от 2%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Базовый ориентир по НИС</span>
              <span class="vn-banks__m-value">около 2,1–2,3 млн ₽</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Срок</span>
              <span class="vn-banks__m-value">до 25 лет</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Первоначальный взнос</span>
              <span class="vn-banks__m-value">0–15%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Объекты</span>
              <span class="vn-banks__m-value">новостройки, вторичка</span>
            </div>
          </div>
        </div>

        <div class="vn-banks__m-card">
          <div class="vn-banks__m-head">
            <span class="vn-banks__m-name">Сбер</span>
          </div>
          <div class="vn-banks__m-params">
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Ставка</span>
              <span class="vn-banks__m-value">от 2%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Базовый ориентир по НИС</span>
              <span class="vn-banks__m-value">около 2,1–2,3 млн ₽</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Срок</span>
              <span class="vn-banks__m-value">до 30 лет</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Первоначальный взнос</span>
              <span class="vn-banks__m-value">10–20%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Объекты</span>
              <span class="vn-banks__m-value">новостройки, вторичка</span>
            </div>
          </div>
        </div>

        <div class="vn-banks__m-card">
          <div class="vn-banks__m-head">
            <span class="vn-banks__m-name">ВТБ</span>
          </div>
          <div class="vn-banks__m-params">
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Ставка</span>
              <span class="vn-banks__m-value">от 2%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Базовый ориентир по НИС</span>
              <span class="vn-banks__m-value">около 2,1–2,3 млн ₽</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Срок</span>
              <span class="vn-banks__m-value">до 30 лет</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Первоначальный взнос</span>
              <span class="vn-banks__m-value">0–15%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Объекты</span>
              <span class="vn-banks__m-value">новостройки, вторичка, дома</span>
            </div>
          </div>
        </div>

        <div class="vn-banks__m-card">
          <div class="vn-banks__m-head">
            <span class="vn-banks__m-name">Банк РОССИЯ</span>
          </div>
          <div class="vn-banks__m-params">
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Ставка</span>
              <span class="vn-banks__m-value">от 2%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Базовый ориентир по НИС</span>
              <span class="vn-banks__m-value">около 2,1–2,3 млн ₽</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Срок</span>
              <span class="vn-banks__m-value">до 25 лет</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Первоначальный взнос</span>
              <span class="vn-banks__m-value">5–15%</span>
            </div>
            <div class="vn-banks__m-row">
              <span class="vn-banks__m-label">Объекты</span>
              <span class="vn-banks__m-value">новостройки, вторичка</span>
            </div>
          </div>
        </div>
      </div>

      <div class="vn-banks__cta-section">
        <div class="vn-banks__cta-content">
          <h3 class="vn-banks__cta-title">
            Банк выбирают не по рекламе, а по вашей ситуации сделки
          </h3>
          <p class="vn-banks__cta-text">
            Мы поможем выбрать банк, который подходит именно под ваши параметры, а не просто выглядит сильнее в таблице.
          </p>
        </div>
        <a
          href="/contacts/#request"
          data-modal-open
          data-modal-title="Получить расчёт ситуации"
          data-modal-subtitle="Проверим бюджет, формат сделки и подскажем, какой банк логичнее смотреть именно в вашей ситуации."
          class="vn-btn-primary vn-banks__cta-btn"
        >
          Подобрать банк под мою ситуацию
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-banks {
    padding-block: var(--spacing-section);
    background: var(--color-bg-surface);
  }

  .vn-banks__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .vn-banks__header {
    margin-bottom: 48px;
  }

  .vn-banks__eyebrow {
    margin-bottom: 16px;
  }

  .vn-banks__title {
    max-width: 760px;
    margin: 0 0 16px;
    font-size: var(--fs-h2);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-banks__lead {
    max-width: 760px;
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.62;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-banks__table-wrapper {
    margin-bottom: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    overflow-x: auto;
  }

  .vn-banks__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }

  .vn-banks__table thead {
    background: var(--color-bg-surface-low);
  }

  .vn-banks__th {
    padding: 16px 20px;
    text-align: left;
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .vn-banks__td {
    padding: 16px 20px;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .vn-banks__td--label {
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .vn-banks__mobile-cards {
    display: none;
    margin-bottom: 48px;
    flex-direction: column;
    gap: 16px;
  }

  .vn-banks__m-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    overflow: hidden;
  }

  .vn-banks__m-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--color-bg-surface-low);
    border-bottom: 1px solid var(--color-border);
  }

  .vn-banks__m-name {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .vn-banks__m-params {
    padding: 12px 20px;
  }

  .vn-banks__m-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 50%, transparent);
  }

  .vn-banks__m-row:last-child {
    border-bottom: none;
  }

  .vn-banks__m-label {
    font-size: var(--fs-body-sm);
    color: var(--color-text-tertiary);
    flex: 0 0 auto;
    padding-right: 16px;
  }

  .vn-banks__m-value {
    font-size: var(--fs-body-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    text-align: right;
  }

  .vn-banks__cta-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-dark);
    color: var(--color-text-ondark);
    position: relative;
    overflow: hidden;
  }

  .vn-banks__cta-section::before {
    content: "";
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 8%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .vn-banks__cta-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
  }

  .vn-banks__cta-title {
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text-ondark);
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .vn-banks__cta-text {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-ondark-mute);
    margin: 0;
    text-wrap: pretty;
  }

  .vn-banks__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    position: relative;
    z-index: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .vn-banks__cta-btn svg {
    transition: transform 0.2s ease;
  }

  .vn-banks__cta-btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .vn-banks {
      padding-block: var(--spacing-section-mobile);
    }

    .vn-banks__header {
      margin-bottom: 32px;
    }

    .vn-banks__table-wrapper {
      display: none;
    }

    .vn-banks__mobile-cards {
      display: flex;
    }

    .vn-banks__cta-section {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
      padding: 24px 20px;
      gap: 20px;
    }

    .vn-banks__cta-btn {
      width: 100%;
      text-align: center;
      white-space: normal;
    }
  }
</style>
