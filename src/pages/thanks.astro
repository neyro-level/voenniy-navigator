---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/constants';
---
<PageLayout
  title="Заявка принята — Михаил Хряпин"
  description="Ваша заявка отправлена. Михаил свяжется с вами в течение нескольких часов."
  canonical={`${SITE.url}/thanks/`}
  noindex={true}
>
  <section class="vn-section" style="min-height: 70vh; display: flex; align-items: center;">
    <div class="vn-container" style="text-align: center; max-width: 560px; margin-inline: auto;">

      <!-- Checkmark icon -->
      <div style="width: 64px; height: 64px; border-radius: 50%; background-color: var(--color-accent-cta-soft); display: flex; align-items: center; justify-content: center; margin: 0 auto 32px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-cta);" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>

      <h1 style="font-size: 32px; font-weight: 600; margin-bottom: 16px;">Заявка принята</h1>
      <p style="font-size: 17px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 40px;">
        Михаил свяжется с вами в течение нескольких часов.<br />
        Если вопрос срочный — напишите напрямую в Telegram.
      </p>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="vn-btn-primary">На главную</a>
        <a href="[TELEGRAM]" class="vn-btn-ghost" rel="noopener" target="_blank">
          Написать в Telegram
        </a>
      </div>
    </div>
  </section>
</PageLayout>
