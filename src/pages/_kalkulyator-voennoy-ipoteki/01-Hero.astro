---
// Компонент: 01-Hero.astro
// Задача: коротко ввести пользователя в страницу и сразу обозначить связь калькулятора с заявкой.
---

<section id="section-calc-hero" class="vn-calc-hero">
  <div class="vn-calc-hero__grid" aria-hidden="true"></div>
  <div class="vn-calc-hero__radial" aria-hidden="true"></div>

  <div class="vn-container">
    <div class="vn-calc-hero__shell">
      <p class="vn-label-mono">Военная ипотека / калькулятор / 01</p>

      <h1 class="vn-calc-hero__title">
        Калькулятор военной ипотеки,
        <span class="vn-calc-hero__title-accent">сколько даст банк?</span>
      </h1>

      <p class="vn-calc-hero__lead">
        Рассчитайте сумму военной ипотеки с учетом актуальных банковских ставок.
      </p>

      <button
        type="button"
        class="vn-btn-primary vn-calc-hero__cta"
        data-modal-open
        data-modal-title="Рассчитаем вашу военную ипотеку бесплатно"
        data-modal-subtitle="Уточним бюджет, подберём банк с лучшими условиями и расскажем, как сейчас можно снизить ставку или первоначальный взнос."
        data-track="cta_click"
        data-track-params='{"placement":"calc_hero_short","page":"kalkulyator-voennoy-ipoteki"}'
      >
        Подать заявку
      </button>
    </div>
  </div>
</section>

<style>
  .vn-calc-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-primary);
    padding-top: 132px;
    padding-bottom: 72px;
  }

  .vn-calc-hero__grid,
  .vn-calc-hero__radial {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vn-calc-hero__grid {
    background-image:
      linear-gradient(
        to right,
        var(--color-deco-grid-light) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        var(--color-deco-grid-light) 1px,
        transparent 1px
      );
    background-size: 64px 64px;
    opacity: 0.85;
  }

  .vn-calc-hero__radial {
    inset: auto auto -180px 52%;
    width: 720px;
    height: 420px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-primary) 8%, transparent) 0%,
      transparent 68%
    );
    transform: translateX(-50%);
  }

  .vn-calc-hero__shell {
    position: relative;
    z-index: 1;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vn-calc-hero__title {
    margin: 16px 0 20px;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-calc-hero__title-accent {
    color: var(--color-accent-primary);
  }

  .vn-calc-hero__lead {
    max-width: 640px;
    margin: 0 0 28px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .vn-calc-hero__cta {
    min-width: 220px;
  }

  @media (max-width: 640px) {
    .vn-calc-hero {
      padding-top: 88px;
      padding-bottom: 44px;
    }

    .vn-calc-hero__grid {
      background-size: 48px 48px;
    }

    .vn-calc-hero__radial {
      left: 50%;
      bottom: -220px;
      width: 540px;
      height: 320px;
    }

    .vn-calc-hero__title {
      margin: 12px 0 14px;
      font-size: 34px;
      line-height: 1.08;
    }

    .vn-calc-hero__lead {
      margin-bottom: 20px;
      font-size: var(--fs-body);
      line-height: 1.5;
    }

    .vn-calc-hero__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
