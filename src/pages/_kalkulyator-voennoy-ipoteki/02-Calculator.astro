---
// Компонент: 02-Calculator.astro
// Задача: дать wide-формат калькулятора с двумя логиками — бюджет покупки и накопления НИС.
---

<section id="calc-workbench" class="vn-calc-workbench" data-calc-root>
  <div class="vn-container">
  <div class="vn-calc-workbench__wide">
    <div class="vn-calc-workbench__intro">
      <p class="vn-label-mono vn-calc-workbench__eyebrow">Военная ипотека / калькулятор / 01</p>
      <h1 class="vn-calc-workbench__title">Калькулятор военной ипотеки</h1>
      <p class="vn-calc-workbench__lead">
        Рассчитайте предварительную сумму кредита. Чтобы получить точное одобрение,
        оставьте заявку на бесплатный анализ вашей кредитной истории и подбор программы.
      </p>
    </div>

    <div class="vn-calc-workbench__frame">
      <div class="vn-calc-workbench__layout">
        <div class="vn-calc-workbench__controls">
          <div class="vn-calc-workbench__tabs" role="tablist" aria-label="Логика калькулятора">
            <button
              type="button"
              class="vn-calc-workbench__tab is-active"
              data-tab-btn
              data-tab-target="budget"
              aria-selected="true"
            >
              Бюджет покупки
            </button>
            <button
              type="button"
              class="vn-calc-workbench__tab"
              data-tab-btn
              data-tab-target="nis"
              aria-selected="false"
            >
              Накопления НИС
            </button>
          </div>

          <div class="vn-calc-workbench__pane is-active" data-pane="budget">
            <div class="vn-calc-workbench__section-head">
              <p>
                Выберите вариант расчёта и посмотрите, на какой кредит и бюджет покупки
                можно ориентироваться.
              </p>
            </div>

            <div class="vn-calc-workbench__scenario-grid">
              <button
                type="button"
                class="vn-calc-workbench__scenario is-active"
                data-scenario="standard"
              >
                <span class="vn-label-mono">Базовый</span>
                <strong>Стандартная военная</strong>
                <span>До 2,3 млн ₽, ставка около 18%</span>
              </button>
              <button
                type="button"
                class="vn-calc-workbench__scenario"
                data-scenario="family"
              >
                <span class="vn-label-mono">Комбинированный</span>
                <strong>Военная + семейная</strong>
                <span>Бюджет до 6 млн ₽, ставка от 6%</span>
              </button>
              <button
                type="button"
                class="vn-calc-workbench__scenario"
                data-scenario="new-territories"
              >
                <span class="vn-label-mono">Спецпрограмма</span>
                <strong>Новые территории</strong>
                <span>Ставка 2%, отдельные условия банка</span>
              </button>
            </div>

            <form class="vn-calc-workbench__fields vn-calc-workbench__fields--budget" novalidate>
              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-price">Стоимость квартиры</label>
                  <output for="calc-price" data-output="price">6 000 000 ₽</output>
                </div>
                <input
                  type="range"
                  id="calc-price"
                  min="1500000"
                  max="12000000"
                  step="50000"
                  value="6000000"
                  data-input="price"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-monthly">Ежемесячный взнос НИС</label>
                  <output for="calc-monthly" data-output="monthly">34 265 ₽</output>
                </div>
                <input
                  type="range"
                  id="calc-monthly"
                  min="20000"
                  max="60000"
                  step="100"
                  value="34265"
                  data-input="monthly"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-savings">Накопления НИС</label>
                  <output for="calc-savings" data-output="savings">0 ₽</output>
                </div>
                <input
                  type="range"
                  id="calc-savings"
                  min="0"
                  max="5000000"
                  step="50000"
                  value="0"
                  data-input="savings"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-own-funds" class="vn-calc-workbench__field-label--own-funds">
                    Свои средства <span>/ маткапитал</span>
                  </label>
                  <output for="calc-own-funds" data-output="ownFunds">0 ₽</output>
                </div>
                <input
                  type="range"
                  id="calc-own-funds"
                  min="0"
                  max="4000000"
                  step="50000"
                  value="0"
                  data-input="ownFunds"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-rate">Ставка банка</label>
                  <output for="calc-rate" data-output="rate">18%</output>
                </div>
                <input
                  type="range"
                  id="calc-rate"
                  min="2"
                  max="25"
                  step="0.1"
                  value="18"
                  data-input="rate"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-term">Срок кредита</label>
                  <output for="calc-term" data-output="term">25 лет</output>
                </div>
                <input
                  type="range"
                  id="calc-term"
                  min="1"
                  max="30"
                  step="1"
                  value="25"
                  data-input="term"
                />
              </div>
            </form>

            <p class="vn-calc-workbench__microcopy">
              Это ориентир по кредиту и бюджету покупки. Точную сумму банк
              подтвердит после проверки анкеты и объекта.
            </p>
          </div>

          <div class="vn-calc-workbench__pane" data-pane="nis" hidden>
            <div class="vn-calc-workbench__section-head">
              <p>
                Уточните период участия в НИС и затем перенесите сумму в бюджет
                покупки.
              </p>
            </div>

            <form class="vn-calc-workbench__fields vn-calc-workbench__fields--nis" novalidate>
              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-nis-year">Год включения в НИС</label>
                  <output for="calc-nis-year" data-output="nisYear">2015</output>
                </div>
                <input
                  type="range"
                  id="calc-nis-year"
                  min="2005"
                  max="2026"
                  step="1"
                  value="2015"
                  data-input="nisYear"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-nis-month">Месяц включения</label>
                  <output for="calc-nis-month" data-output="nisMonth">июнь</output>
                </div>
                <input
                  type="range"
                  id="calc-nis-month"
                  min="1"
                  max="12"
                  step="1"
                  value="6"
                  data-input="nisMonth"
                />
              </div>

              <div class="vn-calc-workbench__field-card">
                <div class="vn-calc-workbench__field-top">
                  <label for="calc-nis-target">Год, до которого считать</label>
                  <output for="calc-nis-target" data-output="nisTarget">2026</output>
                </div>
                <input
                  type="range"
                  id="calc-nis-target"
                  min="2005"
                  max="2026"
                  step="1"
                  value="2026"
                  data-input="nisTarget"
                />
              </div>
            </form>

            <div class="vn-calc-workbench__nis-actions">
              <p class="vn-calc-workbench__microcopy">
                В расчёте учитываются ежегодные взносы НИС без инвестдохода.
                Реальный остаток на счёте может быть выше.
              </p>

              <button
                type="button"
                class="vn-btn-primary"
                data-use-nis
              >
                Подставить накопления в бюджет покупки
              </button>
            </div>
          </div>
        </div>

        <aside class="vn-calc-workbench__summary">
          <div class="vn-calc-workbench__summary-panel is-active" data-summary="budget">
            <p class="vn-label-mono">Сколько даст банк</p>
            <p class="vn-calc-workbench__summary-kicker" data-result="scenarioName">
              Стандартная военная ипотека
            </p>
            <strong class="vn-calc-workbench__summary-value" data-result="loan">
              ~2 150 000 ₽
            </strong>
            <p class="vn-calc-workbench__summary-lead" data-result="scenarioDescription">
              Классический вариант для базовой военной ипотеки без дополнительных программ.
            </p>

            <div class="vn-calc-workbench__summary-grid">
              <div class="vn-calc-workbench__summary-card">
                <span>Стартовый взнос</span>
                <strong data-result="downpayment">0 ₽</strong>
              </div>
              <div class="vn-calc-workbench__summary-card">
                <span>Бюджет покупки</span>
                <strong data-result="budget">~2 150 000 ₽</strong>
              </div>
              <div class="vn-calc-workbench__summary-card vn-calc-workbench__summary-card--accent" data-gap-state="negative">
                <span>Хватает ли на объект</span>
                <strong data-result="gap">Не хватает 3 850 000 ₽</strong>
              </div>
            </div>

            <div class="vn-calc-workbench__summary-stack">
              <div class="vn-calc-workbench__inline-row">
                <span class="vn-label-mono">Банки</span>
                <span data-result="banks">ПСБ, Сбер, ВТБ, Банк Россия</span>
              </div>
              <p class="vn-calc-workbench__summary-note" data-result="budgetLegend">
                Банк считает лимит исходя из ежемесячного взноса НИС, ставки и срока кредита.
              </p>
            </div>

            <button
              type="button"
              class="vn-btn-primary vn-calc-workbench__summary-cta"
              data-modal-open
              data-modal-title="Рассчитать варианты"
              data-track="cta_click"
              data-track-params='{"placement":"calc_workbench_budget","page":"kalkulyator-voennoy-ipoteki"}'
            >
              Рассчитать варианты
            </button>
          </div>

          <div class="vn-calc-workbench__summary-panel" data-summary="nis" hidden>
            <p class="vn-label-mono">Накопления НИС</p>
            <p class="vn-calc-workbench__summary-kicker">Ориентир без инвестдохода</p>
            <strong class="vn-calc-workbench__summary-value" data-result="nisTotal">
              3 203 191 ₽
            </strong>
            <p class="vn-calc-workbench__summary-lead">
              Этот расчёт помогает понять, сколько можно использовать как первый
              взнос до выбора квартиры и общения с банком.
            </p>

            <div class="vn-calc-workbench__summary-grid vn-calc-workbench__summary-grid--nis">
              <div class="vn-calc-workbench__summary-card">
                <span>Старт НИС</span>
                <strong data-result="nisStart">июнь 2015</strong>
              </div>
              <div class="vn-calc-workbench__summary-card">
                <span>Считаем до</span>
                <strong data-result="nisEnd">2026</strong>
              </div>
              <div class="vn-calc-workbench__summary-card">
                <span>Что учтено</span>
                <strong>Взносы государства</strong>
              </div>
            </div>

            <p class="vn-calc-workbench__summary-note">
              Чтобы перейти от накоплений к выбору объекта, перенесите сумму НИС
              в основной расчёт и посмотрите итоговый бюджет покупки.
            </p>

            <button
              type="button"
              class="vn-btn-primary vn-calc-workbench__summary-cta"
              data-use-nis
            >
              Подставить накопления в бюджет покупки
            </button>
          </div>
        </aside>
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  type ScenarioKey = "standard" | "family" | "new-territories";

  interface ScenarioConfig {
    name: string;
    rate: number;
    maxTerm: number;
    banks: string;
    description: string;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-calc-root]");

    const annualContributions: Record<number, number> = {
      2005: 37000,
      2006: 40600,
      2007: 82800,
      2008: 89900,
      2009: 168000,
      2010: 175600,
      2011: 189800,
      2012: 205200,
      2013: 222000,
      2014: 233100,
      2015: 245880,
      2016: 245880,
      2017: 260141,
      2018: 268466,
      2019: 280010,
      2020: 288410,
      2021: 299081,
      2022: 311045,
      2023: 349614,
      2024: 367444,
      2025: 389670,
      2026: 411184.9,
    };

    const monthNames = [
      "январь",
      "февраль",
      "март",
      "апрель",
      "май",
      "июнь",
      "июль",
      "август",
      "сентябрь",
      "октябрь",
      "ноябрь",
      "декабрь",
    ] as const;

    const scenarios: Record<ScenarioKey, ScenarioConfig> = {
      standard: {
        name: "Стандартная военная ипотека",
        rate: 18,
        maxTerm: 25,
        banks: "ПСБ, Сбер, ВТБ, Банк Россия",
        description:
          "Классический вариант для базовой военной ипотеки без дополнительных программ.",
      },
      family: {
        name: "Военная + семейная ипотека",
        rate: 6,
        maxTerm: 30,
        banks: "ПСБ, Сбер, ВТБ, ДОМ.РФ",
        description:
          "Комбинация программ помогает расширить бюджет и снизить ставку, если семья проходит по условиям.",
      },
      "new-territories": {
        name: "Военная ипотека для новых территорий",
        rate: 2,
        maxTerm: 30,
        banks: "ПСБ — специальная программа",
        description:
          "Спецвариант с пониженной ставкой и отдельной банковской логикой по объекту и региону.",
      },
    };

    const formatCurrency = (value: number): string =>
      new Intl.NumberFormat("ru-RU", {
        style: "currency",
        currency: "RUB",
        maximumFractionDigits: 0,
      })
        .format(Math.round(value))
        .trim();

    const formatTerm = (years: number): string => {
      if (years % 10 === 1 && years % 100 !== 11) return `${years} год`;
      if ([2, 3, 4].includes(years % 10) && ![12, 13, 14].includes(years % 100)) {
        return `${years} года`;
      }
      return `${years} лет`;
    };

    const setRangeFill = (input: HTMLInputElement): void => {
      const min = Number(input.min || 0);
      const max = Number(input.max || 100);
      const value = Number(input.value || 0);
      const percent = max === min ? 0 : ((value - min) / (max - min)) * 100;
      input.style.backgroundSize = `${percent}% 100%`;
    };

    roots.forEach((root) => {
      const tabButtons = root.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
      const panes = root.querySelectorAll<HTMLElement>("[data-pane]");
      const summaries = root.querySelectorAll<HTMLElement>("[data-summary]");
      const scenarioButtons = root.querySelectorAll<HTMLButtonElement>("[data-scenario]");
      const useNisButtons = root.querySelectorAll<HTMLButtonElement>("[data-use-nis]");
      const allRanges = root.querySelectorAll<HTMLInputElement>('input[type="range"]');

      const budgetInputs = {
        price: root.querySelector<HTMLInputElement>('[data-input="price"]')!,
        monthly: root.querySelector<HTMLInputElement>('[data-input="monthly"]')!,
        savings: root.querySelector<HTMLInputElement>('[data-input="savings"]')!,
        ownFunds: root.querySelector<HTMLInputElement>('[data-input="ownFunds"]')!,
        rate: root.querySelector<HTMLInputElement>('[data-input="rate"]')!,
        term: root.querySelector<HTMLInputElement>('[data-input="term"]')!,
      };

      const nisInputs = {
        year: root.querySelector<HTMLInputElement>('[data-input="nisYear"]')!,
        month: root.querySelector<HTMLInputElement>('[data-input="nisMonth"]')!,
        target: root.querySelector<HTMLInputElement>('[data-input="nisTarget"]')!,
      };

      const outputs = {
        price: root.querySelector<HTMLOutputElement>('[data-output="price"]')!,
        monthly: root.querySelector<HTMLOutputElement>('[data-output="monthly"]')!,
        savings: root.querySelector<HTMLOutputElement>('[data-output="savings"]')!,
        ownFunds: root.querySelector<HTMLOutputElement>('[data-output="ownFunds"]')!,
        rate: root.querySelector<HTMLOutputElement>('[data-output="rate"]')!,
        term: root.querySelector<HTMLOutputElement>('[data-output="term"]')!,
        nisYear: root.querySelector<HTMLOutputElement>('[data-output="nisYear"]')!,
        nisMonth: root.querySelector<HTMLOutputElement>('[data-output="nisMonth"]')!,
        nisTarget: root.querySelector<HTMLOutputElement>('[data-output="nisTarget"]')!,
      };

      const results = {
        loan: root.querySelector<HTMLElement>('[data-result="loan"]')!,
        downpayment: root.querySelector<HTMLElement>('[data-result="downpayment"]')!,
        budget: root.querySelector<HTMLElement>('[data-result="budget"]')!,
        gap: root.querySelector<HTMLElement>('[data-result="gap"]')!,
        banks: root.querySelector<HTMLElement>('[data-result="banks"]')!,
        scenarioName: root.querySelector<HTMLElement>('[data-result="scenarioName"]')!,
        scenarioDescription: root.querySelector<HTMLElement>('[data-result="scenarioDescription"]')!,
        budgetLegend: root.querySelector<HTMLElement>('[data-result="budgetLegend"]')!,
        nisTotal: root.querySelector<HTMLElement>('[data-result="nisTotal"]')!,
        nisStart: root.querySelector<HTMLElement>('[data-result="nisStart"]')!,
        nisEnd: root.querySelector<HTMLElement>('[data-result="nisEnd"]')!,
      };

      const gapCard = root.querySelector<HTMLElement>(".vn-calc-workbench__summary-card--accent")!;
      let currentScenario: ScenarioKey = "standard";
      let lastNisTotal = 0;

      const activateTab = (tabName: string): void => {
        tabButtons.forEach((button) => {
          const isActive = button.getAttribute("data-tab-target") === tabName;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-selected", String(isActive));
        });

        panes.forEach((pane) => {
          const isActive = pane.getAttribute("data-pane") === tabName;
          pane.classList.toggle("is-active", isActive);
          pane.hidden = !isActive;
        });

        summaries.forEach((summary) => {
          const isActive = summary.getAttribute("data-summary") === tabName;
          summary.classList.toggle("is-active", isActive);
          summary.hidden = !isActive;
        });
      };

      const applyScenario = (scenarioKey: ScenarioKey): void => {
        const config = scenarios[scenarioKey];
        currentScenario = scenarioKey;

        scenarioButtons.forEach((button) => {
          button.classList.toggle(
            "is-active",
            button.getAttribute("data-scenario") === scenarioKey,
          );
        });

        budgetInputs.rate.value = String(config.rate);
        budgetInputs.term.max = String(config.maxTerm);
        if (Number(budgetInputs.term.value) > config.maxTerm) {
          budgetInputs.term.value = String(config.maxTerm);
        }

        setRangeFill(budgetInputs.rate);
        setRangeFill(budgetInputs.term);

        results.banks.textContent = config.banks;
        results.scenarioName.textContent = config.name;
        results.scenarioDescription.textContent = config.description;
      };

      const recalcNis = (): void => {
        let year = Number(nisInputs.year.value);
        let month = Number(nisInputs.month.value);
        let target = Number(nisInputs.target.value);

        year = Math.max(2005, Math.min(2026, year));
        target = Math.max(year, Math.min(2026, target));
        month = Math.max(1, Math.min(12, month));

        nisInputs.year.value = String(year);
        nisInputs.month.value = String(month);
        nisInputs.target.value = String(target);

        outputs.nisYear.textContent = String(year);
        outputs.nisMonth.textContent = monthNames[month - 1];
        outputs.nisTarget.textContent = String(target);

        let total = 0;
        for (let current = year; current <= target; current += 1) {
          let amount = annualContributions[current] ?? 0;
          if (current === year) {
            amount *= (13 - month) / 12;
          }
          total += amount;
        }

        lastNisTotal = total;
        results.nisTotal.textContent = formatCurrency(total);
        results.nisStart.textContent = `${monthNames[month - 1]} ${year}`;
        results.nisEnd.textContent = String(target);
      };

      const loanFromPayment = (
        monthlyPayment: number,
        annualRate: number,
        termYears: number,
      ): number => {
        const months = termYears * 12;
        const monthlyRate = annualRate / 12 / 100;
        if (months <= 0) return 0;
        if (monthlyRate === 0) return monthlyPayment * months;
        return (
          (monthlyPayment * (1 - Math.pow(1 + monthlyRate, -months))) /
          monthlyRate
        );
      };

      const recalcBudget = (): void => {
        const price = Number(budgetInputs.price.value);
        const monthly = Number(budgetInputs.monthly.value);
        const savings = Number(budgetInputs.savings.value);
        const ownFunds = Number(budgetInputs.ownFunds.value);
        const rate = Number(budgetInputs.rate.value);
        const term = Number(budgetInputs.term.value);

        outputs.price.textContent = formatCurrency(price);
        outputs.monthly.textContent = formatCurrency(monthly);
        outputs.savings.textContent = formatCurrency(savings);
        outputs.ownFunds.textContent = formatCurrency(ownFunds);
        outputs.rate.textContent = `${rate.toFixed(1).replace(".0", "")}%`;
        outputs.term.textContent = formatTerm(term);

        const maxLoan = Math.floor(loanFromPayment(monthly, rate, term) / 1000) * 1000;
        const downpayment = savings + ownFunds;
        const budget = maxLoan + downpayment;
        const gap = price - budget;

        results.loan.textContent = `~${formatCurrency(maxLoan)}`;
        results.downpayment.textContent = formatCurrency(downpayment);
        results.budget.textContent = `~${formatCurrency(budget)}`;
        results.gap.textContent =
          gap > 0 ? `Не хватает ${formatCurrency(gap)}` : `Запас ${formatCurrency(Math.abs(gap))}`;
        results.budgetLegend.textContent =
          `Банк считает лимит исходя из взноса НИС ${formatCurrency(monthly)} в месяц, ` +
          `ставки ${rate.toFixed(1).replace(".0", "")}% и срока ${formatTerm(term)}.`;

        gapCard.setAttribute("data-gap-state", gap > 0 ? "negative" : "positive");
      };

      tabButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activateTab(button.getAttribute("data-tab-target") ?? "budget");
        });
      });

      scenarioButtons.forEach((button) => {
        button.addEventListener("click", () => {
          applyScenario((button.getAttribute("data-scenario") as ScenarioKey) ?? "standard");
          recalcBudget();
        });
      });

      useNisButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const savingsMax = Number(budgetInputs.savings.max || lastNisTotal);
          const nextValue = Math.min(lastNisTotal || 0, savingsMax);
          budgetInputs.savings.value = String(nextValue);
          setRangeFill(budgetInputs.savings);
          activateTab("budget");
          recalcBudget();
        });
      });

      Object.values(budgetInputs).forEach((input) => {
        input.addEventListener("input", recalcBudget);
      });

      Object.values(nisInputs).forEach((input) => {
        input.addEventListener("input", recalcNis);
      });

      allRanges.forEach((input) => {
        setRangeFill(input);
        input.addEventListener("input", () => setRangeFill(input));
      });

      applyScenario(currentScenario);
      recalcNis();
      recalcBudget();
      activateTab("budget");
    });
  });
</script>

