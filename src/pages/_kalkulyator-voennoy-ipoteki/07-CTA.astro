---
import { CONTACTS } from "../../lib/constants";
import { getConfiguredValue } from "../../lib/utils";
import { Icon } from 'astro-icon/components';

const telegramHref = getConfiguredValue(CONTACTS.telegram);
const maxHref = getConfiguredValue(CONTACTS.max);

const guarantees = [
  { icon: 'shield-check', text: 'Без комиссий для покупателя' },
  { icon: 'globe', text: 'Можно полностью дистанционно' },
  { icon: 'clock', text: 'Занимает всего 20 минут' },
];
---

<section id="section-cta-final" class="vn-calc-cta" aria-labelledby="vn-calc-cta-title">
  <div class="vn-container">
    <div class="vn-calc-cta__layout">
      <div class="vn-calc-cta__content">
        <span class="vn-label-mono vn-calc-cta__eyebrow">ТОЧНЫЙ РАСЧЁТ</span>
        <h2 class="vn-calc-cta__title" id="vn-calc-cta-title">
          Получите точный расчёт под
          <span class="vn-calc-cta__accent">вашу ситуацию</span>
        </h2>
        <p class="vn-calc-cta__subtitle">
          Оставьте контакты. Мы разберём ваши вводные, проверим подходящий сценарий покупки, пересчитаем всё вручную и подскажем, какой объект реально доступен и что делать дальше.
        </p>

        <div class="vn-calc-cta__actions">
          <a
            href="/contacts/#request"
            data-modal-open
            data-modal-title="Получить разбор ситуации"
            class="vn-btn-primary vn-calc-cta__cta"
          >
            Получить разбор ситуации
          </a>

          {(telegramHref || maxHref) && (
            <p class="vn-calc-cta__alt">
              <span>Или напишите напрямую:</span>
              <span class="vn-calc-cta__alt-links">
                {telegramHref && (
                  <a href={telegramHref} target="_blank" rel="noopener noreferrer" class="vn-calc-cta__alt-link">Telegram</a>
                )}
                {telegramHref && maxHref && <span class="vn-calc-cta__alt-sep">/</span>}
                {maxHref && (
                  <a href={maxHref} target="_blank" rel="noopener noreferrer" class="vn-calc-cta__alt-link">Max</a>
                )}
              </span>
            </p>
          )}
        </div>
      </div>

      <div class="vn-calc-cta__guarantees-wrap">
        <div class="vn-calc-cta__guarantees">
          {guarantees.map((item, index) => (
            <div class="vn-calc-cta__guarantee-item">
              <span class="vn-calc-cta__guarantee-index">{String(index + 1).padStart(2, '0')}</span>
              <div class="vn-calc-cta__guarantee-icon">
                <Icon name={item.icon} width="20" height="20" aria-hidden="true" />
              </div>
              <span class="vn-calc-cta__guarantee-text">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vn-calc-cta {
    position: relative;
    padding-block: 96px;
    background: var(--color-bg-surface);
    overflow: hidden;
  }

  .vn-calc-cta::after {
    content: '';
    position: absolute;
    right: -220px;
    bottom: -260px;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 8%, transparent) 0%,
      transparent 72%
    );
    pointer-events: none;
  }

  .vn-calc-cta__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 64px;
    align-items: center;
  }

  .vn-calc-cta__eyebrow {
    color: var(--color-accent-cta);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .vn-calc-cta__title {
    margin: 16px 0 20px;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .vn-calc-cta__accent {
    display: block;
    color: var(--color-accent-cta);
  }

  .vn-calc-cta__subtitle {
    margin: 0 0 36px;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 520px;
    text-wrap: pretty;
  }

  .vn-calc-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .vn-calc-cta__cta {
    min-width: 280px;
    padding: 18px 36px;
    font-size: var(--fs-body);
    text-align: center;
  }

  .vn-calc-cta__alt {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: 1.4;
    color: var(--color-text-tertiary);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .vn-calc-cta__alt-links {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .vn-calc-cta__alt-sep {
    color: var(--color-text-tertiary);
    opacity: 0.5;
  }

  .vn-calc-cta__alt-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .vn-calc-cta__alt-link:hover {
    color: var(--color-accent-cta);
  }

  .vn-calc-cta__guarantees-wrap {
    position: relative;
    isolation: isolate;
  }

  .vn-calc-cta__guarantees-wrap::before {
    content: '';
    position: absolute;
    inset: 26px -18px -26px 18px;
    border-radius: calc(var(--radius-xl) + 8px);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-accent-cta) 8%, var(--color-bg-surface)) 0%,
      color-mix(in srgb, var(--color-bg-primary) 94%, white) 62%,
      color-mix(in srgb, var(--color-accent-primary) 6%, var(--color-bg-surface)) 100%
    );
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, var(--color-border));
    z-index: 0;
  }

  .vn-calc-cta__guarantees-wrap::after {
    content: '';
    position: absolute;
    top: -18px;
    right: -14px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-cta) 14%, transparent) 0%,
      transparent 70%
    );
    z-index: 0;
    pointer-events: none;
  }

  .vn-calc-cta__guarantees {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 14px;
    padding: 18px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-primary) 94%, white) 0%,
      color-mix(in srgb, var(--color-bg-surface) 96%, white) 100%
    );
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, var(--color-border));
    border-radius: calc(var(--radius-xl) + 4px);
    box-shadow:
      0 26px 60px color-mix(in srgb, var(--color-bg-dark) 8%, transparent),
      0 10px 24px color-mix(in srgb, var(--color-bg-dark) 5%, transparent);
  }

  .vn-calc-cta__guarantee-item {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 18px;
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 10%, var(--color-border));
    border-radius: var(--radius-lg);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-primary) 92%, white) 0%,
      color-mix(in srgb, var(--color-bg-surface) 88%, white) 100%
    );
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 48%, transparent);
  }

  .vn-calc-cta__guarantee-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 46px;
    height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 14%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-cta) 7%, var(--color-bg-primary));
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent-cta);
    font-variant-numeric: tabular-nums;
  }

  .vn-calc-cta__guarantee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, white 56%, transparent), transparent 45%),
      color-mix(in srgb, var(--color-accent-cta) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cta) 12%, transparent);
    color: var(--color-accent-cta);
    flex-shrink: 0;
  }

  .vn-calc-cta__guarantee-text {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  @media (max-width: 1023px) {
    .vn-calc-cta {
      padding-block: 72px;
    }

    .vn-calc-cta__layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .vn-calc-cta__guarantees-wrap {
      max-width: 760px;
    }

    .vn-calc-cta__guarantees-wrap::before {
      inset: 18px -10px -18px 12px;
    }

    .vn-calc-cta__guarantees-wrap::after {
      width: 140px;
      height: 140px;
      right: -6px;
      top: -12px;
    }

    .vn-calc-cta__guarantees {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      padding: 24px;
    }

    .vn-calc-cta__guarantee-item {
      min-height: 100%;
      padding: 16px;
    }

    .vn-calc-cta__guarantee-item:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .vn-calc-cta {
      padding-block: 56px;
    }

    .vn-calc-cta__title {
      font-size: 28px;
      line-height: 1.2;
    }

    .vn-calc-cta__subtitle {
      margin-bottom: 28px;
      font-size: var(--fs-body);
      line-height: 1.55;
    }

    .vn-calc-cta__cta {
      width: 100%;
      min-width: auto;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vn-calc-cta__guarantees {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 14px;
    }

    .vn-calc-cta__guarantee-item {
      padding: 16px;
      gap: 12px;
    }

    .vn-calc-cta__guarantees-wrap::before {
      inset: 14px -6px -10px 10px;
      border-radius: calc(var(--radius-lg) + 8px);
    }

    .vn-calc-cta__guarantees-wrap::after {
      width: 100px;
      height: 100px;
      right: -2px;
      top: -8px;
    }

    .vn-calc-cta__guarantee-index {
      min-width: 40px;
      height: 30px;
      padding: 0 10px;
      font-size: 0.75rem;
    }

    .vn-calc-cta__guarantee-icon {
      width: 42px;
      height: 42px;
    }

    .vn-calc-cta__guarantee-text {
      font-size: var(--fs-body-sm);
      line-height: 1.45;
    }
  }
</style>
